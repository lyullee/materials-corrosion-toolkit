{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "initial_sample_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Initial Sample Fraction",
      "type": "number"
    },
    "minimum_initial_sample_count": {
      "minimum": 0,
      "title": "Minimum Initial Sample Count",
      "type": "integer"
    },
    "failure_count_trigger": {
      "minimum": 1,
      "title": "Failure Count Trigger",
      "type": "integer"
    },
    "expanded_inspection_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Expanded Inspection Fraction",
      "type": "number"
    },
    "reuse_initial_definitive_outcomes_for_expanded_coverage": {
      "title": "Reuse Initial Definitive Outcomes For Expanded Coverage",
      "type": "boolean"
    },
    "basis": {
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "initial_sample_fraction",
    "minimum_initial_sample_count",
    "failure_count_trigger",
    "expanded_inspection_fraction",
    "reuse_initial_definitive_outcomes_for_expanded_coverage",
    "basis",
    "evidence"
  ],
  "title": "InspectionSamplingPlan",
  "type": "object"
}