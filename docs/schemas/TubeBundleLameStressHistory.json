{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TubeCondition": {
      "additionalProperties": false,
      "properties": {
        "tube_id": {
          "minLength": 1,
          "title": "Tube Id",
          "type": "string"
        },
        "inner_diameter_m": {
          "exclusiveMinimum": 0,
          "title": "Inner Diameter M",
          "type": "number"
        },
        "reference_wall_m": {
          "exclusiveMinimum": 0,
          "title": "Reference Wall M",
          "type": "number"
        },
        "minimum_wall_m": {
          "minimum": 0,
          "title": "Minimum Wall M",
          "type": "number"
        },
        "plugged": {
          "title": "Plugged",
          "type": "boolean"
        }
      },
      "required": [
        "tube_id",
        "inner_diameter_m",
        "reference_wall_m",
        "minimum_wall_m",
        "plugged"
      ],
      "title": "TubeCondition",
      "type": "object"
    },
    "TubePressureKnot": {
      "additionalProperties": false,
      "description": "One exact pressure sample for one tube; pressure values are absolute Pa.",
      "properties": {
        "knot_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Knot Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "exchanger_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Exchanger Id",
          "type": "string"
        },
        "bundle_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "tube_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tube Id",
          "type": "string"
        },
        "time_basis_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Time Basis Id",
          "type": "string"
        },
        "pressure_reference_basis_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Pressure Reference Basis Id",
          "type": "string"
        },
        "time_s": {
          "minimum": 0.0,
          "title": "Time S",
          "type": "number"
        },
        "internal_pressure_Pa": {
          "minimum": 0.0,
          "title": "Internal Pressure Pa",
          "type": "number"
        },
        "external_pressure_Pa": {
          "minimum": 0.0,
          "title": "External Pressure Pa",
          "type": "number"
        },
        "source_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "knot_id",
        "asset_id",
        "location_id",
        "exchanger_id",
        "bundle_id",
        "tube_id",
        "time_basis_id",
        "pressure_reference_basis_id",
        "time_s",
        "internal_pressure_Pa",
        "external_pressure_Pa",
        "source_id",
        "source_record_id",
        "source_record_sha256",
        "evidence"
      ],
      "title": "TubePressureKnot",
      "type": "object"
    },
    "TubePressureStressHistory": {
      "additionalProperties": false,
      "description": "One inspected tube's geometry and exact-knot pressure history.",
      "properties": {
        "tube_condition": {
          "$ref": "#/$defs/TubeCondition"
        },
        "asset_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "exchanger_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Exchanger Id",
          "type": "string"
        },
        "bundle_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Bundle Id",
          "type": "string"
        },
        "material_condition_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "closed_ends": {
          "title": "Closed Ends",
          "type": "boolean"
        },
        "geometry_source_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Geometry Source Id",
          "type": "string"
        },
        "geometry_record_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Geometry Record Id",
          "type": "string"
        },
        "geometry_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Record Sha256",
          "type": "string"
        },
        "geometry_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Geometry Evidence",
          "type": "array"
        },
        "pressure_knots": {
          "items": {
            "$ref": "#/$defs/TubePressureKnot"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Pressure Knots",
          "type": "array"
        },
        "plugged_tube_pressure_path_reviewed": {
          "default": false,
          "title": "Plugged Tube Pressure Path Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "tube_condition",
        "asset_id",
        "location_id",
        "exchanger_id",
        "bundle_id",
        "material_condition_id",
        "closed_ends",
        "geometry_source_id",
        "geometry_record_id",
        "geometry_record_sha256",
        "geometry_evidence",
        "pressure_knots"
      ],
      "title": "TubePressureStressHistory",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-reviewed scope and a set of tube-specific pressure-stress histories.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.tube_bundle_lame_stress_history.v1",
      "default": "matintegrity.tube_bundle_lame_stress_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "exchanger_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Exchanger Id",
      "type": "string"
    },
    "bundle_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Bundle Id",
      "type": "string"
    },
    "time_basis_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Time Basis Id",
      "type": "string"
    },
    "pressure_reference_basis_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Pressure Reference Basis Id",
      "type": "string"
    },
    "tube_histories": {
      "items": {
        "$ref": "#/$defs/TubePressureStressHistory"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Tube Histories",
      "type": "array"
    },
    "tube_bundle_and_material_identity_reviewed": {
      "title": "Tube Bundle And Material Identity Reviewed",
      "type": "boolean"
    },
    "current_bore_and_minimum_wall_mapping_reviewed": {
      "title": "Current Bore And Minimum Wall Mapping Reviewed",
      "type": "boolean"
    },
    "wall_is_uniform_and_axisymmetric_reviewed": {
      "title": "Wall Is Uniform And Axisymmetric Reviewed",
      "type": "boolean"
    },
    "absolute_pressure_units_and_common_reference_reviewed": {
      "title": "Absolute Pressure Units And Common Reference Reviewed",
      "type": "boolean"
    },
    "pressure_history_clock_and_record_lineage_reviewed": {
      "title": "Pressure History Clock And Record Lineage Reviewed",
      "type": "boolean"
    },
    "elastic_isotropic_axisymmetric_lame_applicability_reviewed": {
      "title": "Elastic Isotropic Axisymmetric Lame Applicability Reviewed",
      "type": "boolean"
    },
    "axial_end_condition_reviewed": {
      "title": "Axial End Condition Reviewed",
      "type": "boolean"
    },
    "no_acceptance_capacity_or_life_claim_reviewed": {
      "title": "No Acceptance Capacity Or Life Claim Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "maximum_work_units": {
      "default": 2000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Work Units",
      "type": "integer"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "exchanger_id",
    "bundle_id",
    "time_basis_id",
    "pressure_reference_basis_id",
    "tube_histories",
    "tube_bundle_and_material_identity_reviewed",
    "current_bore_and_minimum_wall_mapping_reviewed",
    "wall_is_uniform_and_axisymmetric_reviewed",
    "absolute_pressure_units_and_common_reference_reviewed",
    "pressure_history_clock_and_record_lineage_reviewed",
    "elastic_isotropic_axisymmetric_lame_applicability_reviewed",
    "axial_end_condition_reviewed",
    "no_acceptance_capacity_or_life_claim_reviewed",
    "computational_use_authorized"
  ],
  "title": "TubeBundleLameStressHistory",
  "type": "object"
}