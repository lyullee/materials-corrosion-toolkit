{
  "$defs": {
    "ErosionCorrosionRateRecord": {
      "additionalProperties": false,
      "description": "Evidence-linked thickness-loss rate on one declared interval and condition.",
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "fluid_condition_id": {
          "minLength": 1,
          "title": "Fluid Condition Id",
          "type": "string"
        },
        "geometry_condition_id": {
          "minLength": 1,
          "title": "Geometry Condition Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "rate_m_s": {
          "minimum": 0,
          "title": "Rate M S",
          "type": "number"
        },
        "lower_rate_bound_m_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Rate Bound M S"
        },
        "upper_rate_bound_m_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Rate Bound M S"
        },
        "rate_basis_id": {
          "minLength": 1,
          "title": "Rate Basis Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "provider_id",
        "provider_revision",
        "record_sha256",
        "start_time_s",
        "end_time_s",
        "material_condition_id",
        "fluid_condition_id",
        "geometry_condition_id",
        "physical_scope_id",
        "location_id",
        "rate_m_s",
        "rate_basis_id",
        "evidence"
      ],
      "title": "ErosionCorrosionRateRecord",
      "type": "object"
    },
    "ErosionCorrosionSynergyInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "pure_erosion": {
          "$ref": "#/$defs/ErosionCorrosionRateRecord"
        },
        "pure_corrosion": {
          "$ref": "#/$defs/ErosionCorrosionRateRecord"
        },
        "combined_erosion_corrosion": {
          "$ref": "#/$defs/ErosionCorrosionRateRecord"
        },
        "corrosion_during_erosion": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErosionCorrosionRateRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "pure_erosion",
        "pure_corrosion",
        "combined_erosion_corrosion"
      ],
      "title": "ErosionCorrosionSynergyInterval",
      "type": "object"
    },
    "ErosionCorrosionWallThicknessBaseline": {
      "additionalProperties": false,
      "description": "Digest-linked wall measurement and caller minimum-thickness limit.",
      "properties": {
        "baseline_id": {
          "minLength": 1,
          "title": "Baseline Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "geometry_condition_id": {
          "minLength": 1,
          "title": "Geometry Condition Id",
          "type": "string"
        },
        "baseline_time_s": {
          "minimum": 0,
          "title": "Baseline Time S",
          "type": "number"
        },
        "measured_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Measured Thickness M",
          "type": "number"
        },
        "required_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Required Thickness M",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "baseline_id",
        "provider_id",
        "provider_revision",
        "record_sha256",
        "asset_id",
        "location_id",
        "physical_scope_id",
        "material_condition_id",
        "geometry_condition_id",
        "baseline_time_s",
        "measured_thickness_m",
        "required_thickness_m",
        "evidence"
      ],
      "title": "ErosionCorrosionWallThicknessBaseline",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Rate decomposition under a caller-declared component accounting convention.",
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "time_basis_id": {
      "minLength": 1,
      "title": "Time Basis Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "fluid_condition_id": {
      "minLength": 1,
      "title": "Fluid Condition Id",
      "type": "string"
    },
    "geometry_condition_id": {
      "minLength": 1,
      "title": "Geometry Condition Id",
      "type": "string"
    },
    "rate_basis_id": {
      "minLength": 1,
      "title": "Rate Basis Id",
      "type": "string"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/ErosionCorrosionSynergyInterval"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "wall_thickness_baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErosionCorrosionWallThicknessBaseline"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "matched_conditions_and_rate_basis_reviewed": {
      "title": "Matched Conditions And Rate Basis Reviewed",
      "type": "boolean"
    },
    "component_definitions_and_accounting_convention_reviewed": {
      "title": "Component Definitions And Accounting Convention Reviewed",
      "type": "boolean"
    },
    "interval_clock_and_measurements_reviewed": {
      "title": "Interval Clock And Measurements Reviewed",
      "type": "boolean"
    },
    "evidence_and_usage_rights_reviewed": {
      "title": "Evidence And Usage Rights Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "deterministic_rate_bounds_reviewed": {
      "default": false,
      "title": "Deterministic Rate Bounds Reviewed",
      "type": "boolean"
    },
    "wall_thickness_limit_state_reviewed": {
      "default": false,
      "title": "Wall Thickness Limit State Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "time_basis_id",
    "physical_scope_id",
    "material_condition_id",
    "fluid_condition_id",
    "geometry_condition_id",
    "rate_basis_id",
    "intervals",
    "matched_conditions_and_rate_basis_reviewed",
    "component_definitions_and_accounting_convention_reviewed",
    "interval_clock_and_measurements_reviewed",
    "evidence_and_usage_rights_reviewed",
    "computational_use_authorized"
  ],
  "title": "ErosionCorrosionSynergyAssessment",
  "type": "object"
}