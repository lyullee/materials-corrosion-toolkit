{
  "additionalProperties": false,
  "description": "Coordinates and provenance bound to one separately supplied numeric array.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.rectilinear_field_metadata.v1",
      "default": "matintegrity.rectilinear_field_metadata.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "field_id": {
      "minLength": 1,
      "title": "Field Id",
      "type": "string"
    },
    "physical_specimen_id": {
      "minLength": 1,
      "title": "Physical Specimen Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "array_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Array Sha256",
      "type": "string"
    },
    "missing_mask_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Missing Mask Sha256",
      "type": "string"
    },
    "quantity_name": {
      "minLength": 1,
      "title": "Quantity Name",
      "type": "string"
    },
    "quantity_unit": {
      "minLength": 1,
      "title": "Quantity Unit",
      "type": "string"
    },
    "quantity_basis": {
      "minLength": 1,
      "title": "Quantity Basis",
      "type": "string"
    },
    "coordinate_frame_id": {
      "minLength": 1,
      "title": "Coordinate Frame Id",
      "type": "string"
    },
    "coordinate_basis": {
      "minLength": 1,
      "title": "Coordinate Basis",
      "type": "string"
    },
    "observation_clock": {
      "minLength": 1,
      "title": "Observation Clock",
      "type": "string"
    },
    "x_coordinates_m": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "X Coordinates M",
      "type": "array"
    },
    "y_coordinates_m": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Y Coordinates M",
      "type": "array"
    },
    "value_shape": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Value Shape",
      "type": "array"
    },
    "missing_value_meaning": {
      "minLength": 1,
      "title": "Missing Value Meaning",
      "type": "string"
    }
  },
  "required": [
    "field_id",
    "physical_specimen_id",
    "source_group_id",
    "source_sha256",
    "array_sha256",
    "missing_mask_sha256",
    "quantity_name",
    "quantity_unit",
    "quantity_basis",
    "coordinate_frame_id",
    "coordinate_basis",
    "observation_clock",
    "x_coordinates_m",
    "y_coordinates_m",
    "value_shape",
    "missing_value_meaning"
  ],
  "title": "RectilinearFieldMetadata",
  "type": "object"
}