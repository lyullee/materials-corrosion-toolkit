{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PhasePixelLabel": {
      "additionalProperties": false,
      "properties": {
        "label_value": {
          "title": "Label Value",
          "type": "integer"
        },
        "phase_id": {
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        }
      },
      "required": [
        "label_value",
        "phase_id"
      ],
      "title": "PhasePixelLabel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.phase_label_map_metadata.v1",
      "default": "matintegrity.phase_label_map_metadata.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "map_id": {
      "minLength": 1,
      "title": "Map Id",
      "type": "string"
    },
    "physical_specimen_id": {
      "minLength": 1,
      "title": "Physical Specimen Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "label_array_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Label Array Sha256",
      "type": "string"
    },
    "roi_mask_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Roi Mask Sha256",
      "type": "string"
    },
    "missing_mask_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Missing Mask Sha256",
      "type": "string"
    },
    "shape": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Shape",
      "type": "array"
    },
    "region_id": {
      "minLength": 1,
      "title": "Region Id",
      "type": "string"
    },
    "coordinate_frame_id": {
      "minLength": 1,
      "title": "Coordinate Frame Id",
      "type": "string"
    },
    "coordinate_basis": {
      "minLength": 1,
      "title": "Coordinate Basis",
      "type": "string"
    },
    "pixel_width_m": {
      "exclusiveMinimum": 0,
      "title": "Pixel Width M",
      "type": "number"
    },
    "pixel_height_m": {
      "exclusiveMinimum": 0,
      "title": "Pixel Height M",
      "type": "number"
    },
    "segmentation_method_id": {
      "minLength": 1,
      "title": "Segmentation Method Id",
      "type": "string"
    },
    "segmentation_basis": {
      "minLength": 1,
      "title": "Segmentation Basis",
      "type": "string"
    },
    "labels": {
      "items": {
        "$ref": "#/$defs/PhasePixelLabel"
      },
      "minItems": 1,
      "title": "Labels",
      "type": "array"
    },
    "unclassified_label_values": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Unclassified Label Values",
      "type": "array"
    },
    "scale_reviewed": {
      "title": "Scale Reviewed",
      "type": "boolean"
    },
    "roi_reviewed": {
      "title": "Roi Reviewed",
      "type": "boolean"
    },
    "phase_label_mapping_reviewed": {
      "title": "Phase Label Mapping Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "map_id",
    "physical_specimen_id",
    "source_group_id",
    "source_sha256",
    "label_array_sha256",
    "roi_mask_sha256",
    "missing_mask_sha256",
    "shape",
    "region_id",
    "coordinate_frame_id",
    "coordinate_basis",
    "pixel_width_m",
    "pixel_height_m",
    "segmentation_method_id",
    "segmentation_basis",
    "labels",
    "scale_reviewed",
    "roi_reviewed",
    "phase_label_mapping_reviewed",
    "evidence"
  ],
  "title": "PhaseLabelMapMetadata",
  "type": "object"
}