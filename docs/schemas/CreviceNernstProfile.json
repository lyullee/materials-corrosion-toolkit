{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evaluate a supplied redox half-reaction along a local crevice history.\n\nThe caller supplies dimensionless species activities, standard-potential\nhistory and their evidence. This contract evaluates the Nernst relation;\nit does not infer speciation, reaction direction, mixed potential or rate.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.crevice_nernst_profile.v1",
      "default": "matintegrity.crevice_nernst_profile.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "source_inventory_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Inventory Sha256",
      "type": "string"
    },
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "standard_potential_reference_id": {
      "minLength": 1,
      "title": "Standard Potential Reference Id",
      "type": "string"
    },
    "reaction_quotient_stoichiometry": {
      "additionalProperties": {
        "type": "number"
      },
      "minProperties": 1,
      "title": "Reaction Quotient Stoichiometry",
      "type": "object"
    },
    "electron_number": {
      "maximum": 32,
      "minimum": 1,
      "title": "Electron Number",
      "type": "integer"
    },
    "elapsed_time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Elapsed Time S",
      "type": "array"
    },
    "temperature_K": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Temperature K",
      "type": "array"
    },
    "standard_potential_V": {
      "items": {
        "type": "number"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Standard Potential V",
      "type": "array"
    },
    "species_activity_history": {
      "additionalProperties": {
        "items": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "type": "array"
      },
      "minProperties": 1,
      "title": "Species Activity History",
      "type": "object"
    },
    "activity_provider_id": {
      "minLength": 1,
      "title": "Activity Provider Id",
      "type": "string"
    },
    "activity_provider_revision": {
      "minLength": 1,
      "title": "Activity Provider Revision",
      "type": "string"
    },
    "activity_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Activity Configuration Sha256",
      "type": "string"
    },
    "activity_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Activity Record Sha256",
      "type": "string"
    },
    "standard_potential_provider_id": {
      "minLength": 1,
      "title": "Standard Potential Provider Id",
      "type": "string"
    },
    "standard_potential_provider_revision": {
      "minLength": 1,
      "title": "Standard Potential Provider Revision",
      "type": "string"
    },
    "standard_potential_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Standard Potential Configuration Sha256",
      "type": "string"
    },
    "standard_potential_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Standard Potential Record Sha256",
      "type": "string"
    },
    "redox_reaction_direction_and_electron_number_reviewed": {
      "title": "Redox Reaction Direction And Electron Number Reviewed",
      "type": "boolean"
    },
    "activity_standard_state_and_species_mapping_reviewed": {
      "title": "Activity Standard State And Species Mapping Reviewed",
      "type": "boolean"
    },
    "standard_potential_temperature_history_reviewed": {
      "title": "Standard Potential Temperature History Reviewed",
      "type": "boolean"
    },
    "local_activity_history_applicability_reviewed": {
      "title": "Local Activity History Applicability Reviewed",
      "type": "boolean"
    },
    "potential_only_no_rate_or_acceptance_reviewed": {
      "title": "Potential Only No Rate Or Acceptance Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "clock_id",
    "source_inventory_sha256",
    "reaction_id",
    "standard_potential_reference_id",
    "reaction_quotient_stoichiometry",
    "electron_number",
    "elapsed_time_s",
    "temperature_K",
    "standard_potential_V",
    "species_activity_history",
    "activity_provider_id",
    "activity_provider_revision",
    "activity_configuration_sha256",
    "activity_record_sha256",
    "standard_potential_provider_id",
    "standard_potential_provider_revision",
    "standard_potential_configuration_sha256",
    "standard_potential_record_sha256",
    "redox_reaction_direction_and_electron_number_reviewed",
    "activity_standard_state_and_species_mapping_reviewed",
    "standard_potential_temperature_history_reviewed",
    "local_activity_history_applicability_reviewed",
    "potential_only_no_rate_or_acceptance_reviewed",
    "computational_use_authorized",
    "evidence"
  ],
  "title": "CreviceNernstProfile",
  "type": "object"
}