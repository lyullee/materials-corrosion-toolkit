{
  "$defs": {
    "FractureToughnessReadAuthorization": {
      "additionalProperties": false,
      "description": "Caller attribution, unit-review, and local-only computational-use declaration.",
      "properties": {
        "dataset_id": {
          "const": "fracture-toughness-temperature",
          "default": "fracture-toughness-temperature",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_doi": {
          "const": "10.17632/2vkgrbsy8j.1",
          "default": "10.17632/2vkgrbsy8j.1",
          "title": "Dataset Doi",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "license_scope": {
          "const": "compilation_only_underlying_observation_rights_unresolved",
          "default": "compilation_only_underlying_observation_rights_unresolved",
          "title": "License Scope",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "computational_use_authorized": {
          "const": true,
          "title": "Computational Use Authorized",
          "type": "boolean"
        },
        "local_only_authorized": {
          "const": true,
          "title": "Local Only Authorized",
          "type": "boolean"
        },
        "parser_unit_interpretations_reviewed": {
          "const": true,
          "title": "Parser Unit Interpretations Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "attribution",
        "computational_use_authorized",
        "local_only_authorized",
        "parser_unit_interpretations_reviewed"
      ],
      "title": "FractureToughnessReadAuthorization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "local_archive_path": {
      "minLength": 1,
      "title": "Local Archive Path",
      "type": "string"
    },
    "temperature_unit_override": {
      "anyOf": [
        {
          "enum": [
            "degC",
            "K"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature Unit Override"
    },
    "dimension_unit_override": {
      "anyOf": [
        {
          "enum": [
            "mm",
            "m"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dimension Unit Override"
    },
    "apply_article_dimension_review": {
      "default": true,
      "title": "Apply Article Dimension Review",
      "type": "boolean"
    },
    "condition_group_relative_tolerance": {
      "default": 0.03,
      "minimum": 0,
      "title": "Condition Group Relative Tolerance",
      "type": "number"
    },
    "condition_group_absolute_tolerance_m": {
      "default": 0.0001,
      "minimum": 0,
      "title": "Condition Group Absolute Tolerance M",
      "type": "number"
    },
    "authorization": {
      "$ref": "#/$defs/FractureToughnessReadAuthorization"
    }
  },
  "required": [
    "local_archive_path",
    "authorization"
  ],
  "title": "FractureToughnessArchiveAuditRequest",
  "type": "object"
}