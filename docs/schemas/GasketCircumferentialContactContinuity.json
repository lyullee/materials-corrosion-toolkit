{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "CircumferentialContactNode": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "angle_rad": {
          "title": "Angle Rad",
          "type": "number"
        }
      },
      "required": [
        "node_id",
        "angle_rad"
      ],
      "title": "CircumferentialContactNode",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Map a computed pressure field to circular Voronoi contact/open arc measures.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.gasket_circumferential_contact_continuity.v1",
      "default": "matintegrity.gasket_circumferential_contact_continuity.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "contact_result": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "contact_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contact Result Sha256",
      "type": "string"
    },
    "selected_time_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Time S"
    },
    "contact_nodes": {
      "items": {
        "$ref": "#/$defs/CircumferentialContactNode"
      },
      "maxItems": 100000,
      "minItems": 3,
      "title": "Contact Nodes",
      "type": "array"
    },
    "geometry_provider_id": {
      "minLength": 1,
      "title": "Geometry Provider Id",
      "type": "string"
    },
    "geometry_provider_revision": {
      "minLength": 1,
      "title": "Geometry Provider Revision",
      "type": "string"
    },
    "ring_radius_m": {
      "exclusiveMinimum": 0,
      "title": "Ring Radius M",
      "type": "number"
    },
    "geometry_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Geometry Record Sha256",
      "type": "string"
    },
    "geometry_usage_license_id": {
      "minLength": 1,
      "title": "Geometry Usage License Id",
      "type": "string"
    },
    "geometry_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Geometry Evidence",
      "type": "array"
    },
    "minimum_contact_pressure_Pa": {
      "minimum": 0,
      "title": "Minimum Contact Pressure Pa",
      "type": "number"
    },
    "criterion_provider_id": {
      "minLength": 1,
      "title": "Criterion Provider Id",
      "type": "string"
    },
    "criterion_provider_revision": {
      "minLength": 1,
      "title": "Criterion Provider Revision",
      "type": "string"
    },
    "criterion_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Criterion Record Sha256",
      "type": "string"
    },
    "criterion_usage_license_id": {
      "minLength": 1,
      "title": "Criterion Usage License Id",
      "type": "string"
    },
    "criterion_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Criterion Evidence",
      "type": "array"
    },
    "physical_scope_and_exact_time_reviewed": {
      "title": "Physical Scope And Exact Time Reviewed",
      "type": "boolean"
    },
    "ring_geometry_and_orientation_reviewed": {
      "title": "Ring Geometry And Orientation Reviewed",
      "type": "boolean"
    },
    "pressure_definition_and_threshold_applicability_reviewed": {
      "title": "Pressure Definition And Threshold Applicability Reviewed",
      "type": "boolean"
    },
    "contact_field_resolution_reviewed": {
      "title": "Contact Field Resolution Reviewed",
      "type": "boolean"
    },
    "lineage_license_and_computational_use_reviewed": {
      "title": "Lineage License And Computational Use Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "physical_scope_id",
    "contact_result",
    "contact_result_sha256",
    "contact_nodes",
    "geometry_provider_id",
    "geometry_provider_revision",
    "ring_radius_m",
    "geometry_record_sha256",
    "geometry_usage_license_id",
    "geometry_evidence",
    "minimum_contact_pressure_Pa",
    "criterion_provider_id",
    "criterion_provider_revision",
    "criterion_record_sha256",
    "criterion_usage_license_id",
    "criterion_evidence",
    "physical_scope_and_exact_time_reviewed",
    "ring_geometry_and_orientation_reviewed",
    "pressure_definition_and_threshold_applicability_reviewed",
    "contact_field_resolution_reviewed",
    "lineage_license_and_computational_use_reviewed"
  ],
  "title": "GasketCircumferentialContactContinuity",
  "type": "object"
}