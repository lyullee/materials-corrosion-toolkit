        "sensitivity_unit_token",
        "noise_metric_definition",
        "noise_unit_token",
        "resolution_metric_definition",
        "resolution_unit_token",
        "criteria",
        "profile_provider_id",
        "profile_revision",
        "profile_configuration_digest",
        "caller_acceptance_authority",
        "evidence"
      ],
      "title": "ElectromagneticCampaignAcceptanceProfile",
      "type": "object"
