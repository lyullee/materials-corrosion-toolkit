        "pod_claimed": {
          "const": false,
          "default": false,
          "title": "Pod Claimed",
          "type": "boolean"
        },
        "physical_qualification_claimed": {
          "const": false,
          "default": false,
          "title": "Physical Qualification Claimed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
