        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "metric_id",
        "direction",
        "pass_limit",
        "fail_limit",
        "unit_token",
        "criterion_basis"
      ],
      "title": "ElectromagneticQualityCriterion",
      "type": "object"
