{
  "$defs": {
    "MassActionReaction": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "reactants": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Reactants",
          "type": "object"
        },
        "products": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Products",
          "type": "object"
        },
        "forward_rate_constant": {
          "minimum": 0,
          "title": "Forward Rate Constant",
          "type": "number"
        },
        "reverse_rate_constant": {
          "minimum": 0,
          "title": "Reverse Rate Constant",
          "type": "number"
        },
        "forward_rate_constant_unit": {
          "minLength": 1,
          "title": "Forward Rate Constant Unit",
          "type": "string"
        },
        "reverse_rate_constant_unit": {
          "minLength": 1,
          "title": "Reverse Rate Constant Unit",
          "type": "string"
        },
        "calibration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Sha256",
          "type": "string"
        }
      },
      "required": [
        "reaction_id",
        "reactants",
        "products",
        "forward_rate_constant",
        "reverse_rate_constant",
        "forward_rate_constant_unit",
        "reverse_rate_constant_unit",
        "calibration_sha256"
      ],
      "title": "MassActionReaction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "network_id": {
      "minLength": 1,
      "title": "Network Id",
      "type": "string"
    },
    "species_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Species Ids",
      "type": "array"
    },
    "charge_numbers": {
      "items": {
        "type": "integer"
      },
      "title": "Charge Numbers",
      "type": "array"
    },
    "reactions": {
      "items": {
        "$ref": "#/$defs/MassActionReaction"
      },
      "minItems": 1,
      "title": "Reactions",
      "type": "array"
    },
    "concentration_activity_approximation_and_rates_reviewed": {
      "title": "Concentration Activity Approximation And Rates Reviewed",
      "type": "boolean"
    },
    "elemental_composition": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elemental Composition"
    }
  },
  "required": [
    "network_id",
    "species_ids",
    "charge_numbers",
    "reactions",
    "concentration_activity_approximation_and_rates_reviewed"
  ],
  "title": "MassActionNetwork",
  "type": "object"
}