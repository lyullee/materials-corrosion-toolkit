{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One source CSV observation with archive, member, and row lineage.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.thermal_rod_observation_row.v1",
      "default": "matintegrity.thermal_rod_observation_row.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "thermal-rod-transient",
      "default": "thermal-rod-transient",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_doi": {
      "const": "10.17632/sbcf36976g.1",
      "default": "10.17632/sbcf36976g.1",
      "title": "Dataset Doi",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "source_archive_filename": {
      "const": "sbcf36976g-1.zip",
      "default": "sbcf36976g-1.zip",
      "title": "Source Archive Filename",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "source_archive_bytes": {
      "exclusiveMinimum": 0,
      "title": "Source Archive Bytes",
      "type": "integer"
    },
    "source_member": {
      "minLength": 1,
      "title": "Source Member",
      "type": "string"
    },
    "source_member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Member Sha256",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "source_row_order": {
      "minimum": 0,
      "title": "Source Row Order",
      "type": "integer"
    },
    "provider_source_row": {
      "minimum": 2,
      "title": "Provider Source Row",
      "type": "integer"
    },
    "time_s": {
      "title": "Time S",
      "type": "number"
    },
    "tc1_excess_temperature_K": {
      "title": "Tc1 Excess Temperature K",
      "type": "number"
    },
    "tc2_excess_temperature_K": {
      "title": "Tc2 Excess Temperature K",
      "type": "number"
    },
    "tc3_excess_temperature_K": {
      "title": "Tc3 Excess Temperature K",
      "type": "number"
    },
    "tc4_excess_temperature_K": {
      "title": "Tc4 Excess Temperature K",
      "type": "number"
    },
    "tc5_excess_temperature_K": {
      "title": "Tc5 Excess Temperature K",
      "type": "number"
    },
    "tc6_excess_temperature_K": {
      "title": "Tc6 Excess Temperature K",
      "type": "number"
    },
    "controller_setting_counts": {
      "title": "Controller Setting Counts",
      "type": "number"
    },
    "temperature_basis": {
      "const": "excess_above_source_declared_ambient; kelvin_difference",
      "default": "excess_above_source_declared_ambient; kelvin_difference",
      "title": "Temperature Basis",
      "type": "string"
    },
    "controller_setting_basis": {
      "const": "reported_counts_on_1023_maximum_scale_not_power",
      "default": "reported_counts_on_1023_maximum_scale_not_power",
      "title": "Controller Setting Basis",
      "type": "string"
    },
    "source_row_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Row Sha256",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "heat_flux_inferred": {
      "const": false,
      "default": false,
      "title": "Heat Flux Inferred",
      "type": "boolean"
    },
    "material_property_inferred": {
      "const": false,
      "default": false,
      "title": "Material Property Inferred",
      "type": "boolean"
    },
    "corrosion_metric_inferred": {
      "const": false,
      "default": false,
      "title": "Corrosion Metric Inferred",
      "type": "boolean"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "source_archive_sha256",
    "source_archive_bytes",
    "source_member",
    "source_member_sha256",
    "run_id",
    "source_row_order",
    "provider_source_row",
    "time_s",
    "tc1_excess_temperature_K",
    "tc2_excess_temperature_K",
    "tc3_excess_temperature_K",
    "tc4_excess_temperature_K",
    "tc5_excess_temperature_K",
    "tc6_excess_temperature_K",
    "controller_setting_counts",
    "source_row_sha256",
    "evidence"
  ],
  "title": "ThermalRodObservationRow",
  "type": "object"
}