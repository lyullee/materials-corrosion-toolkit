{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GasketPronyBranch": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "minLength": 1,
          "title": "Branch Id",
          "type": "string"
        },
        "modulus_Pa": {
          "exclusiveMinimum": 0,
          "title": "Modulus Pa",
          "type": "number"
        },
        "relaxation_time_s": {
          "exclusiveMinimum": 0,
          "title": "Relaxation Time S",
          "type": "number"
        }
      },
      "required": [
        "branch_id",
        "modulus_Pa",
        "relaxation_time_s"
      ],
      "title": "GasketPronyBranch",
      "type": "object"
    },
    "GasketPronyTemperatureShiftLaw": {
      "additionalProperties": false,
      "description": "Evidence-bound caller shift law for reference-temperature Prony times.",
      "properties": {
        "law_id": {
          "minLength": 1,
          "title": "Law Id",
          "type": "string"
        },
        "law": {
          "enum": [
            "arrhenius",
            "wlf"
          ],
          "title": "Law",
          "type": "string"
        },
        "reference_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Reference Temperature K",
          "type": "number"
        },
        "minimum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "activation_energy_J_mol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activation Energy J Mol"
        },
        "wlf_c1": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wlf C1"
        },
        "wlf_c2_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wlf C2 K"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "parameter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parameter Sha256",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "calibration_and_shift_form_reviewed": {
          "title": "Calibration And Shift Form Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "law_id",
        "law",
        "reference_temperature_K",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "provider_id",
        "provider_revision",
        "parameter_sha256",
        "evidence",
        "calibration_and_shift_form_reviewed"
      ],
      "title": "GasketPronyTemperatureShiftLaw",
      "type": "object"
    },
    "GasketViscoelasticHistoryRequest": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "material": {
          "$ref": "#/$defs/GasketViscoelasticMaterial"
        },
        "compression_area_m2": {
          "exclusiveMinimum": 0,
          "title": "Compression Area M2",
          "type": "number"
        },
        "compression_area_basis_reviewed": {
          "title": "Compression Area Basis Reviewed",
          "type": "boolean"
        },
        "elapsed_time_s": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "minItems": 2,
          "title": "Elapsed Time S",
          "type": "array"
        },
        "compressive_strain": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "minItems": 2,
          "title": "Compressive Strain",
          "type": "array"
        },
        "piecewise_linear_strain_history_reviewed": {
          "title": "Piecewise Linear Strain History Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "request_id",
        "material",
        "compression_area_m2",
        "compression_area_basis_reviewed",
        "elapsed_time_s",
        "compressive_strain",
        "piecewise_linear_strain_history_reviewed"
      ],
      "title": "GasketViscoelasticHistoryRequest",
      "type": "object"
    },
    "GasketViscoelasticMaterial": {
      "additionalProperties": false,
      "properties": {
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "condition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Condition Sha256",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "equilibrium_modulus_Pa": {
          "minimum": 0,
          "title": "Equilibrium Modulus Pa",
          "type": "number"
        },
        "prony_branches": {
          "items": {
            "$ref": "#/$defs/GasketPronyBranch"
          },
          "minItems": 1,
          "title": "Prony Branches",
          "type": "array"
        },
        "initial_branch_stress_Pa": {
          "items": {
            "type": "number"
          },
          "title": "Initial Branch Stress Pa",
          "type": "array"
        },
        "initial_branch_state_reviewed": {
          "title": "Initial Branch State Reviewed",
          "type": "boolean"
        },
        "calibration_basis_reviewed": {
          "title": "Calibration Basis Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "material_condition_id",
        "physical_specimen_id",
        "source_group_id",
        "condition_sha256",
        "source_sha256",
        "provider_id",
        "provider_revision",
        "temperature_K",
        "equilibrium_modulus_Pa",
        "prony_branches",
        "initial_branch_stress_Pa",
        "initial_branch_state_reviewed",
        "calibration_basis_reviewed",
        "computational_use_authorized"
      ],
      "title": "GasketViscoelasticMaterial",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Isothermal Prony response in caller-defined reduced time with a variable actual temperature path.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.gasket_prony_temperature_shift_history.v1",
      "default": "matintegrity.gasket_prony_temperature_shift_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "base_history": {
      "$ref": "#/$defs/GasketViscoelasticHistoryRequest"
    },
    "shift_law": {
      "$ref": "#/$defs/GasketPronyTemperatureShiftLaw"
    },
    "interval_temperature_K": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "minItems": 1,
      "title": "Interval Temperature K",
      "type": "array"
    },
    "interval_temperature_piecewise_constant_reviewed": {
      "title": "Interval Temperature Piecewise Constant Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "base_history",
    "shift_law",
    "interval_temperature_K",
    "interval_temperature_piecewise_constant_reviewed"
  ],
  "title": "GasketTemperatureShiftedPronyHistory",
  "type": "object"
}