        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_version": {
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "partition": {
          "enum": [
            "calibration",
            "holdout",
            "application"
          ],
          "title": "Partition",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "component_definition": {
          "minLength": 1,
          "title": "Component Definition",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "coordinate_frame_definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Coordinate Frame Definition Sha256",
          "type": "string"
        },
        "coordinate_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Coordinate Names",
          "type": "array"
        },
        "coordinates_m": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Coordinates M",
          "type": "array"
        },
        "stress_Pa": {
          "title": "Stress Pa",
          "type": "number"
        },
        "expanded_uncertainty_Pa": {
          "minimum": 0,
          "title": "Expanded Uncertainty Pa",
          "type": "number"
        },
        "coverage_factor": {
          "exclusiveMinimum": 0,
          "title": "Coverage Factor",
          "type": "number"
        },
        "uncertainty_basis": {
          "minLength": 1,
          "title": "Uncertainty Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "method_kind",
        "provider_id",
        "provider_version",
        "provider_state_digest",
        "record_digest",
        "partition",
        "source_group_id",
        "component_definition",
        "coordinate_frame_id",
        "coordinate_frame_definition_sha256",
        "coordinate_names",
        "coordinates_m",
        "stress_Pa",
        "expanded_uncertainty_Pa",
        "coverage_factor",
        "uncertainty_basis",
        "evidence"
      ],
      "title": "ResidualStressEvidenceRecord",
      "type": "object"
    },
    "ResidualStressProviderQualification": {
      "additionalProperties": false,
      "properties": {
        "qualification_id": {
          "minLength": 1,
          "title": "Qualification Id",
          "type": "string"
        },
        "calibration_dataset_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Dataset Digest",
          "type": "string"
        },
        "holdout_dataset_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Holdout Dataset Digest",
          "type": "string"
        },
        "calibration_observation_count": {
          "minimum": 1,
          "title": "Calibration Observation Count",
          "type": "integer"
        },
        "holdout_observation_count": {
          "minimum": 1,
          "title": "Holdout Observation Count",
          "type": "integer"
        },
        "holdout_metric_definition": {
          "minLength": 1,
          "title": "Holdout Metric Definition",
          "type": "string"
        },
        "holdout_metric_value": {
          "minimum": 0,
          "title": "Holdout Metric Value",
          "type": "number"
        },
        "holdout_metric_unit": {
          "minLength": 1,
          "title": "Holdout Metric Unit",
          "type": "string"
        },
        "maximum_supported_holdout_metric": {
          "exclusiveMinimum": 0,
          "title": "Maximum Supported Holdout Metric",
          "type": "number"
        },
        "maximum_supported_holdout_metric_unit": {
          "minLength": 1,
          "title": "Maximum Supported Holdout Metric Unit",
          "type": "string"
        },
        "calibration_and_holdout_independent": {
          "title": "Calibration And Holdout Independent",
          "type": "boolean"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "qualification_id",
        "calibration_dataset_digest",
        "holdout_dataset_digest",
        "calibration_observation_count",
        "holdout_observation_count",
        "holdout_metric_definition",
        "holdout_metric_value",
        "holdout_metric_unit",
        "maximum_supported_holdout_metric",
        "maximum_supported_holdout_metric_unit",
        "calibration_and_holdout_independent",
        "qualification_basis",
        "evidence"
      ],
      "title": "ResidualStressProviderQualification",
      "type": "object"
