      },
      "minItems": 1,
      "title": "Records",
      "type": "array"
    },
    "candidate_supports": {
      "items": {
        "$ref": "#/$defs/DeclaredResidualStressSupport"
      },
      "minItems": 1,
      "title": "Candidate Supports",
      "type": "array"
    },
    "weld_and_material_identity_reviewed": {
      "title": "Weld And Material Identity Reviewed",
      "type": "boolean"
    },
    "coordinate_frames_and_components_reviewed": {
      "title": "Coordinate Frames And Components Reviewed",
      "type": "boolean"
    },
    "units_and_uncertainty_reviewed": {
      "title": "Units And Uncertainty Reviewed",
      "type": "boolean"
    },
    "provider_identity_and_state_reviewed": {
      "title": "Provider Identity And State Reviewed",
      "type": "boolean"
    },
    "record_digests_reviewed": {
      "title": "Record Digests Reviewed",
      "type": "boolean"
    },
    "calibration_and_holdout_reviewed": {
      "title": "Calibration And Holdout Reviewed",
      "type": "boolean"
    },
    "support_authority_reviewed": {
      "title": "Support Authority Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "weld_id",
    "material_condition_id",
    "records",
    "candidate_supports",
    "weld_and_material_identity_reviewed",
    "coordinate_frames_and_components_reviewed",
    "units_and_uncertainty_reviewed",
    "provider_identity_and_state_reviewed",
    "record_digests_reviewed",
    "calibration_and_holdout_reviewed",
    "support_authority_reviewed",
    "evidence"
  ],
  "title": "ResidualStressEvidenceAssessment",
  "type": "object"
