{
  "$defs": {
    "DeclaredResidualStressSupport": {
      "additionalProperties": false,
      "properties": {
        "support_id": {
          "minLength": 1,
          "title": "Support Id",
          "type": "string"
        },
        "method_kind": {
          "enum": [
            "measured",
            "modelled"
          ],
          "title": "Method Kind",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_version": {
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "component_definition": {
          "minLength": 1,
          "title": "Component Definition",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "coordinate_frame_definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Coordinate Frame Definition Sha256",
          "type": "string"
        },
        "coordinate_names": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Coordinate Names",
          "type": "array"
        },
        "minimum_coordinates_m": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Minimum Coordinates M",
          "type": "array"
        },
        "maximum_coordinates_m": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Maximum Coordinates M",
          "type": "array"
        },
        "minimum_supported_stress_Pa": {
          "title": "Minimum Supported Stress Pa",
          "type": "number"
        },
        "maximum_supported_stress_Pa": {
          "title": "Maximum Supported Stress Pa",
          "type": "number"
        },
        "maximum_supported_expanded_uncertainty_Pa": {
          "minimum": 0,
          "title": "Maximum Supported Expanded Uncertainty Pa",
          "type": "number"
        },
        "applicability_basis": {
          "minLength": 1,
          "title": "Applicability Basis",
          "type": "string"
        },
        "qualification": {
          "$ref": "#/$defs/ResidualStressProviderQualification"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "support_id",
        "method_kind",
        "provider_id",
        "provider_version",
        "provider_state_digest",
        "component_definition",
        "coordinate_frame_id",
        "coordinate_frame_definition_sha256",
        "coordinate_names",
        "minimum_coordinates_m",
        "maximum_coordinates_m",
        "minimum_supported_stress_Pa",
        "maximum_supported_stress_Pa",
        "maximum_supported_expanded_uncertainty_Pa",
        "applicability_basis",
        "qualification",
        "evidence"
      ],
      "title": "DeclaredResidualStressSupport",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ResidualStressEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "method_kind": {
          "enum": [
            "measured",
            "modelled"
          ],
          "title": "Method Kind",
          "type": "string"
