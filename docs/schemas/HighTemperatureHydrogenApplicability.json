      },
      "minItems": 1,
      "title": "Microstructure Evidence",
      "type": "array"
    },
    "qualification_envelope": {
      "$ref": "#/$defs/HighTemperatureHydrogenEnvelope"
    },
    "material_identity_composition_and_heat_treatment_reviewed": {
