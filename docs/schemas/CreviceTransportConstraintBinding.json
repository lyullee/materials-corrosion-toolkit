{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-owned mapping from one transported total to one equilibrium constraint.",
  "properties": {
    "constraint_id": {
      "minLength": 1,
      "title": "Constraint Id",
      "type": "string"
    },
    "transported_species_id": {
      "minLength": 1,
      "title": "Transported Species Id",
      "type": "string"
    },
    "concentration_scale": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "title": "Concentration Scale",
      "type": "number"
    },
    "mapping_record_id": {
      "minLength": 1,
      "title": "Mapping Record Id",
      "type": "string"
    },
    "mapping_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mapping Record Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "constraint_id",
    "transported_species_id",
    "mapping_record_id",
    "mapping_record_sha256",
    "evidence"
  ],
  "title": "CreviceTransportConstraintBinding",
  "type": "object"
}