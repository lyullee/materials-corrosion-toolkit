{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "flux_condition_id": {
      "minLength": 1,
      "title": "Flux Condition Id",
      "type": "string"
    },
    "index_definition_id": {
      "minLength": 1,
      "title": "Index Definition Id",
      "type": "string"
    },
    "input_mass_basis": {
      "enum": [
        "mass_fraction",
        "mass_percent",
        "mass_ppm"
      ],
      "title": "Input Mass Basis",
      "type": "string"
    },
    "compound_assay": {
      "additionalProperties": {
        "anyOf": [
          {
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxProperties": 100,
      "minProperties": 1,
      "title": "Compound Assay",
      "type": "object"
    },
    "numerator_weights": {
      "additionalProperties": {
        "minimum": 0,
        "type": "number"
      },
      "maxProperties": 100,
      "minProperties": 1,
      "title": "Numerator Weights",
      "type": "object"
    },
    "denominator_weights": {
      "additionalProperties": {
        "minimum": 0,
        "type": "number"
      },
      "maxProperties": 100,
      "minProperties": 1,
      "title": "Denominator Weights",
      "type": "object"
    }
  },
  "required": [
    "basis",
    "flux_condition_id",
    "index_definition_id",
    "input_mass_basis",
    "compound_assay",
    "numerator_weights",
    "denominator_weights"
  ],
  "title": "DeclaredFluxBasicityRatio",
  "type": "object"
}