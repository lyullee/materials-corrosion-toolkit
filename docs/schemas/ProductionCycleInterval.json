{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "interval_id": {
      "minLength": 1,
      "title": "Interval Id",
      "type": "string"
    },
    "sequence_position": {
      "minimum": 1,
      "title": "Sequence Position",
      "type": "integer"
    },
    "interval_kind": {
      "enum": [
        "preheat",
        "braze_heat",
        "bond_cure",
        "pressure_hold",
        "cooling"
      ],
      "title": "Interval Kind",
      "type": "string"
    },
    "start_time_s": {
      "minimum": 0,
      "title": "Start Time S",
      "type": "number"
    },
    "end_time_s": {
      "exclusiveMinimum": 0,
      "title": "End Time S",
      "type": "number"
    },
    "minimum_temperature_k": {
      "exclusiveMinimum": 0,
      "title": "Minimum Temperature K",
      "type": "number"
    },
    "maximum_temperature_k": {
      "exclusiveMinimum": 0,
      "title": "Maximum Temperature K",
      "type": "number"
    },
    "minimum_pressure_pa_abs": {
      "minimum": 0,
      "title": "Minimum Pressure Pa Abs",
      "type": "number"
    },
    "maximum_pressure_pa_abs": {
      "minimum": 0,
      "title": "Maximum Pressure Pa Abs",
      "type": "number"
    },
    "atmosphere_id": {
      "minLength": 1,
      "title": "Atmosphere Id",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "result_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "interval_id",
    "sequence_position",
    "interval_kind",
    "start_time_s",
    "end_time_s",
    "minimum_temperature_k",
    "maximum_temperature_k",
    "minimum_pressure_pa_abs",
    "maximum_pressure_pa_abs",
    "atmosphere_id",
    "provider_id",
    "result_digest",
    "evidence"
  ],
  "title": "ProductionCycleInterval",
  "type": "object"
}