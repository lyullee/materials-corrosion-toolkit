{
  "additionalProperties": false,
  "description": "Structural and finite-value audit for one numeric MATLAB variable.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.numeric_mat_variable_record.v1",
      "default": "matintegrity.numeric_mat_variable_record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "variable_name": {
      "minLength": 1,
      "title": "Variable Name",
      "type": "string"
    },
    "matlab_class": {
      "minLength": 1,
      "title": "Matlab Class",
      "type": "string"
    },
    "numpy_dtype": {
      "minLength": 1,
      "title": "Numpy Dtype",
      "type": "string"
    },
    "shape": {
      "items": {
        "type": "integer"
      },
      "title": "Shape",
      "type": "array"
    },
    "element_count": {
      "minimum": 0,
      "title": "Element Count",
      "type": "integer"
    },
    "finite_count": {
      "minimum": 0,
      "title": "Finite Count",
      "type": "integer"
    },
    "nonfinite_count": {
      "minimum": 0,
      "title": "Nonfinite Count",
      "type": "integer"
    },
    "finite_minimum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finite Minimum"
    },
    "finite_maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finite Maximum"
    },
    "declared_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Unit"
    },
    "unit_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Basis"
    }
  },
  "required": [
    "variable_name",
    "matlab_class",
    "numpy_dtype",
    "shape",
    "element_count",
    "finite_count",
    "nonfinite_count"
  ],
  "title": "NumericMatVariableRecord",
  "type": "object"
}