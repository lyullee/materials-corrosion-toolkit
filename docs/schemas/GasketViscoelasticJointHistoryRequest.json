{
  "$defs": {
    "GasketPronyBranch": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "minLength": 1,
          "title": "Branch Id",
          "type": "string"
        },
        "modulus_Pa": {
          "exclusiveMinimum": 0,
          "title": "Modulus Pa",
          "type": "number"
        },
        "relaxation_time_s": {
          "exclusiveMinimum": 0,
          "title": "Relaxation Time S",
          "type": "number"
        }
      },
      "required": [
        "branch_id",
        "modulus_Pa",
        "relaxation_time_s"
      ],
      "title": "GasketPronyBranch",
      "type": "object"
    },
    "GasketViscoelasticMaterial": {
      "additionalProperties": false,
      "properties": {
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "condition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Condition Sha256",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "equilibrium_modulus_Pa": {
          "minimum": 0,
          "title": "Equilibrium Modulus Pa",
          "type": "number"
        },
        "prony_branches": {
          "items": {
            "$ref": "#/$defs/GasketPronyBranch"
          },
          "minItems": 1,
          "title": "Prony Branches",
          "type": "array"
        },
        "initial_branch_stress_Pa": {
          "items": {
            "type": "number"
          },
          "title": "Initial Branch Stress Pa",
          "type": "array"
        },
        "initial_branch_state_reviewed": {
          "title": "Initial Branch State Reviewed",
          "type": "boolean"
        },
        "calibration_basis_reviewed": {
          "title": "Calibration Basis Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "material_condition_id",
        "physical_specimen_id",
        "source_group_id",
        "condition_sha256",
        "source_sha256",
        "provider_id",
        "provider_revision",
        "temperature_K",
        "equilibrium_modulus_Pa",
        "prony_branches",
        "initial_branch_stress_Pa",
        "initial_branch_state_reviewed",
        "calibration_basis_reviewed",
        "computational_use_authorized"
      ],
      "title": "GasketViscoelasticMaterial",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Coupled quasi-static bolt equilibrium and caller-calibrated Prony gasket history.",
  "properties": {
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "joint_id": {
      "minLength": 1,
      "title": "Joint Id",
      "type": "string"
    },
    "material": {
      "$ref": "#/$defs/GasketViscoelasticMaterial"
    },
    "compression_area_m2": {
      "exclusiveMinimum": 0,
      "title": "Compression Area M2",
      "type": "number"
    },
    "gasket_compression_height_m": {
      "exclusiveMinimum": 0,
      "title": "Gasket Compression Height M",
      "type": "number"
    },
    "bolt_stiffness_N_m": {
      "exclusiveMinimum": 0,
      "title": "Bolt Stiffness N M",
      "type": "number"
    },
    "initial_compressive_strain": {
      "minimum": 0,
      "title": "Initial Compressive Strain",
      "type": "number"
    },
    "maximum_compressive_strain": {
      "exclusiveMinimum": 0,
      "title": "Maximum Compressive Strain",
      "type": "number"
    },
    "elapsed_time_s": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "minItems": 2,
      "title": "Elapsed Time S",
      "type": "array"
    },
    "external_separating_force_N": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "minItems": 2,
      "title": "External Separating Force N",
      "type": "array"
    },
    "bolt_free_length_change_m": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Bolt Free Length Change M",
      "type": "array"
    },
    "joint_geometry_and_force_balance_reviewed": {
      "title": "Joint Geometry And Force Balance Reviewed",
      "type": "boolean"
    },
    "piecewise_linear_internal_strain_update_reviewed": {
      "title": "Piecewise Linear Internal Strain Update Reviewed",
      "type": "boolean"
    },
    "coupled_history_model_applicability_reviewed": {
      "title": "Coupled History Model Applicability Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "joint_id",
    "material",
    "compression_area_m2",
    "gasket_compression_height_m",
    "bolt_stiffness_N_m",
    "initial_compressive_strain",
    "maximum_compressive_strain",
    "elapsed_time_s",
    "external_separating_force_N",
    "bolt_free_length_change_m",
    "joint_geometry_and_force_balance_reviewed",
    "piecewise_linear_internal_strain_update_reviewed",
    "coupled_history_model_applicability_reviewed"
  ],
  "title": "GasketViscoelasticJointHistoryRequest",
  "type": "object"
}