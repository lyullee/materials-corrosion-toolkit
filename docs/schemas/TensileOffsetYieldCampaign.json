        "geometry_unit_token": {
          "minLength": 1,
          "title": "Geometry Unit Token",
          "type": "string"
        },
        "area_unit_token": {
          "minLength": 1,
          "title": "Area Unit Token",
          "type": "string"
        },
        "required_machine_id": {
          "minLength": 1,
          "title": "Required Machine Id",
          "type": "string"
        },
        "required_load_cell_id": {
          "minLength": 1,
          "title": "Required Load Cell Id",
          "type": "string"
        },
        "required_extensometer_id": {
          "minLength": 1,
          "title": "Required Extensometer Id",
          "type": "string"
        },
        "minimum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "minimum_strain_rate_per_s": {
          "exclusiveMinimum": 0,
          "title": "Minimum Strain Rate Per S",
          "type": "number"
        },
        "maximum_strain_rate_per_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Strain Rate Per S",
          "type": "number"
        },
        "required_offset_definition_id": {
          "minLength": 1,
          "title": "Required Offset Definition Id",
          "type": "string"
        },
        "required_offset_strain": {
          "minimum": 0,
          "title": "Required Offset Strain",
          "type": "number"
        },
        "offset_strain_tolerance": {
          "minimum": 0,
          "title": "Offset Strain Tolerance",
          "type": "number"
        },
        "required_metrics": {
          "items": {
            "enum": [
              "elastic_modulus",
              "offset_yield_strength",
              "ultimate_tensile_strength",
              "elongation",
              "reduction_of_area"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Metrics",
          "type": "array"
        },
        "metric_criteria": {
          "items": {
            "$ref": "#/$defs/TensileMetricCriterion"
          },
          "minItems": 1,
          "title": "Metric Criteria",
          "type": "array"
        },
        "minimum_valid_test_count": {
          "minimum": 1,
          "title": "Minimum Valid Test Count",
          "type": "integer"
        },
        "minimum_independence_group_count": {
          "minimum": 1,
          "title": "Minimum Independence Group Count",
          "type": "integer"
        },
        "caller_validity_policy_id": {
          "minLength": 1,
          "title": "Caller Validity Policy Id",
          "type": "string"
        },
        "profile_source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Source Digest",
          "type": "string"
        },
        "built_in_standard_rules_used": {
          "const": false,
          "default": false,
          "title": "Built In Standard Rules Used",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "product_id",
        "heat_id",
        "material_condition_id",
        "supported_orientation_ids",
        "supported_geometry_ids",
        "geometry_unit_token",
        "area_unit_token",
        "required_machine_id",
        "required_load_cell_id",
        "required_extensometer_id",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "minimum_strain_rate_per_s",
        "maximum_strain_rate_per_s",
        "required_offset_definition_id",
        "required_offset_strain",
        "offset_strain_tolerance",
        "required_metrics",
        "metric_criteria",
        "minimum_valid_test_count",
        "minimum_independence_group_count",
        "caller_validity_policy_id",
        "profile_source_digest",
        "evidence"
      ],
      "title": "TensileCampaignCallerProfile",
      "type": "object"
    },
    "TensileMachineConfiguration": {
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "minLength": 1,
          "title": "Machine Id",
          "type": "string"
        },
        "machine_revision": {
          "minLength": 1,
          "title": "Machine Revision",
          "type": "string"
        },
        "load_cell_id": {
          "minLength": 1,
          "title": "Load Cell Id",
          "type": "string"
        },
        "load_cell_revision": {
          "minLength": 1,
          "title": "Load Cell Revision",
          "type": "string"
        },
        "extensometer_id": {
          "minLength": 1,
          "title": "Extensometer Id",
          "type": "string"
        },
        "extensometer_revision": {
          "minLength": 1,
          "title": "Extensometer Revision",
          "type": "string"
        },
        "machine_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Machine Configuration Digest",
          "type": "string"
        },
        "load_cell_calibration_id": {
          "minLength": 1,
          "title": "Load Cell Calibration Id",
          "type": "string"
        },
        "load_cell_calibration_status": {
          "enum": [
            "valid",
            "invalid",
            "missing"
          ],
          "title": "Load Cell Calibration Status",
          "type": "string"
        },
        "load_cell_calibration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Load Cell Calibration Digest",
          "type": "string"
        },
        "extensometer_calibration_id": {
          "minLength": 1,
          "title": "Extensometer Calibration Id",
          "type": "string"
        },
        "extensometer_calibration_status": {
          "enum": [
            "valid",
            "invalid",
            "missing"
          ],
          "title": "Extensometer Calibration Status",
          "type": "string"
        },
        "extensometer_calibration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Extensometer Calibration Digest",
          "type": "string"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "machine_id",
        "machine_revision",
        "load_cell_id",
        "load_cell_revision",
        "extensometer_id",
        "extensometer_revision",
        "machine_configuration_digest",
        "load_cell_calibration_id",
        "load_cell_calibration_status",
        "load_cell_calibration_digest",
        "extensometer_calibration_id",
        "extensometer_calibration_status",
        "extensometer_calibration_digest",
        "evidence"
      ],
      "title": "TensileMachineConfiguration",
      "type": "object"
    },
    "TensileMetricCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "metric": {
          "enum": [
            "elastic_modulus",
            "offset_yield_strength",
            "ultimate_tensile_strength",
            "elongation",
            "reduction_of_area"
          ],
          "title": "Metric",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_acceptable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Acceptable"
        },
        "maximum_acceptable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Acceptable"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
