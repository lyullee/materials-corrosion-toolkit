        "caller_validity_basis": {
          "minLength": 1,
          "title": "Caller Validity Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
