          "title": "Comparison Direction",
          "type": "string"
        },
        "threshold_V": {
          "title": "Threshold V",
          "type": "number"
        },
        "threshold_basis": {
          "minLength": 1,
          "title": "Threshold Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "threshold_id",
        "potential_convention",
        "reference_electrode_id",
        "comparison_direction",
        "threshold_V",
        "threshold_basis",
        "evidence"
      ],
      "title": "CallerPotentialThreshold",
      "type": "object"
    },
