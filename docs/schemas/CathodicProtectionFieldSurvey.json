    "CallerPotentialThreshold": {
      "additionalProperties": false,
      "properties": {
        "threshold_id": {
          "minLength": 1,
          "title": "Threshold Id",
          "type": "string"
        },
        "potential_convention": {
          "enum": [
            "native",
            "on",
            "off",
            "instant_off"
          ],
          "title": "Potential Convention",
          "type": "string"
        },
        "reference_electrode_id": {
          "minLength": 1,
          "title": "Reference Electrode Id",
          "type": "string"
        },
        "comparison_direction": {
          "enum": [
            "at_or_more_negative",
            "at_or_more_positive"
