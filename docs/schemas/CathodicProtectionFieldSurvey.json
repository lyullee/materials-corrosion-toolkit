          ],
          "default": null,
          "title": "Expanded Uncertainty A"
        },
        "current_sign_basis": {
          "minLength": 1,
          "title": "Current Sign Basis",
          "type": "string"
        },
        "specimen_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Specimen Temperature K",
          "type": "number"
