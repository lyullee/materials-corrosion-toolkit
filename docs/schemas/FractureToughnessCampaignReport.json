{
  "additionalProperties": false,
  "properties": {
    "report_schema_version": {
      "const": "matintegrity.fracture_toughness_testing_report.v1",
      "default": "matintegrity.fracture_toughness_testing_report.v1",
      "title": "Report Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "campaign_outcome": {
      "enum": [
        "accept",
        "review",
        "reject",
        "insufficient_evidence"
      ],
      "title": "Campaign Outcome",
      "type": "string"
    },
    "caller_profile_id": {
      "minLength": 1,
      "title": "Caller Profile Id",
      "type": "string"
    },
    "metric_values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metric Values",
      "type": "object"
    },
    "criterion_findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Criterion Findings",
      "type": "array"
    },
    "diagnostics": {
      "additionalProperties": true,
      "title": "Diagnostics",
      "type": "object"
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "caller_profile_only": {
      "const": true,
      "default": true,
      "title": "Caller Profile Only",
      "type": "boolean"
    },
    "official_validity_rules_applied": {
      "const": false,
      "default": false,
      "title": "Official Validity Rules Applied",
      "type": "boolean"
    },
    "toughness_converted_or_recalculated": {
      "const": false,
      "default": false,
      "title": "Toughness Converted Or Recalculated",
      "type": "boolean"
    },
    "design_allowable_produced": {
      "const": false,
      "default": false,
      "title": "Design Allowable Produced",
      "type": "boolean"
    },
    "report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Digest",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "campaign_id",
    "campaign_outcome",
    "caller_profile_id",
    "metric_values",
    "criterion_findings",
    "diagnostics",
    "input_digest",
    "report_digest"
  ],
  "title": "FractureToughnessCampaignReport",
  "type": "object"
}