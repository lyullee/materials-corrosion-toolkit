{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "StabilizedCyclicObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "independence_group_id": {
          "minLength": 1,
          "title": "Independence Group Id",
          "type": "string"
        },
        "partition": {
          "enum": [
            "calibration",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "stress_amplitude": {
          "exclusiveMinimum": 0,
          "title": "Stress Amplitude",
          "type": "number"
        },
        "stress_unit_token": {
          "minLength": 1,
          "title": "Stress Unit Token",
          "type": "string"
        },
        "total_strain_amplitude": {
          "exclusiveMinimum": 0,
          "title": "Total Strain Amplitude",
          "type": "number"
        },
        "strain_unit_token": {
          "const": "1",
          "default": "1",
          "title": "Strain Unit Token",
          "type": "string"
        },
        "plastic_strain_definition": {
          "enum": [
            "total_minus_elastic",
            "explicit_reported"
          ],
          "title": "Plastic Strain Definition",
          "type": "string"
        },
        "elastic_modulus": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elastic Modulus"
        },
        "elastic_modulus_unit_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elastic Modulus Unit Token"
        },
        "reported_plastic_strain_amplitude": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Plastic Strain Amplitude"
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "physical_specimen_id",
        "source_group_id",
        "independence_group_id",
        "partition",
        "material_condition_id",
        "stress_amplitude",
        "stress_unit_token",
        "total_strain_amplitude",
        "plastic_strain_definition",
        "weight",
        "record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "StabilizedCyclicObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fit_id": {
      "minLength": 1,
      "title": "Fit Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/StabilizedCyclicObservation"
      },
      "minItems": 4,
      "title": "Observations",
      "type": "array"
    },
    "minimum_calibration_specimen_count": {
      "minimum": 2,
      "title": "Minimum Calibration Specimen Count",
      "type": "integer"
    },
    "minimum_calibration_source_group_count": {
      "minimum": 2,
      "title": "Minimum Calibration Source Group Count",
      "type": "integer"
    },
    "minimum_holdout_specimen_count": {
      "minimum": 1,
      "title": "Minimum Holdout Specimen Count",
      "type": "integer"
    },
    "minimum_holdout_source_group_count": {
      "minimum": 1,
      "title": "Minimum Holdout Source Group Count",
      "type": "integer"
    },
    "material_and_stabilized_cycle_definition_reviewed": {
      "title": "Material And Stabilized Cycle Definition Reviewed",
      "type": "boolean"
    },
    "stress_strain_amplitudes_units_and_sign_reviewed": {
      "title": "Stress Strain Amplitudes Units And Sign Reviewed",
      "type": "boolean"
    },
    "plastic_strain_definition_and_elastic_modulus_reviewed": {
      "title": "Plastic Strain Definition And Elastic Modulus Reviewed",
      "type": "boolean"
    },
    "specimen_source_independence_and_partitions_reviewed": {
      "title": "Specimen Source Independence And Partitions Reviewed",
      "type": "boolean"
    },
    "weights_and_record_validity_reviewed": {
      "title": "Weights And Record Validity Reviewed",
      "type": "boolean"
    },
    "support_and_no_extrapolation_reviewed": {
      "title": "Support And No Extrapolation Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "fit_id",
    "asset_id",
    "location_id",
    "material_condition_id",
    "observations",
    "minimum_calibration_specimen_count",
    "minimum_calibration_source_group_count",
    "minimum_holdout_specimen_count",
    "minimum_holdout_source_group_count",
    "material_and_stabilized_cycle_definition_reviewed",
    "stress_strain_amplitudes_units_and_sign_reviewed",
    "plastic_strain_definition_and_elastic_modulus_reviewed",
    "specimen_source_independence_and_partitions_reviewed",
    "weights_and_record_validity_reviewed",
    "support_and_no_extrapolation_reviewed",
    "evidence"
  ],
  "title": "CyclicRambergOsgoodFit",
  "type": "object"
}