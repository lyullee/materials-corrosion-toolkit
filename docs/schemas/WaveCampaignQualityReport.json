{
  "additionalProperties": false,
  "properties": {
    "report_schema_version": {
      "const": "matintegrity.wave_campaign_quality_report.v1",
      "default": "matintegrity.wave_campaign_quality_report.v1",
      "title": "Report Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "family": {
      "enum": [
        "acoustic_emission",
        "guided_waves"
      ],
      "title": "Family",
      "type": "string"
    },
    "quality_outcome": {
      "enum": [
        "pass",
        "review",
        "fail",
        "insufficient_evidence"
      ],
      "title": "Quality Outcome",
      "type": "string"
    },
    "acceptance_profile_id": {
      "minLength": 1,
      "title": "Acceptance Profile Id",
      "type": "string"
    },
    "metric_values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metric Values",
      "type": "object"
    },
    "criterion_findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Criterion Findings",
      "type": "array"
    },
    "diagnostics": {
      "additionalProperties": true,
      "title": "Diagnostics",
      "type": "object"
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "caller_acceptance_profile_only": {
      "const": true,
      "default": true,
      "title": "Caller Acceptance Profile Only",
      "type": "boolean"
    },
    "automatic_damage_detection_or_sizing": {
      "const": false,
      "default": false,
      "title": "Automatic Damage Detection Or Sizing",
      "type": "boolean"
    },
    "pod_claimed": {
      "const": false,
      "default": false,
      "title": "Pod Claimed",
      "type": "boolean"
    },
    "physical_qualification": {
      "const": false,
      "default": false,
      "title": "Physical Qualification",
      "type": "boolean"
    },
    "report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Digest",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "campaign_id",
    "family",
    "quality_outcome",
    "acceptance_profile_id",
    "metric_values",
    "criterion_findings",
    "diagnostics",
    "input_digest",
    "report_digest"
  ],
  "title": "WaveCampaignQualityReport",
  "type": "object"
}