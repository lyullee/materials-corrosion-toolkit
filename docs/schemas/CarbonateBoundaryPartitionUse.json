{
  "$defs": {
    "CarbonateBoundarySelection": {
      "additionalProperties": false,
      "properties": {
        "boundary_id": {
          "minLength": 1,
          "title": "Boundary Id",
          "type": "string"
        },
        "hydrated_carbonic_fraction_of_co2star": {
          "maximum": 1,
          "minimum": 0,
          "title": "Hydrated Carbonic Fraction Of Co2Star",
          "type": "number"
        },
        "water_concentration_mol_m3": {
          "exclusiveMinimum": 0,
          "title": "Water Concentration Mol M3",
          "type": "number"
        },
        "partition_provider_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Partition Provider Sha256",
          "type": "string"
        },
        "co2star_partition_and_water_basis_reviewed": {
          "title": "Co2Star Partition And Water Basis Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "boundary_id",
        "hydrated_carbonic_fraction_of_co2star",
        "water_concentration_mol_m3",
        "partition_provider_sha256",
        "co2star_partition_and_water_basis_reviewed"
      ],
      "title": "CarbonateBoundarySelection",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "selection": {
      "$ref": "#/$defs/CarbonateBoundarySelection"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "source_record_id": {
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    }
  },
  "required": [
    "selection",
    "provider_id",
    "provider_revision",
    "source_record_id",
    "evidence"
  ],
  "title": "CarbonateBoundaryPartitionUse",
  "type": "object"
}