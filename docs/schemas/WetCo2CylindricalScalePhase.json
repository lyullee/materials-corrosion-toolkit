{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "phase_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Phase Id",
      "type": "string"
    },
    "molar_volume_m3_mol": {
      "exclusiveMinimum": 0,
      "title": "Molar Volume M3 Mol",
      "type": "number"
    },
    "provider_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "source_record_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    }
  },
  "required": [
    "phase_id",
    "molar_volume_m3_mol",
    "provider_id",
    "provider_revision",
    "source_record_id",
    "evidence"
  ],
  "title": "WetCo2CylindricalScalePhase",
  "type": "object"
}