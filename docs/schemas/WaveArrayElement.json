{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "element_id": {
      "minLength": 1,
      "title": "Element Id",
      "type": "string"
    },
    "channel_id": {
      "minLength": 1,
      "title": "Channel Id",
      "type": "string"
    },
    "element_kind": {
      "enum": [
        "sensor",
        "transducer"
      ],
      "title": "Element Kind",
      "type": "string"
    },
    "physical_position_definition": {
      "minLength": 1,
      "title": "Physical Position Definition",
      "type": "string"
    },
    "calibration_id": {
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "element_id",
    "channel_id",
    "element_kind",
    "physical_position_definition",
    "calibration_id",
    "calibration_digest",
    "evidence"
  ],
  "title": "WaveArrayElement",
  "type": "object"
}