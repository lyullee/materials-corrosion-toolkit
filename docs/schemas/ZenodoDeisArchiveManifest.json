{
  "$defs": {
    "DeisMatrixMember": {
      "additionalProperties": false,
      "properties": {
        "member_path": {
          "enum": [
            "DEIS/AZ31/AZ31-zw.txt",
            "DEIS/WE43/WE43-zw.txt"
          ],
          "title": "Member Path",
          "type": "string"
        },
        "declared_material_label": {
          "enum": [
            "AZ31",
            "WE43"
          ],
          "title": "Declared Material Label",
          "type": "string"
        },
        "member_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Member Sha256",
          "type": "string"
        },
        "member_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 8000000,
          "title": "Member Bytes",
          "type": "integer"
        },
        "row_count": {
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "title": "Row Count",
          "type": "integer"
        },
        "column_count": {
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Column Count",
          "type": "integer"
        },
        "blank_cell_count": {
          "minimum": 0,
          "title": "Blank Cell Count",
          "type": "integer"
        },
        "nonfinite_cell_count": {
          "minimum": 0,
          "title": "Nonfinite Cell Count",
          "type": "integer"
        },
        "delimiter": {
          "const": "tab",
          "default": "tab",
          "title": "Delimiter",
          "type": "string"
        },
        "raw_column_order_preserved": {
          "const": true,
          "default": true,
          "title": "Raw Column Order Preserved",
          "type": "boolean"
        },
        "axis_mapping": {
          "const": "not_declared_by_importer",
          "default": "not_declared_by_importer",
          "title": "Axis Mapping",
          "type": "string"
        },
        "units_mapping": {
          "const": "not_declared_by_importer",
          "default": "not_declared_by_importer",
          "title": "Units Mapping",
          "type": "string"
        },
        "spectrum_partitioning": {
          "const": "not_declared_by_importer",
          "default": "not_declared_by_importer",
          "title": "Spectrum Partitioning",
          "type": "string"
        }
      },
      "required": [
        "member_path",
        "declared_material_label",
        "member_sha256",
        "member_bytes",
        "row_count",
        "column_count",
        "blank_cell_count",
        "nonfinite_cell_count"
      ],
      "title": "DeisMatrixMember",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "const": "az-we43-az31-molybdate-eis",
      "default": "az-we43-az31-molybdate-eis",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_doi": {
      "const": "10.5281/zenodo.10482561",
      "default": "10.5281/zenodo.10482561",
      "title": "Dataset Doi",
      "type": "string"
    },
    "dataset_license_id": {
      "const": "CC0-1.0",
      "default": "CC0-1.0",
      "title": "Dataset License Id",
      "type": "string"
    },
    "archive_sha256": {
      "const": "38d69f883ede6caaf988c3af9dd56f34c071f97b668d93fad778428c26dbed7c",
      "title": "Archive Sha256",
      "type": "string"
    },
    "archive_bytes": {
      "const": 30886921,
      "title": "Archive Bytes",
      "type": "integer"
    },
    "declared_use": {
      "const": "local_analysis_only_until_caller_supplies_applicability",
      "default": "local_analysis_only_until_caller_supplies_applicability",
      "title": "Declared Use",
      "type": "string"
    },
    "matrices": {
      "items": {
        "$ref": "#/$defs/DeisMatrixMember"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Matrices",
      "type": "array"
    },
    "non_deis_members_present": {
      "const": true,
      "default": true,
      "title": "Non Deis Members Present",
      "type": "boolean"
    },
    "measured_observations_exported": {
      "const": false,
      "default": false,
      "title": "Measured Observations Exported",
      "type": "boolean"
    },
    "physical_qualification_inferred": {
      "const": false,
      "default": false,
      "title": "Physical Qualification Inferred",
      "type": "boolean"
    }
  },
  "required": [
    "archive_sha256",
    "archive_bytes",
    "matrices"
  ],
  "title": "ZenodoDeisArchiveManifest",
  "type": "object"
}