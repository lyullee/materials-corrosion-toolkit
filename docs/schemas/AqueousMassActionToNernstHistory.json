{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.aqueous_mass_action_to_nernst_history.v1",
      "default": "matintegrity.aqueous_mass_action_to_nernst_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "mass_action_history_result": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "mass_action_history_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mass Action History Result Sha256",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "standard_potential_reference_id": {
      "minLength": 1,
      "title": "Standard Potential Reference Id",
      "type": "string"
    },
    "reaction_quotient_stoichiometry": {
      "additionalProperties": {
        "type": "number"
      },
      "minProperties": 1,
      "title": "Reaction Quotient Stoichiometry",
      "type": "object"
    },
    "electron_number": {
      "maximum": 32,
      "minimum": 1,
      "title": "Electron Number",
      "type": "integer"
    },
    "standard_potential_V": {
      "items": {
        "type": "number"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Standard Potential V",
      "type": "array"
    },
    "standard_potential_provider_id": {
      "minLength": 1,
      "title": "Standard Potential Provider Id",
      "type": "string"
    },
    "standard_potential_provider_revision": {
      "minLength": 1,
      "title": "Standard Potential Provider Revision",
      "type": "string"
    },
    "standard_potential_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Standard Potential Configuration Sha256",
      "type": "string"
    },
    "standard_potential_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Standard Potential Record Sha256",
      "type": "string"
    },
    "redox_reaction_direction_and_electron_number_reviewed": {
      "title": "Redox Reaction Direction And Electron Number Reviewed",
      "type": "boolean"
    },
    "activity_standard_state_and_species_mapping_reviewed": {
      "title": "Activity Standard State And Species Mapping Reviewed",
      "type": "boolean"
    },
    "standard_potential_temperature_history_reviewed": {
      "title": "Standard Potential Temperature History Reviewed",
      "type": "boolean"
    },
    "local_activity_history_applicability_reviewed": {
      "title": "Local Activity History Applicability Reviewed",
      "type": "boolean"
    },
    "potential_only_no_rate_or_acceptance_reviewed": {
      "title": "Potential Only No Rate Or Acceptance Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "mass_action_history_result",
    "mass_action_history_result_sha256",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "clock_id",
    "reaction_id",
    "standard_potential_reference_id",
    "reaction_quotient_stoichiometry",
    "electron_number",
    "standard_potential_V",
    "standard_potential_provider_id",
    "standard_potential_provider_revision",
    "standard_potential_configuration_sha256",
    "standard_potential_record_sha256",
    "redox_reaction_direction_and_electron_number_reviewed",
    "activity_standard_state_and_species_mapping_reviewed",
    "standard_potential_temperature_history_reviewed",
    "local_activity_history_applicability_reviewed",
    "potential_only_no_rate_or_acceptance_reviewed",
    "computational_use_authorized",
    "evidence"
  ],
  "title": "AqueousMassActionToNernstHistory",
  "type": "object"
}