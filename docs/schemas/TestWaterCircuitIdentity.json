{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "water_batch_id": {
      "minLength": 1,
      "title": "Water Batch Id",
      "type": "string"
    },
    "source_type_descriptor": {
      "minLength": 1,
      "title": "Source Type Descriptor",
      "type": "string"
    },
    "tank_id": {
      "minLength": 1,
      "title": "Tank Id",
      "type": "string"
    },
    "circuit_id": {
      "minLength": 1,
      "title": "Circuit Id",
      "type": "string"
    },
    "circuit_scope_definition": {
      "minLength": 1,
      "title": "Circuit Scope Definition",
      "type": "string"
    },
    "contacted_material_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Contacted Material Ids",
      "type": "array"
    },
    "contact_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Contact Configuration Digest",
      "type": "string"
    },
    "source_batch_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Batch Record Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "water_batch_id",
    "source_type_descriptor",
    "tank_id",
    "circuit_id",
    "circuit_scope_definition",
    "contacted_material_ids",
    "contact_configuration_digest",
    "source_batch_record_digest",
    "evidence"
  ],
  "title": "TestWaterCircuitIdentity",
  "type": "object"
}