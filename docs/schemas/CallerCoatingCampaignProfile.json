{
  "$defs": {
    "CallerCoatingMetricRule": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "metric_kind": {
          "minLength": 1,
          "title": "Metric Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "individual",
            "replicate_mean",
            "replicate_minimum",
            "replicate_maximum"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "minimum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Inclusive"
        },
        "maximum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Inclusive"
        },
        "uncertainty_policy": {
          "enum": [
            "point_value",
            "interval_must_fit"
          ],
          "title": "Uncertainty Policy",
          "type": "string"
        },
        "uncertainty_coverage_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Uncertainty Coverage Factor",
          "type": "number"
        },
        "minimum_replicates_per_group": {
          "minimum": 1,
          "title": "Minimum Replicates Per Group",
          "type": "integer"
        },
        "missing_disposition": {
          "enum": [
            "review",
            "insufficient_evidence"
          ],
          "title": "Missing Disposition",
          "type": "string"
        },
        "rule_description": {
          "minLength": 1,
          "title": "Rule Description",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "metric_kind",
        "metric_id",
        "unit_token",
        "aggregation",
        "uncertainty_policy",
        "minimum_replicates_per_group",
        "missing_disposition",
        "rule_description"
      ],
      "title": "CallerCoatingMetricRule",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "permitted_substrate_condition_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Substrate Condition Ids",
      "type": "array"
    },
    "permitted_surface_preparation_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Surface Preparation Ids",
      "type": "array"
    },
    "permitted_coating_system_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Coating System Ids",
      "type": "array"
    },
    "permitted_process_condition_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Process Condition Ids",
      "type": "array"
    },
    "permitted_environment_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Environment Ids",
      "type": "array"
    },
    "minimum_cure_temperature_k": {
      "exclusiveMinimum": 0,
      "title": "Minimum Cure Temperature K",
      "type": "number"
    },
    "maximum_cure_temperature_k": {
      "exclusiveMinimum": 0,
      "title": "Maximum Cure Temperature K",
      "type": "number"
    },
    "maximum_cure_interval_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Cure Interval S",
      "type": "number"
    },
    "metric_rules": {
      "items": {
        "$ref": "#/$defs/CallerCoatingMetricRule"
      },
      "minItems": 1,
      "title": "Metric Rules",
      "type": "array"
    },
    "profile_reviewed": {
      "title": "Profile Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_revision",
    "source_digest",
    "permitted_substrate_condition_ids",
    "permitted_surface_preparation_ids",
    "permitted_coating_system_ids",
    "permitted_process_condition_ids",
    "permitted_environment_ids",
    "minimum_cure_temperature_k",
    "maximum_cure_temperature_k",
    "maximum_cure_interval_s",
    "metric_rules",
    "profile_reviewed",
    "evidence"
  ],
  "title": "CallerCoatingCampaignProfile",
  "type": "object"
}