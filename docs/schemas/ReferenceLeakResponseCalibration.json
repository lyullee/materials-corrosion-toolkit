{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReferenceLeakResponseObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "partition": {
          "enum": [
            "calibration",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "reference_leak_id": {
          "minLength": 1,
          "title": "Reference Leak Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "independence_group_id": {
          "minLength": 1,
          "title": "Independence Group Id",
          "type": "string"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_configuration_id": {
          "minLength": 1,
          "title": "Instrument Configuration Id",
          "type": "string"
        },
        "test_gas_id": {
          "minLength": 1,
          "title": "Test Gas Id",
          "type": "string"
        },
        "boundary_condition_id": {
          "minLength": 1,
          "title": "Boundary Condition Id",
          "type": "string"
        },
        "observation_clock_id": {
          "minLength": 1,
          "title": "Observation Clock Id",
          "type": "string"
        },
        "reference_time_s": {
          "minimum": 0,
          "title": "Reference Time S",
          "type": "number"
        },
        "response_time_s": {
          "minimum": 0,
          "title": "Response Time S",
          "type": "number"
        },
        "reporting_status": {
          "enum": [
            "detected",
            "below_detection",
            "censored",
            "missing",
            "invalid"
          ],
          "title": "Reporting Status",
          "type": "string"
        },
        "reference_leak_rate_mol_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Leak Rate Mol S"
        },
        "expanded_reference_leak_uncertainty_mol_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Reference Leak Uncertainty Mol S"
        },
        "response_value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Value"
        },
        "response_unit_token": {
          "minLength": 1,
          "title": "Response Unit Token",
          "type": "string"
        },
        "expanded_response_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Response Uncertainty"
        },
        "response_detection_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Detection Limit"
        },
        "sample_weight": {
          "exclusiveMinimum": 0,
          "title": "Sample Weight",
          "type": "number"
        },
        "exclusion_or_status_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Or Status Basis"
        },
        "reference_provider_id": {
          "minLength": 1,
          "title": "Reference Provider Id",
          "type": "string"
        },
        "reference_provider_revision": {
          "minLength": 1,
          "title": "Reference Provider Revision",
          "type": "string"
        },
        "reference_provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Reference Provider State Digest",
          "type": "string"
        },
        "instrument_provider_id": {
          "minLength": 1,
          "title": "Instrument Provider Id",
          "type": "string"
        },
        "instrument_provider_revision": {
          "minLength": 1,
          "title": "Instrument Provider Revision",
          "type": "string"
        },
        "instrument_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Instrument Configuration Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "partition",
        "physical_specimen_id",
        "reference_leak_id",
        "source_group_id",
        "independence_group_id",
        "instrument_id",
        "instrument_configuration_id",
        "test_gas_id",
        "boundary_condition_id",
        "observation_clock_id",
        "reference_time_s",
        "response_time_s",
        "reporting_status",
        "response_unit_token",
        "sample_weight",
        "reference_provider_id",
        "reference_provider_revision",
        "reference_provider_state_digest",
        "instrument_provider_id",
        "instrument_provider_revision",
        "instrument_configuration_digest",
        "result_digest",
        "record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "ReferenceLeakResponseObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "calibration_id": {
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "observation_clock_id": {
      "minLength": 1,
      "title": "Observation Clock Id",
      "type": "string"
    },
    "time_basis": {
      "minLength": 1,
      "title": "Time Basis",
      "type": "string"
    },
    "instrument_id": {
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "instrument_configuration_id": {
      "minLength": 1,
      "title": "Instrument Configuration Id",
      "type": "string"
    },
    "test_gas_id": {
      "minLength": 1,
      "title": "Test Gas Id",
      "type": "string"
    },
    "boundary_condition_id": {
      "minLength": 1,
      "title": "Boundary Condition Id",
      "type": "string"
    },
    "leak_quantity_definition": {
      "const": "molar_flow_rate",
      "default": "molar_flow_rate",
      "title": "Leak Quantity Definition",
      "type": "string"
    },
    "leak_rate_unit_token": {
      "const": "mol/s",
      "default": "mol/s",
      "title": "Leak Rate Unit Token",
      "type": "string"
    },
    "pressure_basis": {
      "minLength": 1,
      "title": "Pressure Basis",
      "type": "string"
    },
    "reference_temperature_basis": {
      "minLength": 1,
      "title": "Reference Temperature Basis",
      "type": "string"
    },
    "response_definition": {
      "minLength": 1,
      "title": "Response Definition",
      "type": "string"
    },
    "response_unit_token": {
      "minLength": 1,
      "title": "Response Unit Token",
      "type": "string"
    },
    "log_reference_leak_rate_mol_s": {
      "exclusiveMinimum": 0,
      "title": "Log Reference Leak Rate Mol S",
      "type": "number"
    },
    "log_reference_response_value": {
      "exclusiveMinimum": 0,
      "title": "Log Reference Response Value",
      "type": "number"
    },
    "maximum_clock_alignment_error_s": {
      "minimum": 0,
      "title": "Maximum Clock Alignment Error S",
      "type": "number"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ReferenceLeakResponseObservation"
      },
      "minItems": 3,
      "title": "Observations",
      "type": "array"
    },
    "minimum_calibration_detected_count": {
      "minimum": 2,
      "title": "Minimum Calibration Detected Count",
      "type": "integer"
    },
    "minimum_holdout_detected_count": {
      "minimum": 1,
      "title": "Minimum Holdout Detected Count",
      "type": "integer"
    },
    "minimum_calibration_source_group_count": {
      "minimum": 1,
      "title": "Minimum Calibration Source Group Count",
      "type": "integer"
    },
    "minimum_holdout_source_group_count": {
      "minimum": 1,
      "title": "Minimum Holdout Source Group Count",
      "type": "integer"
    },
    "minimum_holdout_independence_group_count": {
      "minimum": 1,
      "title": "Minimum Holdout Independence Group Count",
      "type": "integer"
    },
    "instrument_configuration_gas_and_boundary_reviewed": {
      "title": "Instrument Configuration Gas And Boundary Reviewed",
      "type": "boolean"
    },
    "clock_alignment_and_physical_scope_reviewed": {
      "title": "Clock Alignment And Physical Scope Reviewed",
      "type": "boolean"
    },
    "si_leak_quantity_pressure_and_temperature_basis_reviewed": {
      "title": "Si Leak Quantity Pressure And Temperature Basis Reviewed",
      "type": "boolean"
    },
    "reference_traceability_and_uncertainty_reviewed": {
      "title": "Reference Traceability And Uncertainty Reviewed",
      "type": "boolean"
    },
    "response_definition_units_and_uncertainty_reviewed": {
      "title": "Response Definition Units And Uncertainty Reviewed",
      "type": "boolean"
    },
    "partition_and_group_independence_reviewed": {
      "title": "Partition And Group Independence Reviewed",
      "type": "boolean"
    },
    "censored_missing_and_invalid_status_reviewed": {
      "title": "Censored Missing And Invalid Status Reviewed",
      "type": "boolean"
    },
    "provider_and_result_digests_reviewed": {
      "title": "Provider And Result Digests Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "calibration_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "observation_clock_id",
    "time_basis",
    "instrument_id",
    "instrument_configuration_id",
    "test_gas_id",
    "boundary_condition_id",
    "pressure_basis",
    "reference_temperature_basis",
    "response_definition",
    "response_unit_token",
    "log_reference_leak_rate_mol_s",
    "log_reference_response_value",
    "maximum_clock_alignment_error_s",
    "observations",
    "minimum_calibration_detected_count",
    "minimum_holdout_detected_count",
    "minimum_calibration_source_group_count",
    "minimum_holdout_source_group_count",
    "minimum_holdout_independence_group_count",
    "instrument_configuration_gas_and_boundary_reviewed",
    "clock_alignment_and_physical_scope_reviewed",
    "si_leak_quantity_pressure_and_temperature_basis_reviewed",
    "reference_traceability_and_uncertainty_reviewed",
    "response_definition_units_and_uncertainty_reviewed",
    "partition_and_group_independence_reviewed",
    "censored_missing_and_invalid_status_reviewed",
    "provider_and_result_digests_reviewed"
  ],
  "title": "ReferenceLeakResponseCalibration",
  "type": "object"
}