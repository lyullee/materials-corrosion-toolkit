{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "tube_id": {
      "minLength": 1,
      "title": "Tube Id",
      "type": "string"
    },
    "tubesheet_hole_id": {
      "minLength": 1,
      "title": "Tubesheet Hole Id",
      "type": "string"
    },
    "initial_outer_diameter_m": {
      "exclusiveMinimum": 0,
      "title": "Initial Outer Diameter M",
      "type": "number"
    },
    "initial_inner_diameter_m": {
      "exclusiveMinimum": 0,
      "title": "Initial Inner Diameter M",
      "type": "number"
    },
    "hole_diameter_m": {
      "exclusiveMinimum": 0,
      "title": "Hole Diameter M",
      "type": "number"
    },
    "expanded_inner_diameter_m": {
      "exclusiveMinimum": 0,
      "title": "Expanded Inner Diameter M",
      "type": "number"
    },
    "final_outer_surface_contact_with_hole_reviewed": {
      "title": "Final Outer Surface Contact With Hole Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "basis",
    "tube_id",
    "tubesheet_hole_id",
    "initial_outer_diameter_m",
    "initial_inner_diameter_m",
    "hole_diameter_m",
    "expanded_inner_diameter_m",
    "final_outer_surface_contact_with_hole_reviewed"
  ],
  "title": "TubeExpansionWallReduction",
  "type": "object"
}