{
  "$defs": {
    "AtmosphericSourceGroupMetric": {
      "additionalProperties": false,
      "properties": {
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "observation_count": {
          "minimum": 1,
          "title": "Observation Count",
          "type": "integer"
        },
        "log_rmse": {
          "minimum": 0,
          "title": "Log Rmse",
          "type": "number"
        },
        "absolute_log_bias": {
          "minimum": 0,
          "title": "Absolute Log Bias",
          "type": "number"
        },
        "outside_support_count": {
          "minimum": 0,
          "title": "Outside Support Count",
          "type": "integer"
        },
        "outside_support_fraction": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Outside Support Fraction",
          "type": "number"
        }
      },
      "required": [
        "source_group_id",
        "observation_count",
        "log_rmse",
        "absolute_log_bias",
        "outside_support_count",
        "outside_support_fraction"
      ],
      "title": "AtmosphericSourceGroupMetric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.atmospheric_first_year_model.v1",
      "default": "matintegrity.atmospheric_first_year_model.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "fit_id": {
      "minLength": 1,
      "title": "Fit Id",
      "type": "string"
    },
    "feature_definition": {
      "const": "intercept,T_K_minus_288.15_over_10,RH_minus_0.75_over_0.1,log1p_Cl_mg_m2_day,log1p_SO2_mg_m2_day",
      "default": "intercept,T_K_minus_288.15_over_10,RH_minus_0.75_over_0.1,log1p_Cl_mg_m2_day,log1p_SO2_mg_m2_day",
      "title": "Feature Definition",
      "type": "string"
    },
    "coefficient_log_m": {
      "title": "Coefficient Log M",
      "type": "number"
    },
    "coefficient_temperature_per_10_K": {
      "title": "Coefficient Temperature Per 10 K",
      "type": "number"
    },
    "coefficient_relative_humidity_per_0_1": {
      "title": "Coefficient Relative Humidity Per 0 1",
      "type": "number"
    },
    "coefficient_log1p_chloride": {
      "title": "Coefficient Log1P Chloride",
      "type": "number"
    },
    "coefficient_log1p_sulfur_dioxide": {
      "title": "Coefficient Log1P Sulfur Dioxide",
      "type": "number"
    },
    "coefficient_covariance": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Coefficient Covariance",
      "type": "array"
    },
    "residual_standard_deviation_log_m": {
      "minimum": 0,
      "title": "Residual Standard Deviation Log M",
      "type": "number"
    },
    "calibration_support_temperature_K": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Calibration Support Temperature K",
      "type": "array"
    },
    "calibration_support_relative_humidity_fraction": {
      "items": {
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Calibration Support Relative Humidity Fraction",
      "type": "array"
    },
    "calibration_support_chloride_mg_m2_day": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Calibration Support Chloride Mg M2 Day",
      "type": "array"
    },
    "calibration_support_sulfur_dioxide_mg_m2_day": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Calibration Support Sulfur Dioxide Mg M2 Day",
      "type": "array"
    },
    "calibration_observation_count": {
      "minimum": 6,
      "title": "Calibration Observation Count",
      "type": "integer"
    },
    "calibration_source_group_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Calibration Source Group Ids",
      "type": "array"
    },
    "calibration_input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Input Digest",
      "type": "string"
    },
    "holdout_input_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Holdout Input Digest"
    },
    "holdout_observation_count": {
      "minimum": 1,
      "title": "Holdout Observation Count",
      "type": "integer"
    },
    "holdout_log_rmse": {
      "minimum": 0,
      "title": "Holdout Log Rmse",
      "type": "number"
    },
    "holdout_absolute_log_bias": {
      "minimum": 0,
      "title": "Holdout Absolute Log Bias",
      "type": "number"
    },
    "holdout_outside_support_fraction": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Holdout Outside Support Fraction",
      "type": "number"
    },
    "holdout_source_group_metrics": {
      "items": {
        "$ref": "#/$defs/AtmosphericSourceGroupMetric"
      },
      "title": "Holdout Source Group Metrics",
      "type": "array"
    },
    "maximum_holdout_source_group_log_rmse": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Holdout Source Group Log Rmse"
    },
    "maximum_holdout_source_group_absolute_log_bias": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Holdout Source Group Absolute Log Bias"
    },
    "source_group_transfer_criteria_met": {
      "default": false,
      "title": "Source Group Transfer Criteria Met",
      "type": "boolean"
    },
    "maximum_holdout_log_rmse": {
      "exclusiveMinimum": 0,
      "title": "Maximum Holdout Log Rmse",
      "type": "number"
    },
    "maximum_absolute_holdout_log_bias": {
      "exclusiveMinimum": 0,
      "title": "Maximum Absolute Holdout Log Bias",
      "type": "number"
    },
    "maximum_holdout_outside_support_fraction": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Maximum Holdout Outside Support Fraction",
      "type": "number"
    },
    "transfer_criteria_met": {
      "title": "Transfer Criteria Met",
      "type": "boolean"
    },
    "parameter_uncertainty_scope": {
      "const": "conditional_ols_given_fixed_covariates_and_model_form",
      "default": "conditional_ols_given_fixed_covariates_and_model_form",
      "title": "Parameter Uncertainty Scope",
      "type": "string"
    }
  },
  "required": [
    "model_id",
    "fit_id",
    "coefficient_log_m",
    "coefficient_temperature_per_10_K",
    "coefficient_relative_humidity_per_0_1",
    "coefficient_log1p_chloride",
    "coefficient_log1p_sulfur_dioxide",
    "coefficient_covariance",
    "residual_standard_deviation_log_m",
    "calibration_support_temperature_K",
    "calibration_support_relative_humidity_fraction",
    "calibration_support_chloride_mg_m2_day",
    "calibration_support_sulfur_dioxide_mg_m2_day",
    "calibration_observation_count",
    "calibration_source_group_ids",
    "calibration_input_digest",
    "holdout_observation_count",
    "holdout_log_rmse",
    "holdout_absolute_log_bias",
    "holdout_outside_support_fraction",
    "maximum_holdout_log_rmse",
    "maximum_absolute_holdout_log_bias",
    "maximum_holdout_outside_support_fraction",
    "transfer_criteria_met"
  ],
  "title": "AtmosphericFirstYearModel",
  "type": "object"
}