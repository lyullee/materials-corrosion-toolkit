{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.weld_procedure.v1",
      "default": "matintegrity.weld_procedure.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "procedure_id": {
      "minLength": 1,
      "title": "Procedure Id",
      "type": "string"
    },
    "qualification_record_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualification Record Id"
    },
    "process": {
      "minLength": 1,
      "title": "Process",
      "type": "string"
    },
    "base_material_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Base Material Ids",
      "type": "array"
    },
    "filler_material_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filler Material Id"
    },
    "parameters_si": {
      "additionalProperties": true,
      "title": "Parameters Si",
      "type": "object"
    },
    "qualified_domain": {
      "additionalProperties": true,
      "title": "Qualified Domain",
      "type": "object"
    },
    "qualification_ruleset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qualification Ruleset Id"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "procedure_id",
    "process",
    "base_material_ids",
    "parameters_si",
    "qualified_domain"
  ],
  "title": "WeldProcedureRecord",
  "type": "object"
}