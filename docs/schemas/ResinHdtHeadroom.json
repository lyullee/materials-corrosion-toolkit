{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "hdt_record_id": {
      "minLength": 1,
      "title": "Hdt Record Id",
      "type": "string"
    },
    "test_method_id": {
      "minLength": 1,
      "title": "Test Method Id",
      "type": "string"
    },
    "test_flexural_stress_Pa": {
      "exclusiveMinimum": 0,
      "title": "Test Flexural Stress Pa",
      "type": "number"
    },
    "heat_deflection_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Heat Deflection Temperature K",
      "type": "number"
    },
    "design_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Design Temperature K",
      "type": "number"
    },
    "required_headroom_K": {
      "minimum": 0,
      "title": "Required Headroom K",
      "type": "number"
    }
  },
  "required": [
    "basis",
    "material_condition_id",
    "hdt_record_id",
    "test_method_id",
    "test_flexural_stress_Pa",
    "heat_deflection_temperature_K",
    "design_temperature_K",
    "required_headroom_K"
  ],
  "title": "ResinHdtHeadroom",
  "type": "object"
}