      "maxItems": 10000,
      "minItems": 1,
      "title": "Candidate Planes",
      "type": "array"
    },
    "maximum_plane_pair_evaluations": {
      "default": 2000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Plane Pair Evaluations",
      "type": "integer"
    },
    "matched_material_endurance_data_reviewed": {
      "title": "Matched Material Endurance Data Reviewed",
      "type": "boolean"
    },
    "fully_reversed_smooth_specimen_basis_reviewed": {
