      "title": "Fully Reversed Torsion Limit Pa",
      "type": "number"
    },
    "sample_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 3,
      "title": "Sample Ids",
      "type": "array"
