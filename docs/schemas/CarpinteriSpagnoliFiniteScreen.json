      "type": "boolean"
    },
    "finite_plane_population_and_basis_reviewed": {
      "title": "Finite Plane Population And Basis Reviewed",
      "type": "boolean"
    },
    "hard_metal_hcf_scope_and_use_reviewed": {
      "title": "Hard Metal Hcf Scope And Use Reviewed",
      "type": "boolean"
    }
