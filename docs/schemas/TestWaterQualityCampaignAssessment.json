          "title": "Event Kind",
          "type": "string"
        },
        "state_definition": {
          "minLength": 1,
          "title": "State Definition",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "water_batch_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Water Batch Id"
        },
        "event_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Configuration Digest",
          "type": "string"
        },
        "event_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
