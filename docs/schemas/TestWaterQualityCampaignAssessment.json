          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "water_batch_id",
        "source_type_descriptor",
        "tank_id",
        "circuit_id",
        "circuit_scope_definition",
        "contacted_material_ids",
