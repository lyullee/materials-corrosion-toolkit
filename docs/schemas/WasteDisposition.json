{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "waste_record_id": {
      "minLength": 1,
      "title": "Waste Record Id",
      "type": "string"
    },
    "waste_stream_id": {
      "minLength": 1,
      "title": "Waste Stream Id",
      "type": "string"
    },
    "disposition_method_id": {
      "minLength": 1,
      "title": "Disposition Method Id",
      "type": "string"
    },
    "destination_id": {
      "minLength": 1,
      "title": "Destination Id",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "record_reviewed": {
      "title": "Record Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "waste_record_id",
    "waste_stream_id",
    "disposition_method_id",
    "destination_id",
    "manifest_digest",
    "record_reviewed",
    "evidence"
  ],
  "title": "WasteDisposition",
  "type": "object"
}