{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReplicaObservationCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "observation_kind": {
          "enum": [
            "grain",
            "cavity",
            "phase",
            "precipitate",
            "decarburization",
            "user_defined"
          ],
          "title": "Observation Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "result_mode": {
          "enum": [
            "quantitative",
            "qualitative"
          ],
          "title": "Result Mode",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_acceptable": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Acceptable"
        },
        "maximum_acceptable": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Acceptable"
        },
        "accepted_qualitative_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Accepted Qualitative Classes",
          "type": "array"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "observation_kind",
        "metric_id",
        "metric_definition",
        "result_mode",
        "unit_token",
        "criterion_basis",
        "evidence"
      ],
      "title": "ReplicaObservationCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "material_id": {
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "heat_id": {
      "minLength": 1,
      "title": "Heat Id",
      "type": "string"
    },
    "supported_replica_site_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Replica Site Ids",
      "type": "array"
    },
    "supported_environment_descriptor_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Environment Descriptor Ids",
      "type": "array"
    },
    "required_surface_preparation_id": {
      "minLength": 1,
      "title": "Required Surface Preparation Id",
      "type": "string"
    },
    "required_replication_medium_id": {
      "minLength": 1,
      "title": "Required Replication Medium Id",
      "type": "string"
    },
    "required_magnification": {
      "exclusiveMinimum": 0,
      "title": "Required Magnification",
      "type": "number"
    },
    "magnification_tolerance": {
      "minimum": 0,
      "title": "Magnification Tolerance",
      "type": "number"
    },
    "required_instrument_id": {
      "minLength": 1,
      "title": "Required Instrument Id",
      "type": "string"
    },
    "required_calibration_id": {
      "minLength": 1,
      "title": "Required Calibration Id",
      "type": "string"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/ReplicaObservationCriterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "minimum_valid_field_count": {
      "minimum": 1,
      "title": "Minimum Valid Field Count",
      "type": "integer"
    },
    "minimum_independence_group_count": {
      "minimum": 1,
      "title": "Minimum Independence Group Count",
      "type": "integer"
    },
    "caller_validity_policy_id": {
      "minLength": 1,
      "title": "Caller Validity Policy Id",
      "type": "string"
    },
    "profile_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Source Digest",
      "type": "string"
    },
    "built_in_grade_table_used": {
      "const": false,
      "default": false,
      "title": "Built In Grade Table Used",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_revision",
    "component_id",
    "material_id",
    "material_condition_id",
    "heat_id",
    "supported_replica_site_ids",
    "supported_environment_descriptor_ids",
    "required_surface_preparation_id",
    "required_replication_medium_id",
    "required_magnification",
    "magnification_tolerance",
    "required_instrument_id",
    "required_calibration_id",
    "criteria",
    "minimum_valid_field_count",
    "minimum_independence_group_count",
    "caller_validity_policy_id",
    "profile_source_digest",
    "evidence"
  ],
  "title": "ReplicaCampaignCallerProfile",
  "type": "object"
}