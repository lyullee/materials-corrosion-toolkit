{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One exact interval of caller-provided phase saturation ratios.",
  "properties": {
    "interval_id": {
      "minLength": 1,
      "title": "Interval Id",
      "type": "string"
    },
    "start_time_s": {
      "minimum": 0.0,
      "title": "Start Time S",
      "type": "number"
    },
    "end_time_s": {
      "exclusiveMinimum": 0,
      "title": "End Time S",
      "type": "number"
    },
    "temperature_K": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature K"
    },
    "saturation_ratio_by_phase": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 16,
      "minProperties": 2,
      "title": "Saturation Ratio By Phase",
      "type": "object"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "interval_id",
    "start_time_s",
    "end_time_s",
    "saturation_ratio_by_phase",
    "record_sha256",
    "evidence"
  ],
  "title": "NucleationSaturationInterval",
  "type": "object"
}