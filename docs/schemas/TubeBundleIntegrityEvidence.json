{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TubeBundleDispositionRecord": {
      "additionalProperties": false,
      "properties": {
        "disposition_id": {
          "minLength": 1,
          "title": "Disposition Id",
          "type": "string"
        },
        "disposition_kind": {
          "enum": [
            "repair",
            "plug",
            "retube",
            "monitor",
            "no_action"
          ],
          "title": "Disposition Kind",
          "type": "string"
        },
        "disposition_time_s": {
          "minimum": 0,
          "title": "Disposition Time S",
          "type": "number"
        },
        "caller_decision_record_id": {
          "minLength": 1,
          "title": "Caller Decision Record Id",
          "type": "string"
        },
        "affected_tube_id": {
          "minLength": 1,
          "title": "Affected Tube Id",
          "type": "string"
        },
        "record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "disposition_id",
        "disposition_kind",
        "disposition_time_s",
        "caller_decision_record_id",
        "affected_tube_id",
        "record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "TubeBundleDispositionRecord",
      "type": "object"
    },
    "TubeBundleIntegrityEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "tube_material_condition_id": {
          "minLength": 1,
          "title": "Tube Material Condition Id",
          "type": "string"
        },
        "minimum_outer_diameter_m": {
          "exclusiveMinimum": 0,
          "title": "Minimum Outer Diameter M",
          "type": "number"
        },
        "maximum_outer_diameter_m": {
          "exclusiveMinimum": 0,
          "title": "Maximum Outer Diameter M",
          "type": "number"
        },
        "minimum_wall_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Minimum Wall Thickness M",
          "type": "number"
        },
        "maximum_wall_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Maximum Wall Thickness M",
          "type": "number"
        },
        "supported_support_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Support Descriptors",
          "type": "array"
        },
        "supported_baffle_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Baffle Descriptors",
          "type": "array"
        },
        "supported_vibration_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Vibration Descriptors",
          "type": "array"
        },
        "supported_operating_state_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Operating State Ids",
          "type": "array"
        },
        "metric_support": {
          "items": {
            "$ref": "#/$defs/TubeBundleMetricSupport"
          },
          "minItems": 1,
          "title": "Metric Support",
          "type": "array"
        },
        "qualification_evidence": {
          "items": {
            "$ref": "#/$defs/TubeBundleQualificationEvidence"
          },
          "minItems": 1,
          "title": "Qualification Evidence",
          "type": "array"
        },
        "minimum_qualification_source_group_count": {
          "minimum": 1,
          "title": "Minimum Qualification Source Group Count",
          "type": "integer"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "tube_material_condition_id",
        "minimum_outer_diameter_m",
        "maximum_outer_diameter_m",
        "minimum_wall_thickness_m",
        "maximum_wall_thickness_m",
        "supported_support_descriptors",
        "supported_baffle_descriptors",
        "supported_vibration_descriptors",
        "supported_operating_state_ids",
        "metric_support",
        "qualification_evidence",
        "minimum_qualification_source_group_count",
        "qualification_basis",
        "evidence"
      ],
      "title": "TubeBundleIntegrityEnvelope",
      "type": "object"
    },
    "TubeBundleMetricSupport": {
      "additionalProperties": false,
      "properties": {
        "observation_kind": {
          "enum": [
            "defect_or_condition_inspection",
            "vibration_observation"
          ],
          "title": "Observation Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "supported_method_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Method Ids",
          "type": "array"
        },
        "minimum_supported_value": {
          "title": "Minimum Supported Value",
          "type": "number"
        },
        "maximum_supported_value": {
          "title": "Maximum Supported Value",
          "type": "number"
        },
        "maximum_supported_expanded_uncertainty": {
          "minimum": 0,
          "title": "Maximum Supported Expanded Uncertainty",
          "type": "number"
        },
        "support_basis": {
          "minLength": 1,
          "title": "Support Basis",
          "type": "string"
        }
      },
      "required": [
        "observation_kind",
        "metric_id",
        "unit_token",
        "supported_method_ids",
        "minimum_supported_value",
        "maximum_supported_value",
        "maximum_supported_expanded_uncertainty",
        "support_basis"
      ],
      "title": "TubeBundleMetricSupport",
      "type": "object"
    },
    "TubeBundleObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "observation_kind": {
          "enum": [
            "defect_or_condition_inspection",
            "vibration_observation"
          ],
          "title": "Observation Kind",
          "type": "string"
        },
        "physical_source_group_id": {
          "minLength": 1,
          "title": "Physical Source Group Id",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "reported_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Value"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "detection_status": {
          "enum": [
            "detected",
            "not_detected",
            "below_detection",
            "not_evaluated"
          ],
          "title": "Detection Status",
          "type": "string"
        },
        "detection_limit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Limit"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "observation_kind",
        "physical_source_group_id",
        "method_id",
        "metric_id",
        "metric_definition",
        "unit_token",
        "detection_status",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "TubeBundleObservation",
      "type": "object"
    },
    "TubeBundleOperatingInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
