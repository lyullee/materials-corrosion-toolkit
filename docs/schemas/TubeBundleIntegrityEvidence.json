        "operating_state_id": {
          "minLength": 1,
          "title": "Operating State Id",
          "type": "string"
        },
        "record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "operating_state_id",
        "record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "TubeBundleOperatingInterval",
      "type": "object"
    },
    "TubeBundleQualificationEvidence": {
      "additionalProperties": false,
