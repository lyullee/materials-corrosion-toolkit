{
  "$defs": {
    "AreaUniformFibonacciPlaneGrid": {
      "additionalProperties": false,
      "description": "Area-stratified golden-angle candidates for unoriented material planes.",
      "properties": {
        "grid_id": {
          "minLength": 1,
          "title": "Grid Id",
          "type": "string"
        },
        "candidate_count": {
          "minimum": 4,
          "title": "Candidate Count",
          "type": "integer"
        },
        "azimuth_phase_rad": {
          "default": 0.0,
          "exclusiveMaximum": 6.283185307179586,
          "minimum": 0.0,
          "title": "Azimuth Phase Rad",
          "type": "number"
        }
      },
      "required": [
        "grid_id",
        "candidate_count"
      ],
      "title": "AreaUniformFibonacciPlaneGrid",
      "type": "object"
    },
    "HemispherePlaneGrid": {
      "additionalProperties": false,
      "description": "Deterministic angular candidate grid for unoriented material planes.",
      "properties": {
        "grid_id": {
          "minLength": 1,
          "title": "Grid Id",
          "type": "string"
        },
        "polar_divisions": {
          "minimum": 1,
          "title": "Polar Divisions",
          "type": "integer"
        },
        "azimuthal_divisions": {
          "minimum": 4,
          "title": "Azimuthal Divisions",
          "type": "integer"
        }
      },
      "required": [
        "grid_id",
        "polar_divisions",
        "azimuthal_divisions"
      ],
      "title": "HemispherePlaneGrid",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One tensor cycle evaluated on declared latitude and/or Fibonacci grids.",
  "properties": {
    "history_id": {
      "minLength": 1,
      "title": "History Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "tensor_source_id": {
      "minLength": 1,
      "title": "Tensor Source Id",
      "type": "string"
    },
    "sample_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "title": "Sample Ids",
      "type": "array"
    },
    "stress_tensor_components_Pa": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "minItems": 3,
      "title": "Stress Tensor Components Pa",
      "type": "array"
    },
    "strain_tensor_components": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "minItems": 3,
      "title": "Strain Tensor Components",
      "type": "array"
    },
    "grid_definitions": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/HemispherePlaneGrid"
          },
          {
            "$ref": "#/$defs/AreaUniformFibonacciPlaneGrid"
          }
        ]
      },
      "minItems": 2,
      "title": "Grid Definitions",
      "type": "array"
    },
    "reference_grid_id": {
      "minLength": 1,
      "title": "Reference Grid Id",
      "type": "string"
    },
    "representative_cycle_declared": {
      "title": "Representative Cycle Declared",
      "type": "boolean"
    },
    "maximum_stress_closure_error_Pa": {
      "minimum": 0,
      "title": "Maximum Stress Closure Error Pa",
      "type": "number"
    },
    "maximum_strain_closure_error": {
      "minimum": 0,
      "title": "Maximum Strain Closure Error",
      "type": "number"
    },
    "fatemi_socie_coefficient": {
      "minimum": 0,
      "title": "Fatemi Socie Coefficient",
      "type": "number"
    },
    "normalization_stress_Pa": {
      "exclusiveMinimum": 0,
      "title": "Normalization Stress Pa",
      "type": "number"
    },
    "declared_maximum_relative_factor_change": {
      "minimum": 0,
      "title": "Declared Maximum Relative Factor Change",
      "type": "number"
    },
    "declared_maximum_plane_rotation_rad": {
      "maximum": 1.5707963267948966,
      "minimum": 0.0,
      "title": "Declared Maximum Plane Rotation Rad",
      "type": "number"
    }
  },
  "required": [
    "history_id",
    "material_condition_id",
    "location_id",
    "tensor_source_id",
    "sample_ids",
    "stress_tensor_components_Pa",
    "strain_tensor_components",
    "grid_definitions",
    "reference_grid_id",
    "representative_cycle_declared",
    "maximum_stress_closure_error_Pa",
    "maximum_strain_closure_error",
    "fatemi_socie_coefficient",
    "normalization_stress_Pa",
    "declared_maximum_relative_factor_change",
    "declared_maximum_plane_rotation_rad"
  ],
  "title": "CriticalPlaneGridFamilyComparison",
  "type": "object"
}