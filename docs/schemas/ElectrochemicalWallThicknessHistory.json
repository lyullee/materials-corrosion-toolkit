{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "ErosionCorrosionWallThicknessBaseline": {
      "additionalProperties": false,
      "description": "Digest-linked wall measurement and caller minimum-thickness limit.",
      "properties": {
        "baseline_id": {
          "minLength": 1,
          "title": "Baseline Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "geometry_condition_id": {
          "minLength": 1,
          "title": "Geometry Condition Id",
          "type": "string"
        },
        "baseline_time_s": {
          "minimum": 0,
          "title": "Baseline Time S",
          "type": "number"
        },
        "measured_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Measured Thickness M",
          "type": "number"
        },
        "required_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Required Thickness M",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "baseline_id",
        "provider_id",
        "provider_revision",
        "record_sha256",
        "asset_id",
        "location_id",
        "physical_scope_id",
        "material_condition_id",
        "geometry_condition_id",
        "baseline_time_s",
        "measured_thickness_m",
        "required_thickness_m",
        "evidence"
      ],
      "title": "ErosionCorrosionWallThicknessBaseline",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic gross-anodic loss projection for one reviewed wall area.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.electrochemical_wall_thickness_history.v1",
      "default": "matintegrity.electrochemical_wall_thickness_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "metal_loss_result": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "metal_loss_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Metal Loss Result Sha256",
      "type": "string"
    },
    "baseline": {
      "$ref": "#/$defs/ErosionCorrosionWallThicknessBaseline"
    },
    "assessed_wall_area_m2": {
      "exclusiveMinimum": 0,
      "title": "Assessed Wall Area M2",
      "type": "number"
    },
    "effective_density_kg_m3": {
      "exclusiveMinimum": 0,
      "title": "Effective Density Kg M3",
      "type": "number"
    },
    "wall_area_relative_tolerance": {
      "maximum": 0.1,
      "minimum": 0.0,
      "title": "Wall Area Relative Tolerance",
      "type": "number"
    },
    "density_provider_id": {
      "minLength": 1,
      "title": "Density Provider Id",
      "type": "string"
    },
    "density_provider_revision": {
      "minLength": 1,
      "title": "Density Provider Revision",
      "type": "string"
    },
    "density_record_id": {
      "minLength": 1,
      "title": "Density Record Id",
      "type": "string"
    },
    "density_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Density Record Sha256",
      "type": "string"
    },
    "density_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Density Evidence",
      "type": "array"
    },
    "material_to_effective_density_reviewed": {
      "title": "Material To Effective Density Reviewed",
      "type": "boolean"
    },
    "complete_reaction_set_reviewed": {
      "title": "Complete Reaction Set Reviewed",
      "type": "boolean"
    },
    "common_wall_area_mapping_reviewed": {
      "title": "Common Wall Area Mapping Reviewed",
      "type": "boolean"
    },
    "anodic_only_noncrediting_projection_reviewed": {
      "title": "Anodic Only Noncrediting Projection Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "metal_loss_result",
    "metal_loss_result_sha256",
    "baseline",
    "assessed_wall_area_m2",
    "effective_density_kg_m3",
    "wall_area_relative_tolerance",
    "density_provider_id",
    "density_provider_revision",
    "density_record_id",
    "density_record_sha256",
    "density_evidence",
    "material_to_effective_density_reviewed",
    "complete_reaction_set_reviewed",
    "common_wall_area_mapping_reviewed",
    "anodic_only_noncrediting_projection_reviewed",
    "computational_use_authorized"
  ],
  "title": "ElectrochemicalWallThicknessHistory",
  "type": "object"
}