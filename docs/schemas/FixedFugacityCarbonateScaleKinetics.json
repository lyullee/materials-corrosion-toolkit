{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "CallerSpeciesActivityRecord": {
      "additionalProperties": false,
      "description": "Explicit dimensionless activity for a non-carbonate species at one knot.",
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "dimensionless_activity": {
          "exclusiveMinimum": 0,
          "title": "Dimensionless Activity",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "species_id",
        "dimensionless_activity",
        "provider_id",
        "provider_revision",
        "record_id",
        "sha256",
        "evidence"
      ],
      "title": "CallerSpeciesActivityRecord",
      "type": "object"
    },
    "CallerSurfaceScaleKinetics": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.caller_surface_scale_kinetics.v1",
          "default": "matintegrity.caller_surface_scale_kinetics.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "substrate_condition_id": {
          "minLength": 1,
          "title": "Substrate Condition Id",
          "type": "string"
        },
        "solution_condition_id": {
          "minLength": 1,
          "title": "Solution Condition Id",
          "type": "string"
        },
        "scale_phase_id": {
          "minLength": 1,
          "title": "Scale Phase Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "condition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Condition Sha256",
          "type": "string"
        },
        "kinetic_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Kinetic Configuration Sha256",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "initial_scale_thickness_m": {
          "minimum": 0,
          "title": "Initial Scale Thickness M",
          "type": "number"
        },
        "precipitation_rate_constant_mol_m2_s": {
          "minimum": 0,
          "title": "Precipitation Rate Constant Mol M2 S",
          "type": "number"
        },
        "rate_reference_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Reference Temperature K"
        },
        "minimum_rate_valid_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Rate Valid Temperature K"
        },
        "maximum_rate_valid_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Rate Valid Temperature K"
        },
        "precipitation_activation_energy_J_mol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precipitation Activation Energy J Mol"
        },
        "precipitation_order": {
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "title": "Precipitation Order",
          "type": "number"
        },
        "dissolution_rate_constant_mol_m2_s": {
          "minimum": 0,
          "title": "Dissolution Rate Constant Mol M2 S",
          "type": "number"
        },
        "dissolution_activation_energy_J_mol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dissolution Activation Energy J Mol"
        },
        "dissolution_order": {
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "title": "Dissolution Order",
          "type": "number"
        },
        "scale_molar_volume_m3_mol": {
          "exclusiveMinimum": 0,
          "title": "Scale Molar Volume M3 Mol",
          "type": "number"
        },
        "intervals": {
          "items": {
            "$ref": "#/$defs/SurfaceScaleKineticInterval"
          },
          "maxItems": 100000,
          "minItems": 1,
          "title": "Intervals",
          "type": "array"
        },
        "interval_constant_saturation_reviewed": {
          "default": false,
          "title": "Interval Constant Saturation Reviewed",
          "type": "boolean"
        },
        "linearly_varying_saturation_reviewed": {
          "default": false,
          "title": "Linearly Varying Saturation Reviewed",
          "type": "boolean"
        },
        "interval_temperature_profile_reviewed": {
          "default": false,
          "title": "Interval Temperature Profile Reviewed",
          "type": "boolean"
        },
        "arrhenius_temperature_scaling_reviewed": {
          "default": false,
          "title": "Arrhenius Temperature Scaling Reviewed",
          "type": "boolean"
        },
        "supersaturation_kinetics_and_standard_state_reviewed": {
          "title": "Supersaturation Kinetics And Standard State Reviewed",
          "type": "boolean"
        },
        "precipitation_and_dissolution_coefficients_reviewed": {
          "title": "Precipitation And Dissolution Coefficients Reviewed",
          "type": "boolean"
        },
        "scale_phase_identity_and_molar_volume_reviewed": {
          "title": "Scale Phase Identity And Molar Volume Reviewed",
          "type": "boolean"
        },
        "single_uniform_scale_layer_scope_reviewed": {
          "title": "Single Uniform Scale Layer Scope Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "physical_scope_id",
        "substrate_condition_id",
        "solution_condition_id",
        "scale_phase_id",
        "physical_specimen_id",
        "source_group_id",
        "provider_id",
        "provider_revision",
        "source_sha256",
        "condition_sha256",
        "kinetic_configuration_sha256",
        "temperature_K",
        "initial_scale_thickness_m",
        "precipitation_rate_constant_mol_m2_s",
        "precipitation_order",
        "dissolution_rate_constant_mol_m2_s",
        "dissolution_order",
        "scale_molar_volume_m3_mol",
        "intervals",
        "supersaturation_kinetics_and_standard_state_reviewed",
        "precipitation_and_dissolution_coefficients_reviewed",
        "scale_phase_identity_and_molar_volume_reviewed",
        "single_uniform_scale_layer_scope_reviewed",
        "computational_use_authorized",
        "evidence"
      ],
      "title": "CallerSurfaceScaleKinetics",
      "type": "object"
    },
    "CarbonateActivityCoefficientRecord": {
      "additionalProperties": false,
      "description": "Caller activity coefficient for one carbonate species at one exact knot.",
      "properties": {
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "value",
        "provider_id",
        "provider_revision",
        "record_id",
        "sha256",
        "evidence"
      ],
      "title": "CarbonateActivityCoefficientRecord",
      "type": "object"
    },
    "CarbonateKspKnotRecord": {
      "additionalProperties": false,
      "description": "Caller-supplied temperature-supported solubility product at one source knot.",
      "properties": {
        "log10_solubility_product": {
          "title": "Log10 Solubility Product",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "temperature_support_min_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature Support Min K",
          "type": "number"
        },
        "temperature_support_max_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature Support Max K",
          "type": "number"
        },
        "temperature_applicability_reviewed": {
          "title": "Temperature Applicability Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "log10_solubility_product",
        "provider_id",
        "provider_revision",
        "record_id",
        "sha256",
        "temperature_support_min_K",
        "temperature_support_max_K",
        "temperature_applicability_reviewed",
        "evidence"
      ],
      "title": "CarbonateKspKnotRecord",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FixedFugacityCarbonateScaleKnot": {
      "additionalProperties": false,
      "description": "Supporting caller activity and Ksp records aligned to one exact carbonate knot.",
      "properties": {
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "carbonate_activity_coefficient": {
          "$ref": "#/$defs/CarbonateActivityCoefficientRecord"
        },
        "other_species_activities": {
          "items": {
            "$ref": "#/$defs/CallerSpeciesActivityRecord"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Other Species Activities",
          "type": "array"
        },
        "solubility_product": {
          "$ref": "#/$defs/CarbonateKspKnotRecord"
        }
      },
      "required": [
        "time_s",
        "carbonate_activity_coefficient",
        "other_species_activities",
        "solubility_product"
      ],
      "title": "FixedFugacityCarbonateScaleKnot",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    },
    "SaturationScreenTerm": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "stoichiometric_exponent": {
          "exclusiveMinimum": 0,
          "title": "Stoichiometric Exponent",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "stoichiometric_exponent"
      ],
      "title": "SaturationScreenTerm",
      "type": "object"
    },
    "SurfaceScaleKineticInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "saturation_ratio": {
          "minimum": 0,
          "title": "Saturation Ratio",
          "type": "number"
        },
        "saturation_ratio_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saturation Ratio End"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "saturation_ratio"
      ],
      "title": "SurfaceScaleKineticInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evaluate a caller scale law using exact carbonate-history saturation screens.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.fixed_fugacity_carbonate_scale_kinetics.v1",
      "default": "matintegrity.fixed_fugacity_carbonate_scale_kinetics.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "fixed_fugacity_carbonate_history": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "fixed_fugacity_carbonate_history_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Fixed Fugacity Carbonate History Sha256",
      "type": "string"
    },
    "carbonate_species_id": {
      "minLength": 1,
      "title": "Carbonate Species Id",
      "type": "string"
    },
    "selected_solid_id": {
      "minLength": 1,
      "title": "Selected Solid Id",
      "type": "string"
    },
    "scale_phase_mapping_reviewed": {
      "title": "Scale Phase Mapping Reviewed",
      "type": "boolean"
    },
    "solid_terms": {
      "items": {
        "$ref": "#/$defs/SaturationScreenTerm"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Solid Terms",
      "type": "array"
    },
    "knots": {
      "items": {
        "$ref": "#/$defs/FixedFugacityCarbonateScaleKnot"
      },
      "maxItems": 100000,
      "minItems": 2,
      "title": "Knots",
      "type": "array"
    },
    "carbonate_activity_and_standard_state_reviewed": {
      "title": "Carbonate Activity And Standard State Reviewed",
      "type": "boolean"
    },
    "complete_knot_species_inventory_reviewed": {
      "title": "Complete Knot Species Inventory Reviewed",
      "type": "boolean"
    },
    "solubility_temperature_support_reviewed": {
      "title": "Solubility Temperature Support Reviewed",
      "type": "boolean"
    },
    "saturation_path_interpolation_reviewed": {
      "title": "Saturation Path Interpolation Reviewed",
      "type": "boolean"
    },
    "caller_kinetic_law_scope_and_coefficients_reviewed": {
      "title": "Caller Kinetic Law Scope And Coefficients Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "kinetics_template": {
      "$ref": "#/$defs/CallerSurfaceScaleKinetics"
    }
  },
  "required": [
    "assessment_id",
    "fixed_fugacity_carbonate_history",
    "fixed_fugacity_carbonate_history_sha256",
    "carbonate_species_id",
    "selected_solid_id",
    "scale_phase_mapping_reviewed",
    "solid_terms",
    "knots",
    "carbonate_activity_and_standard_state_reviewed",
    "complete_knot_species_inventory_reviewed",
    "solubility_temperature_support_reviewed",
    "saturation_path_interpolation_reviewed",
    "caller_kinetic_law_scope_and_coefficients_reviewed",
    "computational_use_authorized",
    "kinetics_template"
  ],
  "title": "FixedFugacityCarbonateScaleKinetics",
  "type": "object"
}