{
  "$defs": {
    "ActivityCoefficientKnot": {
      "additionalProperties": false,
      "description": "Caller-supplied activity coefficients in the reference species order.",
      "properties": {
        "activity_coefficients": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Activity Coefficients",
          "type": "array"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Sha256",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "activity_coefficients",
        "provider_id",
        "provider_revision",
        "provider_configuration_sha256",
        "source_record_id",
        "evidence"
      ],
      "title": "ActivityCoefficientKnot",
      "type": "object"
    },
    "AqueousActivitySpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "charge_number": {
          "maximum": 8,
          "minimum": -8,
          "title": "Charge Number",
          "type": "integer"
        },
        "activity_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Activity Coefficient",
          "type": "number"
        },
        "initial_activity": {
          "exclusiveMinimum": 0,
          "title": "Initial Activity",
          "type": "number"
        },
        "elemental_composition": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elemental Composition"
        }
      },
      "required": [
        "species_id",
        "charge_number",
        "activity_coefficient",
        "initial_activity"
      ],
      "title": "AqueousActivitySpecies",
      "type": "object"
    },
    "AqueousEquilibriumReaction": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "log10_equilibrium_constant": {
          "title": "Log10 Equilibrium Constant",
          "type": "number"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/AqueousStoichiometricTerm"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "reaction_id",
        "log10_equilibrium_constant",
        "terms"
      ],
      "title": "AqueousEquilibriumReaction",
      "type": "object"
    },
    "AqueousLinearConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "target_mol_L": {
          "title": "Target Mol L",
          "type": "number"
        },
        "residual_scale_mol_L": {
          "exclusiveMinimum": 0,
          "title": "Residual Scale Mol L",
          "type": "number"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/AqueousStoichiometricTerm"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "constraint_id",
        "target_mol_L",
        "residual_scale_mol_L",
        "terms"
      ],
      "title": "AqueousLinearConstraint",
      "type": "object"
    },
    "AqueousMassActionSystem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.aqueous_mass_action.v1",
          "default": "matintegrity.aqueous_mass_action.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "solution_id": {
          "minLength": 1,
          "title": "Solution Id",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "activity_standard_state": {
          "const": "molarity_1_mol_L",
          "title": "Activity Standard State",
          "type": "string"
        },
        "species": {
          "items": {
            "$ref": "#/$defs/AqueousActivitySpecies"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Species",
          "type": "array"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/AqueousEquilibriumReaction"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Reactions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/AqueousLinearConstraint"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Constraints",
          "type": "array"
        },
        "maximum_iterations": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "normalized_residual_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "maximum": 0.0001,
          "title": "Normalized Residual Tolerance",
          "type": "number"
        },
        "maximum_jacobian_condition_number": {
          "default": 100000000000000.0,
          "exclusiveMinimum": 0,
          "maximum": 1e+16,
          "title": "Maximum Jacobian Condition Number",
          "type": "number"
        },
        "local_parameter_covariance": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Parameter Covariance"
        },
        "local_parameter_covariance_reviewed": {
          "default": false,
          "title": "Local Parameter Covariance Reviewed",
          "type": "boolean"
        },
        "activity_provider_id": {
          "minLength": 1,
          "title": "Activity Provider Id",
          "type": "string"
        },
        "activity_provider_revision": {
          "minLength": 1,
          "title": "Activity Provider Revision",
          "type": "string"
        },
        "activity_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Activity Configuration Digest",
          "type": "string"
        },
        "activity_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Activity Record Digest",
          "type": "string"
        },
        "equilibrium_provider_id": {
          "minLength": 1,
          "title": "Equilibrium Provider Id",
          "type": "string"
        },
        "equilibrium_provider_revision": {
          "minLength": 1,
          "title": "Equilibrium Provider Revision",
          "type": "string"
        },
        "equilibrium_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Configuration Digest",
          "type": "string"
        },
        "equilibrium_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Record Digest",
          "type": "string"
        },
        "complete_aqueous_species_inventory_reviewed": {
          "title": "Complete Aqueous Species Inventory Reviewed",
          "type": "boolean"
        },
        "reaction_stoichiometry_and_constant_reviewed": {
          "title": "Reaction Stoichiometry And Constant Reviewed",
          "type": "boolean"
        },
        "balance_constraints_and_charge_scope_reviewed": {
          "title": "Balance Constraints And Charge Scope Reviewed",
          "type": "boolean"
        },
        "fixed_activity_coefficients_and_standard_state_reviewed": {
          "title": "Fixed Activity Coefficients And Standard State Reviewed",
          "type": "boolean"
        },
        "temperature_and_provider_lineage_reviewed": {
          "title": "Temperature And Provider Lineage Reviewed",
          "type": "boolean"
        },
        "initial_activity_guess_and_solver_tolerance_reviewed": {
          "title": "Initial Activity Guess And Solver Tolerance Reviewed",
          "type": "boolean"
        },
        "single_liquid_phase_and_no_precipitation_reviewed": {
          "title": "Single Liquid Phase And No Precipitation Reviewed",
          "type": "boolean"
        },
        "elemental_formula_and_reaction_balance_reviewed": {
          "default": false,
          "title": "Elemental Formula And Reaction Balance Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "solution_id",
        "temperature_K",
        "activity_standard_state",
        "species",
        "reactions",
        "constraints",
        "activity_provider_id",
        "activity_provider_revision",
        "activity_configuration_digest",
        "activity_record_digest",
        "equilibrium_provider_id",
        "equilibrium_provider_revision",
        "equilibrium_configuration_digest",
        "equilibrium_record_digest",
        "complete_aqueous_species_inventory_reviewed",
        "reaction_stoichiometry_and_constant_reviewed",
        "balance_constraints_and_charge_scope_reviewed",
        "fixed_activity_coefficients_and_standard_state_reviewed",
        "temperature_and_provider_lineage_reviewed",
        "initial_activity_guess_and_solver_tolerance_reviewed",
        "single_liquid_phase_and_no_precipitation_reviewed",
        "evidence"
      ],
      "title": "AqueousMassActionSystem",
      "type": "object"
    },
    "AqueousStoichiometricTerm": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "coefficient"
      ],
      "title": "AqueousStoichiometricTerm",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReactionEnthalpyReference": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "delta_h_reference_J_mol": {
          "title": "Delta H Reference J Mol",
          "type": "number"
        },
        "delta_cp_reference_J_mol_K": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Cp Reference J Mol K"
        },
        "delta_cp_slope_J_mol_K2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Cp Slope J Mol K2"
        },
        "minimum_valid_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Valid Temperature K",
          "type": "number"
        },
        "maximum_valid_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Valid Temperature K",
          "type": "number"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "reaction_id",
        "delta_h_reference_J_mol",
        "minimum_valid_temperature_K",
        "maximum_valid_temperature_K",
        "source_record_id",
        "evidence"
      ],
      "title": "ReactionEnthalpyReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "history_id": {
      "minLength": 1,
      "title": "History Id",
      "type": "string"
    },
    "reference_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Reference Temperature K",
      "type": "number"
    },
    "reaction_enthalpy_standard_state": {
      "const": "same_as_mass_action_equilibrium_standard_state",
      "title": "Reaction Enthalpy Standard State",
      "type": "string"
    },
    "times_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Times S",
      "type": "array"
    },
    "temperatures_K": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Temperatures K",
      "type": "array"
    },
    "mass_action_system_at_reference": {
      "$ref": "#/$defs/AqueousMassActionSystem"
    },
    "reaction_enthalpies": {
      "items": {
        "$ref": "#/$defs/ReactionEnthalpyReference"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Reaction Enthalpies",
      "type": "array"
    },
    "activity_coefficients_by_knot": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ActivityCoefficientKnot"
          },
          "maxItems": 1000,
          "minItems": 2,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activity Coefficients By Knot"
    },
    "maximum_absolute_log10_equilibrium_constant": {
      "default": 300.0,
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Maximum Absolute Log10 Equilibrium Constant",
      "type": "number"
    },
    "reaction_thermochemistry_temperature_model_reviewed": {
      "title": "Reaction Thermochemistry Temperature Model Reviewed",
      "type": "boolean"
    },
    "constant_reaction_heat_capacity_change_reviewed": {
      "default": false,
      "title": "Constant Reaction Heat Capacity Change Reviewed",
      "type": "boolean"
    },
    "temperature_dependent_reaction_heat_capacity_reviewed": {
      "default": false,
      "title": "Temperature Dependent Reaction Heat Capacity Reviewed",
      "type": "boolean"
    },
    "fixed_activity_coefficients_temperature_applicability_reviewed": {
      "title": "Fixed Activity Coefficients Temperature Applicability Reviewed",
      "type": "boolean"
    },
    "activity_coefficient_temperature_history_reviewed": {
      "default": false,
      "title": "Activity Coefficient Temperature History Reviewed",
      "type": "boolean"
    },
    "temperature_support_and_time_mapping_reviewed": {
      "title": "Temperature Support And Time Mapping Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "history_id",
    "reference_temperature_K",
    "reaction_enthalpy_standard_state",
    "times_s",
    "temperatures_K",
    "mass_action_system_at_reference",
    "reaction_enthalpies",
    "reaction_thermochemistry_temperature_model_reviewed",
    "fixed_activity_coefficients_temperature_applicability_reviewed",
    "temperature_support_and_time_mapping_reviewed",
    "computational_use_authorized"
  ],
  "title": "AqueousMassActionVanTHoffHistory",
  "type": "object"
}