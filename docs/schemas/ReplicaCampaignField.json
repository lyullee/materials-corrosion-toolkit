{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReplicaAcquisitionConfiguration": {
      "additionalProperties": false,
      "properties": {
        "surface_preparation_id": {
          "minLength": 1,
          "title": "Surface Preparation Id",
          "type": "string"
        },
        "surface_preparation_definition": {
          "minLength": 1,
          "title": "Surface Preparation Definition",
          "type": "string"
        },
        "replication_medium_id": {
          "minLength": 1,
          "title": "Replication Medium Id",
          "type": "string"
        },
        "replication_medium_lot_id": {
          "minLength": 1,
          "title": "Replication Medium Lot Id",
          "type": "string"
        },
        "magnification": {
          "exclusiveMinimum": 0,
          "title": "Magnification",
          "type": "number"
        },
        "magnification_unit_token": {
          "const": "1",
          "default": "1",
          "title": "Magnification Unit Token",
          "type": "string"
        },
        "instrument_id": {
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "instrument_revision": {
          "minLength": 1,
          "title": "Instrument Revision",
          "type": "string"
        },
        "instrument_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Instrument Configuration Digest",
          "type": "string"
        },
        "calibration_id": {
          "minLength": 1,
          "title": "Calibration Id",
          "type": "string"
        },
        "calibration_revision": {
          "minLength": 1,
          "title": "Calibration Revision",
          "type": "string"
        },
        "calibration_status": {
          "enum": [
            "valid",
            "invalid",
            "missing"
          ],
          "title": "Calibration Status",
          "type": "string"
        },
        "calibration_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Record Digest",
          "type": "string"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "surface_preparation_id",
        "surface_preparation_definition",
        "replication_medium_id",
        "replication_medium_lot_id",
        "magnification",
        "instrument_id",
        "instrument_revision",
        "instrument_configuration_digest",
        "calibration_id",
        "calibration_revision",
        "calibration_status",
        "calibration_record_digest",
        "evidence"
      ],
      "title": "ReplicaAcquisitionConfiguration",
      "type": "object"
    },
    "ReplicaCampaignObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "observation_kind": {
          "enum": [
            "grain",
            "cavity",
            "phase",
            "precipitate",
            "decarburization",
            "user_defined"
          ],
          "title": "Observation Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "result_mode": {
          "enum": [
            "quantitative",
            "qualitative"
          ],
          "title": "Result Mode",
          "type": "string"
        },
        "status": {
          "enum": [
            "reported",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "qualitative_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualitative Class"
        },
        "qualitative_uncertainty_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualitative Uncertainty Basis"
        },
        "observer_id": {
          "minLength": 1,
          "title": "Observer Id",
          "type": "string"
        },
        "observation_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observation Record Digest",
          "type": "string"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "observation_kind",
        "metric_id",
        "metric_definition",
        "result_mode",
        "status",
        "unit_token",
        "observer_id",
        "observation_record_digest",
        "evidence"
      ],
      "title": "ReplicaCampaignObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "field_id": {
      "minLength": 1,
      "title": "Field Id",
      "type": "string"
    },
    "replica_id": {
      "minLength": 1,
      "title": "Replica Id",
      "type": "string"
    },
    "replica_site_id": {
      "minLength": 1,
      "title": "Replica Site Id",
      "type": "string"
    },
    "sequence_index": {
      "minimum": 0,
      "title": "Sequence Index",
      "type": "integer"
    },
    "configuration": {
      "$ref": "#/$defs/ReplicaAcquisitionConfiguration"
    },
    "image_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Image Digest",
      "type": "string"
    },
    "field_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Field Record Digest",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ReplicaCampaignObservation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "replicate_group_id": {
      "minLength": 1,
      "title": "Replicate Group Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "independence_group_id": {
      "minLength": 1,
      "title": "Independence Group Id",
      "type": "string"
    },
    "caller_validity_status": {
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ],
      "title": "Caller Validity Status",
      "type": "string"
    },
    "caller_validity_basis": {
      "minLength": 1,
      "title": "Caller Validity Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "field_id",
    "replica_id",
    "replica_site_id",
    "sequence_index",
    "configuration",
    "image_digest",
    "field_record_digest",
    "observations",
    "replicate_group_id",
    "source_group_id",
    "independence_group_id",
    "caller_validity_status",
    "caller_validity_basis",
    "evidence"
  ],
  "title": "ReplicaCampaignField",
  "type": "object"
}