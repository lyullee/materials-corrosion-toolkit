{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SolidificationCrackingQualificationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "weld_metal_condition_id": {
          "minLength": 1,
          "title": "Weld Metal Condition Id",
          "type": "string"
        },
        "welding_process_id": {
          "minLength": 1,
          "title": "Welding Process Id",
          "type": "string"
        },
        "consumable_classification_id": {
          "minLength": 1,
          "title": "Consumable Classification Id",
          "type": "string"
        },
        "chemistry_basis_id": {
          "minLength": 1,
          "title": "Chemistry Basis Id",
          "type": "string"
        },
        "supported_chemistry_profile_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Chemistry Profile Ids",
          "type": "array"
        },
        "supported_thermal_history_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Thermal History Descriptors",
          "type": "array"
        },
        "supported_strain_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Strain Descriptors",
          "type": "array"
        },
        "supported_restraint_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Restraint Descriptors",
          "type": "array"
        },
        "result_definition": {
          "minLength": 1,
          "title": "Result Definition",
          "type": "string"
        },
        "result_unit_token": {
          "minLength": 1,
          "title": "Result Unit Token",
          "type": "string"
        },
        "minimum_physical_specimen_count": {
          "minimum": 1,
          "title": "Minimum Physical Specimen Count",
          "type": "integer"
        },
        "minimum_source_group_count": {
          "minimum": 1,
          "title": "Minimum Source Group Count",
          "type": "integer"
        },
        "test_evidence": {
          "items": {
            "$ref": "#/$defs/SolidificationCrackingTestEvidence"
          },
          "minItems": 1,
          "title": "Test Evidence",
          "type": "array"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "weld_metal_condition_id",
        "welding_process_id",
        "consumable_classification_id",
        "chemistry_basis_id",
        "supported_chemistry_profile_ids",
        "supported_thermal_history_descriptors",
        "supported_strain_descriptors",
        "supported_restraint_descriptors",
        "result_definition",
        "result_unit_token",
        "minimum_physical_specimen_count",
        "minimum_source_group_count",
        "test_evidence",
        "qualification_basis",
        "evidence"
      ],
      "title": "SolidificationCrackingQualificationEnvelope",
      "type": "object"
    },
    "SolidificationCrackingTestEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_record_id": {
          "minLength": 1,
          "title": "Evidence Record Id",
          "type": "string"
        },
        "qualification_test_id": {
          "minLength": 1,
          "title": "Qualification Test Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
