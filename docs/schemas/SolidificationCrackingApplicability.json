        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "weld_metal_condition_id": {
          "minLength": 1,
          "title": "Weld Metal Condition Id",
          "type": "string"
        },
        "welding_process_id": {
          "minLength": 1,
          "title": "Welding Process Id",
          "type": "string"
        },
        "consumable_classification_id": {
          "minLength": 1,
          "title": "Consumable Classification Id",
          "type": "string"
        },
        "chemistry_profile_id": {
          "minLength": 1,
          "title": "Chemistry Profile Id",
          "type": "string"
        },
        "test_method_id": {
          "minLength": 1,
          "title": "Test Method Id",
          "type": "string"
        },
        "result_definition": {
          "minLength": 1,
          "title": "Result Definition",
          "type": "string"
        },
        "result_value": {
          "title": "Result Value",
          "type": "number"
        },
        "result_unit_token": {
          "minLength": 1,
          "title": "Result Unit Token",
          "type": "string"
        },
        "expanded_uncertainty": {
          "minimum": 0,
          "title": "Expanded Uncertainty",
          "type": "number"
        },
        "uncertainty_coverage_factor": {
          "exclusiveMinimum": 0,
          "title": "Uncertainty Coverage Factor",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "supports_declared_envelope": {
          "title": "Supports Declared Envelope",
          "type": "boolean"
        },
        "invalid_or_limiting_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Limiting Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "evidence_record_id",
        "qualification_test_id",
        "physical_specimen_id",
        "source_group_id",
        "weld_metal_condition_id",
        "welding_process_id",
        "consumable_classification_id",
        "chemistry_profile_id",
        "test_method_id",
        "result_definition",
        "result_value",
        "result_unit_token",
        "expanded_uncertainty",
        "uncertainty_coverage_factor",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "provider_configuration_digest",
        "input_digest",
        "result_digest",
        "record_valid",
        "supports_declared_envelope",
        "evidence"
      ],
      "title": "SolidificationCrackingTestEvidence",
      "type": "object"
    }
  },
