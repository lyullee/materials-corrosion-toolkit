{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    },
    "TensorComponentBinding": {
      "additionalProperties": false,
      "properties": {
        "tensor_component": {
          "enum": [
            "xx",
            "yy",
            "zz",
            "xy",
            "yz",
            "zx"
          ],
          "title": "Tensor Component",
          "type": "string"
        },
        "provider_component_id": {
          "minLength": 1,
          "title": "Provider Component Id",
          "type": "string"
        }
      },
      "required": [
        "tensor_component",
        "provider_component_id"
      ],
      "title": "TensorComponentBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.gasket_fe_von_mises_caller_limit_screen.v1",
      "default": "matintegrity.gasket_fe_von_mises_caller_limit_screen.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "imported_fe_result": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "imported_fe_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Imported Fe Result Sha256",
      "type": "string"
    },
    "expected_asset_id": {
      "minLength": 1,
      "title": "Expected Asset Id",
      "type": "string"
    },
    "expected_location_id": {
      "minLength": 1,
      "title": "Expected Location Id",
      "type": "string"
    },
    "expected_joint_id": {
      "minLength": 1,
      "title": "Expected Joint Id",
      "type": "string"
    },
    "expected_physical_scope_id": {
      "minLength": 1,
      "title": "Expected Physical Scope Id",
      "type": "string"
    },
    "expected_provider_component_id": {
      "minLength": 1,
      "title": "Expected Provider Component Id",
      "type": "string"
    },
    "expected_coordinate_frame_id": {
      "minLength": 1,
      "title": "Expected Coordinate Frame Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "tensor_component_mapping": {
      "items": {
        "$ref": "#/$defs/TensorComponentBinding"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Tensor Component Mapping",
      "type": "array"
    },
    "maximum_caller_von_mises_stress_Pa": {
      "exclusiveMinimum": 0,
      "title": "Maximum Caller Von Mises Stress Pa",
      "type": "number"
    },
    "criterion_id": {
      "minLength": 1,
      "title": "Criterion Id",
      "type": "string"
    },
    "criterion_basis_description": {
      "minLength": 1,
      "title": "Criterion Basis Description",
      "type": "string"
    },
    "criterion_source_id": {
      "minLength": 1,
      "title": "Criterion Source Id",
      "type": "string"
    },
    "criterion_provider_revision": {
      "minLength": 1,
      "title": "Criterion Provider Revision",
      "type": "string"
    },
    "criterion_record_id": {
      "minLength": 1,
      "title": "Criterion Record Id",
      "type": "string"
    },
    "criterion_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Criterion Record Sha256",
      "type": "string"
    },
    "criterion_usage_license_id": {
      "minLength": 1,
      "title": "Criterion Usage License Id",
      "type": "string"
    },
    "criterion_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Criterion Evidence",
      "type": "array"
    },
    "tensor_component_frame_and_sign_reviewed": {
      "title": "Tensor Component Frame And Sign Reviewed",
      "type": "boolean"
    },
    "single_temperature_material_state_reviewed": {
      "title": "Single Temperature Material State Reviewed",
      "type": "boolean"
    },
    "averaging_basis_and_hotspot_scope_reviewed": {
      "title": "Averaging Basis And Hotspot Scope Reviewed",
      "type": "boolean"
    },
    "caller_limit_applicability_reviewed": {
      "title": "Caller Limit Applicability Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "imported_fe_result",
    "imported_fe_result_sha256",
    "expected_asset_id",
    "expected_location_id",
    "expected_joint_id",
    "expected_physical_scope_id",
    "expected_provider_component_id",
    "expected_coordinate_frame_id",
    "material_condition_id",
    "temperature_K",
    "tensor_component_mapping",
    "maximum_caller_von_mises_stress_Pa",
    "criterion_id",
    "criterion_basis_description",
    "criterion_source_id",
    "criterion_provider_revision",
    "criterion_record_id",
    "criterion_record_sha256",
    "criterion_usage_license_id",
    "criterion_evidence",
    "tensor_component_frame_and_sign_reviewed",
    "single_temperature_material_state_reviewed",
    "averaging_basis_and_hotspot_scope_reviewed",
    "caller_limit_applicability_reviewed",
    "computational_use_authorized"
  ],
  "title": "GasketFEVonMisesCallerLimitScreen",
  "type": "object"
}