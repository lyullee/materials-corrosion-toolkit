      "type": "array"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/ReplicaCampaignField"
      },
      "minItems": 1,
      "title": "Fields",
      "type": "array"
    },
    "caller_profile": {
      "$ref": "#/$defs/ReplicaCampaignCallerProfile"
    },
    "component_location_material_heat_and_service_history_reviewed": {
      "title": "Component Location Material Heat And Service History Reviewed",
