          "type": "string"
        },
        "service_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Service Record Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "environment_descriptor_id",
        "service_record_digest",
        "evidence"
      ],
      "title": "ReplicaServiceInterval",
      "type": "object"
    }
