      "properties": {
        "dataset_id": {
          "const": "mendeley-internal-corrosion-doobn",
          "default": "mendeley-internal-corrosion-doobn",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_doi": {
          "const": "10.17632/g5h5gktwnd.3",
          "default": "10.17632/g5h5gktwnd.3",
