{
  "$defs": {
    "CallerWeldTestCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "test_kind": {
          "minLength": 1,
          "title": "Test Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "individual",
            "replicate_mean",
            "replicate_minimum",
            "replicate_maximum"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "minimum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Inclusive"
        },
        "maximum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Inclusive"
        },
        "uncertainty_policy": {
          "enum": [
            "point_value",
            "interval_must_fit"
          ],
          "title": "Uncertainty Policy",
          "type": "string"
        },
        "uncertainty_coverage_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Uncertainty Coverage Factor",
          "type": "number"
        },
        "minimum_replicates": {
          "minimum": 1,
          "title": "Minimum Replicates",
          "type": "integer"
        },
        "minimum_independent_source_groups": {
          "minimum": 1,
          "title": "Minimum Independent Source Groups",
          "type": "integer"
        },
        "missing_disposition": {
          "enum": [
            "review",
            "insufficient_evidence"
          ],
          "title": "Missing Disposition",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "test_kind",
        "metric_id",
        "unit_token",
        "aggregation",
        "uncertainty_policy",
        "minimum_replicates",
        "minimum_independent_source_groups",
        "missing_disposition",
        "description"
      ],
      "title": "CallerWeldTestCriterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "permitted_wps_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Wps Ids",
      "type": "array"
    },
    "permitted_consumable_lot_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Consumable Lot Ids",
      "type": "array"
    },
    "permitted_base_material_heat_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Base Material Heat Ids",
      "type": "array"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/CallerWeldTestCriterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "profile_reviewed": {
      "title": "Profile Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_revision",
    "source_digest",
    "permitted_wps_ids",
    "permitted_consumable_lot_ids",
    "permitted_base_material_heat_ids",
    "criteria",
    "profile_reviewed",
    "evidence"
  ],
  "title": "CallerProductionWeldTestProfile",
  "type": "object"
}