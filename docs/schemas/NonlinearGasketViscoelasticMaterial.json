{
  "$defs": {
    "GasketBackbonePoint": {
      "additionalProperties": false,
      "properties": {
        "compressive_strain": {
          "minimum": 0,
          "title": "Compressive Strain",
          "type": "number"
        },
        "stress_Pa": {
          "minimum": 0,
          "title": "Stress Pa",
          "type": "number"
        }
      },
      "required": [
        "compressive_strain",
        "stress_Pa"
      ],
      "title": "GasketBackbonePoint",
      "type": "object"
    },
    "NonlinearGasketMaxwellBranch": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "minLength": 1,
          "title": "Branch Id",
          "type": "string"
        },
        "relaxation_time_s": {
          "exclusiveMinimum": 0,
          "title": "Relaxation Time S",
          "type": "number"
        },
        "stress_strain_backbone": {
          "items": {
            "$ref": "#/$defs/GasketBackbonePoint"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Stress Strain Backbone",
          "type": "array"
        }
      },
      "required": [
        "branch_id",
        "relaxation_time_s",
        "stress_strain_backbone"
      ],
      "title": "NonlinearGasketMaxwellBranch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "physical_specimen_id": {
      "minLength": 1,
      "title": "Physical Specimen Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "condition_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Condition Sha256",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "equilibrium_stress_strain_backbone": {
      "items": {
        "$ref": "#/$defs/GasketBackbonePoint"
      },
      "maxItems": 10000,
      "minItems": 2,
      "title": "Equilibrium Stress Strain Backbone",
      "type": "array"
    },
    "branches": {
      "items": {
        "$ref": "#/$defs/NonlinearGasketMaxwellBranch"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Branches",
      "type": "array"
    },
    "initial_branch_stress_Pa": {
      "items": {
        "type": "number"
      },
      "title": "Initial Branch Stress Pa",
      "type": "array"
    },
    "nonlinear_branch_calibration_reviewed": {
      "title": "Nonlinear Branch Calibration Reviewed",
      "type": "boolean"
    },
    "initial_branch_state_reviewed": {
      "title": "Initial Branch State Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "material_condition_id",
    "physical_specimen_id",
    "source_group_id",
    "condition_sha256",
    "source_sha256",
    "provider_id",
    "provider_revision",
    "temperature_K",
    "equilibrium_stress_strain_backbone",
    "branches",
    "initial_branch_stress_Pa",
    "nonlinear_branch_calibration_reviewed",
    "initial_branch_state_reviewed",
    "computational_use_authorized"
  ],
  "title": "NonlinearGasketViscoelasticMaterial",
  "type": "object"
}