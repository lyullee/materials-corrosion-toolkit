{
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "target_id": {
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "review",
        "insufficient_evidence"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "observed_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Value"
    },
    "threshold_or_classes": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "title": "Threshold Or Classes"
    },
    "unit_token": {
      "title": "Unit Token",
      "type": "string"
    },
    "basis": {
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "target_id",
    "outcome",
    "observed_value",
    "threshold_or_classes",
    "unit_token",
    "basis"
  ],
  "title": "AcceptanceRuleEvaluation",
  "type": "object"
}