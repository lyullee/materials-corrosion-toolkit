{
  "additionalProperties": false,
  "description": "Descriptive comparison with an explicitly selected acquisition ensemble.",
  "properties": {
    "specimen_id": {
      "minLength": 1,
      "title": "Specimen Id",
      "type": "string"
    },
    "baseline_acquisition_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "title": "Baseline Acquisition Ids",
      "type": "array"
    },
    "observation_acquisition_id": {
      "minLength": 1,
      "title": "Observation Acquisition Id",
      "type": "string"
    },
    "baseline_source_group_id": {
      "minLength": 1,
      "title": "Baseline Source Group Id",
      "type": "string"
    },
    "observation_source_group_id": {
      "minLength": 1,
      "title": "Observation Source Group Id",
      "type": "string"
    },
    "baseline_selection_basis": {
      "minLength": 1,
      "title": "Baseline Selection Basis",
      "type": "string"
    },
    "frequency_Hz": {
      "exclusiveMinimum": 0,
      "title": "Frequency Hz",
      "type": "number"
    },
    "wave_mode": {
      "enum": [
        "torsional",
        "flexural"
      ],
      "title": "Wave Mode",
      "type": "string"
    },
    "distance_m": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Distance M",
      "type": "array"
    },
    "baseline_voltage_V": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "minItems": 3,
      "title": "Baseline Voltage V",
      "type": "array"
    },
    "observation_distance_m": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Observation Distance M",
      "type": "array"
    },
    "observation_voltage_V": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Observation Voltage V",
      "type": "array"
    },
    "window_start_m": {
      "title": "Window Start M",
      "type": "number"
    },
    "window_end_m": {
      "title": "Window End M",
      "type": "number"
    },
    "distance_match_tolerance_m": {
      "default": 0.0,
      "minimum": 0,
      "title": "Distance Match Tolerance M",
      "type": "number"
    },
    "duplicate_distance_policy": {
      "default": "preserve_samples",
      "enum": [
        "preserve_samples",
        "mean_aligned_duplicates",
        "reject"
      ],
      "title": "Duplicate Distance Policy",
      "type": "string"
    },
    "reference_statistic": {
      "default": "median",
      "enum": [
        "mean",
        "median"
      ],
      "title": "Reference Statistic",
      "type": "string"
    }
  },
  "required": [
    "specimen_id",
    "baseline_acquisition_ids",
    "observation_acquisition_id",
    "baseline_source_group_id",
    "observation_source_group_id",
    "baseline_selection_basis",
    "frequency_Hz",
    "wave_mode",
    "distance_m",
    "baseline_voltage_V",
    "observation_distance_m",
    "observation_voltage_V",
    "window_start_m",
    "window_end_m"
  ],
  "title": "GuidedWaveReferenceEnsemble",
  "type": "object"
}