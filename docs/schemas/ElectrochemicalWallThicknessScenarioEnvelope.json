{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "ElectrochemicalWallThicknessScenario": {
      "additionalProperties": false,
      "description": "One complete computed wall-thickness history and its immutable identity.",
      "properties": {
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "wall_result": {
          "$ref": "#/$defs/AssessmentResult"
        },
        "wall_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Wall Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "wall_result",
        "wall_result_sha256"
      ],
      "title": "ElectrochemicalWallThicknessScenario",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pointwise extrema among complete, caller-enumerated joint scenarios.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.electrochemical_wall_thickness_scenario_envelope.v1",
      "default": "matintegrity.electrochemical_wall_thickness_scenario_envelope.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "time_basis": {
      "minLength": 1,
      "title": "Time Basis",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "baseline_id": {
      "minLength": 1,
      "title": "Baseline Id",
      "type": "string"
    },
    "baseline_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Baseline Record Sha256",
      "type": "string"
    },
    "scenario_provider_id": {
      "minLength": 1,
      "title": "Scenario Provider Id",
      "type": "string"
    },
    "scenario_provider_revision": {
      "minLength": 1,
      "title": "Scenario Provider Revision",
      "type": "string"
    },
    "scenarios_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scenarios Sha256",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ElectrochemicalWallThicknessScenario"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    },
    "scenario_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Scenario Evidence",
      "type": "array"
    },
    "usage_rights_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Usage Rights Evidence",
      "type": "array"
    },
    "usage_license_id": {
      "minLength": 1,
      "title": "Usage License Id",
      "type": "string"
    },
    "complete_scenario_set_reviewed": {
      "title": "Complete Scenario Set Reviewed",
      "type": "boolean"
    },
    "joint_scenario_dependence_reviewed": {
      "title": "Joint Scenario Dependence Reviewed",
      "type": "boolean"
    },
    "baseline_and_scope_match_reviewed": {
      "title": "Baseline And Scope Match Reviewed",
      "type": "boolean"
    },
    "usage_rights_reviewed": {
      "title": "Usage Rights Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "time_basis",
    "physical_scope_id",
    "material_condition_id",
    "baseline_id",
    "baseline_record_sha256",
    "scenario_provider_id",
    "scenario_provider_revision",
    "scenarios_sha256",
    "scenarios",
    "scenario_evidence",
    "usage_rights_evidence",
    "usage_license_id",
    "complete_scenario_set_reviewed",
    "joint_scenario_dependence_reviewed",
    "baseline_and_scope_match_reviewed",
    "usage_rights_reviewed",
    "computational_use_authorized"
  ],
  "title": "ElectrochemicalWallThicknessScenarioEnvelope",
  "type": "object"
}