{
  "$defs": {
    "CastingForgingQualityCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "criterion_source": {
          "enum": [
            "campaign",
            "observation"
          ],
          "title": "Criterion Source",
          "type": "string"
        },
        "campaign_metric": {
          "anyOf": [
            {
              "enum": [
                "product_count",
                "sample_count",
                "replicate_group_count",
                "independent_source_group_count",
                "valid_observation_fraction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Metric"
        },
        "observation_category": {
          "anyOf": [
            {
              "enum": [
                "dimensional",
                "surface",
                "internal",
                "nde",
                "macro",
                "micro",
                "chemistry",
                "mechanical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Category"
        },
        "observation_metric_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Metric Id"
        },
        "aggregation": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Direction",
          "type": "string"
        },
        "accept_limit": {
          "title": "Accept Limit",
          "type": "number"
        },
        "reject_limit": {
          "title": "Reject Limit",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "criterion_source",
        "aggregation",
        "direction",
        "accept_limit",
        "reject_limit",
        "unit_token",
        "criterion_basis"
      ],
      "title": "CastingForgingQualityCriterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "required_product_kinds": {
      "items": {
        "enum": [
          "casting",
          "forging"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Product Kinds",
      "type": "array"
    },
    "required_observation_categories": {
      "items": {
        "enum": [
          "dimensional",
          "surface",
          "internal",
          "nde",
          "macro",
          "micro",
          "chemistry",
          "mechanical"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Observation Categories",
      "type": "array"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/CastingForgingQualityCriterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "profile_provider_id": {
      "minLength": 1,
      "title": "Profile Provider Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "profile_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Configuration Digest",
      "type": "string"
    },
    "caller_acceptance_authority": {
      "minLength": 1,
      "title": "Caller Acceptance Authority",
      "type": "string"
    },
    "built_in_specification_table_used": {
      "const": false,
      "default": false,
      "title": "Built In Specification Table Used",
      "type": "boolean"
    },
    "minimum_forging_ratio_embedded": {
      "const": false,
      "default": false,
      "title": "Minimum Forging Ratio Embedded",
      "type": "boolean"
    },
    "allowable_defect_rule_embedded": {
      "const": false,
      "default": false,
      "title": "Allowable Defect Rule Embedded",
      "type": "boolean"
    },
    "material_qualification_claimed": {
      "const": false,
      "default": false,
      "title": "Material Qualification Claimed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "required_product_kinds",
    "required_observation_categories",
    "criteria",
    "profile_provider_id",
    "profile_revision",
    "profile_configuration_digest",
    "caller_acceptance_authority",
    "evidence"
  ],
  "title": "CastingForgingCallerProfile",
  "type": "object"
}