{
  "$defs": {
    "FatigueLoadingSegment": {
      "additionalProperties": false,
      "description": "Reviewed valid loading cycles for one physical specimen and load case.",
      "properties": {
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "load_case_id": {
          "minLength": 1,
          "title": "Load Case Id",
          "type": "string"
        },
        "valid_loading_cycles": {
          "minimum": 0,
          "title": "Valid Loading Cycles",
          "type": "number"
        },
        "cycle_count_basis": {
          "enum": [
            "provider_cumulative_difference",
            "segment_local_counter",
            "reviewed_manual"
          ],
          "title": "Cycle Count Basis",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "physical_specimen_id",
        "load_case_id",
        "valid_loading_cycles",
        "cycle_count_basis"
      ],
      "title": "FatigueLoadingSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "segments": {
      "items": {
        "$ref": "#/$defs/FatigueLoadingSegment"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "initial_pressure_Pa": {
      "exclusiveMinimum": 0,
      "title": "Initial Pressure Pa",
      "type": "number"
    },
    "observed_pressure_drop_Pa": {
      "minimum": 0,
      "title": "Observed Pressure Drop Pa",
      "type": "number"
    },
    "declared_drop_fraction_threshold": {
      "exclusiveMinimum": 0.0,
      "maximum": 1.0,
      "title": "Declared Drop Fraction Threshold",
      "type": "number"
    },
    "event_origin": {
      "enum": [
        "none",
        "specimen",
        "pressure_system",
        "instrumentation",
        "unresolved"
      ],
      "title": "Event Origin",
      "type": "string"
    },
    "specimen_event_kind": {
      "enum": [
        "none",
        "through_wall_crack",
        "rupture",
        "other"
      ],
      "title": "Specimen Event Kind",
      "type": "string"
    },
    "specimen_pressure_loss_confirmed": {
      "title": "Specimen Pressure Loss Confirmed",
      "type": "boolean"
    },
    "same_physical_specimen_across_segments_declared": {
      "title": "Same Physical Specimen Across Segments Declared",
      "type": "boolean"
    },
    "loading_history_reconstructable": {
      "title": "Loading History Reconstructable",
      "type": "boolean"
    },
    "runout_limit_cycles": {
      "exclusiveMinimum": 0,
      "title": "Runout Limit Cycles",
      "type": "number"
    },
    "observation_window_closed": {
      "title": "Observation Window Closed",
      "type": "boolean"
    }
  },
  "required": [
    "segments",
    "initial_pressure_Pa",
    "observed_pressure_drop_Pa",
    "declared_drop_fraction_threshold",
    "event_origin",
    "specimen_event_kind",
    "specimen_pressure_loss_confirmed",
    "same_physical_specimen_across_segments_declared",
    "loading_history_reconstructable",
    "runout_limit_cycles",
    "observation_window_closed"
  ],
  "title": "PressureLossFatigueEndpoint",
  "type": "object"
}