{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "curve_id": {
      "minLength": 1,
      "title": "Curve Id",
      "type": "string"
    },
    "assessment_basis_id": {
      "minLength": 1,
      "title": "Assessment Basis Id",
      "type": "string"
    },
    "load_ratio": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Load Ratio",
      "type": "array"
    },
    "allowable_toughness_ratio": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Allowable Toughness Ratio",
      "type": "array"
    },
    "interpolation": {
      "const": "linear",
      "default": "linear",
      "title": "Interpolation",
      "type": "string"
    },
    "validity_description": {
      "minLength": 1,
      "title": "Validity Description",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "curve_id",
    "assessment_basis_id",
    "load_ratio",
    "allowable_toughness_ratio",
    "validity_description",
    "evidence"
  ],
  "title": "FailureAssessmentCurve",
  "type": "object"
}