      "type": "string"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/ThermalSprayRegion"
      },
      "minItems": 1,
      "title": "Regions",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ThermalSprayObservation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "declared_requirements": {
      "items": {
        "$ref": "#/$defs/DeclaredThermalSprayRequirement"
      },
      "minItems": 1,
      "title": "Declared Requirements",
      "type": "array"
    },
    "system_and_lot_identity_reviewed": {
      "title": "System And Lot Identity Reviewed",
      "type": "boolean"
    },
    "surface_preparation_and_pass_traceability_reviewed": {
      "title": "Surface Preparation And Pass Traceability Reviewed",
      "type": "boolean"
    },
    "region_coverage_reviewed": {
      "title": "Region Coverage Reviewed",
      "type": "boolean"
    },
    "measurement_methods_reviewed": {
      "title": "Measurement Methods Reviewed",
      "type": "boolean"
    },
    "uncertainty_and_provider_lineage_reviewed": {
      "title": "Uncertainty And Provider Lineage Reviewed",
      "type": "boolean"
    },
    "requirement_authority_reviewed": {
      "title": "Requirement Authority Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
