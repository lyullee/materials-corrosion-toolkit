{
  "$defs": {
    "MorrowStrainLife": {
      "additionalProperties": false,
      "description": "Caller-calibrated Morrow mean-stress correction in uniaxial strain-life form.",
      "properties": {
        "strain_amplitude": {
          "exclusiveMinimum": 0,
          "title": "Strain Amplitude",
          "type": "number"
        },
        "mean_stress_Pa": {
          "title": "Mean Stress Pa",
          "type": "number"
        },
        "elastic_modulus_Pa": {
          "exclusiveMinimum": 0,
          "title": "Elastic Modulus Pa",
          "type": "number"
        },
        "fatigue_strength_coefficient_Pa": {
          "exclusiveMinimum": 0,
          "title": "Fatigue Strength Coefficient Pa",
          "type": "number"
        },
        "fatigue_strength_exponent": {
          "exclusiveMaximum": 0,
          "title": "Fatigue Strength Exponent",
          "type": "number"
        },
        "fatigue_ductility_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Fatigue Ductility Coefficient",
          "type": "number"
        },
        "fatigue_ductility_exponent": {
          "exclusiveMaximum": 0,
          "title": "Fatigue Ductility Exponent",
          "type": "number"
        },
        "minimum_valid_cycles": {
          "exclusiveMinimum": 0,
          "title": "Minimum Valid Cycles",
          "type": "number"
        },
        "maximum_valid_cycles": {
          "exclusiveMinimum": 0,
          "title": "Maximum Valid Cycles",
          "type": "number"
        },
        "mean_stress_sign_convention": {
          "const": "tension_positive",
          "title": "Mean Stress Sign Convention",
          "type": "string"
        },
        "coefficients_and_mean_stress_basis_reviewed": {
          "title": "Coefficients And Mean Stress Basis Reviewed",
          "type": "boolean"
        },
        "material_applicability_reviewed": {
          "title": "Material Applicability Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "strain_amplitude",
        "mean_stress_Pa",
        "elastic_modulus_Pa",
        "fatigue_strength_coefficient_Pa",
        "fatigue_strength_exponent",
        "fatigue_ductility_coefficient",
        "fatigue_ductility_exponent",
        "minimum_valid_cycles",
        "maximum_valid_cycles",
        "mean_stress_sign_convention",
        "coefficients_and_mean_stress_basis_reviewed",
        "material_applicability_reviewed"
      ],
      "title": "MorrowStrainLife",
      "type": "object"
    },
