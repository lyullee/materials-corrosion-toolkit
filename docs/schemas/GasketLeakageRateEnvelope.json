{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GasketLeakageCalibrationMap": {
      "additionalProperties": false,
      "properties": {
        "differential_pressure_Pa": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Differential Pressure Pa",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/GasketLeakageCalibrationRow"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "differential_pressure_Pa",
        "rows"
      ],
      "title": "GasketLeakageCalibrationMap",
      "type": "object"
    },
    "GasketLeakageCalibrationRow": {
      "additionalProperties": false,
      "properties": {
        "contact_pressure_Pa": {
          "minimum": 0,
          "title": "Contact Pressure Pa",
          "type": "number"
        },
        "molar_leak_flux_by_delta_pressure_mol_s_m2": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Molar Leak Flux By Delta Pressure Mol S M2",
          "type": "array"
        }
      },
      "required": [
        "contact_pressure_Pa",
        "molar_leak_flux_by_delta_pressure_mol_s_m2"
      ],
      "title": "GasketLeakageCalibrationRow",
      "type": "object"
    },
    "GasketLeakageNodePressureEnvelope": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "contact_area_m2": {
          "exclusiveMinimum": 0,
          "title": "Contact Area M2",
          "type": "number"
        },
        "minimum_contact_pressure_Pa": {
          "minimum": 0,
          "title": "Minimum Contact Pressure Pa",
          "type": "number"
        },
        "maximum_contact_pressure_Pa": {
          "minimum": 0,
          "title": "Maximum Contact Pressure Pa",
          "type": "number"
        },
        "minimum_differential_pressure_Pa": {
          "minimum": 0,
          "title": "Minimum Differential Pressure Pa",
          "type": "number"
        },
        "maximum_differential_pressure_Pa": {
          "minimum": 0,
          "title": "Maximum Differential Pressure Pa",
          "type": "number"
        }
      },
      "required": [
        "node_id",
        "contact_area_m2",
        "minimum_contact_pressure_Pa",
        "maximum_contact_pressure_Pa",
        "minimum_differential_pressure_Pa",
        "maximum_differential_pressure_Pa"
      ],
      "title": "GasketLeakageNodePressureEnvelope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.gasket_leakage_rate_envelope.v1",
      "default": "matintegrity.gasket_leakage_rate_envelope.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "joint_id": {
      "minLength": 1,
      "title": "Joint Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "time_s": {
      "minimum": 0,
      "title": "Time S",
      "type": "number"
    },
    "calibration": {
      "$ref": "#/$defs/GasketLeakageCalibrationMap"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GasketLeakageNodePressureEnvelope"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "maximum_corner_evaluations": {
      "default": 2000000,
      "maximum": 10000000,
      "minimum": 1,
      "title": "Maximum Corner Evaluations",
      "type": "integer"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "provider_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Configuration Sha256",
      "type": "string"
    },
    "calibration_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Record Sha256",
      "type": "string"
    },
    "scope_transfer_and_uncertainty_bounds_reviewed": {
      "title": "Scope Transfer And Uncertainty Bounds Reviewed",
      "type": "boolean"
    },
    "calibration_and_joint_match_reviewed": {
      "title": "Calibration And Joint Match Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "joint_id",
    "physical_scope_id",
    "time_s",
    "calibration",
    "nodes",
    "provider_id",
    "provider_revision",
    "provider_configuration_sha256",
    "calibration_record_sha256",
    "scope_transfer_and_uncertainty_bounds_reviewed",
    "calibration_and_joint_match_reviewed",
    "computational_use_authorized",
    "evidence"
  ],
  "title": "GasketLeakageRateEnvelope",
  "type": "object"
}