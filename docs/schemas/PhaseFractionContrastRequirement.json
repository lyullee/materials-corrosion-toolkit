{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PhaseFractionLinearTerm": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "phase_id",
        "coefficient"
      ],
      "title": "PhaseFractionLinearTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contrast_id": {
      "minLength": 1,
      "title": "Contrast Id",
      "type": "string"
    },
    "terms": {
      "items": {
        "$ref": "#/$defs/PhaseFractionLinearTerm"
      },
      "minItems": 1,
      "title": "Terms",
      "type": "array"
    },
    "minimum_value_fraction": {
      "title": "Minimum Value Fraction",
      "type": "number"
    },
    "maximum_value_fraction": {
      "title": "Maximum Value Fraction",
      "type": "number"
    },
    "requirement_basis": {
      "minLength": 1,
      "title": "Requirement Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "contrast_id",
    "terms",
    "minimum_value_fraction",
    "maximum_value_fraction",
    "requirement_basis",
    "evidence"
  ],
  "title": "PhaseFractionContrastRequirement",
  "type": "object"
}