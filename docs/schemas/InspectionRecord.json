{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FlawRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "thinning",
            "pit",
            "crack",
            "blister",
            "lamination",
            "misalignment",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "depth_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth M"
        },
        "length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length M"
        },
        "width_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width M"
        },
        "wall_thickness_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Thickness M"
        },
        "orientation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orientation"
        },
        "sizing_uncertainty_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sizing Uncertainty M"
        }
      },
      "required": [
        "id",
        "asset_id",
        "location_id",
        "kind"
      ],
      "title": "FlawRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.inspection.v1",
      "default": "matintegrity.inspection.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "inspection_id": {
      "minLength": 1,
      "title": "Inspection Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "measured_at": {
      "format": "date-time",
      "title": "Measured At",
      "type": "string"
    },
    "method": {
      "minLength": 1,
      "title": "Method",
      "type": "string"
    },
    "procedure_id": {
      "minLength": 1,
      "title": "Procedure Id",
      "type": "string"
    },
    "examined_fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Examined Fraction"
    },
    "outcome": {
      "enum": [
        "indication",
        "no_indication",
        "inconclusive"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "flaws": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FlawRecord"
      },
      "title": "Flaws",
      "type": "array"
    },
    "probability_of_detection_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probability Of Detection Model Id"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "inspection_id",
    "asset_id",
    "location_id",
    "measured_at",
    "method",
    "procedure_id",
    "outcome"
  ],
  "title": "InspectionRecord",
  "type": "object"
}