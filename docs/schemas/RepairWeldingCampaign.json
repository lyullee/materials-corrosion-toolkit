{
  "$defs": {
    "Criterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "title": "Criterion Id",
          "type": "string"
        },
        "metric_kind": {
          "title": "Metric Kind",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "unit_token": {
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Inclusive"
        },
        "maximum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Inclusive"
        },
        "uncertainty_policy": {
          "enum": [
            "point_value",
            "interval_must_fit"
          ],
          "title": "Uncertainty Policy",
          "type": "string"
        },
        "missing_disposition": {
          "enum": [
            "review",
            "insufficient_evidence"
          ],
          "title": "Missing Disposition",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "metric_kind",
        "metric_id",
        "unit_token",
        "uncertainty_policy",
        "missing_disposition"
      ],
      "title": "Criterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExcavationEvidence": {
      "additionalProperties": false,
      "properties": {
        "defect_id": {
          "title": "Defect Id",
          "type": "string"
        },
        "removal_method_id": {
          "title": "Removal Method Id",
          "type": "string"
        },
        "excavation_geometry_id": {
          "title": "Excavation Geometry Id",
          "type": "string"
        },
        "length_m": {
          "minimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "depth_m": {
          "minimum": 0,
          "title": "Depth M",
          "type": "number"
        },
        "width_m": {
          "minimum": 0,
          "title": "Width M",
          "type": "number"
        },
        "standard_uncertainty_m": {
          "minimum": 0,
          "title": "Standard Uncertainty M",
          "type": "number"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "defect_id",
        "removal_method_id",
        "excavation_geometry_id",
        "length_m",
        "depth_m",
        "width_m",
        "standard_uncertainty_m",
        "provider_id",
        "result_digest",
        "evidence"
      ],
      "title": "ExcavationEvidence",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "title": "Profile Revision",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "permitted_wps_ids": {
          "items": {
            "type": "string"
          },
          "title": "Permitted Wps Ids",
          "type": "array"
        },
        "permitted_base_heat_ids": {
          "items": {
            "type": "string"
          },
          "title": "Permitted Base Heat Ids",
          "type": "array"
        },
        "permitted_consumable_lots": {
          "items": {
            "type": "string"
          },
          "title": "Permitted Consumable Lots",
          "type": "array"
        },
        "maximum_repair_count": {
          "minimum": 1,
          "title": "Maximum Repair Count",
          "type": "integer"
        },
        "maximum_excavation_depth_m": {
          "minimum": 0,
          "title": "Maximum Excavation Depth M",
          "type": "number"
        },
        "maximum_event_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Maximum Event Temperature K",
          "type": "number"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "title": "Criteria",
          "type": "array"
        },
        "profile_reviewed": {
          "title": "Profile Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "source_digest",
        "permitted_wps_ids",
        "permitted_base_heat_ids",
        "permitted_consumable_lots",
        "maximum_repair_count",
        "maximum_excavation_depth_m",
        "maximum_event_temperature_k",
        "criteria",
        "profile_reviewed",
        "evidence"
      ],
      "title": "Profile",
      "type": "object"
    },
    "RepairEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "sequence_position": {
          "minimum": 1,
          "title": "Sequence Position",
          "type": "integer"
        },
        "event_kind": {
          "enum": [
            "removal",
            "preheat",
            "deposition",
            "interpass",
            "pwht",
            "cooling"
          ],
          "title": "Event Kind",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "minimum_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "pass_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pass Id"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "sequence_position",
        "event_kind",
        "start_time_s",
        "end_time_s",
        "minimum_temperature_k",
        "maximum_temperature_k",
        "provider_id",
        "result_digest",
        "evidence"
      ],
      "title": "RepairEvent",
      "type": "object"
    },
    "RepairIdentity": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "repair_id": {
          "title": "Repair Id",
          "type": "string"
        },
        "weld_id": {
          "title": "Weld Id",
          "type": "string"
        },
        "wps_id": {
          "title": "Wps Id",
          "type": "string"
        },
        "wps_revision": {
          "title": "Wps Revision",
          "type": "string"
        },
        "welder_ids": {
          "items": {
            "type": "string"
          },
          "title": "Welder Ids",
          "type": "array"
        },
        "base_heat_ids": {
          "items": {
            "type": "string"
          },
          "title": "Base Heat Ids",
          "type": "array"
        },
        "consumable_lot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Consumable Lot Ids",
          "type": "array"
        },
        "repair_sequence_number": {
          "minimum": 1,
          "title": "Repair Sequence Number",
          "type": "integer"
        },
        "previous_repair_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Previous Repair Ids",
          "type": "array"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "repair_id",
        "weld_id",
        "wps_id",
        "wps_revision",
        "welder_ids",
        "base_heat_ids",
        "consumable_lot_ids",
        "repair_sequence_number",
        "reviewed",
        "evidence"
      ],
      "title": "RepairIdentity",
      "type": "object"
    },
    "RepairObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "metric_kind": {
          "enum": [
            "nde",
            "hardness",
            "dimensional",
            "chemistry",
            "mechanical",
            "leak",
            "user_defined"
          ],
          "title": "Metric Kind",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "unit_token": {
          "title": "Unit Token",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "standard_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Uncertainty"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Digest"
        },
        "missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "metric_kind",
        "metric_id",
        "unit_token",
        "status",
        "provider_id",
        "evidence"
      ],
      "title": "RepairObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "title": "Location Id",
      "type": "string"
    },
    "identity": {
      "$ref": "#/$defs/RepairIdentity"
    },
    "excavations": {
      "items": {
        "$ref": "#/$defs/ExcavationEvidence"
      },
      "title": "Excavations",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/RepairEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/RepairObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "identity_and_repair_history_reviewed": {
      "title": "Identity And Repair History Reviewed",
      "type": "boolean"
    },
    "defect_removal_excavation_geometry_reviewed": {
      "title": "Defect Removal Excavation Geometry Reviewed",
      "type": "boolean"
    },
    "thermal_deposition_interpass_and_pwht_sequence_reviewed": {
      "title": "Thermal Deposition Interpass And Pwht Sequence Reviewed",
      "type": "boolean"
    },
    "observation_units_uncertainty_provenance_and_digests_reviewed": {
      "title": "Observation Units Uncertainty Provenance And Digests Reviewed",
      "type": "boolean"
    },
    "caller_profile_reviewed": {
      "title": "Caller Profile Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "identity",
    "excavations",
    "events",
    "observations",
    "profile",
    "identity_and_repair_history_reviewed",
    "defect_removal_excavation_geometry_reviewed",
    "thermal_deposition_interpass_and_pwht_sequence_reviewed",
    "observation_units_uncertainty_provenance_and_digests_reviewed",
    "caller_profile_reviewed",
    "evidence"
  ],
  "title": "RepairWeldingCampaign",
  "type": "object"
}