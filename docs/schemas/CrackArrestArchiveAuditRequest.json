{
  "$defs": {
    "CrackArrestReadAuthorization": {
      "additionalProperties": false,
      "description": "Caller attribution and local-only computational-use declaration.",
      "properties": {
        "dataset_id": {
          "const": "crack-arrest-c1-c2",
          "default": "crack-arrest-c1-c2",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_doi": {
          "const": "10.17632/g69875w65c.1",
          "default": "10.17632/g69875w65c.1",
          "title": "Dataset Doi",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "computational_use_authorized": {
          "const": true,
          "title": "Computational Use Authorized",
          "type": "boolean"
        },
        "local_only_authorized": {
          "const": true,
          "title": "Local Only Authorized",
          "type": "boolean"
        }
      },
      "required": [
