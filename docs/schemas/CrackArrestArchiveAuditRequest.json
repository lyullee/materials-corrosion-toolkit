        "computational_use_authorized",
        "local_only_authorized"
      ],
      "title": "CrackArrestReadAuthorization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "local_archive_path": {
      "minLength": 1,
      "title": "Local Archive Path",
      "type": "string"
    },
    "specimen_id": {
      "minLength": 1,
      "title": "Specimen Id",
      "type": "string"
    },
    "authorization": {
      "$ref": "#/$defs/CrackArrestReadAuthorization"
    }
  },
  "required": [
    "local_archive_path",
    "specimen_id",
    "authorization"
  ],
  "title": "CrackArrestArchiveAuditRequest",
  "type": "object"
}