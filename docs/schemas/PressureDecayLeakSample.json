{
  "additionalProperties": false,
  "description": "One sample from a pinned pressure/temperature series; not a leak-rate datum.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.pressure_decay_leak_sample.v1",
      "default": "matintegrity.pressure_decay_leak_sample.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "zenodo-20582921-pressure-decay-leak-test",
      "default": "zenodo-20582921-pressure-decay-leak-test",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5281/zenodo.20582921",
      "default": "https://doi.org/10.5281/zenodo.20582921",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "source_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "source_sheet_name": {
      "minLength": 1,
      "title": "Source Sheet Name",
      "type": "string"
    },
    "series_id": {
      "minLength": 1,
      "title": "Series Id",
      "type": "string"
    },
    "provider_gas_label": {
      "minLength": 1,
      "title": "Provider Gas Label",
      "type": "string"
    },
    "normalized_gas_label": {
      "enum": [
        "nitrogen",
        "air",
        "argon",
        "carbon_dioxide",
        "propane_butane"
      ],
      "title": "Normalized Gas Label",
      "type": "string"
    },
    "provider_capillary_length_m": {
      "exclusiveMinimum": 0,
      "title": "Provider Capillary Length M",
      "type": "number"
    },
    "sample_index": {
      "maximum": 30,
      "minimum": 0,
      "title": "Sample Index",
      "type": "integer"
    },
    "time_s": {
      "minimum": 0,
      "title": "Time S",
      "type": "number"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "pressure_Pa": {
      "minimum": 0,
      "title": "Pressure Pa",
      "type": "number"
    },
    "temperature_role": {
      "const": "unresolved_ambient_or_internal",
      "default": "unresolved_ambient_or_internal",
      "title": "Temperature Role",
      "type": "string"
    },
    "pressure_basis": {
      "const": "relative_gauge_provider_description",
      "default": "relative_gauge_provider_description",
      "title": "Pressure Basis",
      "type": "string"
    },
    "interpretation_status": {
      "const": "raw_pressure_temperature_not_leak_rate",
      "default": "raw_pressure_temperature_not_leak_rate",
      "title": "Interpretation Status",
      "type": "string"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "source_file_sha256",
    "source_sheet_name",
    "series_id",
    "provider_gas_label",
    "normalized_gas_label",
    "provider_capillary_length_m",
    "sample_index",
    "time_s",
    "temperature_K",
    "pressure_Pa"
  ],
  "title": "PressureDecayLeakSample",
  "type": "object"
}