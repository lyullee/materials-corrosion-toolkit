          "type": "string"
        },
        "review_basis": {
          "minLength": 1,
          "title": "Review Basis",
          "type": "string"
        },
        "limitation_or_unresolved_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
