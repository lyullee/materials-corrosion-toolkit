          "minLength": 1,
          "title": "Review Subject Id",
          "type": "string"
        },
        "review_subject_kind": {
          "enum": [
            "base_material_pair",
            "filler_or_deposit",
            "buttering_or_overlay",
            "fusion_boundary",
            "weld_procedure",
            "heat_treatment",
            "service_environment",
            "dilution_or_transition_zone",
            "user_defined"
          ],
          "title": "Review Subject Kind",
          "type": "string"
