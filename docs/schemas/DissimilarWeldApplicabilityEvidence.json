        "linked_identity_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Linked Identity Ids",
          "type": "array"
        },
        "review_status": {
          "enum": [
            "reviewed_supported",
            "reviewed_limited",
            "reviewed_out_of_scope",
            "unresolved",
            "not_applicable"
          ],
