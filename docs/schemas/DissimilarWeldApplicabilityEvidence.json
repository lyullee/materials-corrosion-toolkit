          "default": null,
          "title": "Limitation Or Unresolved Basis"
        },
        "reviewer_or_provider_id": {
          "minLength": 1,
          "title": "Reviewer Or Provider Id",
          "type": "string"
        },
        "reviewer_or_provider_revision": {
          "minLength": 1,
          "title": "Reviewer Or Provider Revision",
          "type": "string"
        },
        "review_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Review Configuration Digest",
          "type": "string"
        },
        "review_result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Review Result Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "review_id",
        "review_subject_id",
        "review_subject_kind",
        "linked_identity_ids",
        "review_status",
        "review_basis",
