{
  "$defs": {
    "DeclaredUnderInsulationExposure": {
      "additionalProperties": false,
      "properties": {
        "definition_id": {
          "minLength": 1,
          "title": "Definition Id",
          "type": "string"
        },
        "minimum_surface_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Surface Temperature K",
          "type": "number"
        },
        "maximum_surface_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Surface Temperature K",
          "type": "number"
        },
        "included_wetness_state_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Included Wetness State Ids",
          "type": "array"
        },
        "included_insulation_condition_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Included Insulation Condition Ids",
          "type": "array"
        },
        "definition_basis": {
          "minLength": 1,
          "title": "Definition Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "definition_id",
        "minimum_surface_temperature_K",
        "maximum_surface_temperature_K",
        "included_wetness_state_ids",
        "included_insulation_condition_ids",
        "definition_basis",
        "evidence"
      ],
      "title": "DeclaredUnderInsulationExposure",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "InsulationExposureInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "surface_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Surface Temperature K"
        },
        "wetness_state_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wetness State Id"
        },
        "insulation_condition_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Insulation Condition Id"
        },
        "missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "record_valid",
        "evidence"
      ],
      "title": "InsulationExposureInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "source_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Model Id"
    },
    "source_result_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Result Digest"
    },
    "wetness_state_semantics": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wetness State Semantics"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "horizon_start_s": {
      "minimum": 0,
      "title": "Horizon Start S",
      "type": "number"
    },
    "horizon_end_s": {
      "exclusiveMinimum": 0,
      "title": "Horizon End S",
      "type": "number"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/InsulationExposureInterval"
      },
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "exposure_definition": {
      "$ref": "#/$defs/DeclaredUnderInsulationExposure"
    },
    "clock_and_coverage_reviewed": {
      "title": "Clock And Coverage Reviewed",
      "type": "boolean"
    },
    "temperature_measurement_reviewed": {
      "title": "Temperature Measurement Reviewed",
      "type": "boolean"
    },
    "wetness_state_mapping_reviewed": {
      "title": "Wetness State Mapping Reviewed",
      "type": "boolean"
    },
    "insulation_condition_mapping_reviewed": {
      "title": "Insulation Condition Mapping Reviewed",
      "type": "boolean"
    },
    "exposure_definition_reviewed": {
      "title": "Exposure Definition Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "record_id",
    "asset_id",
    "location_id",
    "clock_id",
    "horizon_start_s",
    "horizon_end_s",
    "intervals",
    "exposure_definition",
    "clock_and_coverage_reviewed",
    "temperature_measurement_reviewed",
    "wetness_state_mapping_reviewed",
    "insulation_condition_mapping_reviewed",
    "exposure_definition_reviewed"
  ],
  "title": "UnderInsulationExposureHistory",
  "type": "object"
}