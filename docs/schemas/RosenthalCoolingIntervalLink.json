{
  "$defs": {
    "RosenthalPointSource3D": {
      "additionalProperties": false,
      "description": "Caller-defined steady moving point-source temperature field for a half-space.",
      "properties": {
        "absorbed_power_W": {
          "exclusiveMinimum": 0,
          "title": "Absorbed Power W",
          "type": "number"
        },
        "travel_speed_m_s": {
          "exclusiveMinimum": 0,
          "title": "Travel Speed M S",
          "type": "number"
        },
        "thermal_conductivity_W_m_K": {
          "exclusiveMinimum": 0,
          "title": "Thermal Conductivity W M K",
          "type": "number"
        },
        "density_kg_m3": {
          "exclusiveMinimum": 0,
          "title": "Density Kg M3",
          "type": "number"
        },
        "specific_heat_J_kg_K": {
          "exclusiveMinimum": 0,
          "title": "Specific Heat J Kg K",
          "type": "number"
        },
        "initial_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Initial Temperature K",
          "type": "number"
        },
        "source_relative_x_m": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Source Relative X M",
          "type": "array"
        },
        "transverse_y_m": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Transverse Y M",
          "type": "array"
        },
        "depth_z_m": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "minItems": 1,
          "title": "Depth Z M",
          "type": "array"
        },
        "time_s": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "threshold_temperatures_K": {
          "default": [],
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Threshold Temperatures K",
          "type": "array"
        },
        "semi_infinite_half_space_reviewed": {
          "title": "Semi Infinite Half Space Reviewed",
          "type": "boolean"
        },
        "constant_properties_reviewed": {
          "title": "Constant Properties Reviewed",
          "type": "boolean"
        },
        "phase_change_and_latent_heat_neglected_reviewed": {
          "title": "Phase Change And Latent Heat Neglected Reviewed",
          "type": "boolean"
        },
        "convection_radiation_and_pool_flow_neglected_reviewed": {
          "title": "Convection Radiation And Pool Flow Neglected Reviewed",
          "type": "boolean"
        },
        "point_source_and_steady_moving_frame_reviewed": {
          "title": "Point Source And Steady Moving Frame Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "absorbed_power_W",
        "travel_speed_m_s",
        "thermal_conductivity_W_m_K",
        "density_kg_m3",
        "specific_heat_J_kg_K",
        "initial_temperature_K",
        "source_relative_x_m",
        "transverse_y_m",
        "depth_z_m",
        "semi_infinite_half_space_reviewed",
        "constant_properties_reviewed",
        "phase_change_and_latent_heat_neglected_reviewed",
        "convection_radiation_and_pool_flow_neglected_reviewed",
        "point_source_and_steady_moving_frame_reviewed"
      ],
      "title": "RosenthalPointSource3D",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Compose a fixed-point moving-source history with a caller-selected cooling branch.",
  "properties": {
    "thermal_history": {
      "$ref": "#/$defs/RosenthalPointSource3D"
    },
    "upper_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Upper Temperature K",
      "type": "number"
    },
    "lower_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Lower Temperature K",
      "type": "number"
    },
    "cooling_branch_start_index": {
      "default": 0,
      "minimum": 0,
      "title": "Cooling Branch Start Index",
      "type": "integer"
    },
    "cooling_branch_end_index": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cooling Branch End Index"
    }
  },
  "required": [
    "thermal_history",
    "upper_temperature_K",
    "lower_temperature_K"
  ],
  "title": "RosenthalCoolingIntervalLink",
  "type": "object"
}