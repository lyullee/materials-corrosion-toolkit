{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "ButlerVolmerReaction": {
      "additionalProperties": false,
