{
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Scenario Id",
      "type": "string"
    },
    "operating_case_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Operating Case Id",
      "type": "string"
    },
    "origin": {
      "enum": [
        "api581",
        "prism",
        "user_supplied"
      ],
      "title": "Origin",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "source_code_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Code Digest",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "phase": {
      "enum": [
        "vapour",
        "liquid",
        "two_phase"
      ],
      "title": "Phase",
      "type": "string"
    },
    "mass_rate_kg_s": {
      "minimum": 0,
      "title": "Mass Rate Kg S",
      "type": "number"
    },
    "duration_s": {
      "minimum": 0,
      "title": "Duration S",
      "type": "number"
    },
    "released_mass_kg": {
      "minimum": 0,
      "title": "Released Mass Kg",
      "type": "number"
    },
    "history_basis": {
      "const": "constant_rate",
      "default": "constant_rate",
      "title": "History Basis",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "scenario_id",
    "operating_case_id",
    "origin",
    "source_digest",
    "source_code_digest",
    "evidence_ids",
    "phase",
    "mass_rate_kg_s",
    "duration_s",
    "released_mass_kg"
  ],
  "title": "PinnedExternalSourceTerm",
  "type": "object"
}