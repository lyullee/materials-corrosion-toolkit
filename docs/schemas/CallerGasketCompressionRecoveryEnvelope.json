{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "envelope_id": {
      "minLength": 1,
      "title": "Envelope Id",
      "type": "string"
    },
    "minimum_compression_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Minimum Compression Fraction",
      "type": "number"
    },
    "maximum_compression_fraction": {
      "maximum": 1,
      "minimum": 0,
      "title": "Maximum Compression Fraction",
      "type": "number"
    },
    "minimum_recovery_fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Recovery Fraction"
    },
    "maximum_recovery_fraction": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Recovery Fraction"
    },
    "uncertainty_policy": {
      "enum": [
        "point_value",
        "interval_must_fit"
      ],
      "title": "Uncertainty Policy",
      "type": "string"
    },
    "uncertainty_coverage_factor": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "title": "Uncertainty Coverage Factor",
      "type": "number"
    },
    "missing_recovery_disposition": {
      "enum": [
        "review",
        "insufficient_evidence"
      ],
      "title": "Missing Recovery Disposition",
      "type": "string"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "envelope_id",
    "minimum_compression_fraction",
    "maximum_compression_fraction",
    "uncertainty_policy",
    "missing_recovery_disposition",
    "source_digest",
    "evidence"
  ],
  "title": "CallerGasketCompressionRecoveryEnvelope",
  "type": "object"
}