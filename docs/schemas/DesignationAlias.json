{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MaterialDesignation": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "specification": {
          "minLength": 1,
          "title": "Specification",
          "type": "string"
        },
        "edition": {
          "minLength": 1,
          "title": "Edition",
          "type": "string"
        },
        "grade": {
          "minLength": 1,
          "title": "Grade",
          "type": "string"
        },
        "product_form": {
          "minLength": 1,
          "title": "Product Form",
          "type": "string"
        },
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "specification",
        "edition",
        "grade",
        "product_form",
        "condition"
      ],
      "title": "MaterialDesignation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alias": {
      "$ref": "#/$defs/MaterialDesignation"
    },
    "canonical": {
      "$ref": "#/$defs/MaterialDesignation"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "permitted_use_note": {
      "minLength": 1,
      "title": "Permitted Use Note",
      "type": "string"
    }
  },
  "required": [
    "alias",
    "canonical",
    "evidence",
    "permitted_use_note"
  ],
  "title": "DesignationAlias",
  "type": "object"
}