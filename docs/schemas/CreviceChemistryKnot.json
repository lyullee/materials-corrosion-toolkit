{
  "$defs": {
    "AqueousActivitySpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "charge_number": {
          "maximum": 8,
          "minimum": -8,
          "title": "Charge Number",
          "type": "integer"
        },
        "activity_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Activity Coefficient",
          "type": "number"
        },
        "initial_activity": {
          "exclusiveMinimum": 0,
          "title": "Initial Activity",
          "type": "number"
        },
        "elemental_composition": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elemental Composition"
        }
      },
      "required": [
        "species_id",
        "charge_number",
        "activity_coefficient",
        "initial_activity"
      ],
      "title": "AqueousActivitySpecies",
      "type": "object"
    },
    "AqueousDaviesIteration": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.aqueous_davies_iteration.v1",
          "default": "matintegrity.aqueous_davies_iteration.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "system": {
          "$ref": "#/$defs/AqueousMassActionSystem"
        },
        "water_mass_per_solution_volume_kg_L": {
          "exclusiveMinimum": 0,
          "title": "Water Mass Per Solution Volume Kg L",
          "type": "number"
        },
        "davies_A_at_temperature": {
          "exclusiveMinimum": 0,
          "title": "Davies A At Temperature",
          "type": "number"
        },
        "davies_A_provider_id": {
          "minLength": 1,
          "title": "Davies A Provider Id",
          "type": "string"
        },
        "davies_A_provider_revision": {
          "minLength": 1,
          "title": "Davies A Provider Revision",
          "type": "string"
        },
        "davies_A_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Davies A Configuration Digest",
          "type": "string"
        },
        "davies_A_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Davies A Record Digest",
          "type": "string"
        },
        "ionic_strength_limit_mol_kg": {
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Ionic Strength Limit Mol Kg",
          "type": "number"
        },
        "charge_balance_tolerance_mol_kg": {
          "exclusiveMinimum": 0,
          "title": "Charge Balance Tolerance Mol Kg",
          "type": "number"
        },
        "maximum_outer_iterations": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maximum Outer Iterations",
          "type": "integer"
        },
        "log_gamma_tolerance": {
          "default": 1e-09,
          "exclusiveMinimum": 0,
          "maximum": 0.001,
          "title": "Log Gamma Tolerance",
          "type": "number"
        },
        "damping_fraction": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1.0,
          "title": "Damping Fraction",
          "type": "number"
        },
        "water_mass_conversion_reviewed": {
          "title": "Water Mass Conversion Reviewed",
          "type": "boolean"
        },
        "Davies_A_temperature_solvent_basis_reviewed": {
          "title": "Davies A Temperature Solvent Basis Reviewed",
          "type": "boolean"
        },
        "molarity_to_molality_standard_state_mapping_reviewed": {
          "title": "Molarity To Molality Standard State Mapping Reviewed",
          "type": "boolean"
        },
        "complete_inventory_and_charge_scope_reviewed": {
          "title": "Complete Inventory And Charge Scope Reviewed",
          "type": "boolean"
        },
        "fixed_point_solver_settings_reviewed": {
          "title": "Fixed Point Solver Settings Reviewed",
          "type": "boolean"
        },
        "single_liquid_no_precipitation_scope_reviewed": {
          "title": "Single Liquid No Precipitation Scope Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "system",
        "water_mass_per_solution_volume_kg_L",
        "davies_A_at_temperature",
        "davies_A_provider_id",
        "davies_A_provider_revision",
        "davies_A_configuration_digest",
        "davies_A_record_digest",
        "ionic_strength_limit_mol_kg",
        "charge_balance_tolerance_mol_kg",
        "water_mass_conversion_reviewed",
        "Davies_A_temperature_solvent_basis_reviewed",
        "molarity_to_molality_standard_state_mapping_reviewed",
        "complete_inventory_and_charge_scope_reviewed",
        "fixed_point_solver_settings_reviewed",
        "single_liquid_no_precipitation_scope_reviewed",
        "evidence"
      ],
      "title": "AqueousDaviesIteration",
      "type": "object"
    },
    "AqueousEquilibriumReaction": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "log10_equilibrium_constant": {
          "title": "Log10 Equilibrium Constant",
          "type": "number"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/AqueousStoichiometricTerm"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "reaction_id",
        "log10_equilibrium_constant",
        "terms"
      ],
      "title": "AqueousEquilibriumReaction",
      "type": "object"
    },
    "AqueousLinearConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "target_mol_L": {
          "title": "Target Mol L",
          "type": "number"
        },
        "residual_scale_mol_L": {
          "exclusiveMinimum": 0,
          "title": "Residual Scale Mol L",
          "type": "number"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/AqueousStoichiometricTerm"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "constraint_id",
        "target_mol_L",
        "residual_scale_mol_L",
        "terms"
      ],
      "title": "AqueousLinearConstraint",
      "type": "object"
    },
    "AqueousMassActionSystem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.aqueous_mass_action.v1",
          "default": "matintegrity.aqueous_mass_action.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "solution_id": {
          "minLength": 1,
          "title": "Solution Id",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "activity_standard_state": {
          "const": "molarity_1_mol_L",
          "title": "Activity Standard State",
          "type": "string"
        },
        "species": {
          "items": {
            "$ref": "#/$defs/AqueousActivitySpecies"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Species",
          "type": "array"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/AqueousEquilibriumReaction"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Reactions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/AqueousLinearConstraint"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Constraints",
          "type": "array"
        },
        "maximum_iterations": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "normalized_residual_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "maximum": 0.0001,
          "title": "Normalized Residual Tolerance",
          "type": "number"
        },
        "maximum_jacobian_condition_number": {
          "default": 100000000000000.0,
          "exclusiveMinimum": 0,
          "maximum": 1e+16,
          "title": "Maximum Jacobian Condition Number",
          "type": "number"
        },
        "local_parameter_covariance": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Parameter Covariance"
        },
        "local_parameter_covariance_reviewed": {
          "default": false,
          "title": "Local Parameter Covariance Reviewed",
          "type": "boolean"
        },
        "activity_provider_id": {
          "minLength": 1,
          "title": "Activity Provider Id",
          "type": "string"
        },
        "activity_provider_revision": {
          "minLength": 1,
          "title": "Activity Provider Revision",
          "type": "string"
        },
        "activity_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Activity Configuration Digest",
          "type": "string"
        },
        "activity_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Activity Record Digest",
          "type": "string"
        },
        "equilibrium_provider_id": {
          "minLength": 1,
          "title": "Equilibrium Provider Id",
          "type": "string"
        },
        "equilibrium_provider_revision": {
          "minLength": 1,
          "title": "Equilibrium Provider Revision",
          "type": "string"
        },
        "equilibrium_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Configuration Digest",
          "type": "string"
        },
        "equilibrium_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Record Digest",
          "type": "string"
        },
        "complete_aqueous_species_inventory_reviewed": {
          "title": "Complete Aqueous Species Inventory Reviewed",
          "type": "boolean"
        },
        "reaction_stoichiometry_and_constant_reviewed": {
          "title": "Reaction Stoichiometry And Constant Reviewed",
          "type": "boolean"
        },
        "balance_constraints_and_charge_scope_reviewed": {
          "title": "Balance Constraints And Charge Scope Reviewed",
          "type": "boolean"
        },
        "fixed_activity_coefficients_and_standard_state_reviewed": {
          "title": "Fixed Activity Coefficients And Standard State Reviewed",
          "type": "boolean"
        },
        "temperature_and_provider_lineage_reviewed": {
          "title": "Temperature And Provider Lineage Reviewed",
          "type": "boolean"
        },
        "initial_activity_guess_and_solver_tolerance_reviewed": {
          "title": "Initial Activity Guess And Solver Tolerance Reviewed",
          "type": "boolean"
        },
        "single_liquid_phase_and_no_precipitation_reviewed": {
          "title": "Single Liquid Phase And No Precipitation Reviewed",
          "type": "boolean"
        },
        "elemental_formula_and_reaction_balance_reviewed": {
          "default": false,
          "title": "Elemental Formula And Reaction Balance Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "solution_id",
        "temperature_K",
        "activity_standard_state",
        "species",
        "reactions",
        "constraints",
        "activity_provider_id",
        "activity_provider_revision",
        "activity_configuration_digest",
        "activity_record_digest",
        "equilibrium_provider_id",
        "equilibrium_provider_revision",
        "equilibrium_configuration_digest",
        "equilibrium_record_digest",
        "complete_aqueous_species_inventory_reviewed",
        "reaction_stoichiometry_and_constant_reviewed",
        "balance_constraints_and_charge_scope_reviewed",
        "fixed_activity_coefficients_and_standard_state_reviewed",
        "temperature_and_provider_lineage_reviewed",
        "initial_activity_guess_and_solver_tolerance_reviewed",
        "single_liquid_phase_and_no_precipitation_reviewed",
        "evidence"
      ],
      "title": "AqueousMassActionSystem",
      "type": "object"
    },
    "AqueousStoichiometricTerm": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "coefficient"
      ],
      "title": "AqueousStoichiometricTerm",
      "type": "object"
    },
    "CreviceCellActivitySolidInput": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "minLength": 1,
          "title": "Cell Id",
          "type": "string"
        },
        "aqueous_activity_input": {
          "$ref": "#/$defs/AqueousDaviesIteration"
        },
        "solid_equilibrium_template": {
          "$ref": "#/$defs/CreviceCompetingSolidEquilibriumRequest"
        }
      },
      "required": [
        "cell_id",
        "aqueous_activity_input",
        "solid_equilibrium_template"
      ],
      "title": "CreviceCellActivitySolidInput",
      "type": "object"
    },
    "CreviceCompetingSolidEquilibriumRequest": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "standard_state_id": {
          "minLength": 1,
          "title": "Standard State Id",
          "type": "string"
        },
        "aqueous_species": {
          "items": {
            "$ref": "#/$defs/CreviceEquilibriumAqueousSpecies"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Aqueous Species",
          "type": "array"
        },
        "solid_phases": {
          "items": {
            "$ref": "#/$defs/CreviceCompetingSolidPhase"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Solid Phases",
          "type": "array"
        },
        "absolute_charge_balance_tolerance_mol_charge_m3": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "title": "Absolute Charge Balance Tolerance Mol Charge M3",
          "type": "number"
        },
        "absolute_inventory_balance_tolerance_mol_m3": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "title": "Absolute Inventory Balance Tolerance Mol M3",
          "type": "number"
        },
        "relative_inventory_balance_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0.0,
          "maximum": 0.0001,
          "title": "Relative Inventory Balance Tolerance",
          "type": "number"
        },
        "maximum_log_saturation_residual": {
          "default": 1e-08,
          "exclusiveMinimum": 0,
          "title": "Maximum Log Saturation Residual",
          "type": "number"
        },
        "relative_state_convergence_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0.0,
          "maximum": 0.0001,
          "title": "Relative State Convergence Tolerance",
          "type": "number"
        },
        "solid_presence_tolerance_mol_m3": {
          "default": 1e-12,
          "minimum": 0,
          "title": "Solid Presence Tolerance Mol M3",
          "type": "number"
        },
        "maximum_active_set_sweeps": {
          "default": 100,
          "maximum": 10000,
          "minimum": 1,
          "title": "Maximum Active Set Sweeps",
          "type": "integer"
        },
        "fixed_gamma_standard_states_and_temperature_reviewed": {
          "title": "Fixed Gamma Standard States And Temperature Reviewed",
          "type": "boolean"
        },
        "equilibrium_constants_applicable_to_declared_state_reviewed": {
          "title": "Equilibrium Constants Applicable To Declared State Reviewed",
          "type": "boolean"
        },
        "instantaneous_equilibrium_no_kinetic_barrier_reviewed": {
          "title": "Instantaneous Equilibrium No Kinetic Barrier Reviewed",
          "type": "boolean"
        },
        "shared_solution_volume_and_complete_candidate_set_reviewed": {
          "title": "Shared Solution Volume And Complete Candidate Set Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "asset_id",
        "physical_scope_id",
        "temperature_K",
        "standard_state_id",
        "aqueous_species",
        "solid_phases",
        "fixed_gamma_standard_states_and_temperature_reviewed",
        "equilibrium_constants_applicable_to_declared_state_reviewed",
        "instantaneous_equilibrium_no_kinetic_barrier_reviewed",
        "shared_solution_volume_and_complete_candidate_set_reviewed",
        "computational_use_authorized",
        "evidence"
      ],
      "title": "CreviceCompetingSolidEquilibriumRequest",
      "type": "object"
    },
    "CreviceCompetingSolidPhase": {
      "additionalProperties": false,
      "properties": {
        "solid_species_id": {
          "minLength": 1,
          "title": "Solid Species Id",
          "type": "string"
        },
        "solid_elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Solid Elemental Composition",
          "type": "object"
        },
        "aqueous_reactant_stoichiometry": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "minProperties": 1,
          "title": "Aqueous Reactant Stoichiometry",
          "type": "object"
        },
        "initial_solid_moles_per_solution_volume_mol_m3": {
          "minimum": 0,
          "title": "Initial Solid Moles Per Solution Volume Mol M3",
          "type": "number"
        },
        "dimensionless_solubility_product": {
          "exclusiveMinimum": 0,
          "title": "Dimensionless Solubility Product",
          "type": "number"
        },
        "equilibrium_constant_record_id": {
          "minLength": 1,
          "title": "Equilibrium Constant Record Id",
          "type": "string"
        },
        "equilibrium_constant_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Constant Record Sha256",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "solid_species_id",
        "solid_elemental_composition",
        "aqueous_reactant_stoichiometry",
        "initial_solid_moles_per_solution_volume_mol_m3",
        "dimensionless_solubility_product",
        "equilibrium_constant_record_id",
        "equilibrium_constant_record_sha256",
        "record_sha256",
        "evidence"
      ],
      "title": "CreviceCompetingSolidPhase",
      "type": "object"
    },
    "CreviceEquilibriumAqueousSpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "initial_concentration_mol_m3": {
          "minimum": 0,
          "title": "Initial Concentration Mol M3",
          "type": "number"
        },
        "activity_reference_concentration_mol_m3": {
          "exclusiveMinimum": 0,
          "title": "Activity Reference Concentration Mol M3",
          "type": "number"
        },
        "activity_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Activity Coefficient",
          "type": "number"
        },
        "charge_number": {
          "title": "Charge Number",
          "type": "integer"
        },
        "elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Elemental Composition",
          "type": "object"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "species_id",
        "initial_concentration_mol_m3",
        "activity_reference_concentration_mol_m3",
        "activity_coefficient",
        "charge_number",
        "elemental_composition",
        "record_sha256",
        "evidence"
      ],
      "title": "CreviceEquilibriumAqueousSpecies",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "knot_index": {
      "minimum": 0,
      "title": "Knot Index",
      "type": "integer"
    },
    "time_s": {
      "title": "Time S",
      "type": "number"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/CreviceCellActivitySolidInput"
      },
      "maxItems": 300,
      "minItems": 2,
      "title": "Cells",
      "type": "array"
    }
  },
  "required": [
    "knot_index",
    "time_s",
    "cells"
  ],
  "title": "CreviceChemistryKnot",
  "type": "object"
}