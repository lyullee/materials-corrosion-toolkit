{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MultiaxialSinesMeanLimitScreen": {
      "additionalProperties": false,
      "description": "Finite sampled deviatoric amplitude plus time-mean hydrostatic stress.",
      "properties": {
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "stress_history": {
          "$ref": "#/$defs/SampledStressInvariantHistory"
        },
        "stress_history_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Stress History Sha256",
          "type": "string"
        },
        "sample_time_s": {
          "items": {
            "type": "number"
          },
          "maxItems": 10000,
          "minItems": 3,
          "title": "Sample Time S",
          "type": "array"
        },
        "calibration_id": {
          "minLength": 1,
          "title": "Calibration Id",
          "type": "string"
        },
        "calibration_source_id": {
          "minLength": 1,
          "title": "Calibration Source Id",
          "type": "string"
        },
        "calibration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Sha256",
          "type": "string"
        },
        "calibration_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "calibration_material_condition_id": {
          "minLength": 1,
          "title": "Calibration Material Condition Id",
          "type": "string"
        },
        "deviatoric_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Deviatoric Coefficient",
          "type": "number"
        },
        "mean_hydrostatic_coefficient": {
          "title": "Mean Hydrostatic Coefficient",
          "type": "number"
        },
        "caller_limit_Pa": {
          "exclusiveMinimum": 0,
          "title": "Caller Limit Pa",
          "type": "number"
        },
        "coefficients_and_limit_reviewed": {
          "title": "Coefficients And Limit Reviewed",
          "type": "boolean"
        },
        "calibration_material_scope_reviewed": {
          "title": "Calibration Material Scope Reviewed",
          "type": "boolean"
        },
        "finite_sample_amplitude_and_time_weighting_reviewed": {
          "title": "Finite Sample Amplitude And Time Weighting Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "analysis_id",
        "stress_history",
        "stress_history_sha256",
        "sample_time_s",
        "calibration_id",
        "calibration_source_id",
        "calibration_sha256",
        "calibration_evidence",
        "calibration_material_condition_id",
        "deviatoric_coefficient",
        "mean_hydrostatic_coefficient",
        "caller_limit_Pa",
        "coefficients_and_limit_reviewed",
        "calibration_material_scope_reviewed",
        "finite_sample_amplitude_and_time_weighting_reviewed"
      ],
      "title": "MultiaxialSinesMeanLimitScreen",
      "type": "object"
    },
    "SampledStressInvariantHistory": {
      "additionalProperties": false,
      "description": "Ordered symmetric stress tensors at caller-declared cycle samples.",
      "properties": {
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 3,
          "title": "Sample Ids",
          "type": "array"
        },
        "stress_tensor_components_Pa": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 10000,
          "minItems": 3,
          "title": "Stress Tensor Components Pa",
          "type": "array"
        },
        "tensor_component_order": {
          "default": [
            "xx",
            "yy",
            "zz",
            "xy",
            "yz",
            "zx"
          ],
          "items": {
            "type": "string"
          },
          "title": "Tensor Component Order",
          "type": "array"
        },
        "closed_cycle_and_sample_order_reviewed": {
          "title": "Closed Cycle And Sample Order Reviewed",
          "type": "boolean"
        },
        "stress_tensor_basis_reviewed": {
          "title": "Stress Tensor Basis Reviewed",
          "type": "boolean"
        },
        "maximum_pair_evaluations": {
          "default": 2000000,
          "maximum": 20000000,
          "minimum": 1,
          "title": "Maximum Pair Evaluations",
          "type": "integer"
        }
      },
      "required": [
        "analysis_id",
        "material_condition_id",
        "location_id",
        "source_id",
        "source_sha256",
        "sample_ids",
        "stress_tensor_components_Pa",
        "closed_cycle_and_sample_order_reviewed",
        "stress_tensor_basis_reviewed"
      ],
      "title": "SampledStressInvariantHistory",
      "type": "object"
    },
    "SinesLifeCalibrationTest": {
      "additionalProperties": false,
      "description": "One uncensored failure test with a reviewed closed stress cycle.",
      "properties": {
        "test_id": {
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "cycles_to_failure": {
          "exclusiveMinimum": 0,
          "title": "Cycles To Failure",
          "type": "number"
        },
        "observation_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "screen": {
          "$ref": "#/$defs/MultiaxialSinesMeanLimitScreen"
        }
      },
      "required": [
        "test_id",
        "physical_specimen_id",
        "source_group_id",
        "source_record_id",
        "cycles_to_failure",
        "observation_evidence",
        "screen"
      ],
      "title": "SinesLifeCalibrationTest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fit a bounded Sines-parameter/life relation from same-condition tests.",
  "properties": {
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/SinesLifeCalibrationTest"
      },
      "maxItems": 10000,
      "minItems": 3,
      "title": "Tests",
      "type": "array"
    },
    "fit_source_id": {
      "default": "finite_sines_parameter_loglog_ordinary_least_squares",
      "title": "Fit Source Id",
      "type": "string"
    },
    "independent_specimen_identity_reviewed": {
      "title": "Independent Specimen Identity Reviewed",
      "type": "boolean"
    },
    "failure_endpoint_and_observation_rights_reviewed": {
      "title": "Failure Endpoint And Observation Rights Reviewed",
      "type": "boolean"
    },
    "loglog_power_law_form_and_fit_domain_reviewed": {
      "title": "Loglog Power Law Form And Fit Domain Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "campaign_id",
    "material_condition_id",
    "tests",
    "independent_specimen_identity_reviewed",
    "failure_endpoint_and_observation_rights_reviewed",
    "loglog_power_law_form_and_fit_domain_reviewed"
  ],
  "title": "MultiaxialSinesLifeFit",
  "type": "object"
}