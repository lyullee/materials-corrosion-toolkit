          "minItems": 1,
          "title": "Evidence Requirements",
          "type": "array"
        },
        "test_evidence": {
          "items": {
            "$ref": "#/$defs/LamellarTearingTestEvidence"
          },
          "minItems": 1,
          "title": "Test Evidence",
          "type": "array"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "parent_material_id",
        "material_condition_id",
        "product_form_id",
        "directionality_descriptor",
        "minimum_thickness_m",
        "maximum_thickness_m",
        "supported_joint_geometry_descriptors",
        "supported_through_thickness_loading_descriptors",
        "supported_restraint_descriptors",
        "supported_weld_process_ids",
        "supported_consumable_ids",
        "minimum_heat_input_value",
        "maximum_heat_input_value",
        "heat_input_unit_token",
        "evidence_requirements",
        "test_evidence",
        "qualification_basis",
        "evidence"
