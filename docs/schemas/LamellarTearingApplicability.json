{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "LamellarEvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "observation_kind": {
          "minLength": 1,
          "title": "Observation Kind",
          "type": "string"
        },
        "result_name": {
          "minLength": 1,
          "title": "Result Name",
          "type": "string"
        },
        "direction_id": {
          "minLength": 1,
          "title": "Direction Id",
          "type": "string"
        },
        "result_unit_token": {
          "minLength": 1,
          "title": "Result Unit Token",
          "type": "string"
        },
        "minimum_record_count": {
          "minimum": 1,
          "title": "Minimum Record Count",
          "type": "integer"
        },
        "requirement_basis": {
          "minLength": 1,
          "title": "Requirement Basis",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "observation_kind",
        "result_name",
        "direction_id",
        "result_unit_token",
        "minimum_record_count",
        "requirement_basis"
      ],
      "title": "LamellarEvidenceRequirement",
      "type": "object"
    },
    "LamellarTearingJointCondition": {
      "additionalProperties": false,
      "properties": {
        "joint_id": {
          "minLength": 1,
          "title": "Joint Id",
          "type": "string"
        },
        "joint_geometry_descriptor": {
          "minLength": 1,
          "title": "Joint Geometry Descriptor",
          "type": "string"
        },
        "governing_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Governing Thickness M",
          "type": "number"
        },
        "through_thickness_loading_descriptor": {
          "minLength": 1,
          "title": "Through Thickness Loading Descriptor",
          "type": "string"
        },
        "restraint_descriptor": {
          "minLength": 1,
          "title": "Restraint Descriptor",
          "type": "string"
        },
        "weld_process_id": {
          "minLength": 1,
          "title": "Weld Process Id",
          "type": "string"
        },
        "consumable_id": {
          "minLength": 1,
          "title": "Consumable Id",
          "type": "string"
        },
        "minimum_heat_input_value": {
          "minimum": 0,
          "title": "Minimum Heat Input Value",
          "type": "number"
        },
        "maximum_heat_input_value": {
          "minimum": 0,
          "title": "Maximum Heat Input Value",
          "type": "number"
        },
        "heat_input_unit_token": {
          "minLength": 1,
          "title": "Heat Input Unit Token",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "joint_id",
        "joint_geometry_descriptor",
        "governing_thickness_m",
        "through_thickness_loading_descriptor",
        "restraint_descriptor",
        "weld_process_id",
        "consumable_id",
        "minimum_heat_input_value",
        "maximum_heat_input_value",
        "heat_input_unit_token",
        "record_valid",
        "evidence"
      ],
      "title": "LamellarTearingJointCondition",
      "type": "object"
    },
