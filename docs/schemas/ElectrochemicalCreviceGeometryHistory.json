{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReactionCellVolumeAllocation": {
      "additionalProperties": false,
      "description": "Per-knot spatial allocation of one reaction's cumulative metal-transfer volume.",
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "cumulative_cell_volume_fraction": {
          "items": {
            "items": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 5000,
          "minItems": 2,
          "title": "Cumulative Cell Volume Fraction",
          "type": "array"
        }
      },
      "required": [
        "reaction_id",
        "cumulative_cell_volume_fraction"
      ],
      "title": "ReactionCellVolumeAllocation",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Conserve mapped electrochemical metal volume while updating slit cells.\n\nThe caller supplies the reaction- and knot-specific spatial distribution.\nThis adapter does not infer local current density from a global branch.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.electrochemical_crevice_geometry_history.v1",
      "default": "matintegrity.electrochemical_crevice_geometry_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "metal_loss_result": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "metal_loss_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Metal Loss Result Sha256",
      "type": "string"
    },
    "geometry_id": {
      "minLength": 1,
      "title": "Geometry Id",
      "type": "string"
    },
    "geometry_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Geometry Source Sha256",
      "type": "string"
    },
    "geometry_cell_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 2000,
      "title": "Geometry Cell Ids",
      "type": "array"
    },
    "cell_widths_m": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Cell Widths M",
      "type": "array"
    },
    "initial_cell_aperture_m": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Initial Cell Aperture M",
      "type": "array"
    },
    "transverse_width_m": {
      "exclusiveMinimum": 0,
      "title": "Transverse Width M",
      "type": "number"
    },
    "reference_cross_section_m2": {
      "exclusiveMinimum": 0,
      "title": "Reference Cross Section M2",
      "type": "number"
    },
    "reactive_broad_face_count": {
      "enum": [
        1,
        2
      ],
      "title": "Reactive Broad Face Count",
      "type": "integer"
    },
    "cell_volume_allocations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReactionCellVolumeAllocation"
      },
      "maxItems": 32,
      "title": "Cell Volume Allocations",
      "type": "array"
    },
    "supported_minimum_aperture_m": {
      "exclusiveMinimum": 0,
      "title": "Supported Minimum Aperture M",
      "type": "number"
    },
    "supported_maximum_aperture_m": {
      "exclusiveMinimum": 0,
      "title": "Supported Maximum Aperture M",
      "type": "number"
    },
    "reaction_surface_to_slit_face_mapping_reviewed": {
      "title": "Reaction Surface To Slit Face Mapping Reviewed",
      "type": "boolean"
    },
    "cell_volume_allocation_basis_reviewed": {
      "title": "Cell Volume Allocation Basis Reviewed",
      "type": "boolean"
    },
    "reaction_volume_conservation_reviewed": {
      "title": "Reaction Volume Conservation Reviewed",
      "type": "boolean"
    },
    "wall_recession_is_per_combined_reactive_area_reviewed": {
      "title": "Wall Recession Is Per Combined Reactive Area Reviewed",
      "type": "boolean"
    },
    "opposing_face_recession_is_equal_reviewed": {
      "title": "Opposing Face Recession Is Equal Reviewed",
      "type": "boolean"
    },
    "cell_center_to_face_mapping_reviewed": {
      "title": "Cell Center To Face Mapping Reviewed",
      "type": "boolean"
    },
    "geometry_basis_reviewed": {
      "title": "Geometry Basis Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "source_clock_origin_rebasing_reviewed": {
      "default": false,
      "title": "Source Clock Origin Rebasing Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "metal_loss_result",
    "metal_loss_result_sha256",
    "geometry_id",
    "geometry_source_sha256",
    "cell_widths_m",
    "initial_cell_aperture_m",
    "transverse_width_m",
    "reference_cross_section_m2",
    "reactive_broad_face_count",
    "supported_minimum_aperture_m",
    "supported_maximum_aperture_m",
    "reaction_surface_to_slit_face_mapping_reviewed",
    "cell_volume_allocation_basis_reviewed",
    "reaction_volume_conservation_reviewed",
    "wall_recession_is_per_combined_reactive_area_reviewed",
    "opposing_face_recession_is_equal_reviewed",
    "cell_center_to_face_mapping_reviewed",
    "geometry_basis_reviewed",
    "computational_use_authorized"
  ],
  "title": "ElectrochemicalCreviceGeometryHistory",
  "type": "object"
}