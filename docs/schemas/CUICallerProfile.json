{
  "$defs": {
    "CUICampaignCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "criterion_source": {
          "enum": [
            "campaign",
            "observation"
          ],
          "title": "Criterion Source",
          "type": "string"
        },
        "campaign_metric": {
          "anyOf": [
            {
              "enum": [
                "access_region_count",
                "coverage_fraction",
                "observation_count",
                "independent_source_group_count"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campaign Metric"
        },
        "observation_category": {
          "anyOf": [
            {
              "enum": [
                "moisture",
                "visual",
                "thickness",
                "nde"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Category"
        },
        "observation_metric_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Metric Id"
        },
        "aggregation": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Direction",
          "type": "string"
        },
        "accept_limit": {
          "title": "Accept Limit",
          "type": "number"
        },
        "reject_limit": {
          "title": "Reject Limit",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "criterion_source",
        "aggregation",
        "direction",
        "accept_limit",
        "reject_limit",
        "unit_token",
        "criterion_basis"
      ],
      "title": "CUICampaignCriterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "required_event_kinds": {
      "items": {
        "enum": [
          "access",
          "inspection",
          "repair",
          "reinstatement",
          "other"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Event Kinds",
      "type": "array"
    },
    "required_observation_categories": {
      "items": {
        "enum": [
          "moisture",
          "visual",
          "thickness",
          "nde"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Observation Categories",
      "type": "array"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/CUICampaignCriterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "profile_provider_id": {
      "minLength": 1,
      "title": "Profile Provider Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "profile_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Configuration Digest",
      "type": "string"
    },
    "caller_acceptance_authority": {
      "minLength": 1,
      "title": "Caller Acceptance Authority",
      "type": "string"
    },
    "corrosion_rate_inference_claimed": {
      "const": false,
      "default": false,
      "title": "Corrosion Rate Inference Claimed",
      "type": "boolean"
    },
    "remaining_life_claimed": {
      "const": false,
      "default": false,
      "title": "Remaining Life Claimed",
      "type": "boolean"
    },
    "hidden_area_extrapolation_claimed": {
      "const": false,
      "default": false,
      "title": "Hidden Area Extrapolation Claimed",
      "type": "boolean"
    },
    "risk_or_pod_claimed": {
      "const": false,
      "default": false,
      "title": "Risk Or Pod Claimed",
      "type": "boolean"
    },
    "built_in_code_or_standard_acceptance_used": {
      "const": false,
      "default": false,
      "title": "Built In Code Or Standard Acceptance Used",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "required_event_kinds",
    "required_observation_categories",
    "criteria",
    "profile_provider_id",
    "profile_revision",
    "profile_configuration_digest",
    "caller_acceptance_authority",
    "evidence"
  ],
  "title": "CUICallerProfile",
  "type": "object"
}