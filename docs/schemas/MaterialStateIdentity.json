{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "material_state_id": {
      "minLength": 1,
      "title": "Material State Id",
      "type": "string"
    },
    "material_kind": {
      "enum": [
        "polymer",
        "seal",
        "composite"
      ],
      "title": "Material Kind",
      "type": "string"
    },
    "material_grade_id": {
      "minLength": 1,
      "title": "Material Grade Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "material_lot_id": {
      "minLength": 1,
      "title": "Material Lot Id",
      "type": "string"
    },
    "resin_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resin Id"
    },
    "matrix_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Matrix Id"
    },
    "fiber_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fiber Id"
    },
    "reinforcement_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reinforcement Id"
    },
    "layup_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Layup Id"
    },
    "seal_geometry_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seal Geometry Id"
    },
    "manufacturing_condition_id": {
      "minLength": 1,
      "title": "Manufacturing Condition Id",
      "type": "string"
    },
    "identity_reviewed": {
      "title": "Identity Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "material_state_id",
    "material_kind",
    "material_grade_id",
    "material_condition_id",
    "material_lot_id",
    "manufacturing_condition_id",
    "identity_reviewed",
    "evidence"
  ],
  "title": "MaterialStateIdentity",
  "type": "object"
}