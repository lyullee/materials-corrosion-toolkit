{
  "$defs": {
    "FadEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "lr": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "minItems": 2,
          "title": "Lr",
          "type": "array"
        },
        "kr_limit": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "minItems": 2,
          "title": "Kr Limit",
          "type": "array"
        },
        "material_geometry_load_basis": {
          "minLength": 1,
          "title": "Material Geometry Load Basis",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "envelope_id",
        "revision",
        "lr",
        "kr_limit",
        "material_geometry_load_basis",
        "source_sha256",
        "reviewed"
      ],
      "title": "FadEnvelope",
      "type": "object"
    },
    "FadPoint": {
      "additionalProperties": false,
      "properties": {
        "point_id": {
          "minLength": 1,
          "title": "Point Id",
          "type": "string"
        },
        "lr": {
          "minimum": 0,
          "title": "Lr",
          "type": "number"
        },
        "kr": {
          "minimum": 0,
          "title": "Kr",
          "type": "number"
        },
        "material_geometry_load_basis": {
          "minLength": 1,
          "title": "Material Geometry Load Basis",
          "type": "string"
        },
        "provider_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Result Sha256",
          "type": "string"
        },
        "reviewed": {
          "title": "Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "point_id",
        "lr",
        "kr",
        "material_geometry_load_basis",
        "provider_result_sha256",
        "reviewed"
      ],
      "title": "FadPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "point": {
      "$ref": "#/$defs/FadPoint"
    },
    "envelope": {
      "$ref": "#/$defs/FadEnvelope"
    }
  },
  "required": [
    "point",
    "envelope"
  ],
  "title": "FadEnvelopeAssessment",
  "type": "object"
}