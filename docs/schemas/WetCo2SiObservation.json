{
  "additionalProperties": false,
  "description": "SI view using the associated paper's unit declarations, not CSV labels.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.wet_co2_si_observation.v1",
      "default": "matintegrity.wet_co2_si_observation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "heterogeneous-wet-co2-corrosion",
      "default": "heterogeneous-wet-co2-corrosion",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_source_row": {
      "minimum": 2,
      "title": "Provider Source Row",
      "type": "integer"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "source_file_units_status": {
      "const": "not_supplied",
      "default": "not_supplied",
      "title": "Source File Units Status",
      "type": "string"
    },
    "unit_basis_id": {
      "const": "doi:10.21203/rs.3.rs-8896642/v1#table-1",
      "default": "doi:10.21203/rs.3.rs-8896642/v1#table-1",
      "title": "Unit Basis Id",
      "type": "string"
    },
    "unit_basis_license": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "Unit Basis License",
      "type": "string"
    },
    "unit_basis_reviewed": {
      "const": true,
      "default": true,
      "title": "Unit Basis Reviewed",
      "type": "boolean"
    },
    "year_definition": {
      "const": "julian_year_365.25_days",
      "default": "julian_year_365.25_days",
      "title": "Year Definition",
      "type": "string"
    },
    "temperature_k": {
      "exclusiveMinimum": 0.0,
      "title": "Temperature K",
      "type": "number"
    },
    "flow_velocity_m_s": {
      "minimum": 0,
      "title": "Flow Velocity M S",
      "type": "number"
    },
    "co2_pressure_pa": {
      "minimum": 0,
      "title": "Co2 Pressure Pa",
      "type": "number"
    },
    "internal_pressure_pa": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Internal Pressure Pa"
    },
    "corrosion_inhibitor_efficiency_fraction": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrosion Inhibitor Efficiency Fraction"
    },
    "shear_stress_pa": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Shear Stress Pa"
    },
    "ph": {
      "title": "Ph",
      "type": "number"
    },
    "corrosion_rate_m_s": {
      "minimum": 0,
      "title": "Corrosion Rate M S",
      "type": "number"
    },
    "provider_data_type": {
      "const": "unresolved_field_simulated_or_experimental",
      "default": "unresolved_field_simulated_or_experimental",
      "title": "Provider Data Type",
      "type": "string"
    },
    "provider_source_group_id": {
      "default": null,
      "title": "Provider Source Group Id",
      "type": "null"
    },
    "physical_specimen_id": {
      "default": null,
      "title": "Physical Specimen Id",
      "type": "null"
    },
    "material_condition_id": {
      "default": null,
      "title": "Material Condition Id",
      "type": "null"
    },
    "exposure_duration_s": {
      "default": null,
      "title": "Exposure Duration S",
      "type": "null"
    },
    "row_level_source_mapping_status": {
      "const": "not_provided_by_associated_paper",
      "default": "not_provided_by_associated_paper",
      "title": "Row Level Source Mapping Status",
      "type": "string"
    },
    "empirical_calibration_ready": {
      "const": false,
      "default": false,
      "title": "Empirical Calibration Ready",
      "type": "boolean"
    },
    "mechanistic_calibration_ready": {
      "const": false,
      "default": false,
      "title": "Mechanistic Calibration Ready",
      "type": "boolean"
    },
    "observation_redistribution_status": {
      "const": "underlying_source_review_required",
      "default": "underlying_source_review_required",
      "title": "Observation Redistribution Status",
      "type": "string"
    }
  },
  "required": [
    "provider_source_row",
    "observation_id",
    "source_archive_sha256",
    "temperature_k",
    "flow_velocity_m_s",
    "co2_pressure_pa",
    "ph",
    "corrosion_rate_m_s"
  ],
  "title": "WetCo2SiObservation",
  "type": "object"
}