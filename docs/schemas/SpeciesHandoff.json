{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reviewed disposition for one upstream species at a stage boundary.",
  "properties": {
    "source_species_id": {
      "minLength": 1,
      "title": "Source Species Id",
      "type": "string"
    },
    "target_species_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Species Id"
    },
    "mapping_kind": {
      "enum": [
        "identity",
        "renamed",
        "reaction_transformed",
        "intentionally_excluded"
      ],
      "title": "Mapping Kind",
      "type": "string"
    },
    "mapping_record_id": {
      "minLength": 1,
      "title": "Mapping Record Id",
      "type": "string"
    },
    "mapping_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mapping Sha256",
      "type": "string"
    },
    "reviewed": {
      "title": "Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "source_species_id",
    "mapping_kind",
    "mapping_record_id",
    "mapping_sha256",
    "reviewed",
    "evidence"
  ],
  "title": "SpeciesHandoff",
  "type": "object"
}