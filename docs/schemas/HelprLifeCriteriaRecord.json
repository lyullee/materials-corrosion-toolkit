{
  "additionalProperties": false,
  "description": "One HELPR output row with identities missing from the provider CSV restored.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.helpr_life_criteria.v1",
      "default": "matintegrity.helpr_life_criteria.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "provider_id": {
      "const": "sandia.helpr",
      "default": "sandia.helpr",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_version": {
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "provider_revision": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Provider Revision",
      "type": "string"
    },
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "study_type": {
      "enum": [
        "nominal",
        "probabilistic"
      ],
      "title": "Study Type",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "load_case_id": {
      "minLength": 1,
      "title": "Load Case Id",
      "type": "string"
    },
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "provider_row_index": {
      "minimum": 0,
      "title": "Provider Row Index",
      "type": "integer"
    },
    "provider_reported_a_crit_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Reported A Crit M"
    },
    "provider_reported_cycles_to_a_crit": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Reported Cycles To A Crit"
    },
    "provider_reported_cycles_to_25_percent_a_crit": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Reported Cycles To 25 Percent A Crit"
    },
    "provider_reported_cycles_to_half_nc": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Reported Cycles To Half Nc"
    },
    "provider_reported_cycles_to_fad_line": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Reported Cycles To Fad Line"
    },
    "provider_a_crit_interpretation": {
      "minLength": 1,
      "title": "Provider A Crit Interpretation",
      "type": "string"
    },
    "provider_run_warning_codes": {
      "items": {
        "type": "string"
      },
      "title": "Provider Run Warning Codes",
      "type": "array"
    },
    "provider_run_warnings_reviewed": {
      "const": true,
      "title": "Provider Run Warnings Reviewed",
      "type": "boolean"
    },
    "source_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Content Sha256",
      "type": "string"
    },
    "provider_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Configuration Digest",
      "type": "string"
    },
    "units_reviewed": {
      "const": true,
      "title": "Units Reviewed",
      "type": "boolean"
    },
    "missing_value_semantics": {
      "minLength": 1,
      "title": "Missing Value Semantics",
      "type": "string"
    },
    "endpoint_semantics": {
      "const": "model_criterion_not_observed_failure",
      "default": "model_criterion_not_observed_failure",
      "title": "Endpoint Semantics",
      "type": "string"
    },
    "probability_semantics": {
      "const": "none",
      "default": "none",
      "title": "Probability Semantics",
      "type": "string"
    }
  },
  "required": [
    "provider_version",
    "provider_revision",
    "analysis_id",
    "study_type",
    "asset_id",
    "location_id",
    "material_condition_id",
    "load_case_id",
    "sample_id",
    "provider_row_index",
    "provider_reported_a_crit_m",
    "provider_reported_cycles_to_a_crit",
    "provider_reported_cycles_to_25_percent_a_crit",
    "provider_reported_cycles_to_half_nc",
    "provider_reported_cycles_to_fad_line",
    "provider_a_crit_interpretation",
    "provider_run_warning_codes",
    "provider_run_warnings_reviewed",
    "source_content_sha256",
    "provider_configuration_digest",
    "units_reviewed",
    "missing_value_semantics"
  ],
  "title": "HelprLifeCriteriaRecord",
  "type": "object"
}