{
  "additionalProperties": false,
  "description": "One signed polarization observation with file, source-row and authorization lineage.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.galvanized_polarization_sample.v1",
      "default": "matintegrity.galvanized_polarization_sample.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "galvanized-polarization",
      "default": "galvanized-polarization",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5281/zenodo.13886478",
      "default": "https://doi.org/10.5281/zenodo.13886478",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "source_filename": {
      "minLength": 1,
      "title": "Source Filename",
      "type": "string"
    },
    "source_file_md5": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Source File Md5",
      "type": "string"
    },
    "source_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "provider_source_row": {
      "minimum": 3,
      "title": "Provider Source Row",
      "type": "integer"
    },
    "sample_index": {
      "minimum": 0,
      "title": "Sample Index",
      "type": "integer"
    },
    "specimen_id": {
      "minLength": 1,
      "title": "Specimen Id",
      "type": "string"
    },
    "electrolyte_id": {
      "minLength": 1,
      "title": "Electrolyte Id",
      "type": "string"
    },
    "potential_V_provider_reported_reference_unresolved": {
      "title": "Potential V Provider Reported Reference Unresolved",
      "type": "number"
    },
    "current_density_provider_A_cm2": {
      "title": "Current Density Provider A Cm2",
      "type": "number"
    },
    "signed_current_density_A_m2": {
      "title": "Signed Current Density A M2",
      "type": "number"
    },
    "provider_current_conversion": {
      "const": "A_cm-2_to_A_m-2_factor_10000",
      "default": "A_cm-2_to_A_m-2_factor_10000",
      "title": "Provider Current Conversion",
      "type": "string"
    },
    "tafel_extrapolation_performed": {
      "const": false,
      "default": false,
      "title": "Tafel Extrapolation Performed",
      "type": "boolean"
    },
    "corrosion_rate_inferred": {
      "const": false,
      "default": false,
      "title": "Corrosion Rate Inferred",
      "type": "boolean"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "source_filename",
    "source_file_md5",
    "source_file_sha256",
    "provider_source_row",
    "sample_index",
    "specimen_id",
    "electrolyte_id",
    "potential_V_provider_reported_reference_unresolved",
    "current_density_provider_A_cm2",
    "signed_current_density_A_m2"
  ],
  "title": "GalvanizedPolarizationSample",
  "type": "object"
}