{
  "$defs": {
    "BoltForceChangePoint": {
      "additionalProperties": false,
      "description": "Caller-supplied incremental bolt force versus signed extension.",
      "properties": {
        "extension_change_m": {
          "title": "Extension Change M",
          "type": "number"
        },
        "force_change_N": {
          "title": "Force Change N",
          "type": "number"
        }
      },
      "required": [
        "extension_change_m",
        "force_change_N"
      ],
      "title": "BoltForceChangePoint",
      "type": "object"
    },
    "GasketCompressionPoint": {
      "additionalProperties": false,
      "properties": {
        "compression_m": {
          "minimum": 0,
          "title": "Compression M",
          "type": "number"
        },
        "force_N": {
          "minimum": 0,
          "title": "Force N",
          "type": "number"
        }
      },
      "required": [
        "compression_m",
        "force_N"
      ],
      "title": "GasketCompressionPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Quasi-static joint equilibrium with supplied nonlinear bolt and gasket curves.",
  "properties": {
    "joint_id": {
      "minLength": 1,
      "title": "Joint Id",
      "type": "string"
    },
    "gasket_curve_id": {
      "minLength": 1,
      "title": "Gasket Curve Id",
      "type": "string"
    },
    "gasket_curve_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Gasket Curve Source Sha256",
      "type": "string"
    },
    "gasket_compression_curve": {
      "items": {
        "$ref": "#/$defs/GasketCompressionPoint"
      },
      "minItems": 2,
      "title": "Gasket Compression Curve",
      "type": "array"
    },
    "bolt_curve_id": {
      "minLength": 1,
      "title": "Bolt Curve Id",
      "type": "string"
    },
    "bolt_curve_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bolt Curve Source Sha256",
      "type": "string"
    },
    "bolt_force_change_curve": {
      "items": {
        "$ref": "#/$defs/BoltForceChangePoint"
      },
      "minItems": 3,
      "title": "Bolt Force Change Curve",
      "type": "array"
    },
    "initial_compression_m": {
      "minimum": 0,
      "title": "Initial Compression M",
      "type": "number"
    },
    "external_separating_force_N": {
      "minimum": 0,
      "title": "External Separating Force N",
      "type": "number"
    },
    "bolt_free_length_change_m": {
      "default": 0.0,
      "title": "Bolt Free Length Change M",
      "type": "number"
    },
    "supplied_curves_and_uniform_contact_reviewed": {
      "title": "Supplied Curves And Uniform Contact Reviewed",
      "type": "boolean"
    },
    "both_curves_computational_use_authorized": {
      "title": "Both Curves Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "joint_id",
    "gasket_curve_id",
    "gasket_curve_source_sha256",
    "gasket_compression_curve",
    "bolt_curve_id",
    "bolt_curve_source_sha256",
    "bolt_force_change_curve",
    "initial_compression_m",
    "external_separating_force_N",
    "supplied_curves_and_uniform_contact_reviewed",
    "both_curves_computational_use_authorized"
  ],
  "title": "NonlinearBoltGasketJoint",
  "type": "object"
}