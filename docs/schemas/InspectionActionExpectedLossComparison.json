{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "InspectionActionRiskCandidate": {
      "additionalProperties": false,
      "description": "One complete action alternative and its externally evaluated residual event probability.",
      "properties": {
        "action_id": {
          "minLength": 1,
          "title": "Action Id",
          "type": "string"
        },
        "action_label": {
          "minLength": 1,
          "title": "Action Label",
          "type": "string"
        },
        "candidate_kind": {
          "enum": [
            "baseline",
            "intervention"
          ],
          "title": "Candidate Kind",
          "type": "string"
        },
        "action_definition": {
          "minLength": 1,
          "title": "Action Definition",
          "type": "string"
        },
        "action_effect_model_id": {
          "minLength": 1,
          "title": "Action Effect Model Id",
          "type": "string"
        },
        "action_effect_model_revision": {
          "minLength": 1,
          "title": "Action Effect Model Revision",
          "type": "string"
        },
        "action_effect_input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Action Effect Input Sha256",
          "type": "string"
        },
        "action_effect_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Action Effect Configuration Sha256",
          "type": "string"
        },
        "risk_model_structure_id": {
          "minLength": 1,
          "title": "Risk Model Structure Id",
          "type": "string"
        },
        "event_probability_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Probability Result Sha256",
          "type": "string"
        },
        "common_cause_group_ids": {
          "items": {
            "type": "string"
          },
          "title": "Common Cause Group Ids",
          "type": "array"
        },
        "residual_failure_probability_estimate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Residual Failure Probability Estimate",
          "type": "number"
        },
        "residual_failure_probability_upper_bound": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Residual Failure Probability Upper Bound"
        },
        "action_cost_components": {
          "items": {
            "$ref": "#/$defs/RiskCostComponent"
          },
          "title": "Action Cost Components",
          "type": "array"
        }
      },
      "required": [
        "action_id",
        "action_label",
        "candidate_kind",
        "action_definition",
        "action_effect_model_id",
        "action_effect_model_revision",
        "action_effect_input_sha256",
        "action_effect_configuration_sha256",
        "risk_model_structure_id",
        "event_probability_result_sha256",
        "residual_failure_probability_estimate"
      ],
      "title": "InspectionActionRiskCandidate",
      "type": "object"
    },
    "RiskCostComponent": {
      "additionalProperties": false,
      "description": "One reviewed additive cost in the comparison's declared common cost basis.",
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "amount": {
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "category",
        "amount",
        "basis"
      ],
      "title": "RiskCostComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Compare complete reviewed actions over one event, scope, horizon and cost basis.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.inspection_action_expected_loss.v1",
      "default": "matintegrity.inspection_action_expected_loss.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "comparison_id": {
      "minLength": 1,
      "title": "Comparison Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "event_definition": {
      "minLength": 1,
      "title": "Event Definition",
      "type": "string"
    },
    "horizon_start_s": {
      "minimum": 0,
      "title": "Horizon Start S",
      "type": "number"
    },
    "horizon_end_s": {
      "exclusiveMinimum": 0,
      "title": "Horizon End S",
      "type": "number"
    },
    "conditioning": {
      "minLength": 1,
      "title": "Conditioning",
      "type": "string"
    },
    "event_probability_meaning": {
      "const": "conditional_first_failure_in_period",
      "title": "Event Probability Meaning",
      "type": "string"
    },
    "probability_basis": {
      "enum": [
        "estimate",
        "upper_bound"
      ],
      "title": "Probability Basis",
      "type": "string"
    },
    "cost_basis_id": {
      "minLength": 1,
      "title": "Cost Basis Id",
      "type": "string"
    },
    "currency_or_normalized_unit": {
      "minLength": 1,
      "title": "Currency Or Normalized Unit",
      "type": "string"
    },
    "failure_consequence_components": {
      "items": {
        "$ref": "#/$defs/RiskCostComponent"
      },
      "minItems": 1,
      "title": "Failure Consequence Components",
      "type": "array"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/InspectionActionRiskCandidate"
      },
      "minItems": 2,
      "title": "Candidates",
      "type": "array"
    },
    "cost_tie_absolute_tolerance": {
      "default": 0.0,
      "minimum": 0,
      "title": "Cost Tie Absolute Tolerance",
      "type": "number"
    },
    "action_definitions_reviewed": {
      "title": "Action Definitions Reviewed",
      "type": "boolean"
    },
    "residual_probabilities_reviewed": {
      "title": "Residual Probabilities Reviewed",
      "type": "boolean"
    },
    "costs_and_consequences_reviewed": {
      "title": "Costs And Consequences Reviewed",
      "type": "boolean"
    },
    "decision_criterion_user_approved": {
      "title": "Decision Criterion User Approved",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "comparison_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "event_id",
    "event_definition",
    "horizon_start_s",
    "horizon_end_s",
    "conditioning",
    "event_probability_meaning",
    "probability_basis",
    "cost_basis_id",
    "currency_or_normalized_unit",
    "failure_consequence_components",
    "candidates",
    "action_definitions_reviewed",
    "residual_probabilities_reviewed",
    "costs_and_consequences_reviewed",
    "decision_criterion_user_approved",
    "evidence"
  ],
  "title": "InspectionActionExpectedLossComparison",
  "type": "object"
}