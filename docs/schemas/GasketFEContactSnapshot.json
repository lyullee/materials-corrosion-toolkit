{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GasketFENormalizedFieldArray": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "provider_array_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Array Content Sha256",
          "type": "string"
        },
        "provider_location_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Provider Location Ids",
          "type": "array"
        },
        "component_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Component Ids",
          "type": "array"
        },
        "values": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "normalized_values_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Normalized Values Sha256",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "provider_array_content_sha256",
        "provider_location_ids",
        "component_ids",
        "values",
        "normalized_values_sha256"
      ],
      "title": "GasketFENormalizedFieldArray",
      "type": "object"
    },
    "GasketFESupportObservation": {
      "additionalProperties": false,
      "properties": {
        "support_id": {
          "minLength": 1,
          "title": "Support Id",
          "type": "string"
        },
        "mesh_node_id": {
          "minLength": 1,
          "title": "Mesh Node Id",
          "type": "string"
        },
        "component_id": {
          "enum": [
            "translation_x",
            "translation_y",
            "translation_z",
            "rotation_x",
            "rotation_y",
            "rotation_z"
          ],
          "title": "Component Id",
          "type": "string"
        },
        "prescribed_value": {
          "title": "Prescribed Value",
          "type": "number"
        },
        "prescribed_unit_token": {
          "enum": [
            "m",
            "rad"
          ],
          "title": "Prescribed Unit Token",
          "type": "string"
        },
        "reaction_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction Value"
        },
        "reaction_unit_token": {
          "anyOf": [
            {
              "enum": [
                "N",
                "N*m"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reaction Unit Token"
        }
      },
      "required": [
        "support_id",
        "mesh_node_id",
        "component_id",
        "prescribed_value",
        "prescribed_unit_token"
      ],
      "title": "GasketFESupportObservation",
      "type": "object"
    },
    "StructuralDiagnosticEvidence": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_id": {
          "minLength": 1,
          "title": "Diagnostic Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "equilibrium",
            "convergence",
            "uncertainty",
            "verification"
          ],
          "title": "Category",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "status": {
          "enum": [
            "reported",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "provider_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Record Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "diagnostic_id",
        "category",
        "metric_id",
        "metric_definition",
        "status",
        "unit_token",
        "provider_record_digest",
        "evidence"
      ],
      "title": "StructuralDiagnosticEvidence",
      "type": "object"
    },
    "StructuralMeshReceipt": {
      "additionalProperties": false,
      "properties": {
        "mesh_id": {
          "minLength": 1,
          "title": "Mesh Id",
          "type": "string"
        },
        "mesh_revision": {
          "minLength": 1,
          "title": "Mesh Revision",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "dimensionality": {
          "enum": [
            "axisymmetric",
            "2d",
            "3d"
          ],
          "title": "Dimensionality",
          "type": "string"
        },
        "element_family_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Element Family Ids",
          "type": "array"
        },
        "node_count": {
          "minimum": 1,
          "title": "Node Count",
          "type": "integer"
        },
        "element_count": {
          "minimum": 1,
          "title": "Element Count",
          "type": "integer"
        },
        "mesh_content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Mesh Content Digest",
          "type": "string"
        }
      },
      "required": [
        "mesh_id",
        "mesh_revision",
        "coordinate_frame_id",
        "dimensionality",
        "element_family_ids",
        "node_count",
        "element_count",
        "mesh_content_digest"
      ],
      "title": "StructuralMeshReceipt",
      "type": "object"
    },
    "StructuralProviderResultReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.structural_provider_receipt.v1",
          "default": "matintegrity.structural_provider_receipt.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "receipt_id": {
          "minLength": 1,
          "title": "Receipt Id",
          "type": "string"
        },
        "analysis_kind": {
          "enum": [
            "external_pressure",
            "nozzle_local_stress",
            "finite_element"
          ],
          "title": "Analysis Kind",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "model_revision": {
          "minLength": 1,
          "title": "Model Revision",
          "type": "string"
        },
        "mesh": {
          "$ref": "#/$defs/StructuralMeshReceipt"
        },
        "load_case_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Load Case Ids",
          "type": "array"
        },
        "load_case_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Load Case Digest",
          "type": "string"
        },
        "result_fields": {
          "items": {
            "$ref": "#/$defs/StructuralResultFieldReceipt"
          },
          "minItems": 1,
          "title": "Result Fields",
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/StructuralDiagnosticEvidence"
          },
          "minItems": 1,
          "title": "Diagnostics",
          "type": "array"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "provider_input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Input Digest",
          "type": "string"
        },
        "provider_result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Result Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "payload_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Payload Digest",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "analysis_kind",
        "asset_id",
        "component_id",
        "location_id",
        "physical_scope_id",
        "analysis_id",
        "model_id",
        "model_revision",
        "mesh",
        "load_case_ids",
        "load_case_digest",
        "result_fields",
        "diagnostics",
        "provider_id",
        "provider_revision",
        "provider_configuration_digest",
        "provider_input_digest",
        "provider_result_digest",
        "evidence",
        "payload_digest"
      ],
      "title": "StructuralProviderResultReceipt",
      "type": "object"
    },
    "StructuralResultFieldReceipt": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "load_case_id": {
          "minLength": 1,
          "title": "Load Case Id",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        },
        "result_location": {
          "enum": [
            "node",
            "element",
            "integration_point",
            "face",
            "edge",
            "global"
          ],
          "title": "Result Location",
          "type": "string"
        },
        "averaging_basis": {
          "minLength": 1,
          "title": "Averaging Basis",
          "type": "string"
        },
        "quantity_id": {
          "minLength": 1,
          "title": "Quantity Id",
          "type": "string"
        },
        "quantity_definition": {
          "minLength": 1,
          "title": "Quantity Definition",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "component_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Component Ids",
          "type": "array"
        },
        "array_shape": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Array Shape",
          "type": "array"
        },
        "array_order": {
          "enum": [
            "C",
            "F",
            "provider_native"
          ],
          "title": "Array Order",
          "type": "string"
        },
        "array_content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Array Content Digest",
          "type": "string"
        },
        "result_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Record Digest",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "load_case_id",
        "step_id",
        "coordinate_frame_id",
        "region_id",
        "result_location",
        "averaging_basis",
        "quantity_id",
        "quantity_definition",
        "unit_token",
        "component_ids",
        "array_shape",
        "array_order",
        "array_content_digest",
        "result_record_digest"
      ],
      "title": "StructuralResultFieldReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "load_case_id": {
      "minLength": 1,
      "title": "Load Case Id",
      "type": "string"
    },
    "step_id": {
      "minLength": 1,
      "title": "Step Id",
      "type": "string"
    },
    "time_s": {
      "minimum": 0,
      "title": "Time S",
      "type": "number"
    },
    "time_binding_source_id": {
      "minLength": 1,
      "title": "Time Binding Source Id",
      "type": "string"
    },
    "time_binding_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Time Binding Record Sha256",
      "type": "string"
    },
    "time_binding_usage_license_id": {
      "minLength": 1,
      "title": "Time Binding Usage License Id",
      "type": "string"
    },
    "time_binding_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Time Binding Evidence",
      "type": "array"
    },
    "provider_receipt": {
      "$ref": "#/$defs/StructuralProviderResultReceipt"
    },
    "provider_data_usage_license_id": {
      "minLength": 1,
      "title": "Provider Data Usage License Id",
      "type": "string"
    },
    "provider_data_usage_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Provider Data Usage Evidence",
      "type": "array"
    },
    "field_arrays": {
      "items": {
        "$ref": "#/$defs/GasketFENormalizedFieldArray"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Field Arrays",
      "type": "array"
    },
    "support_observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GasketFESupportObservation"
      },
      "title": "Support Observations",
      "type": "array"
    },
    "support_source_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Source Id"
    },
    "support_record_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Record Sha256"
    },
    "support_usage_license_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Usage License Id"
    },
    "support_evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Support Evidence",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "load_case_id",
    "step_id",
    "time_s",
    "time_binding_source_id",
    "time_binding_record_sha256",
    "time_binding_usage_license_id",
    "time_binding_evidence",
    "provider_receipt",
    "provider_data_usage_license_id",
    "provider_data_usage_evidence",
    "field_arrays"
  ],
  "title": "GasketFEContactSnapshot",
  "type": "object"
}