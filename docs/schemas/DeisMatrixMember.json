{
  "additionalProperties": false,
  "properties": {
    "member_path": {
      "enum": [
        "DEIS/AZ31/AZ31-zw.txt",
        "DEIS/WE43/WE43-zw.txt"
      ],
      "title": "Member Path",
      "type": "string"
    },
    "declared_material_label": {
      "enum": [
        "AZ31",
        "WE43"
      ],
      "title": "Declared Material Label",
      "type": "string"
    },
    "member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Member Sha256",
      "type": "string"
    },
    "member_bytes": {
      "exclusiveMinimum": 0,
      "maximum": 8000000,
      "title": "Member Bytes",
      "type": "integer"
    },
    "row_count": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Row Count",
      "type": "integer"
    },
    "column_count": {
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "title": "Column Count",
      "type": "integer"
    },
    "blank_cell_count": {
      "minimum": 0,
      "title": "Blank Cell Count",
      "type": "integer"
    },
    "nonfinite_cell_count": {
      "minimum": 0,
      "title": "Nonfinite Cell Count",
      "type": "integer"
    },
    "delimiter": {
      "const": "tab",
      "default": "tab",
      "title": "Delimiter",
      "type": "string"
    },
    "raw_column_order_preserved": {
      "const": true,
      "default": true,
      "title": "Raw Column Order Preserved",
      "type": "boolean"
    },
    "axis_mapping": {
      "const": "not_declared_by_importer",
      "default": "not_declared_by_importer",
      "title": "Axis Mapping",
      "type": "string"
    },
    "units_mapping": {
      "const": "not_declared_by_importer",
      "default": "not_declared_by_importer",
      "title": "Units Mapping",
      "type": "string"
    },
    "spectrum_partitioning": {
      "const": "not_declared_by_importer",
      "default": "not_declared_by_importer",
      "title": "Spectrum Partitioning",
      "type": "string"
    }
  },
  "required": [
    "member_path",
    "declared_material_label",
    "member_sha256",
    "member_bytes",
    "row_count",
    "column_count",
    "blank_cell_count",
    "nonfinite_cell_count"
  ],
  "title": "DeisMatrixMember",
  "type": "object"
}