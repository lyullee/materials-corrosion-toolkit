{
  "additionalProperties": false,
  "description": "One tabular cell with provider tokens and a locale-declared parse, if numeric.",
  "properties": {
    "field_position": {
      "minimum": 0,
      "title": "Field Position",
      "type": "integer"
    },
    "label_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label Token"
    },
    "symbol_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Symbol Token"
    },
    "unit_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Token"
    },
    "raw_value_token": {
      "title": "Raw Value Token",
      "type": "string"
    },
    "numeric_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Numeric Value"
    },
    "numeric_parse_status": {
      "enum": [
        "integer",
        "dot_decimal",
        "comma_decimal",
        "non_numeric",
        "header_alignment_unknown"
      ],
      "title": "Numeric Parse Status",
      "type": "string"
    }
  },
  "required": [
    "field_position",
    "raw_value_token",
    "numeric_parse_status"
  ],
  "title": "CMSX6LISColumnValue",
  "type": "object"
}