{
  "$defs": {
    "PolicyStageCostComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "amount_at_stage_time": {
          "minimum": 0,
          "title": "Amount At Stage Time",
          "type": "number"
        },
        "present_value_factor": {
          "minimum": 0,
          "title": "Present Value Factor",
          "type": "number"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "category",
        "amount_at_stage_time",
        "present_value_factor",
        "basis"
      ],
      "title": "PolicyStageCostComponent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "minLength": 1,
      "title": "Action Id",
      "type": "string"
    },
    "action_definition": {
      "minLength": 1,
      "title": "Action Definition",
      "type": "string"
    },
    "action_model_id": {
      "minLength": 1,
      "title": "Action Model Id",
      "type": "string"
    },
    "action_model_revision": {
      "minLength": 1,
      "title": "Action Model Revision",
      "type": "string"
    },
    "action_model_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Action Model Configuration Sha256",
      "type": "string"
    },
    "action_model_input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Action Model Input Sha256",
      "type": "string"
    },
    "cost_components": {
      "items": {
        "$ref": "#/$defs/PolicyStageCostComponent"
      },
      "title": "Cost Components",
      "type": "array"
    }
  },
  "required": [
    "action_id",
    "action_definition",
    "action_model_id",
    "action_model_revision",
    "action_model_configuration_sha256",
    "action_model_input_sha256"
  ],
  "title": "FinitePolicyAction",
  "type": "object"
}