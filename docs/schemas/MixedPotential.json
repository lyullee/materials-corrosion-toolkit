{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PolarizationCurve": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.polarization_curve.v1",
          "default": "matintegrity.polarization_curve.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "curve_id": {
          "minLength": 1,
          "title": "Curve Id",
          "type": "string"
        },
        "surface_condition_id": {
          "minLength": 1,
          "title": "Surface Condition Id",
          "type": "string"
        },
        "protocol_id": {
          "minLength": 1,
          "title": "Protocol Id",
          "type": "string"
        },
        "electrolyte_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electrolyte Id"
        },
        "reference_electrode_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Electrode Id"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "point_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20000,
          "minItems": 2,
          "title": "Point Ids",
          "type": "array"
        },
        "potential_V": {
          "items": {
            "type": "number"
          },
          "maxItems": 20000,
          "minItems": 2,
          "title": "Potential V",
          "type": "array"
        },
        "signed_net_current_density_A_m2": {
          "items": {
            "type": "number"
          },
          "maxItems": 20000,
          "minItems": 2,
          "title": "Signed Net Current Density A M2",
          "type": "array"
        },
        "current_convention": {
          "default": "anodic_positive_net",
          "enum": [
            "anodic_positive_net",
            "unreviewed_signed_net"
          ],
          "title": "Current Convention",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "curve_id",
        "surface_condition_id",
        "protocol_id",
        "point_ids",
        "potential_V",
        "signed_net_current_density_A_m2",
        "evidence"
      ],
      "title": "PolarizationCurve",
      "type": "object"
    },
    "PolarizedElectrode": {
      "additionalProperties": false,
      "properties": {
        "electrode_id": {
          "minLength": 1,
          "title": "Electrode Id",
          "type": "string"
        },
        "exposed_area_m2": {
          "exclusiveMinimum": 0,
          "title": "Exposed Area M2",
          "type": "number"
        },
        "curve": {
          "$ref": "#/$defs/PolarizationCurve"
        }
      },
      "required": [
        "electrode_id",
        "exposed_area_m2",
        "curve"
      ],
      "title": "PolarizedElectrode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "electrodes": {
      "items": {
        "$ref": "#/$defs/PolarizedElectrode"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Electrodes",
      "type": "array"
    },
    "quasi_steady_reviewed": {
      "title": "Quasi Steady Reviewed",
      "type": "boolean"
    },
    "negligible_ohmic_drop_reviewed": {
      "title": "Negligible Ohmic Drop Reviewed",
      "type": "boolean"
    },
    "condition_compatibility_reviewed": {
      "title": "Condition Compatibility Reviewed",
      "type": "boolean"
    },
    "anodic_positive_reviewed": {
      "title": "Anodic Positive Reviewed",
      "type": "boolean"
    },
    "absolute_balance_tolerance_A": {
      "default": 1e-12,
      "minimum": 0,
      "title": "Absolute Balance Tolerance A",
      "type": "number"
    },
    "relative_balance_tolerance": {
      "default": 1e-10,
      "exclusiveMaximum": 0.01,
      "minimum": 0,
      "title": "Relative Balance Tolerance",
      "type": "number"
    }
  },
  "required": [
    "electrodes",
    "quasi_steady_reviewed",
    "negligible_ohmic_drop_reviewed",
    "condition_compatibility_reviewed",
    "anodic_positive_reviewed"
  ],
  "title": "MixedPotential",
  "type": "object"
}