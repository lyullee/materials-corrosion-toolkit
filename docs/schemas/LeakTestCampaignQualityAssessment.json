{
  "$defs": {
    "BlankBackgroundObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "observation_kind": {
          "enum": [
            "blank",
            "background"
          ],
          "title": "Observation Kind",
          "type": "string"
        },
        "sequence_index": {
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        },
        "elapsed_time_s": {
          "minimum": 0,
          "title": "Elapsed Time S",
          "type": "number"
        },
        "state_id": {
          "minLength": 1,
          "title": "State Id",
          "type": "string"
        },
        "response_value": {
          "title": "Response Value",
          "type": "number"
        },
        "expanded_response_uncertainty": {
          "minimum": 0,
          "title": "Expanded Response Uncertainty",
          "type": "number"
        },
        "response_unit_token": {
          "minLength": 1,
          "title": "Response Unit Token",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "observation_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Observation Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "observation_kind",
        "sequence_index",
        "elapsed_time_s",
        "state_id",
        "response_value",
        "expanded_response_uncertainty",
        "response_unit_token",
        "source_group_id",
        "observation_record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "BlankBackgroundObservation",
      "type": "object"
    },
    "DetectionCapabilityEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "detection_threshold",
            "response_uncertainty_profile"
          ],
          "title": "Mode",
          "type": "string"
        },
        "detection_threshold_response": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Threshold Response"
        },
        "response_unit_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Unit Token"
        },
        "uncertainty_profile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Profile Id"
        },
        "uncertainty_profile_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Profile Digest"
        },
        "capability_definition": {
          "minLength": 1,
          "title": "Capability Definition",
          "type": "string"
        },
        "capability_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Capability Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "mode",
        "capability_definition",
        "capability_record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "DetectionCapabilityEvidence",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "LeakCampaignAcceptanceProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "campaign_family": {
          "enum": [
            "leak_rate",
            "vacuum_testing",
            "cryogenic_leak_testing"
          ],
          "title": "Campaign Family",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/LeakCampaignQualityCriterion"
          },
          "minItems": 7,
          "title": "Criteria",
          "type": "array"
        },
        "profile_provider_id": {
          "minLength": 1,
          "title": "Profile Provider Id",
          "type": "string"
        },
        "profile_revision": {
          "minLength": 1,
          "title": "Profile Revision",
          "type": "string"
        },
        "profile_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Configuration Digest",
          "type": "string"
        },
        "caller_acceptance_authority": {
          "minLength": 1,
          "title": "Caller Acceptance Authority",
          "type": "string"
        },
        "built_in_standard_criteria_used": {
          "const": false,
          "default": false,
          "title": "Built In Standard Criteria Used",
          "type": "boolean"
        },
        "physical_qualification_claimed": {
          "const": false,
          "default": false,
          "title": "Physical Qualification Claimed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "campaign_family",
        "criteria",
        "profile_provider_id",
        "profile_revision",
        "profile_configuration_digest",
        "caller_acceptance_authority",
        "evidence"
      ],
      "title": "LeakCampaignAcceptanceProfile",
      "type": "object"
    },
    "LeakCampaignQualityCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "metric_id": {
          "enum": [
            "reference_point_count",
            "distinct_reference_level_count",
            "blank_background_count",
            "mean_absolute_blank_background_response",
            "maximum_repeatability_relative_standard_deviation",
            "maximum_drift_relative_change",
            "maximum_relative_response_uncertainty",
            "detection_threshold_response"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Direction",
          "type": "string"
        },
        "pass_limit": {
          "minimum": 0,
          "title": "Pass Limit",
          "type": "number"
        },
        "fail_limit": {
          "minimum": 0,
          "title": "Fail Limit",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "metric_id",
        "direction",
        "pass_limit",
        "fail_limit",
        "unit_token",
        "criterion_basis"
      ],
      "title": "LeakCampaignQualityCriterion",
      "type": "object"
    },
