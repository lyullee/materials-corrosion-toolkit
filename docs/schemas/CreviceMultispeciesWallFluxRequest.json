    "exact_shared_clock_and_cell_mapping_reviewed": {
      "title": "Exact Shared Clock And Cell Mapping Reviewed",
      "type": "boolean"
    },
    "independent_species_wall_laws_reviewed": {
      "title": "Independent Species Wall Laws Reviewed",
      "type": "boolean"
    },
    "linear_inter_knot_reconstruction_reviewed": {
      "title": "Linear Inter Knot Reconstruction Reviewed",
      "type": "boolean"
    },
    "wall_flux_sign_and_surface_state_reviewed": {
      "title": "Wall Flux Sign And Surface State Reviewed",
      "type": "boolean"
    },
    "transport_species_order_reviewed": {
      "title": "Transport Species Order Reviewed",
      "type": "boolean"
    }
