{
  "$defs": {
    "ButlerVolmerReaction": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "calibration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Sha256",
          "type": "string"
        },
        "exchange_current_density_A_m2": {
          "minimum": 0,
          "title": "Exchange Current Density A M2",
          "type": "number"
        },
        "electron_count": {
          "exclusiveMinimum": 0,
          "title": "Electron Count",
          "type": "integer"
        },
        "anodic_transfer_coefficient": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Anodic Transfer Coefficient",
          "type": "number"
        },
        "cathodic_transfer_coefficient": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Cathodic Transfer Coefficient",
          "type": "number"
        },
        "equilibrium_potential_V": {
          "title": "Equilibrium Potential V",
          "type": "number"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "minimum_overpotential_V": {
          "title": "Minimum Overpotential V",
          "type": "number"
        },
        "maximum_overpotential_V": {
          "title": "Maximum Overpotential V",
          "type": "number"
        },
        "stoichiometric_species_coefficients": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stoichiometric Species Coefficients",
          "type": "object"
        },
        "calibration_and_reaction_direction_reviewed": {
          "title": "Calibration And Reaction Direction Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "reaction_id",
        "calibration_sha256",
        "exchange_current_density_A_m2",
        "electron_count",
        "anodic_transfer_coefficient",
        "cathodic_transfer_coefficient",
        "equilibrium_potential_V",
        "temperature_K",
        "minimum_overpotential_V",
        "maximum_overpotential_V",
        "stoichiometric_species_coefficients",
        "calibration_and_reaction_direction_reviewed"
      ],
      "title": "ButlerVolmerReaction",
      "type": "object"
    },
    "CarbonateTransportBoundary": {
      "additionalProperties": false,
      "properties": {
        "boundary_id": {
          "title": "Boundary Id",
          "type": "string"
        },
        "equilibrium_result_sha256": {
          "title": "Equilibrium Result Sha256",
          "type": "string"
        },
        "selection_sha256": {
          "title": "Selection Sha256",
          "type": "string"
        },
        "species_ids": {
          "items": {
            "type": "string"
          },
          "title": "Species Ids",
          "type": "array"
        },
        "concentration_mol_m3": {
          "items": {
            "type": "number"
          },
          "title": "Concentration Mol M3",
          "type": "array"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "solvent_composition_sha256": {
          "title": "Solvent Composition Sha256",
          "type": "string"
        },
        "interpretation": {
          "title": "Interpretation",
          "type": "string"
        }
      },
      "required": [
        "boundary_id",
        "equilibrium_result_sha256",
        "selection_sha256",
        "species_ids",
        "concentration_mol_m3",
        "temperature_K",
        "solvent_composition_sha256",
        "interpretation"
      ],
      "title": "CarbonateTransportBoundary",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "WetCo2MetalToScaleYield": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "metal_atoms_per_reaction_extent": {
          "exclusiveMinimum": 0,
          "title": "Metal Atoms Per Reaction Extent",
          "type": "number"
        },
        "metal_molar_mass_kg_mol": {
          "exclusiveMinimum": 0,
          "title": "Metal Molar Mass Kg Mol",
          "type": "number"
        },
        "metal_density_kg_m3": {
          "exclusiveMinimum": 0,
          "title": "Metal Density Kg M3",
          "type": "number"
        },
        "scale_moles_per_metal_mole": {
          "minimum": 0,
          "title": "Scale Moles Per Metal Mole",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "alloy_volume_additivity_reviewed": {
          "title": "Alloy Volume Additivity Reviewed",
          "type": "boolean"
        },
        "metal_to_scale_stoichiometry_reviewed": {
          "title": "Metal To Scale Stoichiometry Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "reaction_id",
        "metal_atoms_per_reaction_extent",
        "metal_molar_mass_kg_mol",
        "metal_density_kg_m3",
        "scale_moles_per_metal_mole",
        "provider_id",
        "provider_revision",
        "source_record_id",
        "evidence",
        "alloy_volume_additivity_reviewed",
        "metal_to_scale_stoichiometry_reviewed"
      ],
      "title": "WetCo2MetalToScaleYield",
      "type": "object"
    },
    "WetCo2MovingScaleInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "mixed_potential_request": {
          "$ref": "#/$defs/WetCo2TransportLimitedMixedPotentialRequest"
        },
        "external_net_scale_formation_flux_mol_m2_s": {
          "title": "External Net Scale Formation Flux Mol M2 S",
          "type": "number"
        },
        "external_flux_provider_id": {
          "minLength": 1,
          "title": "External Flux Provider Id",
          "type": "string"
        },
        "external_flux_provider_revision": {
          "minLength": 1,
          "title": "External Flux Provider Revision",
          "type": "string"
        },
        "external_flux_source_record_id": {
          "minLength": 1,
          "title": "External Flux Source Record Id",
          "type": "string"
        },
        "external_flux_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "external_scale_flux_reviewed": {
          "title": "External Scale Flux Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "mixed_potential_request",
        "external_net_scale_formation_flux_mol_m2_s",
        "external_flux_provider_id",
        "external_flux_provider_revision",
        "external_flux_source_record_id",
        "external_flux_evidence",
        "external_scale_flux_reviewed"
      ],
      "title": "WetCo2MovingScaleInterval",
      "type": "object"
    },
    "WetCo2ReactantFilmRecord": {
      "additionalProperties": false,
      "description": "Caller-supplied linear liquid-film conductance for one consumed species.",
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "diffusivity_m2_s": {
          "exclusiveMinimum": 0,
          "title": "Diffusivity M2 S",
          "type": "number"
        },
        "film_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Film Thickness M",
          "type": "number"
        },
        "minimum_surface_concentration_mol_m3": {
          "default": 0.0,
          "minimum": 0,
          "title": "Minimum Surface Concentration Mol M3",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "transfer_parameter_reviewed": {
          "title": "Transfer Parameter Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "species_id",
        "diffusivity_m2_s",
        "film_thickness_m",
        "provider_id",
        "provider_revision",
        "source_record_id",
        "evidence",
        "transfer_parameter_reviewed"
      ],
      "title": "WetCo2ReactantFilmRecord",
      "type": "object"
    },
    "WetCo2TransportLimitedMixedPotentialRequest": {
      "additionalProperties": false,
      "properties": {
        "boundary": {
          "$ref": "#/$defs/CarbonateTransportBoundary"
        },
        "boundary_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Boundary Sha256",
          "type": "string"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/ButlerVolmerReaction"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Reactions",
          "type": "array"
        },
        "reactant_films": {
          "items": {
            "$ref": "#/$defs/WetCo2ReactantFilmRecord"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Reactant Films",
          "type": "array"
        },
        "potential_absolute_tolerance_V": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "title": "Potential Absolute Tolerance V",
          "type": "number"
        },
        "maximum_bisection_iterations": {
          "default": 200,
          "maximum": 500,
          "minimum": 1,
          "title": "Maximum Bisection Iterations",
          "type": "integer"
        },
        "boundary_scope_match_reviewed": {
          "title": "Boundary Scope Match Reviewed",
          "type": "boolean"
        },
        "species_direction_and_reaction_mapping_reviewed": {
          "title": "Species Direction And Reaction Mapping Reviewed",
          "type": "boolean"
        },
        "planar_steady_film_approximation_reviewed": {
          "title": "Planar Steady Film Approximation Reviewed",
          "type": "boolean"
        },
        "common_temperature_and_solution_reference_reviewed": {
          "title": "Common Temperature And Solution Reference Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "boundary",
        "boundary_sha256",
        "reactions",
        "reactant_films",
        "boundary_scope_match_reviewed",
        "species_direction_and_reaction_mapping_reviewed",
        "planar_steady_film_approximation_reviewed",
        "common_temperature_and_solution_reference_reviewed"
      ],
      "title": "WetCo2TransportLimitedMixedPotentialRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "initial_wall_thickness_m": {
      "exclusiveMinimum": 0,
      "title": "Initial Wall Thickness M",
      "type": "number"
    },
    "initial_scale_thickness_m": {
      "exclusiveMinimum": 0,
      "title": "Initial Scale Thickness M",
      "type": "number"
    },
    "scale_molar_volume_m3_mol": {
      "exclusiveMinimum": 0,
      "title": "Scale Molar Volume M3 Mol",
      "type": "number"
    },
    "scale_property_provider_id": {
      "minLength": 1,
      "title": "Scale Property Provider Id",
      "type": "string"
    },
    "scale_property_provider_revision": {
      "minLength": 1,
      "title": "Scale Property Provider Revision",
      "type": "string"
    },
    "scale_property_source_record_id": {
      "minLength": 1,
      "title": "Scale Property Source Record Id",
      "type": "string"
    },
    "scale_property_evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "metal_to_scale_yields": {
      "items": {
        "$ref": "#/$defs/WetCo2MetalToScaleYield"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Metal To Scale Yields",
      "type": "array"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/WetCo2MovingScaleInterval"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "initial_geometry_and_attachment_reviewed": {
      "title": "Initial Geometry And Attachment Reviewed",
      "type": "boolean"
    },
    "interval_clock_and_asset_scope_reviewed": {
      "title": "Interval Clock And Asset Scope Reviewed",
      "type": "boolean"
    },
    "piecewise_constant_operator_split_reviewed": {
      "title": "Piecewise Constant Operator Split Reviewed",
      "type": "boolean"
    },
    "uniform_wall_recession_and_volume_additivity_reviewed": {
      "title": "Uniform Wall Recession And Volume Additivity Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "initial_wall_thickness_m",
    "initial_scale_thickness_m",
    "scale_molar_volume_m3_mol",
    "scale_property_provider_id",
    "scale_property_provider_revision",
    "scale_property_source_record_id",
    "scale_property_evidence",
    "metal_to_scale_yields",
    "intervals",
    "initial_geometry_and_attachment_reviewed",
    "interval_clock_and_asset_scope_reviewed",
    "piecewise_constant_operator_split_reviewed",
    "uniform_wall_recession_and_volume_additivity_reviewed"
  ],
  "title": "WetCo2ScaleCorrosionMovingGeometryHistoryRequest",
  "type": "object"
}