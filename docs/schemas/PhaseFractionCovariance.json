{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Observation Ids",
      "type": "array"
    },
    "expanded_covariance_matrix_fraction2": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "minItems": 1,
      "title": "Expanded Covariance Matrix Fraction2",
      "type": "array"
    },
    "expansion_factor": {
      "exclusiveMinimum": 0,
      "title": "Expansion Factor",
      "type": "number"
    },
    "covariance_basis": {
      "minLength": 1,
      "title": "Covariance Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "observation_ids",
    "expanded_covariance_matrix_fraction2",
    "expansion_factor",
    "covariance_basis",
    "evidence"
  ],
  "title": "PhaseFractionCovariance",
  "type": "object"
}