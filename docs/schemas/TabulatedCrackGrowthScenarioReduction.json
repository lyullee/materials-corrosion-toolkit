{
  "$defs": {
    "CrackGrowthScenarioEvaluation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.crack_growth_scenario_evaluation.v1",
          "default": "matintegrity.crack_growth_scenario_evaluation.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "evaluator_id": {
          "minLength": 1,
          "title": "Evaluator Id",
          "type": "string"
        },
        "evaluator_revision": {
          "minLength": 1,
          "title": "Evaluator Revision",
          "type": "string"
        },
        "evaluator_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evaluator Configuration Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "needs_data",
            "out_of_scope",
            "invalid_input",
            "execution_failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "final_depth_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Depth M"
        },
        "cycles_evaluated": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cycles Evaluated"
        },
        "termination_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Termination Reason"
        },
        "result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "input_sha256",
        "evaluator_id",
        "evaluator_revision",
        "evaluator_configuration_sha256",
        "status",
        "result_sha256"
      ],
      "title": "CrackGrowthScenarioEvaluation",
      "type": "object"
    },
    "CrackGrowthScenarioManifestRow": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.crack_growth_scenario_manifest_row.v1",
          "default": "matintegrity.crack_growth_scenario_manifest_row.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "normalized_weight": {
          "exclusiveMinimum": 0,
          "title": "Normalized Weight",
          "type": "number"
        },
        "joint_scenario_source_id": {
          "minLength": 1,
          "title": "Joint Scenario Source Id",
          "type": "string"
        },
        "joint_scenario_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Joint Scenario Source Sha256",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "normalized_weight",
        "joint_scenario_source_id",
        "joint_scenario_source_sha256",
        "input_sha256",
        "physical_scope_id"
      ],
      "title": "CrackGrowthScenarioManifestRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.tabulated_crack_growth_scenario_reduction.v1",
      "default": "matintegrity.tabulated_crack_growth_scenario_reduction.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "ensemble_run_id": {
      "minLength": 1,
      "title": "Ensemble Run Id",
      "type": "string"
    },
    "distribution_definition_id": {
      "minLength": 1,
      "title": "Distribution Definition Id",
      "type": "string"
    },
    "sample_design_id": {
      "minLength": 1,
      "title": "Sample Design Id",
      "type": "string"
    },
    "manifest": {
      "items": {
        "$ref": "#/$defs/CrackGrowthScenarioManifestRow"
      },
      "minItems": 2,
      "title": "Manifest",
      "type": "array"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/CrackGrowthScenarioEvaluation"
      },
      "minItems": 2,
      "title": "Evaluations",
      "type": "array"
    },
    "requested_quantiles": {
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "title": "Requested Quantiles",
      "type": "array"
    },
    "depth_exceedance_threshold_m": {
      "exclusiveMinimum": 0,
      "title": "Depth Exceedance Threshold M",
      "type": "number"
    },
    "maximum_weight_sum_error": {
      "exclusiveMinimum": 0,
      "maximum": 1e-06,
      "title": "Maximum Weight Sum Error",
      "type": "number"
    },
    "evaluator_id": {
      "minLength": 1,
      "title": "Evaluator Id",
      "type": "string"
    },
    "evaluator_revision": {
      "minLength": 1,
      "title": "Evaluator Revision",
      "type": "string"
    },
    "evaluator_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evaluator Configuration Sha256",
      "type": "string"
    },
    "external_evaluations_reviewed": {
      "const": true,
      "title": "External Evaluations Reviewed",
      "type": "boolean"
    },
    "normalized_weight_meaning_reviewed": {
      "const": true,
      "title": "Normalized Weight Meaning Reviewed",
      "type": "boolean"
    },
    "common_physical_scope_reviewed": {
      "const": true,
      "title": "Common Physical Scope Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "ensemble_run_id",
    "distribution_definition_id",
    "sample_design_id",
    "manifest",
    "evaluations",
    "requested_quantiles",
    "depth_exceedance_threshold_m",
    "maximum_weight_sum_error",
    "evaluator_id",
    "evaluator_revision",
    "evaluator_configuration_sha256",
    "external_evaluations_reviewed",
    "normalized_weight_meaning_reviewed",
    "common_physical_scope_reviewed"
  ],
  "title": "TabulatedCrackGrowthScenarioReduction",
  "type": "object"
}