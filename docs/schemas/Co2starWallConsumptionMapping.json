{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-owned uptake stoichiometry from one removed-metal basis to neutral CO2*.",
  "properties": {
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "co2star_consumed_mol_per_metal_mol": {
      "minimum": 0,
      "title": "Co2Star Consumed Mol Per Metal Mol",
      "type": "number"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "source_record_id": {
      "minLength": 1,
      "title": "Source Record Id",
      "type": "string"
    },
    "provider_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Configuration Sha256",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "reaction_and_carbon_balance_reviewed": {
      "title": "Reaction And Carbon Balance Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "reaction_id",
    "co2star_consumed_mol_per_metal_mol",
    "provider_id",
    "provider_revision",
    "source_record_id",
    "provider_configuration_sha256",
    "record_sha256",
    "reaction_and_carbon_balance_reviewed",
    "evidence"
  ],
  "title": "Co2starWallConsumptionMapping",
  "type": "object"
}