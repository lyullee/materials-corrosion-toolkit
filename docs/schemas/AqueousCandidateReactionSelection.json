{
  "additionalProperties": false,
  "description": "A manually selected balanced candidate with caller-owned equilibrium data.",
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "direction": {
      "enum": [
        "candidate_forward",
        "candidate_reverse"
      ],
      "title": "Direction",
      "type": "string"
    },
    "log10_equilibrium_constant": {
      "title": "Log10 Equilibrium Constant",
      "type": "number"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "equilibrium_parameter_set_id": {
      "minLength": 1,
      "title": "Equilibrium Parameter Set Id",
      "type": "string"
    },
    "equilibrium_record_id": {
      "minLength": 1,
      "title": "Equilibrium Record Id",
      "type": "string"
    },
    "equilibrium_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Equilibrium Record Sha256",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "candidate_sha256",
    "reaction_id",
    "direction",
    "log10_equilibrium_constant",
    "temperature_K",
    "equilibrium_parameter_set_id",
    "equilibrium_record_id",
    "equilibrium_record_sha256"
  ],
  "title": "AqueousCandidateReactionSelection",
  "type": "object"
}