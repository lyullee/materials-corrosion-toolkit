{
  "additionalProperties": false,
  "description": "Digest-bound local-time path between two reviewed steady slit-flow states.",
  "properties": {
    "path_id": {
      "minLength": 1,
      "title": "Path Id",
      "type": "string"
    },
    "global_start_time_s": {
      "minimum": 0,
      "title": "Global Start Time S",
      "type": "number"
    },
    "global_end_time_s": {
      "exclusiveMinimum": 0,
      "title": "Global End Time S",
      "type": "number"
    },
    "start_face_velocity_m_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 2001,
      "minItems": 3,
      "title": "Start Face Velocity M S",
      "type": "array"
    },
    "end_face_velocity_m_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 2001,
      "minItems": 3,
      "title": "End Face Velocity M S",
      "type": "array"
    },
    "start_hydraulic_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Start Hydraulic Result Sha256",
      "type": "string"
    },
    "end_hydraulic_input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "End Hydraulic Input Sha256",
      "type": "string"
    },
    "end_hydraulic_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "End Hydraulic Result Sha256",
      "type": "string"
    },
    "end_pressure_drop_Pa": {
      "title": "End Pressure Drop Pa",
      "type": "number"
    },
    "pressure_history_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pressure History Source Sha256",
      "type": "string"
    },
    "fluid_property_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Fluid Property Source Sha256",
      "type": "string"
    },
    "end_pressure_interpolation_lineage": {
      "additionalProperties": true,
      "title": "End Pressure Interpolation Lineage",
      "type": "object"
    },
    "endpoint_velocity_interpolation_reviewed": {
      "title": "Endpoint Velocity Interpolation Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "path_id",
    "global_start_time_s",
    "global_end_time_s",
    "start_face_velocity_m_s",
    "end_face_velocity_m_s",
    "start_hydraulic_result_sha256",
    "end_hydraulic_input_sha256",
    "end_hydraulic_result_sha256",
    "end_pressure_drop_Pa",
    "pressure_history_source_sha256",
    "fluid_property_source_sha256",
    "end_pressure_interpolation_lineage",
    "endpoint_velocity_interpolation_reviewed"
  ],
  "title": "PlanarSlitEndpointVelocityPath",
  "type": "object"
}