  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "clock_id",
    "material_condition_id",
    "metallurgy_id",
    "heat_treatment_id",
    "exposures",
    "qualification_envelope",
    "material_metallurgy_and_heat_treatment_reviewed",
