        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "metallurgy_id": {
          "minLength": 1,
          "title": "Metallurgy Id",
          "type": "string"
        },
        "heat_treatment_id": {
