          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "metallurgy_id": {
          "minLength": 1,
          "title": "Metallurgy Id",
          "type": "string"
        },
        "heat_treatment_id": {
          "minLength": 1,
          "title": "Heat Treatment Id",
          "type": "string"
        },
        "supported_ammonia_phases": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Ammonia Phases",
          "type": "array"
        },
        "ammonia_concentration_unit": {
          "minLength": 1,
          "title": "Ammonia Concentration Unit",
          "type": "string"
        },
        "minimum_ammonia_concentration": {
          "minimum": 0,
          "title": "Minimum Ammonia Concentration",
          "type": "number"
        },
        "maximum_ammonia_concentration": {
          "minimum": 0,
          "title": "Maximum Ammonia Concentration",
          "type": "number"
        },
        "supported_water_state_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Water State Descriptors",
          "type": "array"
        },
        "supported_oxygen_state_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Oxygen State Descriptors",
          "type": "array"
        },
        "supported_impurity_state_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Impurity State Descriptors",
          "type": "array"
        },
        "minimum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "supported_applied_stress_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Applied Stress Descriptors",
          "type": "array"
        },
        "supported_residual_stress_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Residual Stress Descriptors",
          "type": "array"
        },
        "maximum_cumulative_exposure_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Cumulative Exposure S",
          "type": "number"
        },
        "test_evidence": {
          "items": {
            "$ref": "#/$defs/AmmoniaSCCTestEvidence"
          },
          "minItems": 1,
          "title": "Test Evidence",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "material_condition_id",
        "metallurgy_id",
        "heat_treatment_id",
        "supported_ammonia_phases",
        "ammonia_concentration_unit",
        "minimum_ammonia_concentration",
        "maximum_ammonia_concentration",
        "supported_water_state_descriptors",
        "supported_oxygen_state_descriptors",
        "supported_impurity_state_descriptors",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "supported_applied_stress_descriptors",
        "supported_residual_stress_descriptors",
        "maximum_cumulative_exposure_s",
        "test_evidence",
        "evidence"
      ],
      "title": "AmmoniaSCCEnvelope",
      "type": "object"
    },
    "AmmoniaSCCExposure": {
