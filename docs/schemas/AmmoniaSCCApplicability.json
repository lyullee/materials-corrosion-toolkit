      "properties": {
        "exposure_id": {
          "minLength": 1,
          "title": "Exposure Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "ammonia_phase": {
          "minLength": 1,
          "title": "Ammonia Phase",
          "type": "string"
        },
        "ammonia_concentration": {
          "minimum": 0,
          "title": "Ammonia Concentration",
          "type": "number"
        },
        "ammonia_concentration_unit": {
          "minLength": 1,
          "title": "Ammonia Concentration Unit",
          "type": "string"
        },
        "water_state_descriptor": {
          "minLength": 1,
          "title": "Water State Descriptor",
          "type": "string"
        },
        "oxygen_state_descriptor": {
          "minLength": 1,
          "title": "Oxygen State Descriptor",
          "type": "string"
        },
        "impurity_state_descriptor": {
          "minLength": 1,
          "title": "Impurity State Descriptor",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "applied_stress_descriptor": {
          "minLength": 1,
          "title": "Applied Stress Descriptor",
          "type": "string"
        },
        "residual_stress_descriptor": {
          "minLength": 1,
          "title": "Residual Stress Descriptor",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "exposure_id",
        "start_time_s",
        "end_time_s",
        "ammonia_phase",
        "ammonia_concentration",
        "ammonia_concentration_unit",
        "water_state_descriptor",
        "oxygen_state_descriptor",
        "impurity_state_descriptor",
        "temperature_K",
        "applied_stress_descriptor",
        "residual_stress_descriptor",
        "record_valid",
        "evidence"
      ],
      "title": "AmmoniaSCCExposure",
      "type": "object"
    },
    "AmmoniaSCCTestEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_record_id": {
