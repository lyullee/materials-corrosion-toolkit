{
  "$defs": {
    "CMSX6LISReadAuthorization": {
      "additionalProperties": false,
      "description": "Caller attribution and local-only computational-use declaration.",
      "properties": {
        "dataset_id": {
          "const": "cmsx6-creep",
          "default": "cmsx6-creep",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_doi": {
          "const": "10.5281/zenodo.14750432",
          "default": "10.5281/zenodo.14750432",
          "title": "Dataset Doi",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "computational_use_authorized": {
          "const": true,
          "title": "Computational Use Authorized",
          "type": "boolean"
        },
        "local_only_authorized": {
          "const": true,
          "title": "Local Only Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "attribution",
        "computational_use_authorized",
        "local_only_authorized"
      ],
      "title": "CMSX6LISReadAuthorization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "local_file_path": {
      "minLength": 1,
      "title": "Local File Path",
      "type": "string"
    },
    "authorization": {
      "$ref": "#/$defs/CMSX6LISReadAuthorization"
    }
  },
  "required": [
    "local_file_path",
    "authorization"
  ],
  "title": "CMSX6LISReadRequest",
  "type": "object"
}