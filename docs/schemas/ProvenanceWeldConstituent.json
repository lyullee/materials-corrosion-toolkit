{
  "additionalProperties": false,
  "properties": {
    "material_id": {
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "base",
        "filler",
        "previous_layer"
      ],
      "title": "Role",
      "type": "string"
    },
    "melted_mass_kg": {
      "exclusiveMinimum": 0,
      "title": "Melted Mass Kg",
      "type": "number"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "composition_mass_fraction": {
      "patternProperties": {
        "^[A-Z][a-z]?$": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "Composition Mass Fraction",
      "type": "object"
    }
  },
  "required": [
    "material_id",
    "role",
    "melted_mass_kg",
    "source_id",
    "record_sha256",
    "composition_mass_fraction"
  ],
  "title": "ProvenanceWeldConstituent",
  "type": "object"
}