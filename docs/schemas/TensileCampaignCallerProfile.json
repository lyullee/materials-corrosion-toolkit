{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TensileMetricCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "metric": {
          "enum": [
            "elastic_modulus",
            "offset_yield_strength",
            "ultimate_tensile_strength",
            "elongation",
            "reduction_of_area"
          ],
          "title": "Metric",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_acceptable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Acceptable"
        },
        "maximum_acceptable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Acceptable"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "metric",
        "unit_token",
        "criterion_basis",
        "evidence"
      ],
      "title": "TensileMetricCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "product_id": {
      "minLength": 1,
      "title": "Product Id",
      "type": "string"
    },
    "heat_id": {
      "minLength": 1,
      "title": "Heat Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "supported_orientation_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Orientation Ids",
      "type": "array"
    },
    "supported_geometry_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Supported Geometry Ids",
      "type": "array"
    },
    "geometry_unit_token": {
      "minLength": 1,
      "title": "Geometry Unit Token",
      "type": "string"
    },
    "area_unit_token": {
      "minLength": 1,
      "title": "Area Unit Token",
      "type": "string"
    },
    "required_machine_id": {
      "minLength": 1,
      "title": "Required Machine Id",
      "type": "string"
    },
    "required_load_cell_id": {
      "minLength": 1,
      "title": "Required Load Cell Id",
      "type": "string"
    },
    "required_extensometer_id": {
      "minLength": 1,
      "title": "Required Extensometer Id",
      "type": "string"
    },
    "minimum_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Temperature K",
      "type": "number"
    },
    "maximum_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Temperature K",
      "type": "number"
    },
    "minimum_strain_rate_per_s": {
      "exclusiveMinimum": 0,
      "title": "Minimum Strain Rate Per S",
      "type": "number"
    },
    "maximum_strain_rate_per_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Strain Rate Per S",
      "type": "number"
    },
    "required_offset_definition_id": {
      "minLength": 1,
      "title": "Required Offset Definition Id",
      "type": "string"
    },
    "required_offset_strain": {
      "minimum": 0,
      "title": "Required Offset Strain",
      "type": "number"
    },
    "offset_strain_tolerance": {
      "minimum": 0,
      "title": "Offset Strain Tolerance",
      "type": "number"
    },
    "required_metrics": {
      "items": {
        "enum": [
          "elastic_modulus",
          "offset_yield_strength",
          "ultimate_tensile_strength",
          "elongation",
          "reduction_of_area"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Metrics",
      "type": "array"
    },
    "metric_criteria": {
      "items": {
        "$ref": "#/$defs/TensileMetricCriterion"
      },
      "minItems": 1,
      "title": "Metric Criteria",
      "type": "array"
    },
    "minimum_valid_test_count": {
      "minimum": 1,
      "title": "Minimum Valid Test Count",
      "type": "integer"
    },
    "minimum_independence_group_count": {
      "minimum": 1,
      "title": "Minimum Independence Group Count",
      "type": "integer"
    },
    "caller_validity_policy_id": {
      "minLength": 1,
      "title": "Caller Validity Policy Id",
      "type": "string"
    },
    "profile_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Source Digest",
      "type": "string"
    },
    "built_in_standard_rules_used": {
      "const": false,
      "default": false,
      "title": "Built In Standard Rules Used",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_revision",
    "product_id",
    "heat_id",
    "material_condition_id",
    "supported_orientation_ids",
    "supported_geometry_ids",
    "geometry_unit_token",
    "area_unit_token",
    "required_machine_id",
    "required_load_cell_id",
    "required_extensometer_id",
    "minimum_temperature_K",
    "maximum_temperature_K",
    "minimum_strain_rate_per_s",
    "maximum_strain_rate_per_s",
    "required_offset_definition_id",
    "required_offset_strain",
    "offset_strain_tolerance",
    "required_metrics",
    "metric_criteria",
    "minimum_valid_test_count",
    "minimum_independence_group_count",
    "caller_validity_policy_id",
    "profile_source_digest",
    "evidence"
  ],
  "title": "TensileCampaignCallerProfile",
  "type": "object"
}