{
  "$defs": {
    "InterpolatedStrengthSample": {
      "additionalProperties": false,
      "properties": {
        "sample_id": {
          "title": "Sample Id",
          "type": "string"
        },
        "sample_role": {
          "enum": [
            "nominal",
            "uncertainty_realization"
          ],
          "title": "Sample Role",
          "type": "string"
        },
        "response_value": {
          "title": "Response Value",
          "type": "number"
        },
        "response_unit_token": {
          "title": "Response Unit Token",
          "type": "string"
        },
        "sample_weight": {
          "title": "Sample Weight",
          "type": "number"
        },
        "interpolation_brackets": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Interpolation Brackets",
          "type": "object"
        },
        "geometry_source_digest": {
          "title": "Geometry Source Digest",
          "type": "string"
        }
      },
      "required": [
        "sample_id",
        "sample_role",
        "response_value",
        "response_unit_token",
        "sample_weight",
        "interpolation_brackets",
        "geometry_source_digest"
      ],
      "title": "InterpolatedStrengthSample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluation_id": {
      "title": "Evaluation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "review",
        "needs_data"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_basis": {
      "title": "Status Basis",
      "type": "string"
    },
    "conservative_response": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conservative Response"
    },
    "response_unit_token": {
      "title": "Response Unit Token",
      "type": "string"
    },
    "governing_sample_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Governing Sample Id"
    },
    "interpolated_samples": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InterpolatedStrengthSample"
      },
      "title": "Interpolated Samples",
      "type": "array"
    },
    "unsupported_sample_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unsupported Sample Ids",
      "type": "array"
    },
    "mismatch_fields": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Mismatch Fields",
      "type": "array"
    },
    "surface_digest": {
      "title": "Surface Digest",
      "type": "string"
    },
    "input_digest": {
      "title": "Input Digest",
      "type": "string"
    },
    "report_digest": {
      "title": "Report Digest",
      "type": "string"
    },
    "qualification_claim": {
      "const": false,
      "default": false,
      "title": "Qualification Claim",
      "type": "boolean"
    },
    "physical_validation_claim": {
      "const": false,
      "default": false,
      "title": "Physical Validation Claim",
      "type": "boolean"
    }
  },
  "required": [
    "evaluation_id",
    "status",
    "status_basis",
    "response_unit_token",
    "surface_digest",
    "input_digest",
    "report_digest"
  ],
  "title": "RemainingStrengthEvaluationReport",
  "type": "object"
}