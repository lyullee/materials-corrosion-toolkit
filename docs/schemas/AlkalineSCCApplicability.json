        "concentration_unit": {
          "minLength": 1,
          "title": "Concentration Unit",
          "type": "string"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
