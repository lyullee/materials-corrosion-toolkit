{
  "$defs": {
    "AECoordinateRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.controlled_ae_coordinate.v1",
          "default": "matintegrity.controlled_ae_coordinate.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "coordinate_kind": {
          "enum": [
            "sensor",
            "provider_wire_source"
          ],
          "title": "Coordinate Kind",
          "type": "string"
        },
        "identifier": {
          "minLength": 1,
          "title": "Identifier",
          "type": "string"
        },
        "x_m": {
          "title": "X M",
          "type": "number"
        },
        "y_m": {
          "title": "Y M",
          "type": "number"
        },
        "z_m": {
          "title": "Z M",
          "type": "number"
        }
      },
      "required": [
        "coordinate_kind",
        "identifier",
        "x_m",
        "y_m",
        "z_m"
      ],
      "title": "AECoordinateRecord",
      "type": "object"
    },
    "AEWaveformRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.controlled_ae_waveform.v1",
          "default": "matintegrity.controlled_ae_waveform.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_id": {
          "const": "zenodo-22011152-controlled-wire-cut-ae",
          "default": "zenodo-22011152-controlled-wire-cut-ae",
          "title": "Dataset Id",
          "type": "string"
        },
        "provider_record": {
          "const": "https://doi.org/10.5281/zenodo.22011152",
          "default": "https://doi.org/10.5281/zenodo.22011152",
          "title": "Provider Record",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "source_filename": {
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "source_file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "source_label_from_filename": {
          "pattern": "^C_[AI][0-9]$",
          "title": "Source Label From Filename",
          "type": "string"
        },
        "sensor_channel": {
          "minimum": 1,
          "title": "Sensor Channel",
          "type": "integer"
        },
        "trace_index_from_filename": {
          "minimum": 0,
          "title": "Trace Index From Filename",
          "type": "integer"
        },
        "provider_set": {
          "minimum": 0,
          "title": "Provider Set",
          "type": "integer"
        },
        "provider_index": {
          "minimum": 0,
          "title": "Provider Index",
          "type": "integer"
        },
        "provider_time_text": {
          "minLength": 1,
          "title": "Provider Time Text",
          "type": "string"
        },
        "sample_rate_Hz": {
          "const": 5000000,
          "title": "Sample Rate Hz",
          "type": "integer"
        },
        "pretrigger_samples": {
          "const": 2000,
          "title": "Pretrigger Samples",
          "type": "integer"
        },
        "sample_count": {
          "const": 16384,
          "title": "Sample Count",
          "type": "integer"
        },
        "amplitude_unit": {
          "const": "mV",
          "default": "mV",
          "title": "Amplitude Unit",
          "type": "string"
        },
        "minimum_amplitude_mV": {
          "title": "Minimum Amplitude Mv",
          "type": "number"
        },
        "maximum_amplitude_mV": {
          "title": "Maximum Amplitude Mv",
          "type": "number"
        },
        "localization_use_status": {
          "const": "raw_waveform_no_arrival_pick",
          "default": "raw_waveform_no_arrival_pick",
          "title": "Localization Use Status",
          "type": "string"
        }
      },
      "required": [
        "source_filename",
        "source_file_sha256",
        "source_label_from_filename",
        "sensor_channel",
        "trace_index_from_filename",
        "provider_set",
        "provider_index",
        "provider_time_text",
        "sample_rate_Hz",
        "pretrigger_samples",
        "sample_count",
        "minimum_amplitude_mV",
        "maximum_amplitude_mV"
      ],
      "title": "AEWaveformRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.controlled_ae_dataset_audit.v1",
      "default": "matintegrity.controlled_ae_dataset_audit.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "zenodo-22011152-controlled-wire-cut-ae",
      "default": "zenodo-22011152-controlled-wire-cut-ae",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5281/zenodo.22011152",
      "default": "https://doi.org/10.5281/zenodo.22011152",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "coordinates_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Coordinates File Sha256",
      "type": "string"
    },
    "hit_table_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Hit Table File Sha256",
      "type": "string"
    },
    "waveforms": {
      "items": {
        "$ref": "#/$defs/AEWaveformRecord"
      },
      "maxItems": 11,
      "minItems": 11,
      "title": "Waveforms",
      "type": "array"
    },
    "coordinates": {
      "items": {
        "$ref": "#/$defs/AECoordinateRecord"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Coordinates",
      "type": "array"
    },
    "waveform_count": {
      "const": 11,
      "title": "Waveform Count",
      "type": "integer"
    },
    "total_waveform_samples": {
      "const": 180224,
      "title": "Total Waveform Samples",
      "type": "integer"
    },
    "event_feature_row_count": {
      "const": 87,
      "title": "Event Feature Row Count",
      "type": "integer"
    },
    "event_feature_channel_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Event Feature Channel Counts",
      "type": "object"
    },
    "waveform_source_labels": {
      "items": {
        "enum": [
          "C_A1",
          "C_A2",
          "C_I2"
        ],
        "type": "string"
      },
      "title": "Waveform Source Labels",
      "type": "array"
    },
    "coordinate_source_labels": {
      "items": {
        "enum": [
          "C_A1",
          "C_I1"
        ],
        "type": "string"
      },
      "title": "Coordinate Source Labels",
      "type": "array"
    },
    "waveform_sources_without_coordinates": {
      "items": {
        "enum": [
          "C_A2",
          "C_I2"
        ],
        "type": "string"
      },
      "title": "Waveform Sources Without Coordinates",
      "type": "array"
    },
    "coordinate_sources_without_waveforms": {
      "items": {
        "const": "C_I1",
        "type": "string"
      },
      "title": "Coordinate Sources Without Waveforms",
      "type": "array"
    },
    "incomplete_waveform_channel_group": {
      "const": "C_A2_missing_channel_10",
      "title": "Incomplete Waveform Channel Group",
      "type": "string"
    },
    "localization_use_status": {
      "const": "withheld_missing_arrival_picks_and_source_coordinates",
      "default": "withheld_missing_arrival_picks_and_source_coordinates",
      "title": "Localization Use Status",
      "type": "string"
    }
  },
  "required": [
    "coordinates_file_sha256",
    "hit_table_file_sha256",
    "waveforms",
    "coordinates",
    "waveform_count",
    "total_waveform_samples",
    "event_feature_row_count",
    "event_feature_channel_counts",
    "waveform_source_labels",
    "coordinate_source_labels",
    "waveform_sources_without_coordinates",
    "coordinate_sources_without_waveforms",
    "incomplete_waveform_channel_group"
  ],
  "title": "ControlledAEDatasetAudit",
  "type": "object"
}