{
  "additionalProperties": false,
  "properties": {
    "id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "public_reference",
        "synthetic",
        "user_supplied"
      ],
      "title": "Kind",
      "type": "string"
    },
    "citation": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Citation",
      "type": "string"
    },
    "locator": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Locator",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    }
  },
  "required": [
    "id",
    "kind",
    "citation",
    "locator"
  ],
  "title": "PinnedProviderEvidence",
  "type": "object"
}