{
  "additionalProperties": false,
  "properties": {
    "report_schema_version": {
      "const": "matintegrity.test_water_quality_campaign_report.v1",
      "default": "matintegrity.test_water_quality_campaign_report.v1",
      "title": "Report Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "campaign_outcome": {
      "enum": [
        "accept",
        "review",
        "reject",
        "insufficient_evidence"
      ],
      "title": "Campaign Outcome",
      "type": "string"
    },
    "caller_profile_id": {
      "minLength": 1,
      "title": "Caller Profile Id",
      "type": "string"
    },
    "analyte_metric_values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Analyte Metric Values",
      "type": "object"
    },
    "criterion_findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Criterion Findings",
      "type": "array"
    },
    "diagnostics": {
      "additionalProperties": true,
      "title": "Diagnostics",
      "type": "object"
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "caller_profile_only": {
      "const": true,
      "default": true,
      "title": "Caller Profile Only",
      "type": "boolean"
    },
    "chemical_species_converted": {
      "const": false,
      "default": false,
      "title": "Chemical Species Converted",
      "type": "boolean"
    },
    "corrosion_rate_or_microbiological_risk_inferred": {
      "const": false,
      "default": false,
      "title": "Corrosion Rate Or Microbiological Risk Inferred",
      "type": "boolean"
    },
    "automatic_standard_acceptance": {
      "const": false,
      "default": false,
      "title": "Automatic Standard Acceptance",
      "type": "boolean"
    },
    "report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Digest",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "campaign_id",
    "campaign_outcome",
    "caller_profile_id",
    "analyte_metric_values",
    "criterion_findings",
    "diagnostics",
    "input_digest",
    "report_digest"
  ],
  "title": "TestWaterQualityCampaignReport",
  "type": "object"
}