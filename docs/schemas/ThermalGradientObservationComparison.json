{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ThermalHistoryObservationPair": {
      "additionalProperties": false,
      "properties": {
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "partition": {
          "enum": [
            "calibration",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "sequence_id": {
          "minLength": 1,
          "title": "Sequence Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "independence_group_id": {
          "minLength": 1,
          "title": "Independence Group Id",
          "type": "string"
        },
        "sensor_id": {
          "minLength": 1,
          "title": "Sensor Id",
          "type": "string"
        },
        "observation_clock_id": {
          "minLength": 1,
          "title": "Observation Clock Id",
          "type": "string"
        },
        "measured_elapsed_time_s": {
          "minimum": 0,
          "title": "Measured Elapsed Time S",
          "type": "number"
        },
        "predicted_elapsed_time_s": {
          "minimum": 0,
          "title": "Predicted Elapsed Time S",
          "type": "number"
        },
        "predicted_sensor_position_m": {
          "minimum": 0,
          "title": "Predicted Sensor Position M",
          "type": "number"
        },
        "measured_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Measured Temperature K",
          "type": "number"
        },
        "expanded_measured_temperature_uncertainty_K": {
          "minimum": 0,
          "title": "Expanded Measured Temperature Uncertainty K",
          "type": "number"
        },
        "predicted_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Predicted Temperature K",
          "type": "number"
        },
        "expanded_predicted_temperature_uncertainty_K": {
          "minimum": 0,
          "title": "Expanded Predicted Temperature Uncertainty K",
          "type": "number"
        },
        "sample_weight": {
          "exclusiveMinimum": 0,
          "title": "Sample Weight",
          "type": "number"
        },
        "measured_history_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Measured History Digest",
          "type": "string"
        },
        "predicted_history_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Predicted History Digest",
          "type": "string"
        },
        "pair_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Pair Record Digest",
          "type": "string"
        },
        "record_available": {
          "title": "Record Available",
          "type": "boolean"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "partition",
        "sequence_id",
        "physical_specimen_id",
        "source_group_id",
        "independence_group_id",
        "sensor_id",
        "observation_clock_id",
        "measured_elapsed_time_s",
        "predicted_elapsed_time_s",
        "predicted_sensor_position_m",
        "measured_temperature_K",
        "expanded_measured_temperature_uncertainty_K",
        "predicted_temperature_K",
        "expanded_predicted_temperature_uncertainty_K",
        "sample_weight",
        "measured_history_digest",
        "predicted_history_digest",
        "pair_record_digest",
        "record_available",
        "record_valid",
        "evidence"
      ],
      "title": "ThermalHistoryObservationPair",
      "type": "object"
    },
