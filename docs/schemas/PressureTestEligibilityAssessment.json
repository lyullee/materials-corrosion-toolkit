{
  "$defs": {
    "DeclaredPressureTestEligibilityEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "component_type_id": {
          "minLength": 1,
          "title": "Component Type Id",
          "type": "string"
        },
        "supported_material_condition_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Material Condition Ids",
          "type": "array"
        },
        "test_method_id": {
          "minLength": 1,
          "title": "Test Method Id",
          "type": "string"
        },
        "supported_test_medium_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Test Medium Ids",
          "type": "array"
        },
        "pressure_basis": {
          "enum": [
            "absolute",
            "gauge",
            "differential"
          ],
          "title": "Pressure Basis",
          "type": "string"
        },
        "minimum_test_pressure_Pa": {
          "minimum": 0,
          "title": "Minimum Test Pressure Pa",
          "type": "number"
        },
        "maximum_test_pressure_Pa": {
          "exclusiveMinimum": 0,
          "title": "Maximum Test Pressure Pa",
          "type": "number"
        },
        "minimum_test_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Test Temperature K",
          "type": "number"
        },
        "maximum_test_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Test Temperature K",
          "type": "number"
        },
        "maximum_stored_energy_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Stored Energy Value"
        },
        "stored_energy_unit_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stored Energy Unit Token"
        },
        "required_requirement_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Requirement Ids",
          "type": "array"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_version": {
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "authority_basis": {
          "minLength": 1,
          "title": "Authority Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "component_type_id",
        "supported_material_condition_ids",
        "test_method_id",
        "supported_test_medium_ids",
        "pressure_basis",
        "minimum_test_pressure_Pa",
        "maximum_test_pressure_Pa",
        "minimum_test_temperature_K",
        "maximum_test_temperature_K",
        "required_requirement_ids",
        "provider_id",
        "provider_version",
        "provider_state_digest",
        "authority_basis",
        "evidence"
      ],
      "title": "DeclaredPressureTestEligibilityEnvelope",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PressureTestRequirementRecord": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement_definition": {
          "minLength": 1,
          "title": "Requirement Definition",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "satisfied",
            "not_satisfied",
            "missing"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "physical_source_group_id": {
          "minLength": 1,
          "title": "Physical Source Group Id",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_version": {
          "minLength": 1,
          "title": "Provider Version",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Digest"
        },
        "disposition_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disposition Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "requirement_id",
        "requirement_definition",
        "disposition",
        "physical_source_group_id",
        "method_id",
        "provider_id",
        "provider_version",
        "provider_state_digest",
        "evidence"
      ],
      "title": "PressureTestRequirementRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "component_type_id": {
      "minLength": 1,
      "title": "Component Type Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "test_method_id": {
      "minLength": 1,
      "title": "Test Method Id",
      "type": "string"
    },
    "test_medium_id": {
      "minLength": 1,
      "title": "Test Medium Id",
      "type": "string"
    },
    "pressure_basis": {
      "enum": [
        "absolute",
        "gauge",
        "differential"
      ],
      "title": "Pressure Basis",
      "type": "string"
    },
    "proposed_test_pressure_Pa": {
      "minimum": 0,
      "title": "Proposed Test Pressure Pa",
      "type": "number"
    },
    "minimum_test_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Test Temperature K",
      "type": "number"
    },
    "maximum_test_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Test Temperature K",
      "type": "number"
    },
    "stored_energy_value": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stored Energy Value"
    },
    "stored_energy_unit_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stored Energy Unit Token"
    },
    "boundary_and_isolation_definition": {
      "minLength": 1,
      "title": "Boundary And Isolation Definition",
      "type": "string"
    },
    "requirement_records": {
      "items": {
        "$ref": "#/$defs/PressureTestRequirementRecord"
      },
      "minItems": 1,
      "title": "Requirement Records",
      "type": "array"
    },
    "candidate_envelopes": {
      "items": {
        "$ref": "#/$defs/DeclaredPressureTestEligibilityEnvelope"
      },
      "minItems": 1,
      "title": "Candidate Envelopes",
      "type": "array"
    },
    "component_material_and_scope_reviewed": {
      "title": "Component Material And Scope Reviewed",
      "type": "boolean"
    },
    "test_method_medium_and_pressure_basis_reviewed": {
      "title": "Test Method Medium And Pressure Basis Reviewed",
      "type": "boolean"
    },
    "pressure_and_temperature_plan_reviewed": {
      "title": "Pressure And Temperature Plan Reviewed",
      "type": "boolean"
    },
    "boundary_isolation_and_stored_energy_reviewed": {
      "title": "Boundary Isolation And Stored Energy Reviewed",
      "type": "boolean"
    },
    "requirement_records_and_source_groups_reviewed": {
      "title": "Requirement Records And Source Groups Reviewed",
      "type": "boolean"
    },
    "provider_lineage_and_digests_reviewed": {
      "title": "Provider Lineage And Digests Reviewed",
      "type": "boolean"
    },
    "eligibility_envelope_authority_reviewed": {
      "title": "Eligibility Envelope Authority Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "component_type_id",
    "material_condition_id",
    "test_method_id",
    "test_medium_id",
    "pressure_basis",
    "proposed_test_pressure_Pa",
    "minimum_test_temperature_K",
    "maximum_test_temperature_K",
    "boundary_and_isolation_definition",
    "requirement_records",
    "candidate_envelopes",
    "component_material_and_scope_reviewed",
    "test_method_medium_and_pressure_basis_reviewed",
    "pressure_and_temperature_plan_reviewed",
    "boundary_isolation_and_stored_energy_reviewed",
    "requirement_records_and_source_groups_reviewed",
    "provider_lineage_and_digests_reviewed",
