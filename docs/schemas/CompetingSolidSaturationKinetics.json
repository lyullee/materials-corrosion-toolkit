{
  "$defs": {
    "CompetingSolidSaturationInterval": {
      "additionalProperties": false,
      "description": "Interval-constant, caller-supplied saturation ratios for candidate phases.",
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "saturation_ratio_by_phase": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Saturation Ratio By Phase",
          "type": "object"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "saturation_ratio_by_phase"
      ],
      "title": "CompetingSolidSaturationInterval",
      "type": "object"
    },
    "KineticAqueousSpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "charge_number": {
          "title": "Charge Number",
          "type": "integer"
        },
        "elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Elemental Composition",
          "type": "object"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "initial_concentration_mol_m3": {
          "minimum": 0,
          "title": "Initial Concentration Mol M3",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "charge_number",
        "elemental_composition",
        "source_sha256",
        "initial_concentration_mol_m3"
      ],
      "title": "KineticAqueousSpecies",
      "type": "object"
    },
    "KineticSolidPhase": {
      "additionalProperties": false,
      "properties": {
        "solid_species_id": {
          "minLength": 1,
          "title": "Solid Species Id",
          "type": "string"
        },
        "precipitation_stoichiometry": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Precipitation Stoichiometry",
          "type": "object"
        },
        "solid_elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Solid Elemental Composition",
          "type": "object"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "initial_solid_moles_per_solution_volume_mol_m3": {
          "minimum": 0,
          "title": "Initial Solid Moles Per Solution Volume Mol M3",
          "type": "number"
        }
      },
      "required": [
        "solid_species_id",
        "precipitation_stoichiometry",
        "solid_elemental_composition",
        "source_sha256",
        "initial_solid_moles_per_solution_volume_mol_m3"
      ],
      "title": "KineticSolidPhase",
      "type": "object"
    },
    "SolidSaturationRateLaw": {
      "additionalProperties": false,
      "description": "Caller-calibrated precipitation and dissolution law for one neutral phase.",
      "properties": {
        "solid_species_id": {
          "minLength": 1,
          "title": "Solid Species Id",
          "type": "string"
        },
        "precipitation_rate_constant_mol_m3_s": {
          "minimum": 0,
          "title": "Precipitation Rate Constant Mol M3 S",
          "type": "number"
        },
        "precipitation_order": {
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "title": "Precipitation Order",
          "type": "number"
        },
        "dissolution_rate_constant_mol_m3_s": {
          "minimum": 0,
          "title": "Dissolution Rate Constant Mol M3 S",
          "type": "number"
        },
        "dissolution_order": {
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "title": "Dissolution Order",
          "type": "number"
        },
        "rate_constant_reference_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Constant Reference Temperature K"
        },
        "minimum_valid_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Valid Temperature K"
        },
        "maximum_valid_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Valid Temperature K"
        },
        "precipitation_activation_energy_J_mol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precipitation Activation Energy J Mol"
        },
        "dissolution_activation_energy_J_mol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dissolution Activation Energy J Mol"
        },
        "arrhenius_parameter_applicability_reviewed": {
          "default": false,
          "title": "Arrhenius Parameter Applicability Reviewed",
          "type": "boolean"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "solid_species_id",
        "precipitation_rate_constant_mol_m3_s",
        "precipitation_order",
        "dissolution_rate_constant_mol_m3_s",
        "dissolution_order",
        "source_sha256"
      ],
      "title": "SolidSaturationRateLaw",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Map caller saturation histories to phase rates, then apply the conservative ledger.",
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "kinetic_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Kinetic Configuration Sha256",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "kinetic_parameter_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Kinetic Parameter Source Sha256",
      "type": "string"
    },
    "aqueous_species": {
      "items": {
        "$ref": "#/$defs/KineticAqueousSpecies"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Aqueous Species",
      "type": "array"
    },
    "candidate_solid_phases": {
      "items": {
        "$ref": "#/$defs/KineticSolidPhase"
      },
      "maxItems": 16,
      "minItems": 2,
      "title": "Candidate Solid Phases",
      "type": "array"
    },
    "phase_rate_laws": {
      "items": {
        "$ref": "#/$defs/SolidSaturationRateLaw"
      },
      "maxItems": 16,
      "minItems": 2,
      "title": "Phase Rate Laws",
      "type": "array"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/CompetingSolidSaturationInterval"
      },
      "maxItems": 5000,
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "absolute_balance_tolerance_mol_m3": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "title": "Absolute Balance Tolerance Mol M3",
      "type": "number"
    },
    "relative_balance_tolerance": {
      "default": 1e-09,
      "exclusiveMinimum": 0,
      "maximum": 0.01,
      "title": "Relative Balance Tolerance",
      "type": "number"
    },
    "phase_stoichiometry_and_solution_volume_reviewed": {
      "title": "Phase Stoichiometry And Solution Volume Reviewed",
      "type": "boolean"
    },
    "saturation_ratio_and_standard_state_reviewed": {
      "title": "Saturation Ratio And Standard State Reviewed",
      "type": "boolean"
    },
    "caller_rate_law_units_temperature_and_support_reviewed": {
      "title": "Caller Rate Law Units Temperature And Support Reviewed",
      "type": "boolean"
    },
    "dissolution_then_precipitation_split_order_reviewed": {
      "title": "Dissolution Then Precipitation Split Order Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "physical_scope_id",
    "provider_id",
    "provider_revision",
    "kinetic_configuration_sha256",
    "temperature_K",
    "kinetic_parameter_source_sha256",
    "aqueous_species",
    "candidate_solid_phases",
    "phase_rate_laws",
    "intervals",
    "phase_stoichiometry_and_solution_volume_reviewed",
    "saturation_ratio_and_standard_state_reviewed",
    "caller_rate_law_units_temperature_and_support_reviewed",
    "dissolution_then_precipitation_split_order_reviewed",
    "computational_use_authorized"
  ],
  "title": "CompetingSolidSaturationKinetics",
  "type": "object"
}