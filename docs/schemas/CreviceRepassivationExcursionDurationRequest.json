{
  "$defs": {
    "CreviceOperatingPotentialKnot": {
      "additionalProperties": false,
      "properties": {
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "material_id": {
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "electrolyte_record_id": {
          "minLength": 1,
          "title": "Electrolyte Record Id",
          "type": "string"
        },
        "electrolyte_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Electrolyte Sha256",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0.0,
          "title": "Temperature K",
          "type": "number"
        },
        "chloride_molality_mol_kg": {
          "minimum": 0,
          "title": "Chloride Molality Mol Kg",
          "type": "number"
        },
        "reference_electrode_id": {
          "minLength": 1,
          "title": "Reference Electrode Id",
          "type": "string"
        },
        "potential_convention_id": {
          "minLength": 1,
          "title": "Potential Convention Id",
          "type": "string"
        },
        "operating_potential_mV": {
          "title": "Operating Potential Mv",
          "type": "number"
        },
        "standard_uncertainty_mV": {
          "minimum": 0,
          "title": "Standard Uncertainty Mv",
          "type": "number"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "time_s",
        "material_id",
        "condition_id",
        "electrolyte_record_id",
        "electrolyte_sha256",
        "temperature_K",
        "chloride_molality_mol_kg",
        "reference_electrode_id",
        "potential_convention_id",
        "operating_potential_mV",
        "standard_uncertainty_mV",
        "record_sha256",
        "evidence"
      ],
      "title": "CreviceOperatingPotentialKnot",
      "type": "object"
    },
    "CreviceRepassivationMarginHistoryRequest": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "threshold_history": {
          "items": {
            "$ref": "#/$defs/CreviceRepassivationThresholdKnot"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Threshold History",
          "type": "array"
        },
        "operating_history": {
          "items": {
            "$ref": "#/$defs/CreviceOperatingPotentialKnot"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Operating History",
          "type": "array"
        },
        "uncertainty_multiplier": {
          "default": 2.0,
          "minimum": 0,
          "title": "Uncertainty Multiplier",
          "type": "number"
        },
        "exact_material_condition_and_reference_match_reviewed": {
          "title": "Exact Material Condition And Reference Match Reviewed",
          "type": "boolean"
        },
        "threshold_measurement_and_interpretation_reviewed": {
          "title": "Threshold Measurement And Interpretation Reviewed",
          "type": "boolean"
        },
        "measurement_uncertainty_basis_reviewed": {
          "title": "Measurement Uncertainty Basis Reviewed",
          "type": "boolean"
        },
        "no_extrapolation_or_probability_interpretation_reviewed": {
          "title": "No Extrapolation Or Probability Interpretation Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "assessment_id",
        "asset_id",
        "physical_scope_id",
        "threshold_history",
        "operating_history",
        "exact_material_condition_and_reference_match_reviewed",
        "threshold_measurement_and_interpretation_reviewed",
        "measurement_uncertainty_basis_reviewed",
        "no_extrapolation_or_probability_interpretation_reviewed",
        "computational_use_authorized"
      ],
      "title": "CreviceRepassivationMarginHistoryRequest",
      "type": "object"
    },
