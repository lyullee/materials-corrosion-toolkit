        },
        "temperature_K": {
          "exclusiveMinimum": 0.0,
          "title": "Temperature K",
          "type": "number"
        },
        "chloride_molality_mol_kg": {
          "minimum": 0,
          "title": "Chloride Molality Mol Kg",
          "type": "number"
        },
        "reference_electrode_id": {
          "minLength": 1,
          "title": "Reference Electrode Id",
          "type": "string"
        },
        "potential_convention_id": {
          "minLength": 1,
          "title": "Potential Convention Id",
          "type": "string"
        },
        "repassivation_potential_mV": {
          "title": "Repassivation Potential Mv",
