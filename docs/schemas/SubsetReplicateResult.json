{
  "$defs": {
    "SubsetSimulationLevel": {
      "additionalProperties": false,
      "properties": {
        "level_index": {
          "minimum": 0,
          "title": "Level Index",
          "type": "integer"
        },
        "threshold_value": {
          "title": "Threshold Value",
          "type": "number"
        },
        "conditional_probability_estimate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Conditional Probability Estimate",
          "type": "number"
        },
        "conditioned_seed_count": {
          "minimum": 0,
          "title": "Conditioned Seed Count",
          "type": "integer"
        },
        "samples_per_level": {
          "exclusiveMinimum": 0,
          "title": "Samples Per Level",
          "type": "integer"
        },
        "proposal_count": {
          "minimum": 0,
          "title": "Proposal Count",
          "type": "integer"
        },
        "proposal_acceptance_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proposal Acceptance Fraction"
        },
        "distinct_adjacent_state_fraction": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Distinct Adjacent State Fraction"
        },
        "cumulative_probability_estimate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Cumulative Probability Estimate",
          "type": "number"
        },
        "cumulative_log_probability_estimate": {
          "title": "Cumulative Log Probability Estimate",
          "type": "number"
        }
      },
      "required": [
        "level_index",
        "threshold_value",
        "conditional_probability_estimate",
        "conditioned_seed_count",
        "samples_per_level",
        "proposal_count",
        "proposal_acceptance_fraction",
        "distinct_adjacent_state_fraction",
        "cumulative_probability_estimate",
        "cumulative_log_probability_estimate"
      ],
      "title": "SubsetSimulationLevel",
      "type": "object"
    },
    "SubsetSimulationResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.subset_simulation_result.v1",
          "default": "matintegrity.subset_simulation_result.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "estimate_id": {
          "minLength": 1,
          "title": "Estimate Id",
          "type": "string"
        },
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_definition": {
          "minLength": 1,
          "title": "Event Definition",
          "type": "string"
        },
        "failure_mode": {
          "minLength": 1,
          "title": "Failure Mode",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "horizon_start_s": {
          "minimum": 0,
          "title": "Horizon Start S",
          "type": "number"
        },
        "horizon_end_s": {
          "exclusiveMinimum": 0,
          "title": "Horizon End S",
          "type": "number"
        },
        "conditioning": {
          "minLength": 1,
          "title": "Conditioning",
          "type": "string"
        },
        "event_is_first_failure_in_period_reviewed": {
          "title": "Event Is First Failure In Period Reviewed",
          "type": "boolean"
        },
        "sampler_algorithm_id": {
          "const": "pcn_subset.v1",
          "default": "pcn_subset.v1",
          "title": "Sampler Algorithm Id",
          "type": "string"
        },
        "evaluator_id": {
          "minLength": 1,
          "title": "Evaluator Id",
          "type": "string"
        },
        "evaluator_revision": {
          "minLength": 1,
          "title": "Evaluator Revision",
          "type": "string"
        },
        "evaluator_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Evaluator Configuration Sha256",
          "type": "string"
        },
        "latent_variable_ids": {
          "items": {
            "type": "string"
          },
          "title": "Latent Variable Ids",
          "type": "array"
        },
        "samples_per_level": {
          "maximum": 200000,
          "minimum": 100,
          "title": "Samples Per Level",
          "type": "integer"
        },
        "conditional_probability": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Conditional Probability",
          "type": "number"
        },
        "pcn_beta": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Pcn Beta",
          "type": "number"
        },
        "maximum_levels": {
          "maximum": 20,
          "minimum": 1,
          "title": "Maximum Levels",
          "type": "integer"
        },
        "latent_mapping_reviewed": {
          "title": "Latent Mapping Reviewed",
          "type": "boolean"
        },
        "event_semantics_reviewed": {
          "title": "Event Semantics Reviewed",
          "type": "boolean"
        },
        "deterministic_evaluator_declared": {
          "title": "Deterministic Evaluator Declared",
          "type": "boolean"
        },
        "random_seed": {
          "minimum": 0,
          "title": "Random Seed",
          "type": "integer"
        },
        "random_generator_id": {
          "const": "numpy.PCG64",
          "default": "numpy.PCG64",
          "title": "Random Generator Id",
          "type": "string"
        },
        "numpy_version": {
          "minLength": 1,
          "title": "Numpy Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "probability_estimate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Probability Estimate"
        },
        "log_probability_estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Log Probability Estimate"
        },
        "partial_probability_estimate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Partial Probability Estimate"
        },
        "log_partial_probability_estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Log Partial Probability Estimate"
        },
        "level_count": {
          "minimum": 0,
          "title": "Level Count",
          "type": "integer"
        },
        "total_limit_state_evaluations": {
          "minimum": 0,
          "title": "Total Limit State Evaluations",
          "type": "integer"
        },
        "levels": {
          "items": {
            "$ref": "#/$defs/SubsetSimulationLevel"
          },
          "title": "Levels",
          "type": "array"
        },
        "uncertainty_status": {
          "const": "not_estimated",
          "default": "not_estimated",
          "title": "Uncertainty Status",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "estimate_id",
        "event_id",
        "event_definition",
        "failure_mode",
        "asset_id",
        "location_id",
        "physical_scope_id",
        "horizon_start_s",
        "horizon_end_s",
        "conditioning",
        "event_is_first_failure_in_period_reviewed",
        "evaluator_id",
        "evaluator_revision",
        "evaluator_configuration_sha256",
        "latent_variable_ids",
        "samples_per_level",
        "conditional_probability",
        "pcn_beta",
        "maximum_levels",
        "latent_mapping_reviewed",
        "event_semantics_reviewed",
        "deterministic_evaluator_declared",
        "random_seed",
        "numpy_version",
        "status",
        "probability_estimate",
        "log_probability_estimate",
        "partial_probability_estimate",
        "log_partial_probability_estimate",
        "level_count",
        "total_limit_state_evaluations",
        "levels",
        "notes"
      ],
      "title": "SubsetSimulationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "request_sha256": {
      "title": "Request Sha256",
      "type": "string"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/SubsetSimulationResult"
      },
      "title": "Runs",
      "type": "array"
    },
    "complete_run_count": {
      "title": "Complete Run Count",
      "type": "integer"
    },
    "mean_probability": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mean Probability"
    },
    "between_run_standard_deviation": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Between Run Standard Deviation"
    },
    "standard_error_of_replicate_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Standard Error Of Replicate Mean"
    },
    "coefficient_of_variation": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Coefficient Of Variation"
    },
    "status": {
      "enum": [
        "computed",
        "needs_data"
      ],
      "title": "Status",
      "type": "string"
    },
    "log_mean_probability": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Log Mean Probability"
    },
    "log_standard_error_of_replicate_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Log Standard Error Of Replicate Mean"
    },
    "relative_standard_error_of_replicate_mean": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Relative Standard Error Of Replicate Mean"
    },
    "declared_precision_target_met": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Declared Precision Target Met"
    },
    "uncertainty_basis": {
      "title": "Uncertainty Basis",
      "type": "string"
    }
  },
  "required": [
    "analysis_id",
    "request_sha256",
    "runs",
    "complete_run_count",
    "mean_probability",
    "between_run_standard_deviation",
    "standard_error_of_replicate_mean",
    "coefficient_of_variation",
    "status",
    "log_mean_probability",
    "log_standard_error_of_replicate_mean",
    "relative_standard_error_of_replicate_mean",
    "declared_precision_target_met",
    "uncertainty_basis"
  ],
  "title": "SubsetReplicateResult",
  "type": "object"
}