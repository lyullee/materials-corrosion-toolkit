{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "pressure_limit_Pa": {
      "exclusiveMinimum": 0,
      "title": "Pressure Limit Pa",
      "type": "number"
    },
    "elevation_m": {
      "title": "Elevation M",
      "type": "number"
    },
    "condition_id": {
      "minLength": 1,
      "title": "Condition Id",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "capacity_input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Capacity Input Digest",
      "type": "string"
    },
    "capacity_result_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Capacity Result Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "component_id",
    "pressure_limit_Pa",
    "elevation_m",
    "condition_id",
    "temperature_K",
    "capacity_input_digest",
    "capacity_result_digest",
    "evidence"
  ],
  "title": "ComponentPressureLimit",
  "type": "object"
}