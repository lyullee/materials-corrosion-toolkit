{
  "$defs": {
    "AHSS1300WorkbookCell": {
      "additionalProperties": false,
      "description": "A nonblank source cell with original coordinate, scalar type, and value.",
      "properties": {
        "coordinate": {
          "minLength": 2,
          "title": "Coordinate",
          "type": "string"
        },
        "cell_kind": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "datetime",
            "time",
            "formula",
            "error"
          ],
          "title": "Cell Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "coordinate",
        "cell_kind",
        "value"
      ],
      "title": "AHSS1300WorkbookCell",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One workbook row tied to the fixed provider file, worksheet, and source order.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.mendeley_ahss1300_permeation_row.v1",
      "default": "matintegrity.mendeley_ahss1300_permeation_row.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "mendeley-ahss1300-hydrogen-permeation",
      "default": "mendeley-ahss1300-hydrogen-permeation",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_doi": {
      "const": "10.17632/tnsgf7v76z.1",
      "default": "10.17632/tnsgf7v76z.1",
      "title": "Dataset Doi",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "provider_filename": {
      "const": "Permeation_MS AHSS 1300.xlsx",
      "default": "Permeation_MS AHSS 1300.xlsx",
      "title": "Provider Filename",
      "type": "string"
    },
    "provider_file_id": {
      "const": "64121556-2ab2-4aec-8a20-4bc51d48ad44",
      "default": "64121556-2ab2-4aec-8a20-4bc51d48ad44",
      "title": "Provider File Id",
      "type": "string"
    },
    "provider_bytes": {
      "default": 88885,
      "title": "Provider Bytes",
      "type": "integer"
    },
    "provider_md5": {
      "const": "15316bf88b2e341e153bb6fecf7b823f",
      "default": "15316bf88b2e341e153bb6fecf7b823f",
      "title": "Provider Md5",
      "type": "string"
    },
    "provider_sha256": {
      "const": "117d75a3f8329456732beada95b8f2be8bda688da88e6b8c7c83a9ee49698b3b",
      "default": "117d75a3f8329456732beada95b8f2be8bda688da88e6b8c7c83a9ee49698b3b",
      "title": "Provider Sha256",
      "type": "string"
    },
    "worksheet_name": {
      "minLength": 1,
      "title": "Worksheet Name",
      "type": "string"
    },
    "provider_row_number": {
      "minimum": 1,
      "title": "Provider Row Number",
      "type": "integer"
    },
    "source_order": {
      "minimum": 0,
      "title": "Source Order",
      "type": "integer"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/AHSS1300WorkbookCell"
      },
      "title": "Cells",
      "type": "array"
    },
    "source_row_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Row Sha256",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "formulas_evaluated": {
      "const": false,
      "default": false,
      "title": "Formulas Evaluated",
      "type": "boolean"
    },
    "units_converted": {
      "const": false,
      "default": false,
      "title": "Units Converted",
      "type": "boolean"
    },
    "effective_diffusivity_inferred": {
      "const": false,
      "default": false,
      "title": "Effective Diffusivity Inferred",
      "type": "boolean"
    },
    "remaining_life_inferred": {
      "const": false,
      "default": false,
      "title": "Remaining Life Inferred",
      "type": "boolean"
    },
    "failure_probability_inferred": {
      "const": false,
      "default": false,
      "title": "Failure Probability Inferred",
      "type": "boolean"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "worksheet_name",
    "provider_row_number",
    "source_order",
    "cells",
    "source_row_sha256",
    "evidence"
  ],
  "title": "AHSS1300PermeationWorkbookRow",
  "type": "object"
}