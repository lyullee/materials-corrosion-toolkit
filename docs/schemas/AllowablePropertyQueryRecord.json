{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PropertyIdentity": {
      "additionalProperties": false,
      "properties": {
        "material_id": {
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "product_form": {
          "minLength": 1,
          "title": "Product Form",
          "type": "string"
        },
        "material_condition": {
          "minLength": 1,
          "title": "Material Condition",
          "type": "string"
        },
        "orientation": {
          "minLength": 1,
          "title": "Orientation",
          "type": "string"
        },
        "property_id": {
          "minLength": 1,
          "title": "Property Id",
          "type": "string"
        },
        "basis_id": {
          "minLength": 1,
          "title": "Basis Id",
          "type": "string"
        },
        "basis_edition": {
          "minLength": 1,
          "title": "Basis Edition",
          "type": "string"
        }
      },
      "required": [
        "material_id",
        "product_form",
        "material_condition",
        "orientation",
        "property_id",
        "basis_id",
        "basis_edition"
      ],
      "title": "PropertyIdentity",
      "type": "object"
    },
    "PropertyQuery": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "$ref": "#/$defs/PropertyIdentity"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "requested_unit": {
          "minLength": 1,
          "title": "Requested Unit",
          "type": "string"
        }
      },
      "required": [
        "identity",
        "temperature_K",
        "requested_unit"
      ],
      "title": "PropertyQuery",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query_id": {
      "minLength": 1,
      "title": "Query Id",
      "type": "string"
    },
    "applicability_id": {
      "minLength": 1,
      "title": "Applicability Id",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/PropertyQuery"
    },
    "query_source_id": {
      "minLength": 1,
      "title": "Query Source Id",
      "type": "string"
    },
    "query_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Query Record Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "query_id",
    "applicability_id",
    "query",
    "query_source_id",
    "query_record_digest",
    "evidence"
  ],
  "title": "AllowablePropertyQueryRecord",
  "type": "object"
}