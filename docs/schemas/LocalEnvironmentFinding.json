{
  "additionalProperties": false,
  "properties": {
    "state_id": {
      "title": "State Id",
      "type": "string"
    },
    "criterion_id": {
      "title": "Criterion Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "within",
        "outside",
        "boundary_overlap",
        "missing",
        "invalid",
        "mismatch"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "basis": {
      "title": "Basis",
      "type": "string"
    },
    "observed_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Value"
    },
    "expanded_uncertainty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expanded Uncertainty"
    }
  },
  "required": [
    "state_id",
    "criterion_id",
    "outcome",
    "basis"
  ],
  "title": "LocalEnvironmentFinding",
  "type": "object"
}