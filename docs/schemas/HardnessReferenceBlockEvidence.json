{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reference_block_id": {
      "minLength": 1,
      "title": "Reference Block Id",
      "type": "string"
    },
    "reference_block_condition_id": {
      "minLength": 1,
      "title": "Reference Block Condition Id",
      "type": "string"
    },
    "scale_id": {
      "minLength": 1,
      "title": "Scale Id",
      "type": "string"
    },
    "certified_value": {
      "title": "Certified Value",
      "type": "number"
    },
    "certified_expanded_uncertainty": {
      "minimum": 0,
      "title": "Certified Expanded Uncertainty",
      "type": "number"
    },
    "hardness_unit_token": {
      "minLength": 1,
      "title": "Hardness Unit Token",
      "type": "string"
    },
    "certificate_id": {
      "minLength": 1,
      "title": "Certificate Id",
      "type": "string"
    },
    "certificate_revision": {
      "minLength": 1,
      "title": "Certificate Revision",
      "type": "string"
    },
    "certificate_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Certificate Digest",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "valid",
        "invalid",
        "missing"
      ],
      "title": "Verification Status",
      "type": "string"
    },
    "verification_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Verification Record Digest",
      "type": "string"
    },
    "invalid_or_missing_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalid Or Missing Basis"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "reference_block_id",
    "reference_block_condition_id",
    "scale_id",
    "certified_value",
    "certified_expanded_uncertainty",
    "hardness_unit_token",
    "certificate_id",
    "certificate_revision",
    "certificate_digest",
    "verification_status",
    "verification_record_digest",
    "evidence"
  ],
  "title": "HardnessReferenceBlockEvidence",
  "type": "object"
}