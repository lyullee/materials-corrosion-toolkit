        },
        "hidden_area_extrapolation_claimed": {
          "const": false,
          "default": false,
          "title": "Hidden Area Extrapolation Claimed",
          "type": "boolean"
        },
        "risk_or_pod_claimed": {
          "const": false,
          "default": false,
          "title": "Risk Or Pod Claimed",
          "type": "boolean"
        },
        "built_in_code_or_standard_acceptance_used": {
          "const": false,
          "default": false,
          "title": "Built In Code Or Standard Acceptance Used",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
