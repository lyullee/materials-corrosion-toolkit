{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One reviewed Arrhenius limiting surface-flux parameterization.",
  "properties": {
    "rate_id": {
      "minLength": 1,
      "title": "Rate Id",
      "type": "string"
    },
    "pre_exponential_capacity_flux_mol_m2_s": {
      "exclusiveMinimum": 0,
      "title": "Pre Exponential Capacity Flux Mol M2 S",
      "type": "number"
    },
    "activation_energy_J_mol": {
      "minimum": 0,
      "title": "Activation Energy J Mol",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "rate_id",
    "pre_exponential_capacity_flux_mol_m2_s",
    "activation_energy_J_mol",
    "evidence"
  ],
  "title": "ThermallyActivatedSurfaceFlux",
  "type": "object"
}