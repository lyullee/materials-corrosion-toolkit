{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "product_id": {
      "minLength": 1,
      "title": "Product Id",
      "type": "string"
    },
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "observation_category": {
      "enum": [
        "dimensional",
        "surface",
        "internal",
        "nde",
        "macro",
        "micro",
        "chemistry",
        "mechanical"
      ],
      "title": "Observation Category",
      "type": "string"
    },
    "examination_or_test_method_id": {
      "minLength": 1,
      "title": "Examination Or Test Method Id",
      "type": "string"
    },
    "method_revision": {
      "minLength": 1,
      "title": "Method Revision",
      "type": "string"
    },
    "metric_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Id"
    },
    "metric_definition": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metric Definition"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "unit_token": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Token"
    },
    "expanded_uncertainty": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expanded Uncertainty"
    },
    "uncertainty_basis": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Basis"
    },
    "reported_finding": {
      "minLength": 1,
      "title": "Reported Finding",
      "type": "string"
    },
    "caller_disposition_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Caller Disposition Id"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "provider_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Configuration Digest",
      "type": "string"
    },
    "raw_data_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Raw Data Digest",
      "type": "string"
    },
    "observation_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Observation Record Digest",
      "type": "string"
    },
    "record_valid": {
      "title": "Record Valid",
      "type": "boolean"
    },
    "invalid_or_missing_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalid Or Missing Basis"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "observation_id",
    "product_id",
    "sample_id",
    "observation_category",
    "examination_or_test_method_id",
    "method_revision",
    "reported_finding",
    "provider_id",
    "provider_revision",
    "provider_configuration_digest",
    "raw_data_digest",
    "observation_record_digest",
    "record_valid",
    "evidence"
  ],
  "title": "ProductQualityObservation",
  "type": "object"
}