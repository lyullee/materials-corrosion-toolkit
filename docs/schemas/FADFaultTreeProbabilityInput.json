{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Explicit caller probability and physical scope for the period event.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.fad_fta_probability_input.v1",
      "default": "matintegrity.fad_fta_probability_input.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "failure_mode": {
      "minLength": 1,
      "title": "Failure Mode",
      "type": "string"
    },
    "event_condition": {
      "const": "first_outside_pinned_fad_boundary_during_period",
      "title": "Event Condition",
      "type": "string"
    },
    "condition_id": {
      "minLength": 1,
      "title": "Condition Id",
      "type": "string"
    },
    "condition_statement": {
      "minLength": 1,
      "title": "Condition Statement",
      "type": "string"
    },
    "probability": {
      "maximum": 1,
      "minimum": 0,
      "title": "Probability",
      "type": "number"
    },
    "probability_meaning": {
      "const": "conditional_first_failure_in_period",
      "title": "Probability Meaning",
      "type": "string"
    },
    "conditioning": {
      "minLength": 1,
      "title": "Conditioning",
      "type": "string"
    },
    "probability_scope_id": {
      "minLength": 1,
      "title": "Probability Scope Id",
      "type": "string"
    },
    "probability_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Probability Evidence",
      "type": "array"
    },
    "rights_boundary": {
      "enum": [
        "local_only",
        "caller_authorized_open_distribution"
      ],
      "title": "Rights Boundary",
      "type": "string"
    },
    "rights_authorization_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rights Authorization Digest"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "horizon_start_s": {
      "minimum": 0,
      "title": "Horizon Start S",
      "type": "number"
    },
    "horizon_end_s": {
      "exclusiveMinimum": 0,
      "title": "Horizon End S",
      "type": "number"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "geometry_basis_id": {
      "minLength": 1,
      "title": "Geometry Basis Id",
      "type": "string"
    },
    "load_history_id": {
      "minLength": 1,
      "title": "Load History Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "failure_mode",
    "event_condition",
    "condition_id",
    "condition_statement",
    "probability",
    "probability_meaning",
    "conditioning",
    "probability_scope_id",
    "probability_evidence",
    "rights_boundary",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "clock_id",
    "horizon_start_s",
    "horizon_end_s",
    "material_condition_id",
    "geometry_basis_id",
    "load_history_id"
  ],
  "title": "FADFaultTreeProbabilityInput",
  "type": "object"
}