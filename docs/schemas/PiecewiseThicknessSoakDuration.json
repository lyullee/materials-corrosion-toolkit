{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ThicknessSoakBand": {
      "additionalProperties": false,
      "properties": {
        "band_id": {
          "minLength": 1,
          "title": "Band Id",
          "type": "string"
        },
        "upper_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Upper Thickness M",
          "type": "number"
        },
        "slope_s_per_m": {
          "minimum": 0,
          "title": "Slope S Per M",
          "type": "number"
        }
      },
      "required": [
        "band_id",
        "upper_thickness_m",
        "slope_s_per_m"
      ],
      "title": "ThicknessSoakBand",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "procedure_id": {
      "minLength": 1,
      "title": "Procedure Id",
      "type": "string"
    },
    "governing_thickness_m": {
      "exclusiveMinimum": 0,
      "title": "Governing Thickness M",
      "type": "number"
    },
    "minimum_supported_thickness_m": {
      "minimum": 0,
      "title": "Minimum Supported Thickness M",
      "type": "number"
    },
    "baseline_time_s": {
      "minimum": 0,
      "title": "Baseline Time S",
      "type": "number"
    },
    "minimum_soak_time_s": {
      "minimum": 0,
      "title": "Minimum Soak Time S",
      "type": "number"
    },
    "thickness_bands": {
      "items": {
        "$ref": "#/$defs/ThicknessSoakBand"
      },
      "minItems": 1,
      "title": "Thickness Bands",
      "type": "array"
    }
  },
  "required": [
    "basis",
    "component_id",
    "procedure_id",
    "governing_thickness_m",
    "minimum_supported_thickness_m",
    "baseline_time_s",
    "minimum_soak_time_s",
    "thickness_bands"
  ],
  "title": "PiecewiseThicknessSoakDuration",
  "type": "object"
}