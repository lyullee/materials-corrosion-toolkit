{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExplosiveWeldFatigueObservationField": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "caller_meaning": {
          "minLength": 1,
          "title": "Caller Meaning",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "role": {
          "enum": [
            "record_id",
            "condition",
            "measurement",
            "derived_formula",
            "metadata",
            "unclassified"
          ],
          "title": "Role",
          "type": "string"
        },
        "column_number": {
          "minimum": 1,
          "title": "Column Number",
          "type": "integer"
        },
        "cell_address": {
          "maxLength": 16,
          "minLength": 2,
          "title": "Cell Address",
          "type": "string"
        },
        "cell_type": {
          "maxLength": 8,
          "minLength": 1,
          "title": "Cell Type",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value"
        },
        "source_header_value": {
          "title": "Source Header Value"
        },
        "mapping_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Mapping Evidence",
          "type": "array"
        }
      },
      "required": [
        "field_id",
        "caller_meaning",
        "unit_token",
        "role",
        "column_number",
        "cell_address",
        "cell_type",
        "raw_value",
        "source_header_value",
        "mapping_evidence"
      ],
      "title": "ExplosiveWeldFatigueObservationField",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.mendeley_explosive_weld_fatigue_mapped_row.v1",
      "default": "matintegrity.mendeley_explosive_weld_fatigue_mapped_row.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "mendeley-explosive-weld-multilayer-fatigue",
      "default": "mendeley-explosive-weld-multilayer-fatigue",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_doi": {
      "const": "10.17632/mc8bc9tm59.1",
      "default": "10.17632/mc8bc9tm59.1",
      "title": "Dataset Doi",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "mapping_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mapping Sha256",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "source_filename": {
      "const": "MultilayerPlatesData.xlsx",
      "default": "MultilayerPlatesData.xlsx",
      "title": "Source Filename",
      "type": "string"
    },
    "provider_file_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider File Id",
      "type": "string"
    },
    "source_file_bytes": {
      "exclusiveMinimum": 0,
      "title": "Source File Bytes",
      "type": "integer"
    },
    "source_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "worksheet_name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Worksheet Name",
      "type": "string"
    },
    "header_row_number": {
      "minimum": 1,
      "title": "Header Row Number",
      "type": "integer"
    },
    "provider_row_number": {
      "minimum": 1,
      "title": "Provider Row Number",
      "type": "integer"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/ExplosiveWeldFatigueObservationField"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Fields",
      "type": "array"
    },
    "source_row_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Row Sha256",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "mapping_sha256",
    "provider_file_id",
    "source_file_bytes",
    "source_file_sha256",
    "worksheet_name",
    "header_row_number",
    "provider_row_number",
    "fields",
    "source_row_sha256",
    "evidence"
  ],
  "title": "ExplosiveWeldFatigueMappedObservationRow",
  "type": "object"
}