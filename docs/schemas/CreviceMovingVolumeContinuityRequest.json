{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Reconstruct interval-mean face flow from cell-volume change and boundaries.\n\nPositive flow points from the left reservoir toward the right reservoir.\nThis is a kinematic volume-continuity operator; pressure, momentum, species\ntransport and deposition kinetics are not solved here.",
  "properties": {
    "schema_version": {
      "default": "matintegrity.crevice_moving_volume_continuity.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Time S",
      "type": "array"
    },
    "cell_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 300,
      "minItems": 1,
      "title": "Cell Ids",
      "type": "array"
    },
    "cell_lengths_m": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 300,
      "minItems": 1,
      "title": "Cell Lengths M",
      "type": "array"
    },
    "transverse_width_m": {
      "exclusiveMinimum": 0,
      "title": "Transverse Width M",
      "type": "number"
    },
    "aperture_m_by_knot_and_cell": {
      "items": {
        "items": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Aperture M By Knot And Cell",
      "type": "array"
    },
    "left_boundary_flow_m3_s_by_knot": {
      "items": {
        "type": "number"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Left Boundary Flow M3 S By Knot",
      "type": "array"
    },
    "right_boundary_flow_m3_s_by_knot": {
      "items": {
        "type": "number"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Right Boundary Flow M3 S By Knot",
      "type": "array"
    },
    "geometry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Geometry Sha256",
      "type": "string"
    },
    "boundary_flow_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Boundary Flow Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 256,
      "minItems": 2,
      "title": "Evidence",
      "type": "array"
    },
    "geometry_boundary_and_sign_convention_reviewed": {
      "title": "Geometry Boundary And Sign Convention Reviewed",
      "type": "boolean"
    },
    "incompressible_liquid_and_fixed_mesh_reviewed": {
      "title": "Incompressible Liquid And Fixed Mesh Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "absolute_flow_closure_tolerance_m3_s": {
      "default": 1e-15,
      "exclusiveMinimum": 0,
      "title": "Absolute Flow Closure Tolerance M3 S",
      "type": "number"
    },
    "relative_flow_closure_tolerance": {
      "default": 1e-09,
      "exclusiveMinimum": 0,
      "maximum": 0.001,
      "title": "Relative Flow Closure Tolerance",
      "type": "number"
    }
  },
  "required": [
    "assessment_id",
    "physical_scope_id",
    "time_s",
    "cell_ids",
    "cell_lengths_m",
    "transverse_width_m",
    "aperture_m_by_knot_and_cell",
    "left_boundary_flow_m3_s_by_knot",
    "right_boundary_flow_m3_s_by_knot",
    "geometry_sha256",
    "boundary_flow_sha256",
    "evidence",
    "geometry_boundary_and_sign_convention_reviewed",
    "incompressible_liquid_and_fixed_mesh_reviewed",
    "computational_use_authorized"
  ],
  "title": "CreviceMovingVolumeContinuityRequest",
  "type": "object"
}