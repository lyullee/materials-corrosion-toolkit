        },
        "element_charge_and_reaction_direction_reviewed": {
          "title": "Element Charge And Reaction Direction Reviewed",
          "type": "boolean"
        },
        "geometry_trial_mode": {
          "default": false,
          "title": "Geometry Trial Mode",
          "type": "boolean"
        },
        "fixed_point_input_sha256": {
          "anyOf": [
