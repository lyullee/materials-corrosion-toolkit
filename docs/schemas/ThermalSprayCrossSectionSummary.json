{
  "$defs": {
    "CrossSectionFrameCalibration": {
      "additionalProperties": false,
      "properties": {
        "calibration_id": {
          "minLength": 1,
          "title": "Calibration Id",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "x_scale_m_per_px": {
          "exclusiveMinimum": 0,
          "title": "X Scale M Per Px",
          "type": "number"
        },
        "y_scale_m_per_px": {
          "exclusiveMinimum": 0,
          "title": "Y Scale M Per Px",
          "type": "number"
        },
        "x_scale_expanded_uncertainty_m_per_px": {
          "minimum": 0,
          "title": "X Scale Expanded Uncertainty M Per Px",
          "type": "number"
        },
        "y_scale_expanded_uncertainty_m_per_px": {
          "minimum": 0,
          "title": "Y Scale Expanded Uncertainty M Per Px",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Configuration Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "calibration_id",
        "coordinate_frame_id",
        "x_scale_m_per_px",
        "y_scale_m_per_px",
        "x_scale_expanded_uncertainty_m_per_px",
        "y_scale_expanded_uncertainty_m_per_px",
        "provider_id",
        "provider_revision",
        "configuration_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "CrossSectionFrameCalibration",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SegmentedPoreGeometry": {
