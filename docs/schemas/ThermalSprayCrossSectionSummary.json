        "coordinate_unit_token": {
          "enum": [
            "px",
            "m"
          ],
          "title": "Coordinate Unit Token",
          "type": "string"
        },
        "minimum_x": {
          "minimum": 0,
          "title": "Minimum X",
          "type": "number"
        },
        "maximum_x": {
          "minimum": 0,
          "title": "Maximum X",
          "type": "number"
        },
        "minimum_y": {
          "minimum": 0,
          "title": "Minimum Y",
          "type": "number"
        },
        "maximum_y": {
          "minimum": 0,
          "title": "Maximum Y",
          "type": "number"
        },
        "touches_field_edge": {
          "title": "Touches Field Edge",
          "type": "boolean"
        },
        "overlaps_pore_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Overlaps Pore Ids",
          "type": "array"
        },
        "segmentation_method_id": {
          "minLength": 1,
          "title": "Segmentation Method Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "pore_id",
        "area_value",
        "area_unit_token",
        "coordinate_unit_token",
        "minimum_x",
        "maximum_x",
        "minimum_y",
        "maximum_y",
        "touches_field_edge",
        "segmentation_method_id",
        "provider_id",
        "provider_revision",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "SegmentedPoreGeometry",
      "type": "object"
