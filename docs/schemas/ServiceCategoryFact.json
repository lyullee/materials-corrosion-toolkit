{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fact_id": {
      "minLength": 1,
      "title": "Fact Id",
      "type": "string"
    },
    "domain": {
      "enum": [
        "fluid",
        "pressure",
        "temperature",
        "equipment",
        "material",
        "operation",
        "owner_decision",
        "location"
      ],
      "title": "Domain",
      "type": "string"
    },
    "definition": {
      "minLength": 1,
      "title": "Definition",
      "type": "string"
    },
    "value_kind": {
      "enum": [
        "number",
        "descriptor",
        "boolean"
      ],
      "title": "Value Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "known",
        "unknown",
        "invalid"
      ],
      "title": "Status",
      "type": "string"
    },
    "numeric_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Numeric Value"
    },
    "unit_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit Token"
    },
    "descriptor_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Descriptor Value"
    },
    "boolean_value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Boolean Value"
    },
    "unknown_or_invalid_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unknown Or Invalid Basis"
    },
    "evidence_record_id": {
      "minLength": 1,
      "title": "Evidence Record Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "fact_id",
    "domain",
    "definition",
    "value_kind",
    "status",
    "evidence_record_id",
    "source_group_id",
    "record_digest",
    "evidence"
  ],
  "title": "ServiceCategoryFact",
  "type": "object"
}