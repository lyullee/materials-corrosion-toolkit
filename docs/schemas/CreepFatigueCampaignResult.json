        "block_id",
        "status",
        "cycle_count",
        "cycles_to_failure",
        "linear_damage_fraction"
      ],
      "title": "StrainLifeBlockResult",
      "type": "object"
    },
    "StrainLifeCampaignResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.strain_life_campaign.v1",
          "default": "matintegrity.strain_life_campaign.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "needs_data",
            "out_of_scope"
          ],
          "title": "Status",
          "type": "string"
        },
        "block_results": {
          "items": {
            "$ref": "#/$defs/StrainLifeBlockResult"
          },
          "title": "Block Results",
          "type": "array"
