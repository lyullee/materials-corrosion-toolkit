    "fatigue_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/StrainLifeCampaignResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "interaction_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CreepFatigueInteractionResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    }
