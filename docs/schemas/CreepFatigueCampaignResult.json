          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Linear Damage"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "campaign_id",
        "input_sha256",
        "status",
        "block_results",
        "total_linear_damage",
        "notes"
      ],
      "title": "StrainLifeCampaignResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.creep_fatigue_campaign.v1",
      "default": "matintegrity.creep_fatigue_campaign.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "campaign_id": {
      "title": "Campaign Id",
      "type": "string"
    },
    "input_sha256": {
      "title": "Input Sha256",
      "type": "string"
    },
    "status": {
      "enum": [
        "computed",
        "needs_data",
        "out_of_scope"
      ],
      "title": "Status",
      "type": "string"
    },
    "creep_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/CreepHistoryResult"
        },
        {
          "type": "null"
