{
  "$defs": {
    "CreepFatigueInteractionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.creep_fatigue_interaction.v1",
          "default": "matintegrity.creep_fatigue_interaction.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "point_id": {
          "title": "Point Id",
          "type": "string"
        },
        "envelope_id": {
          "title": "Envelope Id",
          "type": "string"
        },
        "envelope_revision": {
          "title": "Envelope Revision",
          "type": "string"
        },
        "envelope_sha256": {
          "title": "Envelope Sha256",
          "type": "string"
        },
        "point_sha256": {
          "title": "Point Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "needs_data",
            "out_of_scope"
          ],
          "title": "Status",
          "type": "string"
        },
        "fatigue_limit_at_creep_damage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fatigue Limit At Creep Damage"
        },
        "fatigue_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fatigue Margin"
        },
        "fatigue_utilization": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fatigue Utilization"
        },
        "within_caller_envelope": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Within Caller Envelope"
        },
        "segment_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Segment Index"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "point_id",
        "envelope_id",
        "envelope_revision",
        "envelope_sha256",
        "point_sha256",
        "status",
        "fatigue_limit_at_creep_damage",
        "fatigue_margin",
        "fatigue_utilization",
        "within_caller_envelope",
        "segment_index",
        "notes"
      ],
      "title": "CreepFatigueInteractionResult",
      "type": "object"
    },
    "CreepHistoryResult": {
      "additionalProperties": false,
