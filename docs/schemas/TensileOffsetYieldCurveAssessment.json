{
  "$defs": {
    "EngineeringStressStrainPoint": {
      "additionalProperties": false,
      "properties": {
        "point_id": {
          "minLength": 1,
          "title": "Point Id",
          "type": "string"
        },
        "engineering_strain": {
          "minimum": 0,
          "title": "Engineering Strain",
          "type": "number"
        },
        "engineering_stress_Pa": {
          "minimum": 0,
          "title": "Engineering Stress Pa",
          "type": "number"
        },
        "elastic_fit_weight": {
          "exclusiveMinimum": 0,
          "title": "Elastic Fit Weight",
          "type": "number"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "point_id",
        "engineering_strain",
        "engineering_stress_Pa",
        "elastic_fit_weight",
        "record_valid",
        "evidence"
      ],
      "title": "EngineeringStressStrainPoint",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "OffsetYieldReferenceComparison": {
      "additionalProperties": false,
      "properties": {
        "reference_record_id": {
          "minLength": 1,
