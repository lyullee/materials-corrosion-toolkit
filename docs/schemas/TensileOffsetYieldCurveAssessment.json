          "type": "string"
        },
        "offset_strain": {
          "exclusiveMinimum": 0,
          "title": "Offset Strain",
          "type": "number"
        },
        "offset_yield_stress_Pa": {
          "exclusiveMinimum": 0,
          "title": "Offset Yield Stress Pa",
          "type": "number"
        },
        "expanded_uncertainty_Pa": {
