        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "reference_record_id",
        "physical_specimen_id",
        "source_group_id",
        "independence_group_id",
        "reference_method_id",
        "offset_strain",
        "offset_yield_stress_Pa",
        "expanded_uncertainty_Pa",
        "uncertainty_coverage_factor",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "OffsetYieldReferenceComparison",
      "type": "object"
    }
