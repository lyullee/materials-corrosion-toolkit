{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "electron_number": {
      "maximum": 32,
      "minimum": 1,
      "title": "Electron Number",
      "type": "integer"
    },
    "aqueous_species_stoichiometry_per_extent": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 40,
      "minProperties": 1,
      "title": "Aqueous Species Stoichiometry Per Extent",
      "type": "object"
    },
    "external_reservoir_element_stoichiometry_per_extent": {
      "additionalProperties": {
        "type": "number"
      },
      "maxProperties": 32,
      "title": "External Reservoir Element Stoichiometry Per Extent",
      "type": "object"
    },
    "record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "reaction_id",
    "electron_number",
    "aqueous_species_stoichiometry_per_extent",
    "record_sha256",
    "evidence"
  ],
  "title": "CreviceFaradaicBranchMap",
  "type": "object"
}