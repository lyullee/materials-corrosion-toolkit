{
  "$defs": {
    "CoatingAdhesionGroupRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.coating_adhesion_group.v1",
          "default": "matintegrity.coating_adhesion_group.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "dataset_id": {
          "const": "zenodo-4777893-coating-adhesion",
          "default": "zenodo-4777893-coating-adhesion",
          "title": "Dataset Id",
          "type": "string"
        },
        "provider_record": {
          "const": "https://doi.org/10.5281/zenodo.4777893",
          "default": "https://doi.org/10.5281/zenodo.4777893",
          "title": "Provider Record",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "source_file_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source File Sha256",
          "type": "string"
        },
        "source_sheet_name": {
          "const": "ADHESION",
          "default": "ADHESION",
          "title": "Source Sheet Name",
          "type": "string"
        },
        "source_row": {
          "maximum": 34,
          "minimum": 3,
          "title": "Source Row",
          "type": "integer"
        },
        "provider_sample_label": {
          "minLength": 1,
          "title": "Provider Sample Label",
          "type": "string"
        },
        "provider_condition": {
          "enum": [
            "climate_room",
            "ambient_laboratory",
            "after_water_absorption",
            "primer_plus_coating_section_condition_unresolved"
          ],
          "title": "Provider Condition",
          "type": "string"
        },
        "observation_count": {
          "maximum": 5,
          "minimum": 2,
          "title": "Observation Count",
          "type": "integer"
        },
        "provider_native_values": {
          "items": {
            "type": "number"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Provider Native Values",
          "type": "array"
        },
        "quantity_label": {
          "const": "adhesion_strength",
          "default": "adhesion_strength",
          "title": "Quantity Label",
          "type": "string"
        },
        "unit_status": {
          "const": "not_declared_in_workbook_or_readme",
          "default": "not_declared_in_workbook_or_readme",
          "title": "Unit Status",
          "type": "string"
        },
        "substrate": {
          "const": "wood",
          "default": "wood",
          "title": "Substrate",
          "type": "string"
        },
        "physical_dolly_identity_status": {
          "const": "column_label_only",
          "default": "column_label_only",
          "title": "Physical Dolly Identity Status",
          "type": "string"
        },
        "interpretation_status": {
          "const": "raw_replicates_not_metal_coating_qualification",
          "default": "raw_replicates_not_metal_coating_qualification",
          "title": "Interpretation Status",
          "type": "string"
        }
      },
      "required": [
        "source_file_sha256",
        "source_row",
        "provider_sample_label",
        "provider_condition",
        "observation_count",
        "provider_native_values"
      ],
      "title": "CoatingAdhesionGroupRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.coating_adhesion_dataset_audit.v1",
      "default": "matintegrity.coating_adhesion_dataset_audit.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "zenodo-4777893-coating-adhesion",
      "default": "zenodo-4777893-coating-adhesion",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5281/zenodo.4777893",
      "default": "https://doi.org/10.5281/zenodo.4777893",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "source_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/CoatingAdhesionGroupRecord"
      },
      "maxItems": 35,
      "minItems": 35,
      "title": "Groups",
      "type": "array"
    },
    "group_count": {
      "const": 35,
      "title": "Group Count",
      "type": "integer"
    },
    "raw_observation_count": {
