      "title": "Formula Cells Used As Observations",
      "type": "boolean"
    },
    "unit_status": {
      "const": "withheld_no_source_unit_label",
      "default": "withheld_no_source_unit_label",
      "title": "Unit Status",
      "type": "string"
    },
    "calibration_use_status": {
      "const": "withheld_wood_substrate_and_missing_test_metadata",
      "default": "withheld_wood_substrate_and_missing_test_metadata",
      "title": "Calibration Use Status",
      "type": "string"
    }
  },
  "required": [
    "source_file_sha256",
    "groups",
    "group_count",
    "raw_observation_count"
  ],
  "title": "CoatingAdhesionDatasetAudit",
  "type": "object"
}