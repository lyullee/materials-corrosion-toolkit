{
  "$defs": {
    "PrecipitatingAqueousSpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "stoichiometric_moles_per_solid_mole": {
          "exclusiveMinimum": 0,
          "title": "Stoichiometric Moles Per Solid Mole",
          "type": "number"
        },
        "initial_concentration_mol_m3": {
          "minimum": 0,
          "title": "Initial Concentration Mol M3",
          "type": "number"
        },
        "activity_reference_concentration_mol_m3": {
          "exclusiveMinimum": 0,
          "title": "Activity Reference Concentration Mol M3",
          "type": "number"
        },
        "activity_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Activity Coefficient",
          "type": "number"
        },
        "charge_number": {
          "title": "Charge Number",
          "type": "integer"
        },
        "elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Elemental Composition",
          "type": "object"
        }
      },
      "required": [
        "species_id",
        "stoichiometric_moles_per_solid_mole",
        "initial_concentration_mol_m3",
        "activity_reference_concentration_mol_m3",
        "activity_coefficient",
        "charge_number",
        "elemental_composition"
      ],
      "title": "PrecipitatingAqueousSpecies",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "equilibrium_id": {
      "minLength": 1,
      "title": "Equilibrium Id",
      "type": "string"
    },
    "solid_species_id": {
      "minLength": 1,
      "title": "Solid Species Id",
      "type": "string"
    },
    "solid_elemental_composition": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Solid Elemental Composition",
      "type": "object"
    },
    "aqueous_species": {
      "items": {
        "$ref": "#/$defs/PrecipitatingAqueousSpecies"
      },
      "minItems": 1,
      "title": "Aqueous Species",
      "type": "array"
    },
    "initial_solid_moles_per_solution_volume_mol_m3": {
      "minimum": 0,
      "title": "Initial Solid Moles Per Solution Volume Mol M3",
      "type": "number"
    },
    "dimensionless_solubility_product": {
      "exclusiveMinimum": 0,
      "title": "Dimensionless Solubility Product",
      "type": "number"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "standard_state_id": {
      "minLength": 1,
      "title": "Standard State Id",
      "type": "string"
    },
    "equilibrium_constant_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Equilibrium Constant Source Sha256",
      "type": "string"
    },
    "maximum_absolute_log_saturation_residual": {
      "default": 1e-08,
      "exclusiveMinimum": 0,
      "maximum": 0.01,
      "title": "Maximum Absolute Log Saturation Residual",
      "type": "number"
    },
    "absolute_extent_balance_tolerance_mol_m3": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "title": "Absolute Extent Balance Tolerance Mol M3",
      "type": "number"
    },
    "relative_extent_balance_tolerance": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "maximum": 0.01,
      "title": "Relative Extent Balance Tolerance",
      "type": "number"
    },
    "single_neutral_pure_solid_and_fixed_volume_reviewed": {
      "title": "Single Neutral Pure Solid And Fixed Volume Reviewed",
      "type": "boolean"
    },
    "fixed_activity_coefficients_and_standard_states_reviewed": {
      "title": "Fixed Activity Coefficients And Standard States Reviewed",
      "type": "boolean"
    },
    "equilibrium_constant_temperature_and_computational_use_reviewed": {
      "title": "Equilibrium Constant Temperature And Computational Use Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "equilibrium_id",
    "solid_species_id",
    "solid_elemental_composition",
    "aqueous_species",
    "initial_solid_moles_per_solution_volume_mol_m3",
    "dimensionless_solubility_product",
    "temperature_K",
    "standard_state_id",
    "equilibrium_constant_source_sha256",
    "single_neutral_pure_solid_and_fixed_volume_reviewed",
    "fixed_activity_coefficients_and_standard_states_reviewed",
    "equilibrium_constant_temperature_and_computational_use_reviewed"
  ],
  "title": "SingleSolidEquilibrium",
  "type": "object"
}