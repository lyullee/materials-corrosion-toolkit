{
  "$defs": {
    "CompositeExposure": {
      "additionalProperties": false,
      "properties": {
        "exposure_id": {
          "minLength": 1,
          "title": "Exposure Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "moisture_mass_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Moisture Mass Fraction",
          "type": "number"
        },
        "pressure_Pa_abs": {
          "exclusiveMinimum": 0,
          "title": "Pressure Pa Abs",
          "type": "number"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "exposure_id",
        "start_time_s",
        "end_time_s",
        "temperature_K",
        "moisture_mass_fraction",
        "pressure_Pa_abs",
        "record_valid",
        "evidence"
      ],
      "title": "CompositeExposure",
      "type": "object"
    },
    "CompositeQualificationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "laminate_system_id": {
          "minLength": 1,
          "title": "Laminate System Id",
          "type": "string"
        },
        "resin_system_id": {
          "minLength": 1,
          "title": "Resin System Id",
          "type": "string"
        },
        "fiber_system_id": {
          "minLength": 1,
          "title": "Fiber System Id",
          "type": "string"
        },
        "manufacturing_condition_id": {
          "minLength": 1,
          "title": "Manufacturing Condition Id",
          "type": "string"
        },
        "layup_id": {
          "minLength": 1,
          "title": "Layup Id",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "minimum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "minimum_moisture_mass_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Moisture Mass Fraction",
          "type": "number"
        },
        "maximum_moisture_mass_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Moisture Mass Fraction",
          "type": "number"
        },
        "minimum_pressure_Pa_abs": {
          "exclusiveMinimum": 0,
          "title": "Minimum Pressure Pa Abs",
          "type": "number"
        },
        "maximum_pressure_Pa_abs": {
          "exclusiveMinimum": 0,
          "title": "Maximum Pressure Pa Abs",
          "type": "number"
        },
        "maximum_cumulative_exposure_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Cumulative Exposure S",
          "type": "number"
        },
        "qualification_records": {
          "items": {
            "$ref": "#/$defs/CompositeQualificationRecord"
          },
          "minItems": 1,
          "title": "Qualification Records",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "laminate_system_id",
        "resin_system_id",
        "fiber_system_id",
        "manufacturing_condition_id",
        "layup_id",
        "environment_id",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "minimum_moisture_mass_fraction",
        "maximum_moisture_mass_fraction",
        "minimum_pressure_Pa_abs",
        "maximum_pressure_Pa_abs",
        "maximum_cumulative_exposure_s",
        "qualification_records",
        "evidence"
      ],
      "title": "CompositeQualificationEnvelope",
      "type": "object"
    },
    "CompositeQualificationRecord": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "coupon_id": {
          "minLength": 1,
          "title": "Coupon Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "partition": {
          "enum": [
            "calibration",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "laminate_system_id": {
          "minLength": 1,
          "title": "Laminate System Id",
          "type": "string"
        },
        "resin_system_id": {
          "minLength": 1,
          "title": "Resin System Id",
          "type": "string"
        },
        "fiber_system_id": {
          "minLength": 1,
          "title": "Fiber System Id",
          "type": "string"
        },
        "manufacturing_condition_id": {
          "minLength": 1,
          "title": "Manufacturing Condition Id",
          "type": "string"
        },
        "layup_id": {
          "minLength": 1,
          "title": "Layup Id",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "supports_declared_envelope": {
          "title": "Supports Declared Envelope",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "coupon_id",
        "source_group_id",
        "partition",
        "laminate_system_id",
        "resin_system_id",
        "fiber_system_id",
        "manufacturing_condition_id",
        "layup_id",
        "environment_id",
        "record_valid",
        "supports_declared_envelope",
        "evidence"
      ],
      "title": "CompositeQualificationRecord",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "laminate_system_id": {
      "minLength": 1,
      "title": "Laminate System Id",
      "type": "string"
    },
    "resin_system_id": {
      "minLength": 1,
      "title": "Resin System Id",
      "type": "string"
    },
    "fiber_system_id": {
      "minLength": 1,
      "title": "Fiber System Id",
      "type": "string"
    },
    "manufacturing_condition_id": {
      "minLength": 1,
      "title": "Manufacturing Condition Id",
      "type": "string"
    },
    "layup_id": {
      "minLength": 1,
      "title": "Layup Id",
      "type": "string"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "exposures": {
      "items": {
        "$ref": "#/$defs/CompositeExposure"
      },
      "minItems": 1,
      "title": "Exposures",
      "type": "array"
    },
    "qualification_envelope": {
      "$ref": "#/$defs/CompositeQualificationEnvelope"
    },
    "material_and_layup_identity_reviewed": {
      "title": "Material And Layup Identity Reviewed",
      "type": "boolean"
    },
    "manufacturing_condition_reviewed": {
      "title": "Manufacturing Condition Reviewed",
      "type": "boolean"
    },
    "environment_and_clock_reviewed": {
      "title": "Environment And Clock Reviewed",
      "type": "boolean"
    },
    "exposure_records_reviewed": {
      "title": "Exposure Records Reviewed",
      "type": "boolean"
    },
    "qualification_evidence_reviewed": {
      "title": "Qualification Evidence Reviewed",
      "type": "boolean"
    },
    "calibration_holdout_partition_reviewed": {
      "title": "Calibration Holdout Partition Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "clock_id",
    "laminate_system_id",
    "resin_system_id",
    "fiber_system_id",
    "manufacturing_condition_id",
    "layup_id",
    "environment_id",
    "exposures",
    "qualification_envelope",
    "material_and_layup_identity_reviewed",
    "manufacturing_condition_reviewed",
    "environment_and_clock_reviewed",
    "exposure_records_reviewed",
    "qualification_evidence_reviewed",
    "calibration_holdout_partition_reviewed"
  ],
  "title": "CompositeCompatibility",
  "type": "object"
}