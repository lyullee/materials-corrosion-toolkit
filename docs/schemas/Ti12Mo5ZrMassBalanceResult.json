{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Ti12Mo5ZrPenetrationPoint": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.ti12mo5zr_penetration_point.v1",
          "default": "matintegrity.ti12mo5zr_penetration_point.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_row_number": {
          "minimum": 2,
          "title": "Source Row Number",
          "type": "integer"
        },
        "source_row_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Row Sha256",
          "type": "string"
        },
        "source_member_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Member Sha256",
          "type": "string"
        },
        "source_archive_sha256": {
          "const": "caf53855e78ff7162c361ba73435892759926f2d60513f5d42220239ce21f537",
          "default": "caf53855e78ff7162c361ba73435892759926f2d60513f5d42220239ce21f537",
          "title": "Source Archive Sha256",
          "type": "string"
        },
        "provider_time_s": {
          "minimum": 0,
          "title": "Provider Time S",
          "type": "number"
        },
        "elemental_mass_flux_kg_m2_s": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "enum": [
              "Ti",
              "Mo",
              "Zr"
            ]
          },
          "title": "Elemental Mass Flux Kg M2 S",
          "type": "object"
        },
        "signed_net_mass_flux_kg_m2_s": {
          "title": "Signed Net Mass Flux Kg M2 S",
          "type": "number"
        },
        "signed_equivalent_penetration_velocity_m_s": {
          "title": "Signed Equivalent Penetration Velocity M S",
          "type": "number"
        },
        "cumulative_positive_penetration_m": {
          "minimum": 0,
          "title": "Cumulative Positive Penetration M",
          "type": "number"
        },
        "cumulative_negative_penetration_m": {
          "maximum": 0,
          "title": "Cumulative Negative Penetration M",
          "type": "number"
        },
        "cumulative_signed_net_penetration_m": {
          "title": "Cumulative Signed Net Penetration M",
          "type": "number"
        }
      },
      "required": [
        "source_row_number",
        "source_row_sha256",
        "source_member_sha256",
        "provider_time_s",
        "elemental_mass_flux_kg_m2_s",
        "signed_net_mass_flux_kg_m2_s",
        "signed_equivalent_penetration_velocity_m_s",
        "cumulative_positive_penetration_m",
        "cumulative_negative_penetration_m",
        "cumulative_signed_net_penetration_m"
      ],
      "title": "Ti12Mo5ZrPenetrationPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.ti12mo5zr_mass_balance_result.v1",
      "default": "matintegrity.ti12mo5zr_mass_balance_result.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "model_id": {
      "const": "corrosion.ti12mo5zr_aesec_signed_equivalent_penetration",
      "default": "corrosion.ti12mo5zr_aesec_signed_equivalent_penetration",
      "title": "Model Id",
      "type": "string"
    },
    "dataset_id": {
      "const": "zenodo-ti12mo5zr-aqueous-corrosion",
      "default": "zenodo-ti12mo5zr-aqueous-corrosion",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5281/zenodo.14981665",
      "default": "https://doi.org/10.5281/zenodo.14981665",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC0-1.0",
      "default": "CC0-1.0",
      "title": "License Id",
      "type": "string"
    },
    "source_member_path": {
      "const": "zenodo_APSUC_2024/Fig.5/Fig.5d/TiMoZr_DissolutionRate_OCP_PSP_OCP_AESEC.xls",
      "default": "zenodo_APSUC_2024/Fig.5/Fig.5d/TiMoZr_DissolutionRate_OCP_PSP_OCP_AESEC.xls",
      "title": "Source Member Path",
      "type": "string"
    },
    "source_archive_sha256": {
      "const": "caf53855e78ff7162c361ba73435892759926f2d60513f5d42220239ce21f537",
      "default": "caf53855e78ff7162c361ba73435892759926f2d60513f5d42220239ce21f537",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "source_member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Member Sha256",
      "type": "string"
    },
    "exact_request_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Exact Request Sha256",
      "type": "string"
    },
    "exact_input_rows_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Exact Input Rows Sha256",
      "type": "string"
    },
    "density_kg_m3": {
      "exclusiveMinimum": 0,
      "title": "Density Kg M3",
      "type": "number"
    },
    "density_evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "density_evidence_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Density Evidence Sha256",
      "type": "string"
    },
    "analyzed_elements": {
      "items": {
        "enum": [
          "Ti",
          "Mo",
          "Zr"
        ],
        "type": "string"
      },
      "title": "Analyzed Elements",
      "type": "array"
    },
    "input_row_count": {
      "maximum": 20000,
      "minimum": 2,
      "title": "Input Row Count",
      "type": "integer"
    },
    "first_provider_time_s": {
      "minimum": 0,
      "title": "First Provider Time S",
      "type": "number"
    },
    "last_provider_time_s": {
      "minimum": 0,
      "title": "Last Provider Time S",
      "type": "number"
    },
    "signed_net_mass_flux_unit": {
      "const": "kg/m^2/s",
      "default": "kg/m^2/s",
      "title": "Signed Net Mass Flux Unit",
      "type": "string"
    },
    "signed_equivalent_penetration_velocity_unit": {
      "const": "m/s",
      "default": "m/s",
      "title": "Signed Equivalent Penetration Velocity Unit",
      "type": "string"
    },
    "integrated_penetration_unit": {
      "const": "m",
      "default": "m",
      "title": "Integrated Penetration Unit",
      "type": "string"
    },
    "positive_cumulative_penetration_m": {
      "minimum": 0,
      "title": "Positive Cumulative Penetration M",
      "type": "number"
    },
    "negative_cumulative_penetration_m": {
      "maximum": 0,
      "title": "Negative Cumulative Penetration M",
      "type": "number"
    },
    "signed_net_integrated_penetration_m": {
      "title": "Signed Net Integrated Penetration M",
      "type": "number"
    },
    "integration_basis": {
      "const": "piecewise_linear_trapezoid_over_provider_time_seconds",
      "default": "piecewise_linear_trapezoid_over_provider_time_seconds",
      "title": "Integration Basis",
      "type": "string"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/Ti12Mo5ZrPenetrationPoint"
      },
      "maxItems": 20000,
      "minItems": 2,
      "title": "Points",
      "type": "array"
    },
    "interpretation_scope": {
      "const": "signed_uniform_equivalent_thickness_not_localized_loss",
      "default": "signed_uniform_equivalent_thickness_not_localized_loss",
      "title": "Interpretation Scope",
      "type": "string"
    }
  },
  "required": [
    "source_member_sha256",
    "exact_request_sha256",
    "exact_input_rows_sha256",
    "density_kg_m3",
    "density_evidence",
    "density_evidence_sha256",
    "analyzed_elements",
    "input_row_count",
    "first_provider_time_s",
    "last_provider_time_s",
    "positive_cumulative_penetration_m",
    "negative_cumulative_penetration_m",
    "signed_net_integrated_penetration_m",
    "points"
  ],
  "title": "Ti12Mo5ZrMassBalanceResult",
  "type": "object"
}