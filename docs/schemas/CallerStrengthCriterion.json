{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "criterion_id": {
      "minLength": 1,
      "title": "Criterion Id",
      "type": "string"
    },
    "response_definition": {
      "minLength": 1,
      "title": "Response Definition",
      "type": "string"
    },
    "response_unit_token": {
      "minLength": 1,
      "title": "Response Unit Token",
      "type": "string"
    },
    "fail_below": {
      "title": "Fail Below",
      "type": "number"
    },
    "pass_at_or_above": {
      "title": "Pass At Or Above",
      "type": "number"
    },
    "conservative_statistic": {
      "const": "minimum_sample_response",
      "default": "minimum_sample_response",
      "title": "Conservative Statistic",
      "type": "string"
    },
    "criterion_basis": {
      "minLength": 1,
      "title": "Criterion Basis",
      "type": "string"
    },
    "criterion_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Criterion Source Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "criterion_id",
    "response_definition",
    "response_unit_token",
    "fail_below",
    "pass_at_or_above",
    "criterion_basis",
    "criterion_source_digest",
    "evidence"
  ],
  "title": "CallerStrengthCriterion",
  "type": "object"
}