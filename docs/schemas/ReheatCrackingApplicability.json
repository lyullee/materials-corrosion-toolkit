{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ReheatCrackingEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "weld_condition_id": {
          "minLength": 1,
          "title": "Weld Condition Id",
          "type": "string"
        },
        "haz_condition_id": {
          "minLength": 1,
          "title": "Haz Condition Id",
          "type": "string"
        },
        "welding_process_id": {
          "minLength": 1,
          "title": "Welding Process Id",
          "type": "string"
        },
        "heat_input_unit_token": {
          "minLength": 1,
          "title": "Heat Input Unit Token",
          "type": "string"
        },
        "minimum_heat_input_value": {
          "minimum": 0,
          "title": "Minimum Heat Input Value",
          "type": "number"
        },
        "maximum_heat_input_value": {
          "minimum": 0,
          "title": "Maximum Heat Input Value",
          "type": "number"
        },
        "minimum_reheat_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Reheat Temperature K",
          "type": "number"
        },
        "maximum_reheat_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Reheat Temperature K",
          "type": "number"
        },
        "maximum_cumulative_reheat_duration_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Cumulative Reheat Duration S",
          "type": "number"
        },
        "stress_unit_token": {
          "minLength": 1,
          "title": "Stress Unit Token",
          "type": "string"
        },
        "minimum_stress_value": {
          "title": "Minimum Stress Value",
          "type": "number"
        },
        "maximum_stress_value": {
          "title": "Maximum Stress Value",
          "type": "number"
        },
        "supported_stress_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Stress Descriptors",
          "type": "array"
        },
        "supported_restraint_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Restraint Descriptors",
          "type": "array"
        },
        "supported_region_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Region Ids",
          "type": "array"
        },
        "supported_method_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Method Ids",
          "type": "array"
        },
        "minimum_qualification_source_group_count": {
          "minimum": 1,
          "title": "Minimum Qualification Source Group Count",
          "type": "integer"
        },
        "qualification_observations": {
          "items": {
            "$ref": "#/$defs/ReheatQualificationObservation"
          },
          "minItems": 1,
          "title": "Qualification Observations",
          "type": "array"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "material_condition_id",
        "weld_condition_id",
        "haz_condition_id",
        "welding_process_id",
        "heat_input_unit_token",
        "minimum_heat_input_value",
        "maximum_heat_input_value",
        "minimum_reheat_temperature_K",
        "maximum_reheat_temperature_K",
        "maximum_cumulative_reheat_duration_s",
        "stress_unit_token",
        "minimum_stress_value",
        "maximum_stress_value",
        "supported_stress_descriptors",
        "supported_restraint_descriptors",
        "supported_region_ids",
        "supported_method_ids",
        "minimum_qualification_source_group_count",
        "qualification_observations",
        "qualification_basis",
        "evidence"
      ],
      "title": "ReheatCrackingEnvelope",
      "type": "object"
    },
    "ReheatQualificationObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "partition": {
          "enum": [
            "qualification",
            "holdout",
            "application"
          ],
          "title": "Partition",
          "type": "string"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "reported_value": {
          "title": "Reported Value",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "expanded_uncertainty": {
          "minimum": 0,
          "title": "Expanded Uncertainty",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "supports_declared_envelope": {
          "title": "Supports Declared Envelope",
          "type": "boolean"
        },
        "invalid_or_limiting_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Limiting Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "physical_specimen_id",
        "source_group_id",
        "partition",
        "region_id",
        "method_id",
        "metric_definition",
        "reported_value",
        "unit_token",
        "expanded_uncertainty",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "result_digest",
        "record_valid",
        "supports_declared_envelope",
        "evidence"
      ],
      "title": "ReheatQualificationObservation",
      "type": "object"
    },
    "ReheatThermalInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "stage_kind": {
          "enum": [
            "welding",
            "postweld_heat_treatment",
            "service_thermal_exposure"
          ],
          "title": "Stage Kind",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "minimum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "interval_id",
        "stage_kind",
        "start_time_s",
        "end_time_s",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "ReheatThermalInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "weld_condition_id": {
      "minLength": 1,
      "title": "Weld Condition Id",
      "type": "string"
    },
    "haz_condition_id": {
      "minLength": 1,
      "title": "Haz Condition Id",
      "type": "string"
    },
    "welding_process_id": {
      "minLength": 1,
      "title": "Welding Process Id",
      "type": "string"
    },
    "heat_input_value": {
      "minimum": 0,
      "title": "Heat Input Value",
      "type": "number"
    },
    "heat_input_unit_token": {
      "minLength": 1,
      "title": "Heat Input Unit Token",
      "type": "string"
    },
    "thermal_history": {
      "items": {
        "$ref": "#/$defs/ReheatThermalInterval"
      },
      "minItems": 1,
      "title": "Thermal History",
      "type": "array"
    },
    "stress_descriptor": {
      "minLength": 1,
      "title": "Stress Descriptor",
      "type": "string"
    },
    "stress_value": {
      "title": "Stress Value",
      "type": "number"
    },
    "stress_unit_token": {
      "minLength": 1,
      "title": "Stress Unit Token",
      "type": "string"
    },
    "restraint_descriptor": {
      "minLength": 1,
      "title": "Restraint Descriptor",
      "type": "string"
    },
    "candidate_envelopes": {
      "items": {
        "$ref": "#/$defs/ReheatCrackingEnvelope"
      },
      "minItems": 1,
      "title": "Candidate Envelopes",
      "type": "array"
    },
    "material_weld_and_haz_identity_reviewed": {
      "title": "Material Weld And Haz Identity Reviewed",
      "type": "boolean"
    },
    "welding_process_and_heat_input_reviewed": {
      "title": "Welding Process And Heat Input Reviewed",
      "type": "boolean"
    },
    "heat_treatment_clock_and_temperature_reviewed": {
      "title": "Heat Treatment Clock And Temperature Reviewed",
      "type": "boolean"
    },
    "stress_and_restraint_basis_reviewed": {
      "title": "Stress And Restraint Basis Reviewed",
      "type": "boolean"
    },
    "specimen_region_and_source_groups_reviewed": {
      "title": "Specimen Region And Source Groups Reviewed",
      "type": "boolean"
    },
    "observation_method_units_and_uncertainty_reviewed": {
      "title": "Observation Method Units And Uncertainty Reviewed",
      "type": "boolean"
    },
    "provider_lineage_and_digests_reviewed": {
      "title": "Provider Lineage And Digests Reviewed",
      "type": "boolean"
    },
    "qualification_envelope_authority_reviewed": {
      "title": "Qualification Envelope Authority Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "clock_id",
    "material_condition_id",
    "weld_condition_id",
    "haz_condition_id",
    "welding_process_id",
    "heat_input_value",
    "heat_input_unit_token",
    "thermal_history",
    "stress_descriptor",
    "stress_value",
    "stress_unit_token",
    "restraint_descriptor",
    "candidate_envelopes",
    "material_weld_and_haz_identity_reviewed",
    "welding_process_and_heat_input_reviewed",
    "heat_treatment_clock_and_temperature_reviewed",
    "stress_and_restraint_basis_reviewed",
    "specimen_region_and_source_groups_reviewed",
    "observation_method_units_and_uncertainty_reviewed",
    "provider_lineage_and_digests_reviewed",
    "qualification_envelope_authority_reviewed",
    "evidence"
  ],
  "title": "ReheatCrackingApplicability",
  "type": "object"
}