{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "component_kind": {
      "enum": [
        "electrolyte",
        "contact",
        "lead",
        "caller_other"
      ],
      "title": "Component Kind",
      "type": "string"
    },
    "resistance_ohm": {
      "minimum": 0,
      "title": "Resistance Ohm",
      "type": "number"
    },
    "basis": {
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "component_id",
    "component_kind",
    "resistance_ohm",
    "basis",
    "evidence"
  ],
  "title": "ResistanceComponent",
  "type": "object"
}