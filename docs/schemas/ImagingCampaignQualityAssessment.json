{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ImagingAcquisitionEvidence": {
      "additionalProperties": false,
      "properties": {
        "acquisition_id": {
          "minLength": 1,
          "title": "Acquisition Id",
          "type": "string"
        },
        "procedure_id": {
          "minLength": 1,
          "title": "Procedure Id",
          "type": "string"
        },
        "procedure_revision": {
          "minLength": 1,
          "title": "Procedure Revision",
          "type": "string"
        },
        "acquisition_configuration_id": {
          "minLength": 1,
          "title": "Acquisition Configuration Id",
          "type": "string"
        },
        "acquisition_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Acquisition Configuration Digest",
          "type": "string"
        },
        "acquisition_device_id": {
          "minLength": 1,
          "title": "Acquisition Device Id",
          "type": "string"
        },
        "reference_standard_id": {
          "minLength": 1,
          "title": "Reference Standard Id",
          "type": "string"
        },
        "target_extent": {
          "exclusiveMinimum": 0,
          "title": "Target Extent",
          "type": "number"
        },
        "examined_extent": {
          "minimum": 0,
          "title": "Examined Extent",
          "type": "number"
        },
        "extent_unit_token": {
          "minLength": 1,
          "title": "Extent Unit Token",
          "type": "string"
        },
        "encoded_data_id": {
          "minLength": 1,
          "title": "Encoded Data Id",
          "type": "string"
        },
        "encoded_data_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Encoded Data Digest",
          "type": "string"
        },
        "encoded_data_format": {
          "minLength": 1,
          "title": "Encoded Data Format",
          "type": "string"
        },
        "verifications": {
          "items": {
            "$ref": "#/$defs/ImagingReferenceVerification"
          },
          "minItems": 1,
          "title": "Verifications",
          "type": "array"
        },
        "acquisition_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Acquisition Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "acquisition_id",
        "procedure_id",
        "procedure_revision",
        "acquisition_configuration_id",
        "acquisition_configuration_digest",
        "acquisition_device_id",
        "reference_standard_id",
        "target_extent",
        "examined_extent",
        "extent_unit_token",
        "encoded_data_id",
        "encoded_data_digest",
        "encoded_data_format",
        "verifications",
        "acquisition_record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "ImagingAcquisitionEvidence",
      "type": "object"
    },
    "ImagingCampaignAcceptanceProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        },
        "imaging_family": {
          "enum": [
            "radiography",
            "phased_array"
          ],
          "title": "Imaging Family",
          "type": "string"
        },
        "required_check_stages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Check Stages",
          "type": "array"
        },
        "sensitivity_metric_definition": {
          "minLength": 1,
          "title": "Sensitivity Metric Definition",
          "type": "string"
        },
        "sensitivity_unit_token": {
          "minLength": 1,
          "title": "Sensitivity Unit Token",
          "type": "string"
        },
        "resolution_metric_definition": {
          "minLength": 1,
          "title": "Resolution Metric Definition",
          "type": "string"
        },
        "resolution_unit_token": {
          "minLength": 1,
          "title": "Resolution Unit Token",
          "type": "string"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/ImagingQualityCriterion"
          },
          "minItems": 7,
          "title": "Criteria",
          "type": "array"
        },
        "profile_provider_id": {
          "minLength": 1,
          "title": "Profile Provider Id",
          "type": "string"
        },
        "profile_revision": {
          "minLength": 1,
          "title": "Profile Revision",
          "type": "string"
        },
        "profile_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Configuration Digest",
          "type": "string"
        },
        "caller_acceptance_authority": {
          "minLength": 1,
          "title": "Caller Acceptance Authority",
          "type": "string"
        },
        "built_in_code_or_standard_limits_used": {
          "const": false,
          "default": false,
          "title": "Built In Code Or Standard Limits Used",
          "type": "boolean"
        },
        "flaw_acceptance_claimed": {
          "const": false,
          "default": false,
          "title": "Flaw Acceptance Claimed",
          "type": "boolean"
        },
        "pod_claimed": {
          "const": false,
          "default": false,
          "title": "Pod Claimed",
          "type": "boolean"
        },
        "physical_qualification_claimed": {
          "const": false,
          "default": false,
          "title": "Physical Qualification Claimed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "imaging_family",
        "required_check_stages",
        "sensitivity_metric_definition",
        "sensitivity_unit_token",
        "resolution_metric_definition",
        "resolution_unit_token",
        "criteria",
        "profile_provider_id",
        "profile_revision",
        "profile_configuration_digest",
        "caller_acceptance_authority",
        "evidence"
      ],
      "title": "ImagingCampaignAcceptanceProfile",
      "type": "object"
    },
    "ImagingQualityCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "metric_id": {
          "enum": [
            "acquisition_count",
            "coverage_fraction",
            "reference_feature_check_coverage_fraction",
            "required_stage_coverage_fraction",
            "response_present_fraction",
            "minimum_sensitivity_metric",
            "maximum_resolution_metric"
          ],
          "title": "Metric Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Direction",
          "type": "string"
        },
        "pass_limit": {
          "minimum": 0,
          "title": "Pass Limit",
          "type": "number"
        },
        "fail_limit": {
          "minimum": 0,
          "title": "Fail Limit",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "metric_id",
        "direction",
        "pass_limit",
        "fail_limit",
        "unit_token",
        "criterion_basis"
      ],
      "title": "ImagingQualityCriterion",
      "type": "object"
    },
    "ImagingReferenceFeature": {
      "additionalProperties": false,
      "properties": {
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "feature_type_descriptor": {
          "minLength": 1,
          "title": "Feature Type Descriptor",
          "type": "string"
        },
        "physical_location_definition": {
          "minLength": 1,
          "title": "Physical Location Definition",
          "type": "string"
        },
        "nominal_dimension": {
          "exclusiveMinimum": 0,
          "title": "Nominal Dimension",
          "type": "number"
        },
        "dimension_unit_token": {
          "minLength": 1,
          "title": "Dimension Unit Token",
          "type": "string"
        },
        "expanded_dimension_uncertainty": {
          "minimum": 0,
          "title": "Expanded Dimension Uncertainty",
          "type": "number"
        },
        "physical_feature_identity_reviewed": {
          "title": "Physical Feature Identity Reviewed",
          "type": "boolean"
        },
        "feature_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Feature Record Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "feature_id",
        "feature_type_descriptor",
        "physical_location_definition",
        "nominal_dimension",
        "dimension_unit_token",
        "expanded_dimension_uncertainty",
        "physical_feature_identity_reviewed",
        "feature_record_digest",
        "evidence"
      ],
      "title": "ImagingReferenceFeature",
      "type": "object"
    },
    "ImagingReferenceStandard": {
      "additionalProperties": false,
      "properties": {
        "reference_standard_id": {
          "minLength": 1,
          "title": "Reference Standard Id",
          "type": "string"
        },
        "material_and_product_form_id": {
          "minLength": 1,
          "title": "Material And Product Form Id",
          "type": "string"
        },
        "standard_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Standard Configuration Digest",
          "type": "string"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/ImagingReferenceFeature"
          },
          "minItems": 1,
          "title": "Features",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "reference_standard_id",
        "material_and_product_form_id",
        "standard_configuration_digest",
        "features",
        "evidence"
      ],
      "title": "ImagingReferenceStandard",
      "type": "object"
    },
    "ImagingReferenceVerification": {
      "additionalProperties": false,
      "properties": {
        "verification_id": {
          "minLength": 1,
          "title": "Verification Id",
          "type": "string"
        },
        "reference_feature_id": {
          "minLength": 1,
          "title": "Reference Feature Id",
          "type": "string"
        },
        "check_stage": {
          "minLength": 1,
          "title": "Check Stage",
          "type": "string"
        },
        "reported_response_present": {
          "title": "Reported Response Present",
          "type": "boolean"
        },
        "sensitivity_metric": {
          "title": "Sensitivity Metric",
          "type": "number"
        },
        "sensitivity_unit_token": {
          "minLength": 1,
          "title": "Sensitivity Unit Token",
          "type": "string"
        },
        "expanded_sensitivity_uncertainty": {
          "minimum": 0,
          "title": "Expanded Sensitivity Uncertainty",
          "type": "number"
        },
        "resolution_metric": {
          "minimum": 0,
          "title": "Resolution Metric",
          "type": "number"
        },
        "resolution_unit_token": {
          "minLength": 1,
          "title": "Resolution Unit Token",
          "type": "string"
        },
        "expanded_resolution_uncertainty": {
          "minimum": 0,
          "title": "Expanded Resolution Uncertainty",
          "type": "number"
        },
        "verification_method_definition": {
          "minLength": 1,
          "title": "Verification Method Definition",
          "type": "string"
        },
        "verification_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Verification Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "verification_id",
        "reference_feature_id",
        "check_stage",
        "reported_response_present",
        "sensitivity_metric",
        "sensitivity_unit_token",
        "expanded_sensitivity_uncertainty",
        "resolution_metric",
        "resolution_unit_token",
        "expanded_resolution_uncertainty",
        "verification_method_definition",
        "verification_record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "ImagingReferenceVerification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "imaging_family": {
      "enum": [
        "radiography",
        "phased_array"
      ],
      "title": "Imaging Family",
      "type": "string"
    },
    "procedure_id": {
      "minLength": 1,
      "title": "Procedure Id",
      "type": "string"
    },
    "procedure_revision": {
      "minLength": 1,
      "title": "Procedure Revision",
      "type": "string"
    },
    "extent_unit_token": {
      "minLength": 1,
      "title": "Extent Unit Token",
      "type": "string"
    },
    "reference_standard": {
      "$ref": "#/$defs/ImagingReferenceStandard"
    },
    "acquisitions": {
      "items": {
        "$ref": "#/$defs/ImagingAcquisitionEvidence"
      },
      "minItems": 1,
      "title": "Acquisitions",
      "type": "array"
    },
    "acceptance_profile": {
      "$ref": "#/$defs/ImagingCampaignAcceptanceProfile"
    },
    "procedure_and_acquisition_identities_reviewed": {
      "title": "Procedure And Acquisition Identities Reviewed",
      "type": "boolean"
    },
    "reference_standard_features_and_uncertainty_reviewed": {
      "title": "Reference Standard Features And Uncertainty Reviewed",
      "type": "boolean"
    },
    "calibration_and_verification_checks_reviewed": {
      "title": "Calibration And Verification Checks Reviewed",
      "type": "boolean"
    },
    "coverage_and_extent_units_reviewed": {
      "title": "Coverage And Extent Units Reviewed",
      "type": "boolean"
    },
    "encoded_data_identity_and_digests_reviewed": {
      "title": "Encoded Data Identity And Digests Reviewed",
      "type": "boolean"
    },
    "sensitivity_resolution_metrics_units_and_uncertainty_reviewed": {
      "title": "Sensitivity Resolution Metrics Units And Uncertainty Reviewed",
      "type": "boolean"
    },
    "caller_acceptance_profile_reviewed": {
      "title": "Caller Acceptance Profile Reviewed",
      "type": "boolean"
    },
    "record_validity_and_missingness_reviewed": {
      "title": "Record Validity And Missingness Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "campaign_id",
    "imaging_family",
    "procedure_id",
    "procedure_revision",
    "extent_unit_token",
    "reference_standard",
    "acquisitions",
    "acceptance_profile",
    "procedure_and_acquisition_identities_reviewed",
    "reference_standard_features_and_uncertainty_reviewed",
    "calibration_and_verification_checks_reviewed",
    "coverage_and_extent_units_reviewed",
    "encoded_data_identity_and_digests_reviewed",
    "sensitivity_resolution_metrics_units_and_uncertainty_reviewed",
    "caller_acceptance_profile_reviewed",
    "record_validity_and_missingness_reviewed",
    "evidence"
  ],
  "title": "ImagingCampaignQualityAssessment",
  "type": "object"
}