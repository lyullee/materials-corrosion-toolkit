{
  "additionalProperties": false,
  "description": "One provider curve sample; not a protection decision or corrosion rate.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.cathodic_protection_sample.v1",
      "default": "matintegrity.cathodic_protection_sample.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "zenodo-18735817-cathodic-protection",
      "default": "zenodo-18735817-cathodic-protection",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5281/zenodo.18735817",
      "default": "https://doi.org/10.5281/zenodo.18735817",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "source_filename": {
      "minLength": 1,
      "title": "Source Filename",
      "type": "string"
    },
    "source_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "curve_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Curve Record Sha256",
      "type": "string"
    },
    "curve_index": {
      "minimum": 1,
      "title": "Curve Index",
      "type": "integer"
    },
    "provider_curve_label": {
      "minLength": 1,
      "title": "Provider Curve Label",
      "type": "string"
    },
    "curve_sample_index": {
      "minimum": 0,
      "title": "Curve Sample Index",
      "type": "integer"
    },
    "measurement_kind": {
      "enum": [
        "open_circuit_potential",
        "potentiodynamic_scan"
      ],
      "title": "Measurement Kind",
      "type": "string"
    },
    "x_quantity": {
      "enum": [
        "time",
        "current"
      ],
      "title": "X Quantity",
      "type": "string"
    },
    "x_unit": {
      "enum": [
        "s",
        "provider_current_axis_unresolved"
      ],
      "title": "X Unit",
      "type": "string"
    },
    "x_value_provider_native": {
      "title": "X Value Provider Native",
      "type": "number"
    },
    "potential_V_vs_calomel": {
      "title": "Potential V Vs Calomel",
      "type": "number"
    },
    "reference_electrode_subtype": {
      "const": "unresolved_calomel_subtype",
      "default": "unresolved_calomel_subtype",
      "title": "Reference Electrode Subtype",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "interpretation_status": {
      "const": "raw_curve_sample_no_protection_or_corrosion_rate",
      "default": "raw_curve_sample_no_protection_or_corrosion_rate",
      "title": "Interpretation Status",
      "type": "string"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "source_filename",
    "source_file_sha256",
    "curve_record_sha256",
    "curve_index",
    "provider_curve_label",
    "curve_sample_index",
    "measurement_kind",
    "x_quantity",
    "x_unit",
    "x_value_provider_native",
    "potential_V_vs_calomel"
  ],
  "title": "CathodicProtectionSample",
  "type": "object"
}