{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "StoichiometricTransferTerm": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "coefficient": {
          "minimum": 1,
          "title": "Coefficient",
          "type": "integer"
        }
      },
      "required": [
        "species_id",
        "coefficient"
      ],
      "title": "StoichiometricTransferTerm",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "transfer_id": {
      "minLength": 1,
      "title": "Transfer Id",
      "type": "string"
    },
    "transfer_kind": {
      "enum": [
        "identity",
        "renamed",
        "reaction_transformed"
      ],
      "title": "Transfer Kind",
      "type": "string"
    },
    "source_terms": {
      "items": {
        "$ref": "#/$defs/StoichiometricTransferTerm"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Source Terms",
      "type": "array"
    },
    "target_terms": {
      "items": {
        "$ref": "#/$defs/StoichiometricTransferTerm"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Target Terms",
      "type": "array"
    },
    "reviewed": {
      "title": "Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "transfer_id",
    "transfer_kind",
    "source_terms",
    "target_terms",
    "reviewed",
    "evidence"
  ],
  "title": "SpeciesTransferRule",
  "type": "object"
}