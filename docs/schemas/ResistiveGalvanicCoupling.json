{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GalvanicElectrodeEvidence": {
      "additionalProperties": false,
      "properties": {
        "electrode_id": {
          "minLength": 1,
          "title": "Electrode Id",
          "type": "string"
        },
        "metal_id": {
          "minLength": 1,
          "title": "Metal Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "exposed_area_m2": {
          "exclusiveMinimum": 0,
          "title": "Exposed Area M2",
          "type": "number"
        },
        "polarization_curve": {
          "$ref": "#/$defs/PolarizationCurve"
        },
        "curve_provider_id": {
          "minLength": 1,
          "title": "Curve Provider Id",
          "type": "string"
        },
        "curve_provider_revision": {
          "minLength": 1,
          "title": "Curve Provider Revision",
          "type": "string"
        },
        "curve_input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Curve Input Digest",
          "type": "string"
        },
        "curve_result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Curve Result Digest",
          "type": "string"
        },
        "curve_support_reviewed": {
          "title": "Curve Support Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "electrode_id",
        "metal_id",
        "material_condition_id",
        "exposed_area_m2",
        "polarization_curve",
        "curve_provider_id",
        "curve_provider_revision",
        "curve_input_digest",
        "curve_result_digest",
        "curve_support_reviewed"
      ],
      "title": "GalvanicElectrodeEvidence",
      "type": "object"
    },
    "GalvanicEnvironment": {
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "electrolyte_id": {
          "minLength": 1,
          "title": "Electrolyte Id",
          "type": "string"
        },
        "electrolyte_description": {
          "minLength": 1,
          "title": "Electrolyte Description",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "reference_electrode_id": {
          "minLength": 1,
          "title": "Reference Electrode Id",
          "type": "string"
        },
        "condition_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Condition Digest",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "electrolyte_id",
        "electrolyte_description",
        "temperature_K",
        "reference_electrode_id",
        "condition_digest"
      ],
      "title": "GalvanicEnvironment",
      "type": "object"
    },
    "PartialDissolutionObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "electrode_id": {
          "minLength": 1,
          "title": "Electrode Id",
          "type": "string"
        },
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "partial_dissolution_current_density_A_m2": {
          "minimum": 0,
          "title": "Partial Dissolution Current Density A M2",
          "type": "number"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "electrode_id",
        "species_id",
        "partial_dissolution_current_density_A_m2",
        "method_id",
        "provider_id",
        "result_digest",
        "evidence"
      ],
      "title": "PartialDissolutionObservation",
      "type": "object"
    },
    "PolarizationCurve": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.polarization_curve.v1",
          "default": "matintegrity.polarization_curve.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "curve_id": {
          "minLength": 1,
          "title": "Curve Id",
          "type": "string"
        },
        "surface_condition_id": {
          "minLength": 1,
          "title": "Surface Condition Id",
          "type": "string"
        },
        "protocol_id": {
          "minLength": 1,
          "title": "Protocol Id",
          "type": "string"
        },
        "electrolyte_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electrolyte Id"
        },
        "reference_electrode_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Electrode Id"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "point_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20000,
          "minItems": 2,
          "title": "Point Ids",
          "type": "array"
        },
        "potential_V": {
          "items": {
            "type": "number"
          },
          "maxItems": 20000,
          "minItems": 2,
          "title": "Potential V",
          "type": "array"
        },
        "signed_net_current_density_A_m2": {
          "items": {
            "type": "number"
          },
          "maxItems": 20000,
          "minItems": 2,
          "title": "Signed Net Current Density A M2",
          "type": "array"
        },
        "current_convention": {
          "default": "anodic_positive_net",
          "enum": [
            "anodic_positive_net",
            "unreviewed_signed_net"
          ],
          "title": "Current Convention",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "curve_id",
        "surface_condition_id",
        "protocol_id",
        "point_ids",
        "potential_V",
        "signed_net_current_density_A_m2",
        "evidence"
      ],
      "title": "PolarizationCurve",
      "type": "object"
    },
    "ResistanceComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "component_kind": {
          "enum": [
            "electrolyte",
            "contact",
            "lead",
            "caller_other"
          ],
          "title": "Component Kind",
          "type": "string"
        },
        "resistance_ohm": {
          "minimum": 0,
          "title": "Resistance Ohm",
          "type": "number"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "component_kind",
        "resistance_ohm",
        "basis",
        "evidence"
      ],
      "title": "ResistanceComponent",
      "type": "object"
    },
    "ResistiveGalvanicConnection": {
      "additionalProperties": false,
      "properties": {
        "connection_id": {
          "minLength": 1,
          "title": "Connection Id",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ResistanceComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "declared_total_series_resistance_ohm": {
          "exclusiveMinimum": 0,
          "title": "Declared Total Series Resistance Ohm",
          "type": "number"
        },
        "component_sum_tolerance_ohm": {
          "default": 1e-12,
          "minimum": 0,
          "title": "Component Sum Tolerance Ohm",
          "type": "number"
        },
        "connection_reviewed": {
          "title": "Connection Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "connection_id",
        "components",
        "declared_total_series_resistance_ohm",
        "connection_reviewed"
      ],
      "title": "ResistiveGalvanicConnection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "environment": {
      "$ref": "#/$defs/GalvanicEnvironment"
    },
    "electrodes": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/GalvanicElectrodeEvidence"
        },
        {
          "$ref": "#/$defs/GalvanicElectrodeEvidence"
        }
      ],
      "title": "Electrodes",
      "type": "array"
    },
    "connection": {
      "$ref": "#/$defs/ResistiveGalvanicConnection"
    },
    "partial_dissolution_observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PartialDissolutionObservation"
      },
      "title": "Partial Dissolution Observations",
      "type": "array"
    },
    "solver_id": {
      "const": "matintegrity.two_electrode_piecewise_resistive_balance.v1",
      "title": "Solver Id",
      "type": "string"
    },
    "solver_revision": {
      "minLength": 1,
      "title": "Solver Revision",
      "type": "string"
    },
    "quasi_steady_reviewed": {
      "title": "Quasi Steady Reviewed",
      "type": "boolean"
    },
    "condition_compatibility_reviewed": {
      "title": "Condition Compatibility Reviewed",
      "type": "boolean"
    },
    "common_reference_reviewed": {
      "title": "Common Reference Reviewed",
      "type": "boolean"
    },
    "anodic_positive_net_current_reviewed": {
      "title": "Anodic Positive Net Current Reviewed",
      "type": "boolean"
    },
    "caller_reviewed": {
      "title": "Caller Reviewed",
      "type": "boolean"
    },
    "absolute_current_balance_tolerance_A": {
      "default": 1e-12,
      "minimum": 0,
      "title": "Absolute Current Balance Tolerance A",
      "type": "number"
    },
    "absolute_voltage_balance_tolerance_V": {
      "default": 1e-12,
      "minimum": 0,
      "title": "Absolute Voltage Balance Tolerance V",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "environment",
    "electrodes",
    "connection",
    "solver_id",
    "solver_revision",
    "quasi_steady_reviewed",
    "condition_compatibility_reviewed",
    "common_reference_reviewed",
    "anodic_positive_net_current_reviewed",
    "caller_reviewed",
    "evidence"
  ],
  "title": "ResistiveGalvanicCoupling",
  "type": "object"
}