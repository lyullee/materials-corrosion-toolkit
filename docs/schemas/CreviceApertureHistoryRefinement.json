{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bounded, deterministic subdivision request for an existing aperture path.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.crevice_aperture_history_refinement.v1",
      "default": "matintegrity.crevice_aperture_history_refinement.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "refinement_id": {
      "minLength": 1,
      "title": "Refinement Id",
      "type": "string"
    },
    "source_geometry_result": {
      "additionalProperties": true,
      "title": "Source Geometry Result",
      "type": "object"
    },
    "source_geometry_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Geometry Result Sha256",
      "type": "string"
    },
    "source_geometry_assessment_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssessmentResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_geometry_assessment_result_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Geometry Assessment Result Sha256"
    },
    "maximum_relative_aperture_change_per_segment": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Maximum Relative Aperture Change Per Segment",
      "type": "number"
    },
    "maximum_internal_segments": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Maximum Internal Segments",
      "type": "integer"
    },
    "maximum_bisection_refinements": {
      "maximum": 100000,
      "minimum": 0,
      "title": "Maximum Bisection Refinements",
      "type": "integer"
    },
    "linear_geometry_interpolation_reviewed": {
      "title": "Linear Geometry Interpolation Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "refinement_id",
    "source_geometry_result",
    "source_geometry_result_sha256",
    "maximum_relative_aperture_change_per_segment",
    "maximum_internal_segments",
    "maximum_bisection_refinements",
    "linear_geometry_interpolation_reviewed"
  ],
  "title": "CreviceApertureHistoryRefinement",
  "type": "object"
}