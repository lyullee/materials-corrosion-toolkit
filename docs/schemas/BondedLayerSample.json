{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "assembly_id": {
      "minLength": 1,
      "title": "Assembly Id",
      "type": "string"
    },
    "interface_id": {
      "minLength": 1,
      "title": "Interface Id",
      "type": "string"
    },
    "sampling_plan_id": {
      "minLength": 1,
      "title": "Sampling Plan Id",
      "type": "string"
    },
    "physical_location_definition": {
      "minLength": 1,
      "title": "Physical Location Definition",
      "type": "string"
    },
    "orientation_id": {
      "minLength": 1,
      "title": "Orientation Id",
      "type": "string"
    },
    "coordinate_frame_id": {
      "minLength": 1,
      "title": "Coordinate Frame Id",
      "type": "string"
    },
    "replicate_group_id": {
      "minLength": 1,
      "title": "Replicate Group Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "independence_group_id": {
      "minLength": 1,
      "title": "Independence Group Id",
      "type": "string"
    },
    "sampling_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sampling Record Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "sample_id",
    "assembly_id",
    "interface_id",
    "sampling_plan_id",
    "physical_location_definition",
    "orientation_id",
    "coordinate_frame_id",
    "replicate_group_id",
    "source_group_id",
    "independence_group_id",
    "sampling_record_digest",
    "evidence"
  ],
  "title": "BondedLayerSample",
  "type": "object"
}