{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "bolt_id": {
      "minLength": 1,
      "title": "Bolt Id",
      "type": "string"
    },
    "common_geometry_thread_bearing_and_lubrication_condition_id": {
      "minLength": 1,
      "title": "Common Geometry Thread Bearing And Lubrication Condition Id",
      "type": "string"
    },
    "reference_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reference Record Digest",
      "type": "string"
    },
    "reference_torque_N_m": {
      "minimum": 0,
      "title": "Reference Torque N M",
      "type": "number"
    },
    "reference_tensile_stress_Pa": {
      "exclusiveMinimum": 0,
      "title": "Reference Tensile Stress Pa",
      "type": "number"
    },
    "target_tensile_stress_Pa": {
      "minimum": 0,
      "title": "Target Tensile Stress Pa",
      "type": "number"
    },
    "unchanged_geometry_and_friction_conditions_reviewed": {
      "title": "Unchanged Geometry And Friction Conditions Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "basis",
    "bolt_id",
    "common_geometry_thread_bearing_and_lubrication_condition_id",
    "reference_record_digest",
    "reference_torque_N_m",
    "reference_tensile_stress_Pa",
    "target_tensile_stress_Pa",
    "unchanged_geometry_and_friction_conditions_reviewed"
  ],
  "title": "BoltReferenceTorqueScaling",
  "type": "object"
}