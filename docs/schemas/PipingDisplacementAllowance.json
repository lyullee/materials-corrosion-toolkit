{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "variant": {
      "enum": [
        "base",
        "with_sustained_stress"
      ],
      "title": "Variant",
      "type": "string"
    },
    "cold_allowable_Pa": {
      "exclusiveMinimum": 0,
      "title": "Cold Allowable Pa",
      "type": "number"
    },
    "hot_allowable_Pa": {
      "exclusiveMinimum": 0,
      "title": "Hot Allowable Pa",
      "type": "number"
    },
    "cycle_reduction_factor": {
      "exclusiveMinimum": 0,
      "title": "Cycle Reduction Factor",
      "type": "number"
    },
    "cold_multiplier": {
      "minimum": 0,
      "title": "Cold Multiplier",
      "type": "number"
    },
    "hot_multiplier": {
      "minimum": 0,
      "title": "Hot Multiplier",
      "type": "number"
    },
    "sustained_stress_Pa": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sustained Stress Pa"
    }
  },
  "required": [
    "basis",
    "variant",
    "cold_allowable_Pa",
    "hot_allowable_Pa",
    "cycle_reduction_factor",
    "cold_multiplier",
    "hot_multiplier"
  ],
  "title": "PipingDisplacementAllowance",
  "type": "object"
}