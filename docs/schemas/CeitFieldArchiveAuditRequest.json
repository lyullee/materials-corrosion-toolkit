{
  "$defs": {
    "CeitFieldReadAuthorization": {
      "additionalProperties": false,
      "description": "Caller attribution and local-only computational-use declaration.",
      "properties": {
        "dataset_id": {
          "const": "ceit-uniform-corrosion-field",
          "default": "ceit-uniform-corrosion-field",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_doi": {
          "const": "10.5281/zenodo.13897090",
          "default": "10.5281/zenodo.13897090",
          "title": "Dataset Doi",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "computational_use_authorized": {
          "const": true,
          "title": "Computational Use Authorized",
          "type": "boolean"
        },
        "local_only_authorized": {
          "const": true,
          "title": "Local Only Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "attribution",
        "computational_use_authorized",
        "local_only_authorized"
      ],
      "title": "CeitFieldReadAuthorization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "local_json_path": {
      "minLength": 1,
      "title": "Local Json Path",
      "type": "string"
    },
    "series_id": {
      "minLength": 1,
      "title": "Series Id",
      "type": "string"
    },
    "reported_tof_unit": {
      "anyOf": [
        {
          "enum": [
            "ns",
            "s"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Tof Unit"
    },
    "reported_temperature_unit": {
      "anyOf": [
        {
          "enum": [
            "degC",
            "K"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Temperature Unit"
    },
    "sample_interval_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Interval S"
    },
    "authorization": {
      "$ref": "#/$defs/CeitFieldReadAuthorization"
    }
  },
  "required": [
    "local_json_path",
    "series_id",
    "authorization"
  ],
  "title": "CeitFieldArchiveAuditRequest",
  "type": "object"
}