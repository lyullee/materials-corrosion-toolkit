{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixed integer stoichiometry and caller-calibrated interval rate tables.",
  "properties": {
    "reaction_id": {
      "minLength": 1,
      "title": "Reaction Id",
      "type": "string"
    },
    "reactants": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Reactants",
      "type": "object"
    },
    "products": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Products",
      "type": "object"
    },
    "forward_rate_constants": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "minItems": 1,
      "title": "Forward Rate Constants",
      "type": "array"
    },
    "reverse_rate_constants": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "minItems": 1,
      "title": "Reverse Rate Constants",
      "type": "array"
    },
    "forward_rate_constant_unit": {
      "minLength": 1,
      "title": "Forward Rate Constant Unit",
      "type": "string"
    },
    "reverse_rate_constant_unit": {
      "minLength": 1,
      "title": "Reverse Rate Constant Unit",
      "type": "string"
    },
    "calibration_record_id": {
      "minLength": 1,
      "title": "Calibration Record Id",
      "type": "string"
    },
    "calibration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Sha256",
      "type": "string"
    },
    "calibration_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Calibration Evidence",
      "type": "array"
    }
  },
  "required": [
    "reaction_id",
    "reactants",
    "products",
    "forward_rate_constants",
    "reverse_rate_constants",
    "forward_rate_constant_unit",
    "reverse_rate_constant_unit",
    "calibration_record_id",
    "calibration_sha256",
    "calibration_evidence"
  ],
  "title": "SpatialMassActionReaction",
  "type": "object"
}