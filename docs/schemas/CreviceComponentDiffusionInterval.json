{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "interval_id": {
      "minLength": 1,
      "title": "Interval Id",
      "type": "string"
    },
    "support_id": {
      "minLength": 1,
      "title": "Support Id",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "gap_m": {
      "exclusiveMinimum": 0,
      "title": "Gap M",
      "type": "number"
    },
    "diffusivity_m2_s": {
      "exclusiveMinimum": 0,
      "title": "Diffusivity M2 S",
      "type": "number"
    },
    "mouth_component_concentration_mol_m3": {
      "minimum": 0,
      "title": "Mouth Component Concentration Mol M3",
      "type": "number"
    },
    "volumetric_component_source_mol_m3_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Volumetric Component Source Mol M3 S",
      "type": "array"
    },
    "provider_state_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider State Digest"
    },
    "record_valid": {
      "title": "Record Valid",
      "type": "boolean"
    },
    "invalid_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalid Basis"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "interval_id",
    "support_id",
    "temperature_K",
    "gap_m",
    "diffusivity_m2_s",
    "mouth_component_concentration_mol_m3",
    "volumetric_component_source_mol_m3_s",
    "record_valid",
    "evidence"
  ],
  "title": "CreviceComponentDiffusionInterval",
  "type": "object"
}