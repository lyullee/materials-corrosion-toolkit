{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Summarize sign-invariant changes in the largest-principal-stress axis.",
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "sample_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 3,
      "title": "Sample Ids",
      "type": "array"
    },
    "stress_tensor_components_Pa": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 10000,
      "minItems": 3,
      "title": "Stress Tensor Components Pa",
      "type": "array"
    },
    "minimum_relative_principal_gap": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Minimum Relative Principal Gap",
      "type": "number"
    },
    "tensor_basis_and_component_order_reviewed": {
      "title": "Tensor Basis And Component Order Reviewed",
      "type": "boolean"
    },
    "closed_cycle_and_sample_order_reviewed": {
      "title": "Closed Cycle And Sample Order Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_id",
    "source_id",
    "source_sha256",
    "evidence",
    "sample_ids",
    "stress_tensor_components_Pa",
    "minimum_relative_principal_gap",
    "tensor_basis_and_component_order_reviewed",
    "closed_cycle_and_sample_order_reviewed"
  ],
  "title": "PrincipalStressAxisRotation",
  "type": "object"
}