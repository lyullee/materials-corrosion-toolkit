{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "component_id": {
      "title": "Component Id",
      "type": "string"
    },
    "repair_id": {
      "title": "Repair Id",
      "type": "string"
    },
    "weld_id": {
      "title": "Weld Id",
      "type": "string"
    },
    "wps_id": {
      "title": "Wps Id",
      "type": "string"
    },
    "wps_revision": {
      "title": "Wps Revision",
      "type": "string"
    },
    "welder_ids": {
      "items": {
        "type": "string"
      },
      "title": "Welder Ids",
      "type": "array"
    },
    "base_heat_ids": {
      "items": {
        "type": "string"
      },
      "title": "Base Heat Ids",
      "type": "array"
    },
    "consumable_lot_ids": {
      "items": {
        "type": "string"
      },
      "title": "Consumable Lot Ids",
      "type": "array"
    },
    "repair_sequence_number": {
      "minimum": 1,
      "title": "Repair Sequence Number",
      "type": "integer"
    },
    "previous_repair_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Previous Repair Ids",
      "type": "array"
    },
    "reviewed": {
      "title": "Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "component_id",
    "repair_id",
    "weld_id",
    "wps_id",
    "wps_revision",
    "welder_ids",
    "base_heat_ids",
    "consumable_lot_ids",
    "repair_sequence_number",
    "reviewed",
    "evidence"
  ],
  "title": "RepairIdentity",
  "type": "object"
}