{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "NumericAcceptanceRule": {
      "additionalProperties": false,
      "properties": {
        "rule_kind": {
          "const": "numeric",
          "default": "numeric",
          "title": "Rule Kind",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "target_scope": {
          "enum": [
            "examination",
            "region",
            "indication",
            "group"
          ],
          "title": "Target Scope",
          "type": "string"
        },
        "metric": {
          "enum": [
            "coverage_fraction",
            "indication_count",
            "length_m",
            "width_m",
            "area_m2",
            "group_member_count",
            "aggregate_length_m",
            "aggregate_width_m",
            "aggregate_area_m2"
          ],
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            "less_than",
            "less_than_or_equal",
            "greater_than",
            "greater_than_or_equal"
          ],
          "title": "Operator",
          "type": "string"
        },
        "threshold": {
          "title": "Threshold",
          "type": "number"
        },
        "unit_token": {
          "enum": [
            "1",
            "count",
            "m",
            "m^2"
          ],
          "title": "Unit Token",
          "type": "string"
        },
        "missing_metric_disposition": {
          "enum": [
            "review",
            "insufficient_evidence"
          ],
          "title": "Missing Metric Disposition",
          "type": "string"
        },
        "rule_description": {
          "minLength": 1,
          "title": "Rule Description",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "target_scope",
        "metric",
        "operator",
        "threshold",
        "unit_token",
        "missing_metric_disposition",
        "rule_description"
      ],
      "title": "NumericAcceptanceRule",
      "type": "object"
    },
    "ProhibitedClassRule": {
      "additionalProperties": false,
      "properties": {
        "rule_kind": {
          "const": "prohibited_class",
          "default": "prohibited_class",
          "title": "Rule Kind",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "target_scope": {
          "const": "indication",
          "default": "indication",
          "title": "Target Scope",
          "type": "string"
        },
        "prohibited_reported_classes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Prohibited Reported Classes",
          "type": "array"
        },
        "case_sensitive": {
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "rule_description": {
          "minLength": 1,
          "title": "Rule Description",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "prohibited_reported_classes",
        "case_sensitive",
        "rule_description"
      ],
      "title": "ProhibitedClassRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "profile_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Source Digest",
      "type": "string"
    },
    "applicable_methods": {
      "items": {
        "enum": [
          "visual_surface",
          "penetrant",
          "magnetic_particle"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Applicable Methods",
      "type": "array"
    },
    "applicable_procedure_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Applicable Procedure Ids",
      "type": "array"
    },
    "permitted_geometry_types": {
      "items": {
        "enum": [
          "planar",
          "cylindrical",
          "conical",
          "complex",
          "user_defined"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Geometry Types",
      "type": "array"
    },
    "permitted_surface_condition_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Permitted Surface Condition Ids",
      "type": "array"
    },
    "rules": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/NumericAcceptanceRule"
          },
          {
            "$ref": "#/$defs/ProhibitedClassRule"
          }
        ]
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "profile_reviewed": {
      "title": "Profile Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_revision",
    "profile_source_digest",
    "applicable_methods",
    "applicable_procedure_ids",
    "permitted_geometry_types",
    "permitted_surface_condition_ids",
    "rules",
    "profile_reviewed",
    "evidence"
  ],
  "title": "CallerAcceptanceProfile",
  "type": "object"
}