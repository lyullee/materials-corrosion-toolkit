{
  "$defs": {
    "LossCondition": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "feature_values": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Feature Values",
          "type": "object"
        },
        "feature_units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Feature Units",
          "type": "object"
        },
        "condition_and_measurement_basis_reviewed": {
          "title": "Condition And Measurement Basis Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "condition_id",
        "source_sha256",
        "feature_values",
        "feature_units",
        "condition_and_measurement_basis_reviewed"
      ],
      "title": "LossCondition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "interval_id": {
      "minLength": 1,
      "title": "Interval Id",
      "type": "string"
    },
    "start_s": {
      "minimum": 0,
      "title": "Start S",
      "type": "number"
    },
    "end_s": {
      "exclusiveMinimum": 0,
      "title": "End S",
      "type": "number"
    },
    "condition": {
      "$ref": "#/$defs/LossCondition"
    }
  },
  "required": [
    "interval_id",
    "start_s",
    "end_s",
    "condition"
  ],
  "title": "ConditionLossInterval",
  "type": "object"
}