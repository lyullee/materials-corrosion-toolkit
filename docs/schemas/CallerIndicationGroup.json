{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "group_id": {
      "minLength": 1,
      "title": "Group Id",
      "type": "string"
    },
    "member_indication_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Member Indication Ids",
      "type": "array"
    },
    "grouping_basis": {
      "minLength": 1,
      "title": "Grouping Basis",
      "type": "string"
    },
    "aggregate_length_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregate Length M"
    },
    "aggregate_width_m": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregate Width M"
    },
    "aggregate_area_m2": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregate Area M2"
    },
    "provider_result_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Result Digest",
      "type": "string"
    },
    "grouping_reviewed": {
      "title": "Grouping Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "group_id",
    "member_indication_ids",
    "grouping_basis",
    "provider_result_digest",
    "grouping_reviewed",
    "evidence"
  ],
  "title": "CallerIndicationGroup",
  "type": "object"
}