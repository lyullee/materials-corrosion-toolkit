{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evaluate a caller-reviewed finite tensor cycle and material hardening factor.\n\nTensor components use ``[xx, yy, zz, xy, yz, zx]`` order. Shear entries\nare explicitly declared as tensorial or engineering strain. The principal\nstrain range and material coefficient are supplied and evidence-pinned by\nthe caller; the evaluator computes the sampled path non-proportionality\nfactor from the principal strain axes.",
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "cycle_id": {
      "minLength": 1,
      "title": "Cycle Id",
      "type": "string"
    },
    "history_source_id": {
      "minLength": 1,
      "title": "History Source Id",
      "type": "string"
    },
    "history_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "History Source Sha256",
      "type": "string"
    },
    "history_evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "strain_tensor_components": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 10001,
      "minItems": 4,
      "title": "Strain Tensor Components",
      "type": "array"
    },
    "sample_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10001,
      "minItems": 4,
      "title": "Sample Ids",
      "type": "array"
    },
    "time_s": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 10001,
      "minItems": 4,
      "title": "Time S",
      "type": "array"
    },
    "period_s": {
      "exclusiveMinimum": 0,
      "title": "Period S",
      "type": "number"
    },
    "strain_shear_convention": {
      "pattern": "^(tensor|engineering)$",
      "title": "Strain Shear Convention",
      "type": "string"
    },
    "tensor_component_order": {
      "default": [
        "xx",
        "yy",
        "zz",
        "xy",
        "yz",
        "zx"
      ],
      "items": {
        "type": "string"
      },
      "title": "Tensor Component Order",
      "type": "array"
    },
    "maximum_principal_strain_range": {
      "exclusiveMinimum": 0,
      "title": "Maximum Principal Strain Range",
      "type": "number"
    },
    "principal_strain_range_evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "hardening_coefficient_alpha": {
      "title": "Hardening Coefficient Alpha",
      "type": "number"
    },
    "calibration_source_id": {
      "minLength": 1,
      "title": "Calibration Source Id",
      "type": "string"
    },
    "calibration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Sha256",
      "type": "string"
    },
    "calibration_evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "maximum_absolute_principal_strain_direction_gap_relative_tolerance": {
      "default": 1e-10,
      "minimum": 0,
      "title": "Maximum Absolute Principal Strain Direction Gap Relative Tolerance",
      "type": "number"
    },
    "maximum_sample_count": {
      "default": 10001,
      "maximum": 10001,
      "minimum": 4,
      "title": "Maximum Sample Count",
      "type": "integer"
    },
    "tensor_basis_reviewed": {
      "title": "Tensor Basis Reviewed",
      "type": "boolean"
    },
    "cycle_clock_and_sample_order_reviewed": {
      "title": "Cycle Clock And Sample Order Reviewed",
      "type": "boolean"
    },
    "cycle_closure_reviewed": {
      "title": "Cycle Closure Reviewed",
      "type": "boolean"
    },
    "principal_strain_range_basis_reviewed": {
      "title": "Principal Strain Range Basis Reviewed",
      "type": "boolean"
    },
    "material_condition_and_alpha_calibration_reviewed": {
      "title": "Material Condition And Alpha Calibration Reviewed",
      "type": "boolean"
    },
    "principal_axis_tie_convention_reviewed": {
      "title": "Principal Axis Tie Convention Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_id",
    "material_condition_id",
    "cycle_id",
    "history_source_id",
    "history_source_sha256",
    "history_evidence",
    "strain_tensor_components",
    "sample_ids",
    "time_s",
    "period_s",
    "strain_shear_convention",
    "maximum_principal_strain_range",
    "principal_strain_range_evidence",
    "hardening_coefficient_alpha",
    "calibration_source_id",
    "calibration_sha256",
    "calibration_evidence",
    "tensor_basis_reviewed",
    "cycle_clock_and_sample_order_reviewed",
    "cycle_closure_reviewed",
    "principal_strain_range_basis_reviewed",
    "material_condition_and_alpha_calibration_reviewed",
    "principal_axis_tie_convention_reviewed"
  ],
  "title": "ItohNonproportionalStrainRequest",
  "type": "object"
}