{
  "$defs": {
    "CallerBrazingBondingProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "minLength": 1,
          "title": "Profile Revision",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "permitted_base_lot_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Permitted Base Lot Ids",
          "type": "array"
        },
        "permitted_filler_lot_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Permitted Filler Lot Ids",
          "type": "array"
        },
        "permitted_adhesive_lot_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Permitted Adhesive Lot Ids",
          "type": "array"
        },
        "permitted_surface_preparation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Permitted Surface Preparation Ids",
          "type": "array"
        },
        "permitted_joint_geometry_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Permitted Joint Geometry Ids",
          "type": "array"
        },
        "minimum_fitup_gap_m": {
          "minimum": 0,
          "title": "Minimum Fitup Gap M",
          "type": "number"
        },
        "maximum_fitup_gap_m": {
          "minimum": 0,
          "title": "Maximum Fitup Gap M",
          "type": "number"
        },
        "fitup_uncertainty_policy": {
          "enum": [
            "point_value",
            "interval_must_fit"
          ],
          "title": "Fitup Uncertainty Policy",
          "type": "string"
        },
        "permitted_atmosphere_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Permitted Atmosphere Ids",
          "type": "array"
        },
        "permitted_flux_lot_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Permitted Flux Lot Ids",
          "type": "array"
        },
        "minimum_cycle_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Minimum Cycle Temperature K",
          "type": "number"
        },
        "maximum_cycle_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Maximum Cycle Temperature K",
          "type": "number"
        },
        "maximum_cycle_pressure_pa_abs": {
          "minimum": 0,
          "title": "Maximum Cycle Pressure Pa Abs",
          "type": "number"
        },
        "maximum_interval_duration_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Interval Duration S",
          "type": "number"
        },
        "criteria": {
          "items": {
            "$ref": "#/$defs/CallerProductionCriterion"
          },
          "minItems": 1,
          "title": "Criteria",
          "type": "array"
        },
        "profile_reviewed": {
          "title": "Profile Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "source_digest",
        "permitted_base_lot_ids",
        "permitted_surface_preparation_ids",
        "permitted_joint_geometry_ids",
        "minimum_fitup_gap_m",
        "maximum_fitup_gap_m",
        "fitup_uncertainty_policy",
        "permitted_atmosphere_ids",
        "minimum_cycle_temperature_k",
        "maximum_cycle_temperature_k",
        "maximum_cycle_pressure_pa_abs",
        "maximum_interval_duration_s",
        "criteria",
        "profile_reviewed",
        "evidence"
      ],
      "title": "CallerBrazingBondingProfile",
      "type": "object"
    },
    "CallerProductionCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "metric_kind": {
          "minLength": 1,
          "title": "Metric Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "individual",
            "replicate_mean",
            "replicate_minimum",
            "replicate_maximum"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "minimum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Inclusive"
        },
        "maximum_inclusive": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Inclusive"
        },
        "uncertainty_policy": {
          "enum": [
            "point_value",
            "interval_must_fit"
          ],
          "title": "Uncertainty Policy",
          "type": "string"
        },
        "uncertainty_coverage_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Uncertainty Coverage Factor",
          "type": "number"
        },
        "minimum_replicates": {
          "minimum": 1,
          "title": "Minimum Replicates",
          "type": "integer"
        },
        "missing_disposition": {
          "enum": [
            "review",
            "insufficient_evidence"
          ],
          "title": "Missing Disposition",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "metric_kind",
        "metric_id",
        "unit_token",
        "aggregation",
        "uncertainty_policy",
        "minimum_replicates",
        "missing_disposition",
        "description"
      ],
      "title": "CallerProductionCriterion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ProductionCycleInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "sequence_position": {
          "minimum": 1,
          "title": "Sequence Position",
          "type": "integer"
        },
        "interval_kind": {
          "enum": [
            "preheat",
            "braze_heat",
            "bond_cure",
            "pressure_hold",
            "cooling"
          ],
          "title": "Interval Kind",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "minimum_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_k": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "minimum_pressure_pa_abs": {
          "minimum": 0,
          "title": "Minimum Pressure Pa Abs",
          "type": "number"
        },
        "maximum_pressure_pa_abs": {
          "minimum": 0,
          "title": "Maximum Pressure Pa Abs",
          "type": "number"
        },
        "atmosphere_id": {
          "minLength": 1,
          "title": "Atmosphere Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "interval_id",
        "sequence_position",
        "interval_kind",
        "start_time_s",
        "end_time_s",
        "minimum_temperature_k",
        "maximum_temperature_k",
        "minimum_pressure_pa_abs",
        "maximum_pressure_pa_abs",
        "atmosphere_id",
        "provider_id",
        "result_digest",
        "evidence"
      ],
      "title": "ProductionCycleInterval",
      "type": "object"
    },
    "ProductionJointMeasurement": {
      "additionalProperties": false,
      "properties": {
        "measurement_id": {
          "minLength": 1,
          "title": "Measurement Id",
          "type": "string"
        },
        "joint_id": {
          "minLength": 1,
          "title": "Joint Id",
          "type": "string"
        },
        "replicate_group_id": {
          "minLength": 1,
          "title": "Replicate Group Id",
          "type": "string"
        },
        "metric_kind": {
          "enum": [
            "destructive",
            "nde",
            "leak",
            "strength",
            "continuity",
            "user_defined"
          ],
          "title": "Metric Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "standard_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Uncertainty"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Digest"
        },
        "missing_or_invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Or Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "measurement_id",
        "joint_id",
        "replicate_group_id",
        "metric_kind",
        "metric_id",
        "metric_definition",
        "unit_token",
        "status",
        "method_id",
        "provider_id",
        "provider_revision",
        "input_digest",
        "evidence"
      ],
      "title": "ProductionJointMeasurement",
      "type": "object"
    },
    "ProductionJointRecord": {
      "additionalProperties": false,
      "properties": {
        "joint_id": {
          "minLength": 1,
          "title": "Joint Id",
          "type": "string"
        },
        "process_kind": {
          "enum": [
            "brazing",
            "adhesive_bonding"
          ],
          "title": "Process Kind",
          "type": "string"
        },
        "base_material_lot_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Base Material Lot Ids",
          "type": "array"
        },
        "filler_lot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filler Lot Id"
        },
        "adhesive_lot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adhesive Lot Id"
        },
        "surface_preparation_id": {
          "minLength": 1,
          "title": "Surface Preparation Id",
          "type": "string"
        },
        "joint_geometry_id": {
          "minLength": 1,
          "title": "Joint Geometry Id",
          "type": "string"
        },
        "fitup_gap_m": {
          "minimum": 0,
          "title": "Fitup Gap M",
          "type": "number"
        },
        "fitup_gap_standard_uncertainty_m": {
          "minimum": 0,
          "title": "Fitup Gap Standard Uncertainty M",
          "type": "number"
        },
        "atmosphere_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Atmosphere Id"
        },
        "flux_lot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flux Lot Id"
        },
        "fitup_and_identity_reviewed": {
          "title": "Fitup And Identity Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "joint_id",
        "process_kind",
        "base_material_lot_ids",
        "surface_preparation_id",
        "joint_geometry_id",
        "fitup_gap_m",
        "fitup_gap_standard_uncertainty_m",
        "fitup_and_identity_reviewed",
        "evidence"
      ],
      "title": "ProductionJointRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "joints": {
      "items": {
        "$ref": "#/$defs/ProductionJointRecord"
      },
      "minItems": 1,
      "title": "Joints",
      "type": "array"
    },
    "cycle_history": {
      "items": {
        "$ref": "#/$defs/ProductionCycleInterval"
      },
      "minItems": 1,
      "title": "Cycle History",
      "type": "array"
    },
    "measurements": {
      "items": {
        "$ref": "#/$defs/ProductionJointMeasurement"
      },
      "minItems": 1,
      "title": "Measurements",
      "type": "array"
    },
    "profile": {
      "$ref": "#/$defs/CallerBrazingBondingProfile"
    },
    "material_consumable_surface_prep_fitup_atmosphere_flux_and_geometry_reviewed": {
      "title": "Material Consumable Surface Prep Fitup Atmosphere Flux And Geometry Reviewed",
      "type": "boolean"
    },
    "ordered_heat_pressure_cure_cycle_reviewed": {
      "title": "Ordered Heat Pressure Cure Cycle Reviewed",
      "type": "boolean"
    },
    "destructive_nde_leak_strength_continuity_measurements_reviewed": {
      "title": "Destructive Nde Leak Strength Continuity Measurements Reviewed",
      "type": "boolean"
    },
    "units_uncertainty_methods_provenance_and_digests_reviewed": {
      "title": "Units Uncertainty Methods Provenance And Digests Reviewed",
      "type": "boolean"
    },
    "caller_profile_authority_and_criteria_reviewed": {
      "title": "Caller Profile Authority And Criteria Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "campaign_id",
    "joints",
    "cycle_history",
    "measurements",
    "profile",
    "material_consumable_surface_prep_fitup_atmosphere_flux_and_geometry_reviewed",
    "ordered_heat_pressure_cure_cycle_reviewed",
    "destructive_nde_leak_strength_continuity_measurements_reviewed",
    "units_uncertainty_methods_provenance_and_digests_reviewed",
    "caller_profile_authority_and_criteria_reviewed",
    "evidence"
  ],
  "title": "BrazingBondingProductionCampaign",
  "type": "object"
}