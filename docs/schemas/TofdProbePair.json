{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "pair_id": {
      "minLength": 1,
      "title": "Pair Id",
      "type": "string"
    },
    "transmit_probe_id": {
      "minLength": 1,
      "title": "Transmit Probe Id",
      "type": "string"
    },
    "receive_probe_id": {
      "minLength": 1,
      "title": "Receive Probe Id",
      "type": "string"
    },
    "transmit_wedge_id": {
      "minLength": 1,
      "title": "Transmit Wedge Id",
      "type": "string"
    },
    "receive_wedge_id": {
      "minLength": 1,
      "title": "Receive Wedge Id",
      "type": "string"
    },
    "probe_index_separation_m": {
      "exclusiveMinimum": 0,
      "title": "Probe Index Separation M",
      "type": "number"
    },
    "center_frequency_Hz": {
      "exclusiveMinimum": 0,
      "title": "Center Frequency Hz",
      "type": "number"
    },
    "nominal_refracted_angle_rad": {
      "exclusiveMaximum": 1.5707963267948966,
      "exclusiveMinimum": 0,
      "title": "Nominal Refracted Angle Rad",
      "type": "number"
    },
    "index_separation_basis": {
      "minLength": 1,
      "title": "Index Separation Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "pair_id",
    "transmit_probe_id",
    "receive_probe_id",
    "transmit_wedge_id",
    "receive_wedge_id",
    "probe_index_separation_m",
    "center_frequency_Hz",
    "nominal_refracted_angle_rad",
    "index_separation_basis",
    "evidence"
  ],
  "title": "TofdProbePair",
  "type": "object"
}