      "type": "boolean"
    },
    "coupling_and_clock_identity_reviewed": {
      "title": "Coupling And Clock Identity Reviewed",
      "type": "boolean"
    },
    "calibration_and_reference_source_checks_reviewed": {
      "title": "Calibration And Reference Source Checks Reviewed",
      "type": "boolean"
    },
    "baseline_observation_identity_and_digests_reviewed": {
      "title": "Baseline Observation Identity And Digests Reviewed",
      "type": "boolean"
    },
    "channel_mapping_and_coverage_reviewed": {
      "title": "Channel Mapping And Coverage Reviewed",
      "type": "boolean"
    },
    "timing_amplitude_noise_localization_units_and_uncertainty_reviewed": {
      "title": "Timing Amplitude Noise Localization Units And Uncertainty Reviewed",
      "type": "boolean"
    },
    "source_and_independence_groups_reviewed": {
      "title": "Source And Independence Groups Reviewed",
      "type": "boolean"
    },
    "caller_acceptance_profile_reviewed": {
      "title": "Caller Acceptance Profile Reviewed",
      "type": "boolean"
    },
    "record_validity_and_missingness_reviewed": {
      "title": "Record Validity And Missingness Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "campaign_id",
    "family",
    "procedure_id",
    "procedure_revision",
    "extent_unit_token",
    "acquisition_configuration",
    "records",
    "acceptance_profile",
    "procedure_array_and_acquisition_identity_reviewed",
    "coupling_and_clock_identity_reviewed",
    "calibration_and_reference_source_checks_reviewed",
    "baseline_observation_identity_and_digests_reviewed",
    "channel_mapping_and_coverage_reviewed",
    "timing_amplitude_noise_localization_units_and_uncertainty_reviewed",
    "source_and_independence_groups_reviewed",
    "caller_acceptance_profile_reviewed",
    "record_validity_and_missingness_reviewed",
    "evidence"
