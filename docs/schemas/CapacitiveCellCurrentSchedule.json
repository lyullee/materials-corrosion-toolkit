{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-supplied double-layer current density integrated as charge source per cell.\n\nPositive current is defined into the aqueous phase from the interface. This is\nan explicit forcing schedule, not a potential state or constitutive capacitor law.",
  "properties": {
    "time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Time S",
      "type": "array"
    },
    "current_A_by_knot_and_cell": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 500,
      "minItems": 2,
      "title": "Current A By Knot And Cell",
      "type": "array"
    },
    "schedule_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schedule Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "time_s",
    "current_A_by_knot_and_cell",
    "schedule_sha256",
    "evidence"
  ],
  "title": "CapacitiveCellCurrentSchedule",
  "type": "object"
}