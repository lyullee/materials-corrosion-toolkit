{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "PreservationCampaignFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "fact_kind": {
          "enum": [
            "temperature",
            "relative_humidity",
            "dewpoint",
            "water_ingress",
            "desiccant",
            "inhibitor",
            "cover",
            "seal",
            "surface",
            "corrosion_observation"
          ],
          "title": "Fact Kind",
          "type": "string"
        },
        "quantity_id": {
          "minLength": 1,
          "title": "Quantity Id",
          "type": "string"
        },
        "result_mode": {
          "enum": [
            "quantitative",
            "qualitative"
          ],
          "title": "Result Mode",
          "type": "string"
        },
        "status": {
          "enum": [
            "reported",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "qualitative_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualitative Class"
        },
        "qualitative_uncertainty_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualitative Uncertainty Basis"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "fact_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fact Record Digest",
          "type": "string"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "fact_kind",
        "quantity_id",
        "result_mode",
        "status",
        "unit_token",
        "method_id",
        "fact_record_digest",
        "evidence"
      ],
      "title": "PreservationCampaignFact",
      "type": "object"
    },
    "PreservationFactCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "fact_kind": {
          "enum": [
            "temperature",
            "relative_humidity",
            "dewpoint",
            "water_ingress",
            "desiccant",
            "inhibitor",
            "cover",
            "seal",
            "surface",
            "corrosion_observation"
          ],
          "title": "Fact Kind",
          "type": "string"
        },
        "quantity_id": {
          "minLength": 1,
          "title": "Quantity Id",
          "type": "string"
        },
        "result_mode": {
          "enum": [
            "quantitative",
            "qualitative"
          ],
          "title": "Result Mode",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_acceptable": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Acceptable"
        },
        "maximum_acceptable": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Acceptable"
        },
        "accepted_qualitative_classes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Accepted Qualitative Classes",
          "type": "array"
        },
        "required_event_kinds": {
          "items": {
            "enum": [
              "exposure",
              "inspection",
              "renewal"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Event Kinds",
          "type": "array"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "fact_kind",
        "quantity_id",
        "result_mode",
        "unit_token",
        "required_event_kinds",
        "criterion_basis",
        "evidence"
      ],
      "title": "PreservationFactCriterion",
      "type": "object"
    },
    "PreservationSystemIdentity": {
      "additionalProperties": false,
      "properties": {
        "preservation_system_id": {
          "minLength": 1,
          "title": "Preservation System Id",
          "type": "string"
        },
        "preservation_method_id": {
          "minLength": 1,
          "title": "Preservation Method Id",
          "type": "string"
        },
        "preservation_material_id": {
          "minLength": 1,
          "title": "Preservation Material Id",
          "type": "string"
        },
        "preservation_material_batch_id": {
          "minLength": 1,
          "title": "Preservation Material Batch Id",
          "type": "string"
        },
        "application_procedure_id": {
          "minLength": 1,
          "title": "Application Procedure Id",
          "type": "string"
        },
        "system_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "System Record Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "preservation_system_id",
        "preservation_method_id",
        "preservation_material_id",
        "preservation_material_batch_id",
        "application_procedure_id",
        "system_record_digest",
        "evidence"
      ],
      "title": "PreservationSystemIdentity",
      "type": "object"
    },
    "StoragePreservationCallerProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "minLength": 1,
          "title": "Profile Revision",
          "type": "string"
        },
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "material_id": {
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "storage_area_id": {
          "minLength": 1,
          "title": "Storage Area Id",
          "type": "string"
        },
        "storage_location_id": {
          "minLength": 1,
          "title": "Storage Location Id",
          "type": "string"
        },
        "supported_preservation_system_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Preservation System Ids",
          "type": "array"
        },
        "maximum_uncovered_duration_s": {
          "minimum": 0,
          "title": "Maximum Uncovered Duration S",
          "type": "number"
        },
        "minimum_inspection_count": {
          "minimum": 0,
          "title": "Minimum Inspection Count",
          "type": "integer"
        },
        "minimum_renewal_count": {
          "minimum": 0,
          "title": "Minimum Renewal Count",
          "type": "integer"
        },
        "fact_criteria": {
          "items": {
            "$ref": "#/$defs/PreservationFactCriterion"
          },
          "minItems": 1,
          "title": "Fact Criteria",
          "type": "array"
        },
        "profile_source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Source Digest",
          "type": "string"
        },
        "built_in_standard_cycle_used": {
          "const": false,
          "default": false,
          "title": "Built In Standard Cycle Used",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "item_id",
        "material_id",
        "storage_area_id",
        "storage_location_id",
        "supported_preservation_system_ids",
        "maximum_uncovered_duration_s",
        "minimum_inspection_count",
        "minimum_renewal_count",
        "fact_criteria",
        "profile_source_digest",
        "evidence"
      ],
      "title": "StoragePreservationCallerProfile",
      "type": "object"
    },
    "StoragePreservationEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "sequence_index": {
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        },
        "event_kind": {
          "enum": [
            "storage_start",
            "exposure",
            "inspection",
            "renewal",
            "storage_end"
          ],
          "title": "Event Kind",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Time S"
        },
        "storage_location_id": {
          "minLength": 1,
          "title": "Storage Location Id",
          "type": "string"
        },
        "preservation_system_id": {
          "minLength": 1,
          "title": "Preservation System Id",
          "type": "string"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PreservationCampaignFact"
          },
          "title": "Facts",
          "type": "array"
        },
        "caller_validity_status": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ],
          "title": "Caller Validity Status",
          "type": "string"
        },
        "caller_validity_basis": {
          "minLength": 1,
          "title": "Caller Validity Basis",
          "type": "string"
        },
        "event_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Record Digest",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "sequence_index",
        "event_kind",
        "start_time_s",
        "storage_location_id",
        "preservation_system_id",
        "caller_validity_status",
        "caller_validity_basis",
        "event_record_digest",
        "source_group_id",
        "evidence"
      ],
      "title": "StoragePreservationEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "item_id": {
      "minLength": 1,
      "title": "Item Id",
      "type": "string"
    },
    "material_id": {
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "storage_area_id": {
      "minLength": 1,
      "title": "Storage Area Id",
      "type": "string"
    },
    "storage_location_id": {
      "minLength": 1,
      "title": "Storage Location Id",
      "type": "string"
    },
    "horizon_start_s": {
      "minimum": 0,
      "title": "Horizon Start S",
      "type": "number"
    },
    "horizon_end_s": {
      "exclusiveMinimum": 0,
      "title": "Horizon End S",
      "type": "number"
    },
    "preservation_systems": {
      "items": {
        "$ref": "#/$defs/PreservationSystemIdentity"
      },
      "minItems": 1,
      "title": "Preservation Systems",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/StoragePreservationEvent"
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "caller_profile": {
      "$ref": "#/$defs/StoragePreservationCallerProfile"
    },
    "item_material_area_and_storage_location_reviewed": {
      "title": "Item Material Area And Storage Location Reviewed",
      "type": "boolean"
    },
    "preservation_methods_material_batches_and_procedures_reviewed": {
      "title": "Preservation Methods Material Batches And Procedures Reviewed",
      "type": "boolean"
    },
    "event_clock_order_and_interval_coverage_reviewed": {
      "title": "Event Clock Order And Interval Coverage Reviewed",
      "type": "boolean"
    },
    "environment_and_preservation_fact_units_uncertainties_reviewed": {
      "title": "Environment And Preservation Fact Units Uncertainties Reviewed",
      "type": "boolean"
    },
    "inspections_renewals_surface_and_corrosion_observations_reviewed": {
      "title": "Inspections Renewals Surface And Corrosion Observations Reviewed",
      "type": "boolean"
    },
    "caller_validity_profile_missingness_and_digests_reviewed": {
      "title": "Caller Validity Profile Missingness And Digests Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "campaign_id",
    "item_id",
    "material_id",
    "storage_area_id",
    "storage_location_id",
    "horizon_start_s",
    "horizon_end_s",
    "preservation_systems",
    "events",
    "caller_profile",
    "item_material_area_and_storage_location_reviewed",
    "preservation_methods_material_batches_and_procedures_reviewed",
    "event_clock_order_and_interval_coverage_reviewed",
    "environment_and_preservation_fact_units_uncertainties_reviewed",
    "inspections_renewals_surface_and_corrosion_observations_reviewed",
    "caller_validity_profile_missingness_and_digests_reviewed",
    "evidence"
  ],
  "title": "StoragePreservationCampaign",
  "type": "object"
}