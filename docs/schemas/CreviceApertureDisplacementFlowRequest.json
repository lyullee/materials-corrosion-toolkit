    "asset_id",
    "location_id",
    "time_basis",
    "geometry_id",
    "geometry_history_result",
    "geometry_history_result_sha256",
    "blind_end_single_mouth_reviewed",
    "incompressible_liquid_reviewed",
    "one_dimensional_cellwise_continuity_reviewed",
    "linear_cell_volume_change_between_knots_reviewed",
