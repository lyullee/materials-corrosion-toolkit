      "type": "boolean"
    },
    "physical_validation_claimed": {
      "const": false,
      "default": false,
      "title": "Physical Validation Claimed",
      "type": "boolean"
    },
    "engineering_qualification_claimed": {
      "const": false,
      "default": false,
      "title": "Engineering Qualification Claimed",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "request_digest",
    "calculation_id",
    "calculation_input_digest",
    "calculation_output_digest",
    "engine_code_digest",
    "concentration_kg_m3",
    "provider_result_digest",
    "report_digest",
