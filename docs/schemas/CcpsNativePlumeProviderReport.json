      "title": "Schema Version",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "calculation_id": {
      "const": "dispersion/plume",
      "title": "Calculation Id",
      "type": "string"
    },
    "calculation_input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calculation Input Digest",
      "type": "string"
    },
    "calculation_output_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calculation Output Digest",
      "type": "string"
    },
    "engine_code_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Engine Code Digest",
      "type": "string"
    },
    "concentration_kg_m3": {
      "minimum": 0,
      "title": "Concentration Kg M3",
      "type": "number"
    },
    "provider_result_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Result Digest",
      "type": "string"
    },
    "report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Digest",
      "type": "string"
    },
    "external_native_engine_executed": {
      "const": true,
      "default": true,
