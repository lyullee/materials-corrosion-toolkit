{
  "$defs": {
    "CreviceElectroneutralSpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "charge_number": {
          "maximum": 8,
          "minimum": -8,
          "title": "Charge Number",
          "type": "integer"
        },
        "diffusivity_m2_s": {
          "exclusiveMinimum": 0,
          "title": "Diffusivity M2 S",
          "type": "number"
        },
        "initial_cell_concentration_mol_m3": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "maxItems": 500,
          "minItems": 2,
          "title": "Initial Cell Concentration Mol M3",
          "type": "array"
        },
        "elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 12,
          "minProperties": 1,
          "title": "Elemental Composition",
          "type": "object"
        }
      },
      "required": [
        "species_id",
        "charge_number",
        "diffusivity_m2_s",
        "initial_cell_concentration_mol_m3",
        "elemental_composition"
      ],
      "title": "CreviceElectroneutralSpecies",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "model_provider_id": {
      "minLength": 1,
      "title": "Model Provider Id",
      "type": "string"
    },
    "model_revision": {
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "length_m": {
      "exclusiveMinimum": 0,
      "title": "Length M",
      "type": "number"
    },
    "cross_section_area_m2": {
      "exclusiveMinimum": 0,
      "title": "Cross Section Area M2",
      "type": "number"
    },
    "cell_count": {
      "maximum": 500,
      "minimum": 2,
      "title": "Cell Count",
      "type": "integer"
    },
    "output_time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Output Time S",
      "type": "array"
    },
    "species": {
      "items": {
        "$ref": "#/$defs/CreviceElectroneutralSpecies"
      },
      "maxItems": 40,
      "minItems": 2,
      "title": "Species",
      "type": "array"
    },
    "mouth_boundary_concentration_mol_m3_by_species": {
      "additionalProperties": {
        "items": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "type": "array"
      },
      "maxProperties": 40,
      "minProperties": 2,
      "title": "Mouth Boundary Concentration Mol M3 By Species",
      "type": "object"
    },
    "relative_tolerance": {
      "default": 1e-08,
      "exclusiveMinimum": 0,
      "maximum": 0.001,
      "title": "Relative Tolerance",
      "type": "number"
    },
    "absolute_tolerance_mol_m3": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "title": "Absolute Tolerance Mol M3",
      "type": "number"
    },
    "maximum_step_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Step S",
      "type": "number"
    },
    "maximum_function_evaluations": {
      "default": 200000,
      "maximum": 10000000,
      "minimum": 100,
      "title": "Maximum Function Evaluations",
      "type": "integer"
    },
    "provider_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Provider Evidence",
      "type": "array"
    },
    "rights_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Rights Evidence",
      "type": "array"
    },
    "geometry_reviewed": {
      "title": "Geometry Reviewed",
      "type": "boolean"
    },
    "dilute_solution_nernst_planck_applicability_reviewed": {
      "title": "Dilute Solution Nernst Planck Applicability Reviewed",
      "type": "boolean"
    },
    "local_electroneutrality_and_zero_current_reviewed": {
      "title": "Local Electroneutrality And Zero Current Reviewed",
      "type": "boolean"
    },
    "reaction_free_interval_reviewed": {
      "title": "Reaction Free Interval Reviewed",
      "type": "boolean"
    },
    "provider_and_parameter_support_reviewed": {
      "title": "Provider And Parameter Support Reviewed",
      "type": "boolean"
    },
    "usage_rights_reviewed": {
      "title": "Usage Rights Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "physical_scope_id",
    "clock_id",
    "model_provider_id",
    "model_revision",
    "length_m",
    "cross_section_area_m2",
    "cell_count",
    "output_time_s",
    "species",
    "mouth_boundary_concentration_mol_m3_by_species",
    "maximum_step_s",
    "provider_evidence",
    "rights_evidence",
    "geometry_reviewed",
    "dilute_solution_nernst_planck_applicability_reviewed",
    "local_electroneutrality_and_zero_current_reviewed",
    "reaction_free_interval_reviewed",
    "provider_and_parameter_support_reviewed",
    "usage_rights_reviewed",
    "computational_use_authorized"
  ],
  "title": "CreviceElectroneutralDiffusionRequest",
  "type": "object"
}