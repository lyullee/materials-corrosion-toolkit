{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requirement_id": {
      "minLength": 1,
      "title": "Requirement Id",
      "type": "string"
    },
    "quantity_kind": {
      "enum": [
        "chemistry",
        "mechanical"
      ],
      "title": "Quantity Kind",
      "type": "string"
    },
    "quantity_id": {
      "minLength": 1,
      "title": "Quantity Id",
      "type": "string"
    },
    "canonical_unit": {
      "minLength": 1,
      "title": "Canonical Unit",
      "type": "string"
    },
    "minimum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum"
    },
    "maximum": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum"
    },
    "requirement_basis": {
      "minLength": 1,
      "title": "Requirement Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "requirement_id",
    "quantity_kind",
    "quantity_id",
    "canonical_unit",
    "requirement_basis",
    "evidence"
  ],
  "title": "CertificateRequirement",
  "type": "object"
}