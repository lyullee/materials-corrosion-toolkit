{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.atmospheric_corrosion_observation.v1",
      "default": "matintegrity.atmospheric_corrosion_observation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "atmospheric-carbon-steel-first-year",
      "default": "atmospheric-carbon-steel-first-year",
      "title": "Dataset Id",
      "type": "string"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "provider_partition": {
      "enum": [
        "programme",
        "independent"
      ],
      "title": "Provider Partition",
      "type": "string"
    },
    "provider_source_row": {
      "minimum": 2,
      "title": "Provider Source Row",
      "type": "integer"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "provider_source_id": {
      "minLength": 1,
      "title": "Provider Source Id",
      "type": "string"
    },
    "programme_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Programme Id"
    },
    "provider_site_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Site Id"
    },
    "physical_specimen_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Specimen Id"
    },
    "country": {
      "minLength": 1,
      "title": "Country",
      "type": "string"
    },
    "site": {
      "minLength": 1,
      "title": "Site",
      "type": "string"
    },
    "latitude_deg": {
      "maximum": 90.0,
      "minimum": -90.0,
      "title": "Latitude Deg",
      "type": "number"
    },
    "longitude_deg": {
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Longitude Deg",
      "type": "number"
    },
    "exposure_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exposure Label"
    },
    "reported_first_year_rate_um_year": {
      "exclusiveMinimum": 0,
      "title": "Reported First Year Rate Um Year",
      "type": "number"
    },
    "first_year_loss_m": {
      "exclusiveMinimum": 0,
      "title": "First Year Loss M",
      "type": "number"
    },
    "equivalent_first_year_rate_m_s": {
      "exclusiveMinimum": 0,
      "title": "Equivalent First Year Rate M S",
      "type": "number"
    },
    "chloride_deposition_mg_m2_day": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chloride Deposition Mg M2 Day"
    },
    "sulfur_dioxide_deposition_mg_m2_day": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sulfur Dioxide Deposition Mg M2 Day"
    },
    "chloride_assumed_zero_by_provider": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chloride Assumed Zero By Provider"
    },
    "provider_tier": {
      "anyOf": [
        {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Tier"
    },
    "provider_rate_source": {
      "anyOf": [
        {
          "enum": [
            "table",
            "figure"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Rate Source"
    },
    "underlying_source_doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Underlying Source Doi"
    },
    "provider_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Note"
    },
    "era5_cell_id": {
      "minLength": 1,
      "title": "Era5 Cell Id",
      "type": "string"
    },
    "era5_corrected_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Era5 Corrected Temperature K",
      "type": "number"
    },
    "era5_relative_humidity_fraction": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Era5 Relative Humidity Fraction",
      "type": "number"
    },
    "era5_wet_hours_rh80_per_year": {
      "minimum": 0,
      "title": "Era5 Wet Hours Rh80 Per Year",
      "type": "number"
    },
    "era5_wet_hour_mean_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Era5 Wet Hour Mean Temperature K",
      "type": "number"
    },
    "era5_annual_precipitation_m": {
      "minimum": 0,
      "title": "Era5 Annual Precipitation M",
      "type": "number"
    },
    "climate_covariate_origin": {
      "const": "ERA5 via Open-Meteo; provider harmonisation",
      "default": "ERA5 via Open-Meteo; provider harmonisation",
      "title": "Climate Covariate Origin",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "observation_redistribution_status": {
      "const": "source_specific_review_required",
      "default": "source_specific_review_required",
      "title": "Observation Redistribution Status",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "provider_partition",
    "provider_source_row",
    "source_group_id",
    "provider_source_id",
    "country",
    "site",
    "latitude_deg",
    "longitude_deg",
    "reported_first_year_rate_um_year",
    "first_year_loss_m",
    "equivalent_first_year_rate_m_s",
    "era5_cell_id",
    "era5_corrected_temperature_K",
    "era5_relative_humidity_fraction",
    "era5_wet_hours_rh80_per_year",
    "era5_wet_hour_mean_temperature_K",
    "era5_annual_precipitation_m",
    "source_archive_sha256"
  ],
  "title": "AtmosphericCorrosionObservation",
  "type": "object"
}