{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "host_component_id": {
      "minLength": 1,
      "title": "Host Component Id",
      "type": "string"
    },
    "branch_component_id": {
      "minLength": 1,
      "title": "Branch Component Id",
      "type": "string"
    },
    "host_external_capacity_record_id": {
      "minLength": 1,
      "title": "Host External Capacity Record Id",
      "type": "string"
    },
    "branch_test_limit_record_id": {
      "minLength": 1,
      "title": "Branch Test Limit Record Id",
      "type": "string"
    },
    "host_operating_pressure_Pa_abs": {
      "exclusiveMinimum": 0,
      "title": "Host Operating Pressure Pa Abs",
      "type": "number"
    },
    "allowable_host_external_pressure_difference_Pa": {
      "minimum": 0,
      "title": "Allowable Host External Pressure Difference Pa",
      "type": "number"
    },
    "branch_test_pressure_limit_Pa_abs": {
      "exclusiveMinimum": 0,
      "title": "Branch Test Pressure Limit Pa Abs",
      "type": "number"
    },
    "proposed_test_pressure_Pa_abs": {
      "exclusiveMinimum": 0,
      "title": "Proposed Test Pressure Pa Abs",
      "type": "number"
    }
  },
  "required": [
    "basis",
    "host_component_id",
    "branch_component_id",
    "host_external_capacity_record_id",
    "branch_test_limit_record_id",
    "host_operating_pressure_Pa_abs",
    "allowable_host_external_pressure_difference_Pa",
    "branch_test_pressure_limit_Pa_abs",
    "proposed_test_pressure_Pa_abs"
  ],
  "title": "HotTapBranchTestPressureCap",
  "type": "object"
}