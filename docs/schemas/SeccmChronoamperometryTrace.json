{
  "additionalProperties": false,
  "description": "Provenance for one raw current trace returned as separate NumPy arrays.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.seccm_chronoamperometry_trace.v1",
      "default": "matintegrity.seccm_chronoamperometry_trace.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "physical_specimen_id": {
      "minLength": 1,
      "title": "Physical Specimen Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "map_id": {
      "maximum": 205,
      "minimum": 1,
      "title": "Map Id",
      "type": "integer"
    },
    "map_point_label": {
      "pattern": "^MAP_Point_\\d+$",
      "title": "Map Point Label",
      "type": "string"
    },
    "provider_signal_label": {
      "pattern": "^I_Substrate_A_LN_\\d+$",
      "title": "Provider Signal Label",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "source_member": {
      "const": "SS_NaCl_CA_M_1031_C.csv",
      "default": "SS_NaCl_CA_M_1031_C.csv",
      "title": "Source Member",
      "type": "string"
    },
    "source_member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Member Sha256",
      "type": "string"
    },
    "sample_count": {
      "exclusiveMinimum": 0,
      "title": "Sample Count",
      "type": "integer"
    },
    "time_unit": {
      "const": "s",
      "default": "s",
      "title": "Time Unit",
      "type": "string"
    },
    "current_quantity": {
      "const": "substrate_current",
      "default": "substrate_current",
      "title": "Current Quantity",
      "type": "string"
    },
    "current_unit": {
      "const": "A",
      "default": "A",
      "title": "Current Unit",
      "type": "string"
    },
    "unit_basis": {
      "minLength": 1,
      "title": "Unit Basis",
      "type": "string"
    },
    "provider_code_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Provider Code Commit",
      "type": "string"
    },
    "provider_code_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Code Sha256",
      "type": "string"
    },
    "physical_specimen_independence": {
      "const": "unresolved_across_map_points",
      "default": "unresolved_across_map_points",
      "title": "Physical Specimen Independence",
      "type": "string"
    },
    "interpretation_status": {
      "const": "raw_signal_only",
      "default": "raw_signal_only",
      "title": "Interpretation Status",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "physical_specimen_id",
    "source_group_id",
    "map_id",
    "map_point_label",
    "provider_signal_label",
    "source_archive_sha256",
    "source_member_sha256",
    "sample_count",
    "unit_basis",
    "provider_code_commit",
    "provider_code_sha256"
  ],
  "title": "SeccmChronoamperometryTrace",
  "type": "object"
}