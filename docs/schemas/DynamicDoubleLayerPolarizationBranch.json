{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One caller-calibrated, signed current-density curve for each cell.",
  "properties": {
    "branch_id": {
      "minLength": 1,
      "title": "Branch Id",
      "type": "string"
    },
    "overpotential_axis_V": {
      "items": {
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Overpotential Axis V",
      "type": "array"
    },
    "signed_current_density_A_m2_by_cell_and_overpotential": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Signed Current Density A M2 By Cell And Overpotential",
      "type": "array"
    },
    "equilibrium_potential_V_by_knot_and_cell": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Equilibrium Potential V By Knot And Cell",
      "type": "array"
    },
    "curve_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Curve Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "branch_id",
    "overpotential_axis_V",
    "signed_current_density_A_m2_by_cell_and_overpotential",
    "equilibrium_potential_V_by_knot_and_cell",
    "curve_sha256",
    "evidence"
  ],
  "title": "DynamicDoubleLayerPolarizationBranch",
  "type": "object"
}