{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One caller-selected CO2 solubility row; not a Henry coefficient or corrosion rate.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.aquasoldb_co2_solubility_observation.v1",
      "default": "matintegrity.aquasoldb_co2_solubility_observation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "aquasoldb-gas-solubility-v2-1",
      "default": "aquasoldb-gas-solubility-v2-1",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version_doi": {
      "const": "10.5281/zenodo.23470595",
      "default": "10.5281/zenodo.23470595",
      "title": "Dataset Version Doi",
      "type": "string"
    },
    "dataset_license_scope": {
      "const": "CC-BY-4.0 compilation only",
      "default": "CC-BY-4.0 compilation only",
      "title": "Dataset License Scope",
      "type": "string"
    },
    "compilation_attribution": {
      "const": "Abd and Abushaikha (2026), AquaSolDB v2.1",
      "default": "Abd and Abushaikha (2026), AquaSolDB v2.1",
      "title": "Compilation Attribution",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "point_id": {
      "minLength": 1,
      "title": "Point Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "temperature_K": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature K"
    },
    "pressure_MPa": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pressure Mpa"
    },
    "pressure_basis": {
      "minLength": 1,
      "title": "Pressure Basis",
      "type": "string"
    },
    "salt": {
      "minLength": 1,
      "title": "Salt",
      "type": "string"
    },
    "salt_molality_mol_per_kgw": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Salt Molality Mol Per Kgw"
    },
    "salt_composition_as_reported": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Salt Composition As Reported"
    },
    "sodium_molality_mol_per_kgw": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sodium Molality Mol Per Kgw"
    },
    "chloride_molality_mol_per_kgw": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chloride Molality Mol Per Kgw"
    },
    "potassium_molality_mol_per_kgw": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Potassium Molality Mol Per Kgw"
    },
    "calcium_molality_mol_per_kgw": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calcium Molality Mol Per Kgw"
    },
    "magnesium_molality_mol_per_kgw": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Magnesium Molality Mol Per Kgw"
    },
    "sulfate_molality_mol_per_kgw": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sulfate Molality Mol Per Kgw"
    },
    "solubility_mol_per_kg_water": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Solubility Mol Per Kg Water"
    },
    "status": {
      "enum": [
        "measured",
        "calculated",
        "no_value"
      ],
      "title": "Status",
      "type": "string"
    },
    "flags": {
      "items": {
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "method": {
      "minLength": 1,
      "title": "Method",
      "type": "string"
    },
    "source_specific_original_paper_citation_required": {
      "const": true,
      "default": true,
      "title": "Source Specific Original Paper Citation Required",
      "type": "boolean"
    },
    "source_specific_rights_review_required": {
      "const": true,
      "default": true,
      "title": "Source Specific Rights Review Required",
      "type": "boolean"
    },
    "henry_coefficient_derived": {
      "const": false,
      "default": false,
      "title": "Henry Coefficient Derived",
      "type": "boolean"
    },
    "corrosion_calibration_ready": {
      "const": false,
      "default": false,
      "title": "Corrosion Calibration Ready",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "source_archive_sha256",
    "point_id",
    "source_id",
    "pressure_basis",
    "salt",
    "solubility_mol_per_kg_water",
    "status",
    "flags",
    "method",
    "evidence"
  ],
  "title": "AquaSolDBCo2SolubilityObservation",
  "type": "object"
}