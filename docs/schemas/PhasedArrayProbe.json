{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "probe_id": {
      "minLength": 1,
      "title": "Probe Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "pulse_echo",
        "transmit",
        "receive"
      ],
      "title": "Role",
      "type": "string"
    },
    "element_count": {
      "exclusiveMinimum": 0,
      "title": "Element Count",
      "type": "integer"
    },
    "element_pitch_m": {
      "exclusiveMinimum": 0,
      "title": "Element Pitch M",
      "type": "number"
    },
    "element_width_m": {
      "exclusiveMinimum": 0,
      "title": "Element Width M",
      "type": "number"
    },
    "center_frequency_Hz": {
      "exclusiveMinimum": 0,
      "title": "Center Frequency Hz",
      "type": "number"
    },
    "element_layout_basis": {
      "minLength": 1,
      "title": "Element Layout Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "probe_id",
    "role",
    "element_count",
    "element_pitch_m",
    "element_width_m",
    "center_frequency_Hz",
    "element_layout_basis",
    "evidence"
  ],
  "title": "PhasedArrayProbe",
  "type": "object"
}