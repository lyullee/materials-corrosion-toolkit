{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "property_definition_id": {
      "minLength": 1,
      "title": "Property Definition Id",
      "type": "string"
    },
    "trend_basis_id": {
      "minLength": 1,
      "title": "Trend Basis Id",
      "type": "string"
    },
    "reference_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Reference Temperature K",
      "type": "number"
    },
    "evaluation_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Evaluation Temperature K",
      "type": "number"
    },
    "reference_strength_Pa": {
      "exclusiveMinimum": 0,
      "title": "Reference Strength Pa",
      "type": "number"
    },
    "trend_strength_at_reference_Pa": {
      "exclusiveMinimum": 0,
      "title": "Trend Strength At Reference Pa",
      "type": "number"
    },
    "trend_strength_at_evaluation_Pa": {
      "exclusiveMinimum": 0,
      "title": "Trend Strength At Evaluation Pa",
      "type": "number"
    }
  },
  "required": [
    "basis",
    "material_condition_id",
    "property_definition_id",
    "trend_basis_id",
    "reference_temperature_K",
    "evaluation_temperature_K",
    "reference_strength_Pa",
    "trend_strength_at_reference_Pa",
    "trend_strength_at_evaluation_Pa"
  ],
  "title": "TemperatureTrendStrengthScaling",
  "type": "object"
}