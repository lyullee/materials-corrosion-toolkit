{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FormingEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_record_id": {
          "minLength": 1,
          "title": "Evidence Record Id",
          "type": "string"
        },
        "evidence_kind": {
          "enum": [
            "inspection",
            "property_test"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "independence_group_id": {
          "minLength": 1,
          "title": "Independence Group Id",
          "type": "string"
        },
        "physical_region_id": {
          "minLength": 1,
          "title": "Physical Region Id",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "result_definition": {
          "minLength": 1,
          "title": "Result Definition",
          "type": "string"
        },
        "reported_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Value"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "result_descriptor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Descriptor"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "uncertainty_coverage_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Coverage Factor"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "evidence_record_id",
        "evidence_kind",
        "physical_specimen_id",
        "source_group_id",
        "independence_group_id",
        "physical_region_id",
        "method_id",
        "result_definition",
        "unit_token",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "provider_configuration_digest",
        "input_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "FormingEvidenceRecord",
      "type": "object"
    },
    "FormingEvidenceRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "minLength": 1,
