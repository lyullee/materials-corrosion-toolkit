          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_record_count": {
          "minimum": 1,
          "title": "Minimum Record Count",
          "type": "integer"
        },
        "supported_result_descriptors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supported Result Descriptors",
          "type": "array"
        },
        "minimum_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Value"
        },
        "maximum_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Value"
        },
        "requirement_basis": {
          "minLength": 1,
          "title": "Requirement Basis",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "evidence_kind",
        "method_id",
        "result_definition",
        "unit_token",
        "minimum_record_count",
        "requirement_basis"
      ],
      "title": "FormingEvidenceRequirement",
      "type": "object"
    },
