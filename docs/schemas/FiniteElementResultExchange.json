{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FELoadBoundaryCase": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "load_definition_id": {
          "minLength": 1,
          "title": "Load Definition Id",
          "type": "string"
        },
        "boundary_definition_id": {
          "minLength": 1,
          "title": "Boundary Definition Id",
          "type": "string"
        },
        "load_basis": {
          "minLength": 1,
          "title": "Load Basis",
          "type": "string"
        },
        "load_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Load Digest",
          "type": "string"
        },
        "boundary_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Boundary Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "load_definition_id",
        "boundary_definition_id",
        "load_basis",
        "load_digest",
        "boundary_digest",
        "evidence"
      ],
      "title": "FELoadBoundaryCase",
      "type": "object"
    },
    "FEMaterialAssignment": {
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "minLength": 1,
          "title": "Assignment Id",
          "type": "string"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        },
        "material_id": {
          "minLength": 1,
          "title": "Material Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "property_provider_id": {
          "minLength": 1,
          "title": "Property Provider Id",
          "type": "string"
        },
        "property_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Property State Digest",
          "type": "string"
        },
        "assignment_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Assignment Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assignment_id",
        "region_id",
        "material_id",
        "material_condition_id",
        "property_provider_id",
        "property_state_digest",
        "assignment_digest",
        "evidence"
      ],
      "title": "FEMaterialAssignment",
      "type": "object"
    },
    "FEMeshDescriptor": {
      "additionalProperties": false,
      "properties": {
        "mesh_id": {
          "minLength": 1,
          "title": "Mesh Id",
          "type": "string"
        },
        "mesh_revision": {
          "minLength": 1,
          "title": "Mesh Revision",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "dimensionality": {
          "enum": [
            "1d",
            "2d",
            "axisymmetric",
            "3d"
          ],
          "title": "Dimensionality",
          "type": "string"
        },
        "element_family_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Element Family Ids",
          "type": "array"
        },
        "node_count": {
          "minimum": 1,
          "title": "Node Count",
          "type": "integer"
        },
        "element_count": {
          "minimum": 1,
          "title": "Element Count",
          "type": "integer"
        },
        "region_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Region Ids",
          "type": "array"
        },
        "node_identity_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Node Identity Digest",
          "type": "string"
        },
        "element_identity_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Element Identity Digest",
          "type": "string"
        },
        "connectivity_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Connectivity Digest",
          "type": "string"
        },
        "geometry_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "mesh_id",
        "mesh_revision",
        "coordinate_frame_id",
        "dimensionality",
        "element_family_ids",
        "node_count",
        "element_count",
        "region_ids",
        "node_identity_digest",
        "element_identity_digest",
        "connectivity_digest",
        "geometry_digest",
        "evidence"
      ],
      "title": "FEMeshDescriptor",
      "type": "object"
    },
    "FEResultExchangeEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "supported_dimensionalities": {
          "items": {
            "enum": [
              "1d",
              "2d",
              "axisymmetric",
              "3d"
            ],
            "type": "string"
          },
          "title": "Supported Dimensionalities",
          "type": "array"
        },
        "supported_element_family_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Element Family Ids",
          "type": "array"
        },
        "supported_result_locations": {
          "items": {
            "enum": [
              "node",
              "element",
              "integration_point",
              "face",
              "edge"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Result Locations",
          "type": "array"
        },
        "supported_quantity_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Quantity Ids",
          "type": "array"
        },
        "supported_unit_tokens": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Unit Tokens",
          "type": "array"
        },
        "maximum_node_count": {
          "minimum": 1,
          "title": "Maximum Node Count",
          "type": "integer"
        },
        "maximum_element_count": {
          "minimum": 1,
          "title": "Maximum Element Count",
          "type": "integer"
        },
        "required_partitions": {
          "items": {
            "enum": [
              "calibration",
              "holdout",
              "application"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Partitions",
          "type": "array"
        },
        "solver_id": {
          "minLength": 1,
          "title": "Solver Id",
          "type": "string"
        },
        "solver_revision": {
          "minLength": 1,
          "title": "Solver Revision",
          "type": "string"
        },
        "solver_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Solver Configuration Digest",
          "type": "string"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "supported_dimensionalities",
        "supported_element_family_ids",
        "supported_result_locations",
        "supported_quantity_ids",
        "supported_unit_tokens",
        "maximum_node_count",
        "maximum_element_count",
        "required_partitions",
        "solver_id",
        "solver_revision",
        "solver_configuration_digest",
        "qualification_basis",
        "evidence"
      ],
      "title": "FEResultExchangeEnvelope",
      "type": "object"
    },
    "FEResultFieldDescriptor": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "minLength": 1,
          "title": "Field Id",
          "type": "string"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time S"
        },
        "frequency_Hz": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency Hz"
        },
        "region_id": {
          "minLength": 1,
          "title": "Region Id",
          "type": "string"
        },
        "result_location": {
          "enum": [
            "node",
            "element",
            "integration_point",
            "face",
            "edge"
          ],
          "title": "Result Location",
          "type": "string"
        },
        "averaging_basis": {
          "minLength": 1,
          "title": "Averaging Basis",
          "type": "string"
        },
        "quantity_kind": {
          "enum": [
            "scalar",
            "vector",
            "tensor"
          ],
          "title": "Quantity Kind",
          "type": "string"
