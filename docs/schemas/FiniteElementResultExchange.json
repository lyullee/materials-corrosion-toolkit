        "field_id",
        "case_id",
        "step_id",
        "region_id",
        "result_location",
        "averaging_basis",
        "quantity_kind",
        "quantity_id",
        "quantity_definition",
        "unit_token",
        "component_ids",
        "array_shape",
        "array_order",
        "identity_axis_basis",
        "array_content_digest",
        "result_digest",
        "record_valid",
        "evidence"
