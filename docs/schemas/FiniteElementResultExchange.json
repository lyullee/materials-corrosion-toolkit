        "quantity_definition": {
          "minLength": 1,
          "title": "Quantity Definition",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "component_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Component Ids",
          "type": "array"
        },
        "array_shape": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Array Shape",
          "type": "array"
        },
        "array_order": {
          "enum": [
            "C",
            "F",
            "provider_native"
          ],
          "title": "Array Order",
          "type": "string"
        },
        "identity_axis_basis": {
          "minLength": 1,
          "title": "Identity Axis Basis",
          "type": "string"
        },
        "array_content_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Array Content Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
