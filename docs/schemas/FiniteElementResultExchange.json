        "physical_specimen_id",
        "source_group_id",
        "verification_kind",
        "metric_id",
        "metric_value",
        "metric_unit_token",
        "provider_id",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "FEVerificationRecord",
      "type": "object"
