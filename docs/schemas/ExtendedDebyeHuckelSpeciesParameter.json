{
  "additionalProperties": false,
  "description": "Caller-owned ion-size parameter for one mass-action species.",
  "properties": {
    "species_id": {
      "minLength": 1,
      "title": "Species Id",
      "type": "string"
    },
    "ion_size_parameter_nm": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ion Size Parameter Nm"
    },
    "evidence_source_id": {
      "minLength": 1,
      "title": "Evidence Source Id",
      "type": "string"
    },
    "evidence_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Evidence Record Sha256",
      "type": "string"
    }
  },
  "required": [
    "species_id",
    "evidence_source_id",
    "evidence_record_sha256"
  ],
  "title": "ExtendedDebyeHuckelSpeciesParameter",
  "type": "object"
}