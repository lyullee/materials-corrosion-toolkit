{
  "$defs": {
    "AISI1018FileMapping": {
      "additionalProperties": false,
      "properties": {
        "source_filename": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Filename",
          "type": "string"
        },
        "caller_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Caller Label",
          "type": "string"
        },
        "mapping_basis": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Mapping Basis",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "source_filename",
        "caller_label",
        "mapping_basis",
        "evidence"
      ],
      "title": "AISI1018FileMapping",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.mendeley_aisi1018_inventory_item.v1",
      "default": "matintegrity.mendeley_aisi1018_inventory_item.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "mendeley-aisi1018-aerobic-consortium-corrosion",
      "default": "mendeley-aisi1018-aerobic-consortium-corrosion",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_doi": {
      "const": "10.17632/zyy3yktzpf.1",
      "default": "10.17632/zyy3yktzpf.1",
      "title": "Dataset Doi",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "provider_filename": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Provider Filename",
      "type": "string"
    },
    "provider_file_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Provider File Id",
      "type": "string"
    },
    "content_type": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Content Type",
      "type": "string"
    },
    "extension": {
      "maxLength": 16,
      "minLength": 1,
      "title": "Extension",
      "type": "string"
    },
    "provider_bytes": {
      "exclusiveMinimum": 0,
      "title": "Provider Bytes",
      "type": "integer"
    },
    "provider_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Sha256",
      "type": "string"
    },
    "caller_mapping": {
      "anyOf": [
        {
          "$ref": "#/$defs/AISI1018FileMapping"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "provider_filename",
    "provider_file_id",
    "content_type",
    "extension",
    "provider_bytes",
    "provider_sha256",
    "evidence"
  ],
  "title": "AISI1018InventoryItem",
  "type": "object"
}