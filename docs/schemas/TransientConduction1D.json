    "nonlinear_relative_tolerance": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "title": "Nonlinear Relative Tolerance",
      "type": "number"
    },
    "maximum_nonlinear_iterations": {
      "default": 80,
      "maximum": 500,
      "minimum": 2,
      "title": "Maximum Nonlinear Iterations",
      "type": "integer"
    },
    "maximum_relative_energy_balance_error": {
      "default": 1e-07,
      "exclusiveMinimum": 0,
      "title": "Maximum Relative Energy Balance Error",
      "type": "number"
    },
    "one_dimensional_geometry_reviewed": {
      "title": "One Dimensional Geometry Reviewed",
      "type": "boolean"
    },
    "material_property_support_reviewed": {
      "title": "Material Property Support Reviewed",
      "type": "boolean"
    },
    "boundary_conditions_reviewed": {
      "title": "Boundary Conditions Reviewed",
      "type": "boolean"
    },
    "phase_change_absent_or_included_in_capacity_reviewed": {
      "title": "Phase Change Absent Or Included In Capacity Reviewed",
      "type": "boolean"
    }
