{
  "$defs": {
    "BoltProofStrengthPoint": {
      "additionalProperties": false,
      "properties": {
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "nominal_proof_strength_Pa": {
          "exclusiveMinimum": 0,
          "title": "Nominal Proof Strength Pa",
          "type": "number"
        }
      },
      "required": [
        "temperature_K",
        "nominal_proof_strength_Pa"
      ],
      "title": "BoltProofStrengthPoint",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One bolt's caller-owned nominal tensile strength versus temperature.",
  "properties": {
    "bolt_id": {
      "minLength": 1,
      "title": "Bolt Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "curve_id": {
      "minLength": 1,
      "title": "Curve Id",
      "type": "string"
    },
    "source_id": {
      "default": "caller_bolt_proof_strength_temperature_curve",
      "title": "Source Id",
      "type": "string"
    },
    "curve_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Curve Sha256",
      "type": "string"
    },
    "curve_points": {
      "items": {
        "$ref": "#/$defs/BoltProofStrengthPoint"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Curve Points",
      "type": "array"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "strength_definition_reviewed": {
      "title": "Strength Definition Reviewed",
      "type": "boolean"
    },
    "application_to_declared_bolt_reviewed": {
      "title": "Application To Declared Bolt Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "bolt_id",
    "material_condition_id",
    "curve_id",
    "curve_sha256",
    "curve_points",
    "evidence",
    "strength_definition_reviewed",
    "application_to_declared_bolt_reviewed"
  ],
  "title": "BoltMaterialStrengthBasis",
  "type": "object"
}