{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "bolt_id": {
      "minLength": 1,
      "title": "Bolt Id",
      "type": "string"
    },
    "target_preload_N": {
      "minimum": 0,
      "title": "Target Preload N",
      "type": "number"
    },
    "mean_bearing_diameter_m": {
      "exclusiveMinimum": 0,
      "title": "Mean Bearing Diameter M",
      "type": "number"
    },
    "thread_pitch_diameter_m": {
      "exclusiveMinimum": 0,
      "title": "Thread Pitch Diameter M",
      "type": "number"
    },
    "lead_m_per_turn": {
      "exclusiveMinimum": 0,
      "title": "Lead M Per Turn",
      "type": "number"
    },
    "thread_half_angle_rad": {
      "exclusiveMaximum": 1.5707963267948966,
      "minimum": 0.0,
      "title": "Thread Half Angle Rad",
      "type": "number"
    },
    "bearing_friction_coefficient": {
      "minimum": 0,
      "title": "Bearing Friction Coefficient",
      "type": "number"
    },
    "thread_friction_coefficient": {
      "minimum": 0,
      "title": "Thread Friction Coefficient",
      "type": "number"
    }
  },
  "required": [
    "basis",
    "bolt_id",
    "target_preload_N",
    "mean_bearing_diameter_m",
    "thread_pitch_diameter_m",
    "lead_m_per_turn",
    "thread_half_angle_rad",
    "bearing_friction_coefficient",
    "thread_friction_coefficient"
  ],
  "title": "FrictionResolvedBoltTorque",
  "type": "object"
}