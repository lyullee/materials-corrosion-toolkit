{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Evidence-bound caller shift law for reference-temperature Prony times.",
  "properties": {
    "law_id": {
      "minLength": 1,
      "title": "Law Id",
      "type": "string"
    },
    "law": {
      "enum": [
        "arrhenius",
        "wlf"
      ],
      "title": "Law",
      "type": "string"
    },
    "reference_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Reference Temperature K",
      "type": "number"
    },
    "minimum_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Temperature K",
      "type": "number"
    },
    "maximum_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Temperature K",
      "type": "number"
    },
    "activation_energy_J_mol": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Activation Energy J Mol"
    },
    "wlf_c1": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wlf C1"
    },
    "wlf_c2_K": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wlf C2 K"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "parameter_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parameter Sha256",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "calibration_and_shift_form_reviewed": {
      "title": "Calibration And Shift Form Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "law_id",
    "law",
    "reference_temperature_K",
    "minimum_temperature_K",
    "maximum_temperature_K",
    "provider_id",
    "provider_revision",
    "parameter_sha256",
    "evidence",
    "calibration_and_shift_form_reviewed"
  ],
  "title": "GasketPronyTemperatureShiftLaw",
  "type": "object"
}