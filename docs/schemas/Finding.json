{
  "additionalProperties": false,
  "properties": {
    "criterion_id": {
      "title": "Criterion Id",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "review",
        "insufficient_evidence"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "observed_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Value"
    },
    "unit_token": {
      "title": "Unit Token",
      "type": "string"
    },
    "evaluated_lower": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluated Lower"
    },
    "evaluated_upper": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluated Upper"
    },
    "basis": {
      "title": "Basis",
      "type": "string"
    }
  },
  "required": [
    "criterion_id",
    "target_id",
    "outcome",
    "observed_value",
    "unit_token",
    "basis"
  ],
  "title": "Finding",
  "type": "object"
}