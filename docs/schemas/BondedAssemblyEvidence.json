{
  "$defs": {
    "BondProcessEvent": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "sequence_index": {
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        },
        "process_kind": {
          "enum": [
            "surface_preparation",
            "layer_application",
            "bonding",
            "cure",
            "heat_treatment",
            "cooling",
            "other"
          ],
          "title": "Process Kind",
          "type": "string"
        },
        "process_step_id": {
          "minLength": 1,
          "title": "Process Step Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "minimum_recorded_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Recorded Temperature K",
          "type": "number"
        },
        "maximum_recorded_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Recorded Temperature K",
          "type": "number"
        },
        "expanded_temperature_uncertainty_K": {
          "minimum": 0,
          "title": "Expanded Temperature Uncertainty K",
          "type": "number"
        },
        "applied_pressure": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied Pressure"
        },
        "pressure_unit_token": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressure Unit Token"
        },
        "expanded_pressure_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Pressure Uncertainty"
        },
        "process_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Process Configuration Digest",
          "type": "string"
        },
        "process_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Process Record Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "sequence_index",
        "process_kind",
        "process_step_id",
        "start_time_s",
        "end_time_s",
        "minimum_recorded_temperature_K",
        "maximum_recorded_temperature_K",
        "expanded_temperature_uncertainty_K",
        "process_configuration_digest",
        "process_record_digest",
        "record_valid",
        "evidence"
      ],
      "title": "BondProcessEvent",
      "type": "object"
    },
    "BondedAssemblyGeometry": {
      "additionalProperties": false,
      "properties": {
        "geometry_id": {
          "minLength": 1,
          "title": "Geometry Id",
          "type": "string"
        },
        "substrate_thickness": {
          "exclusiveMinimum": 0,
          "title": "Substrate Thickness",
          "type": "number"
        },
        "layer_nominal_thickness": {
          "exclusiveMinimum": 0,
          "title": "Layer Nominal Thickness",
          "type": "number"
        },
        "bonded_area": {
          "exclusiveMinimum": 0,
          "title": "Bonded Area",
          "type": "number"
        },
        "thickness_unit_token": {
          "minLength": 1,
          "title": "Thickness Unit Token",
          "type": "string"
        },
        "area_unit_token": {
          "minLength": 1,
          "title": "Area Unit Token",
          "type": "string"
        },
        "geometry_uncertainty": {
          "minimum": 0,
          "title": "Geometry Uncertainty",
          "type": "number"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "geometry_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Record Digest",
          "type": "string"
        }
      },
      "required": [
        "geometry_id",
        "substrate_thickness",
        "layer_nominal_thickness",
        "bonded_area",
        "thickness_unit_token",
        "area_unit_token",
        "geometry_uncertainty",
        "coordinate_frame_id",
        "geometry_record_digest"
      ],
      "title": "BondedAssemblyGeometry",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assembly_id": {
      "minLength": 1,
      "title": "Assembly Id",
      "type": "string"
    },
    "product_id": {
      "minLength": 1,
      "title": "Product Id",
      "type": "string"
    },
    "substrate_id": {
      "minLength": 1,
      "title": "Substrate Id",
      "type": "string"
    },
    "substrate_material_id": {
      "minLength": 1,
      "title": "Substrate Material Id",
      "type": "string"
    },
    "substrate_material_lot_id": {
      "minLength": 1,
      "title": "Substrate Material Lot Id",
      "type": "string"
    },
    "substrate_condition_id": {
      "minLength": 1,
      "title": "Substrate Condition Id",
      "type": "string"
    },
    "layer_id": {
      "minLength": 1,
      "title": "Layer Id",
      "type": "string"
    },
    "layer_material_id": {
      "minLength": 1,
      "title": "Layer Material Id",
      "type": "string"
    },
    "layer_material_lot_id": {
      "minLength": 1,
      "title": "Layer Material Lot Id",
      "type": "string"
    },
    "layer_condition_id": {
      "minLength": 1,
      "title": "Layer Condition Id",
      "type": "string"
    },
    "interface_id": {
      "minLength": 1,
      "title": "Interface Id",
      "type": "string"
    },
    "interface_definition": {
      "minLength": 1,
      "title": "Interface Definition",
      "type": "string"
    },
    "bond_process_id": {
      "minLength": 1,
      "title": "Bond Process Id",
      "type": "string"
    },
    "bond_process_revision": {
      "minLength": 1,
      "title": "Bond Process Revision",
      "type": "string"
    },
    "bond_process_provider_id": {
      "minLength": 1,
      "title": "Bond Process Provider Id",
      "type": "string"
    },
    "bond_process_route_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bond Process Route Digest",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/BondedAssemblyGeometry"
    },
    "process_events": {
      "items": {
        "$ref": "#/$defs/BondProcessEvent"
      },
      "minItems": 1,
      "title": "Process Events",
      "type": "array"
    },
    "assembly_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Assembly Record Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assembly_id",
    "product_id",
    "substrate_id",
    "substrate_material_id",
    "substrate_material_lot_id",
    "substrate_condition_id",
    "layer_id",
    "layer_material_id",
    "layer_material_lot_id",
    "layer_condition_id",
    "interface_id",
    "interface_definition",
    "bond_process_id",
    "bond_process_revision",
    "bond_process_provider_id",
    "bond_process_route_digest",
    "geometry",
    "process_events",
    "assembly_record_digest",
    "evidence"
  ],
  "title": "BondedAssemblyEvidence",
  "type": "object"
}