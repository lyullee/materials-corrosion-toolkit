{
  "$defs": {
    "DaviesActivitySpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "species_label": {
          "minLength": 1,
          "title": "Species Label",
          "type": "string"
        },
        "charge_number": {
          "maximum": 8,
          "minimum": -8,
          "title": "Charge Number",
          "type": "integer"
        },
        "molality_mol_kg": {
          "minimum": 0,
          "title": "Molality Mol Kg",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "species_label",
        "charge_number",
        "molality_mol_kg"
      ],
      "title": "DaviesActivitySpecies",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "solution_id": {
      "minLength": 1,
      "title": "Solution Id",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "ionic_strength_limit_mol_kg": {
      "exclusiveMinimum": 0,
      "maximum": 0.5,
      "title": "Ionic Strength Limit Mol Kg",
      "type": "number"
    },
    "davies_A_at_temperature": {
      "exclusiveMinimum": 0,
      "title": "Davies A At Temperature",
      "type": "number"
    },
    "A_provider_id": {
      "minLength": 1,
      "title": "A Provider Id",
      "type": "string"
    },
    "A_provider_revision": {
      "minLength": 1,
      "title": "A Provider Revision",
      "type": "string"
    },
    "A_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "A Configuration Digest",
      "type": "string"
    },
    "A_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "A Record Digest",
      "type": "string"
    },
    "charge_balance_absolute_tolerance_mol_kg": {
      "minimum": 0,
      "title": "Charge Balance Absolute Tolerance Mol Kg",
      "type": "number"
    },
    "species": {
      "items": {
        "$ref": "#/$defs/DaviesActivitySpecies"
      },
      "minItems": 1,
      "title": "Species",
      "type": "array"
    },
    "complete_ionic_inventory_reviewed": {
      "title": "Complete Ionic Inventory Reviewed",
      "type": "boolean"
    },
    "charge_balance_reviewed": {
      "title": "Charge Balance Reviewed",
      "type": "boolean"
    },
    "ionic_strength_convention_reviewed": {
      "title": "Ionic Strength Convention Reviewed",
      "type": "boolean"
    },
    "davies_scope_reviewed": {
      "title": "Davies Scope Reviewed",
      "type": "boolean"
    },
    "temperature_solvent_A_lineage_reviewed": {
      "title": "Temperature Solvent A Lineage Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "solution_id",
    "temperature_K",
    "ionic_strength_limit_mol_kg",
    "davies_A_at_temperature",
    "A_provider_id",
    "A_provider_revision",
    "A_configuration_digest",
    "A_record_digest",
    "charge_balance_absolute_tolerance_mol_kg",
    "species",
    "complete_ionic_inventory_reviewed",
    "charge_balance_reviewed",
    "ionic_strength_convention_reviewed",
    "davies_scope_reviewed",
    "temperature_solvent_A_lineage_reviewed",
    "evidence"
  ],
  "title": "DaviesActivityCoefficientInput",
  "type": "object"
}