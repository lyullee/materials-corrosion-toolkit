{
  "additionalProperties": false,
  "description": "Identity and structural diagnostics for one provider workbook trace.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.escape1_leak_trace.v1",
      "default": "matintegrity.escape1_leak_trace.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "escape1-controlled-subsurface-natural-gas-release-v1",
      "default": "escape1-controlled-subsurface-natural-gas-release-v1",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5061/dryad.8931zcrwq",
      "default": "https://doi.org/10.5061/dryad.8931zcrwq",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC0-1.0",
      "default": "CC0-1.0",
      "title": "License Id",
      "type": "string"
    },
    "provider_experiment_file_id": {
      "minLength": 1,
      "title": "Provider Experiment File Id",
      "type": "string"
    },
    "source_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "source_sheet_name": {
      "minLength": 1,
      "title": "Source Sheet Name",
      "type": "string"
    },
    "sample_count": {
      "exclusiveMinimum": 1,
      "title": "Sample Count",
      "type": "integer"
    },
    "time_quantity": {
      "const": "provider_local_time_of_day",
      "default": "provider_local_time_of_day",
      "title": "Time Quantity",
      "type": "string"
    },
    "time_unit": {
      "const": "s_from_local_midnight",
      "default": "s_from_local_midnight",
      "title": "Time Unit",
      "type": "string"
    },
    "time_zone": {
      "const": "Mountain Time_provider_statement_without_dst_resolution",
      "default": "Mountain Time_provider_statement_without_dst_resolution",
      "title": "Time Zone",
      "type": "string"
    },
    "methane_response_quantity": {
      "const": "path_integrated_methane_mixing_ratio",
      "default": "path_integrated_methane_mixing_ratio",
      "title": "Methane Response Quantity",
      "type": "string"
    },
    "methane_response_unit": {
      "const": "ppm_m",
      "default": "ppm_m",
      "title": "Methane Response Unit",
      "type": "string"
    },
    "provider_declared_leak_rate_value": {
      "exclusiveMinimum": 0,
      "title": "Provider Declared Leak Rate Value",
      "type": "number"
    },
    "provider_declared_leak_rate_unit": {
      "const": "standard_litre_per_minute",
      "default": "standard_litre_per_minute",
      "title": "Provider Declared Leak Rate Unit",
      "type": "string"
    },
    "leak_reference_pressure_temperature": {
      "const": "unresolved",
      "default": "unresolved",
      "title": "Leak Reference Pressure Temperature",
      "type": "string"
    },
    "detector_height_m": {
      "const": 2.0,
      "default": 2.0,
      "title": "Detector Height M",
      "type": "number"
    },
    "nominal_burial_depth_m": {
      "const": 0.9,
      "default": 0.9,
      "title": "Nominal Burial Depth M",
      "type": "number"
    },
    "timestamps_strictly_increasing": {
      "const": true,
      "title": "Timestamps Strictly Increasing",
      "type": "boolean"
    },
    "minimum_sample_interval_s": {
      "exclusiveMinimum": 0,
      "title": "Minimum Sample Interval S",
      "type": "number"
    },
    "maximum_sample_interval_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Sample Interval S",
      "type": "number"
    },
    "minimum_response_ppm_m": {
      "minimum": 0,
      "title": "Minimum Response Ppm M",
      "type": "number"
    },
    "maximum_response_ppm_m": {
      "minimum": 0,
      "title": "Maximum Response Ppm M",
      "type": "number"
    },
    "physical_independence_status": {
      "const": "unresolved_across_experiment_files",
      "default": "unresolved_across_experiment_files",
      "title": "Physical Independence Status",
      "type": "string"
    },
    "interpretation_status": {
      "const": "raw_response_not_calibration_ready",
      "default": "raw_response_not_calibration_ready",
      "title": "Interpretation Status",
      "type": "string"
    }
  },
  "required": [
    "provider_experiment_file_id",
    "source_file_sha256",
    "source_sheet_name",
    "sample_count",
    "provider_declared_leak_rate_value",
    "timestamps_strictly_increasing",
    "minimum_sample_interval_s",
    "maximum_sample_interval_s",
    "minimum_response_ppm_m",
    "maximum_response_ppm_m"
  ],
  "title": "EscapeLeakTraceRecord",
  "type": "object"
}