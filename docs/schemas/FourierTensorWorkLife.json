{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FourierWorkLifeCycle": {
      "additionalProperties": false,
      "properties": {
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "work_request": {
          "$ref": "#/$defs/PeriodicFourierTensorWork"
        },
        "cycle_count_equivalents": {
          "exclusiveMinimum": 0,
          "title": "Cycle Count Equivalents",
          "type": "number"
        }
      },
      "required": [
        "cycle_id",
        "work_request",
        "cycle_count_equivalents"
      ],
      "title": "FourierWorkLifeCycle",
      "type": "object"
    },
    "PeriodicFourierTensorWork": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "minLength": 1,
          "title": "Analysis Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4097,
          "minItems": 4,
          "title": "Sample Ids",
          "type": "array"
        },
        "stress_tensor_components_Pa": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 4097,
          "minItems": 4,
          "title": "Stress Tensor Components Pa",
          "type": "array"
        },
        "strain_tensor_components": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 4097,
          "minItems": 4,
          "title": "Strain Tensor Components",
          "type": "array"
        },
        "strain_shear_convention": {
          "enum": [
            "tensor",
            "engineering"
          ],
          "title": "Strain Shear Convention",
          "type": "string"
        },
        "maximum_trigonometric_term_work": {
          "default": 2000000,
          "maximum": 20000000,
          "minimum": 1,
          "title": "Maximum Trigonometric Term Work",
          "type": "integer"
        },
        "tensor_basis_and_order_reviewed": {
          "title": "Tensor Basis And Order Reviewed",
          "type": "boolean"
        },
        "uniform_periodic_sampling_reviewed": {
          "title": "Uniform Periodic Sampling Reviewed",
          "type": "boolean"
        },
        "closed_cycle_and_path_order_reviewed": {
          "title": "Closed Cycle And Path Order Reviewed",
          "type": "boolean"
        },
        "stress_strain_conjugacy_and_work_sign_reviewed": {
          "title": "Stress Strain Conjugacy And Work Sign Reviewed",
          "type": "boolean"
        },
        "fourier_reconstruction_suitability_reviewed": {
          "title": "Fourier Reconstruction Suitability Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "analysis_id",
        "material_condition_id",
        "source_id",
        "source_sha256",
        "evidence",
        "sample_ids",
        "stress_tensor_components_Pa",
        "strain_tensor_components",
        "strain_shear_convention",
        "tensor_basis_and_order_reviewed",
        "uniform_periodic_sampling_reviewed",
        "closed_cycle_and_path_order_reviewed",
        "stress_strain_conjugacy_and_work_sign_reviewed",
        "fourier_reconstruction_suitability_reviewed"
      ],
      "title": "PeriodicFourierTensorWork",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "cycles": {
      "items": {
        "$ref": "#/$defs/FourierWorkLifeCycle"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Cycles",
      "type": "array"
    },
    "calibration_id": {
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_material_condition_id": {
      "minLength": 1,
      "title": "Calibration Material Condition Id",
      "type": "string"
    },
    "calibration_source_id": {
      "minLength": 1,
      "title": "Calibration Source Id",
      "type": "string"
    },
    "calibration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Sha256",
      "type": "string"
    },
    "calibration_evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "absolute_work_density_points_J_m3": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 10000,
      "minItems": 2,
      "title": "Absolute Work Density Points J M3",
      "type": "array"
    },
    "cycles_to_failure": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 10000,
      "minItems": 2,
      "title": "Cycles To Failure",
      "type": "array"
    },
    "maximum_total_trigonometric_term_work": {
      "default": 2000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Total Trigonometric Term Work",
      "type": "integer"
    },
    "material_match_and_curve_basis_reviewed": {
      "title": "Material Match And Curve Basis Reviewed",
      "type": "boolean"
    },
    "rights_and_engineering_use_reviewed": {
      "title": "Rights And Engineering Use Reviewed",
      "type": "boolean"
    },
    "cycle_decomposition_and_repetitions_reviewed": {
      "title": "Cycle Decomposition And Repetitions Reviewed",
      "type": "boolean"
    },
    "absolute_work_parameter_and_curve_fit_reviewed": {
      "title": "Absolute Work Parameter And Curve Fit Reviewed",
      "type": "boolean"
    },
    "linear_miner_rule_reviewed": {
      "title": "Linear Miner Rule Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_id",
    "material_condition_id",
    "cycles",
    "calibration_id",
    "calibration_material_condition_id",
    "calibration_source_id",
    "calibration_sha256",
    "calibration_evidence",
    "absolute_work_density_points_J_m3",
    "cycles_to_failure",
    "material_match_and_curve_basis_reviewed",
    "rights_and_engineering_use_reviewed",
    "cycle_decomposition_and_repetitions_reviewed",
    "absolute_work_parameter_and_curve_fit_reviewed",
    "linear_miner_rule_reviewed"
  ],
  "title": "FourierTensorWorkLife",
  "type": "object"
}