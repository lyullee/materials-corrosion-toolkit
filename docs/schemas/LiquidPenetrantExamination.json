{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SurfaceExaminationArea": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "minLength": 1,
          "title": "Area Id",
          "type": "string"
        },
        "physical_location_id": {
          "minLength": 1,
          "title": "Physical Location Id",
          "type": "string"
        },
        "target_area_m2": {
          "exclusiveMinimum": 0,
          "title": "Target Area M2",
          "type": "number"
        },
        "examined_area_m2": {
          "minimum": 0,
          "title": "Examined Area M2",
          "type": "number"
        },
        "unexamined_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unexamined Basis"
        }
      },
      "required": [
        "area_id",
        "physical_location_id",
        "target_area_m2",
        "examined_area_m2"
      ],
      "title": "SurfaceExaminationArea",
      "type": "object"
    },
    "SurfaceIndication": {
      "additionalProperties": false,
      "properties": {
        "indication_id": {
          "minLength": 1,
          "title": "Indication Id",
          "type": "string"
        },
        "area_id": {
          "minLength": 1,
          "title": "Area Id",
          "type": "string"
        },
        "physical_location_id": {
          "minLength": 1,
          "title": "Physical Location Id",
          "type": "string"
        },
        "reported_indication_type": {
          "minLength": 1,
          "title": "Reported Indication Type",
          "type": "string"
        },
        "location_description": {
          "minLength": 1,
          "title": "Location Description",
          "type": "string"
        },
        "measured_length_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Length M"
        },
        "measured_width_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured Width M"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "indication_id",
        "area_id",
        "physical_location_id",
        "reported_indication_type",
        "location_description",
        "evidence"
      ],
      "title": "SurfaceIndication",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "examination_id": {
      "minLength": 1,
      "title": "Examination Id",
      "type": "string"
    },
    "procedure_id": {
      "minLength": 1,
      "title": "Procedure Id",
      "type": "string"
    },
    "procedure_revision": {
      "minLength": 1,
      "title": "Procedure Revision",
      "type": "string"
    },
    "penetrant_type": {
      "enum": [
        "visible",
        "fluorescent"
      ],
      "title": "Penetrant Type",
      "type": "string"
    },
    "removal_method": {
      "enum": [
        "water_washable",
        "post_emulsifiable_lipophilic",
        "solvent_removable",
        "post_emulsifiable_hydrophilic"
      ],
      "title": "Removal Method",
      "type": "string"
    },
    "cleaner_batch_id": {
      "minLength": 1,
      "title": "Cleaner Batch Id",
      "type": "string"
    },
    "penetrant_batch_id": {
      "minLength": 1,
      "title": "Penetrant Batch Id",
      "type": "string"
    },
    "remover_or_emulsifier_batch_id": {
      "minLength": 1,
      "title": "Remover Or Emulsifier Batch Id",
      "type": "string"
    },
    "developer_batch_id": {
      "minLength": 1,
      "title": "Developer Batch Id",
      "type": "string"
    },
    "surface_material_id": {
      "minLength": 1,
      "title": "Surface Material Id",
      "type": "string"
    },
    "surface_condition": {
      "minLength": 1,
      "title": "Surface Condition",
      "type": "string"
    },
    "precleaning_basis": {
      "minLength": 1,
      "title": "Precleaning Basis",
      "type": "string"
    },
    "drying_basis": {
      "minLength": 1,
      "title": "Drying Basis",
      "type": "string"
    },
    "examination_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Examination Temperature K",
      "type": "number"
    },
    "penetrant_dwell_s": {
      "exclusiveMinimum": 0,
      "title": "Penetrant Dwell S",
      "type": "number"
    },
    "excess_removal_basis": {
      "minLength": 1,
      "title": "Excess Removal Basis",
      "type": "string"
    },
    "developer_application_basis": {
      "minLength": 1,
      "title": "Developer Application Basis",
      "type": "string"
    },
    "development_time_s": {
      "exclusiveMinimum": 0,
      "title": "Development Time S",
      "type": "number"
    },
    "observation_lighting_basis": {
      "minLength": 1,
      "title": "Observation Lighting Basis",
      "type": "string"
    },
    "final_cleaning_basis": {
      "minLength": 1,
      "title": "Final Cleaning Basis",
      "type": "string"
    },
    "areas": {
      "items": {
        "$ref": "#/$defs/SurfaceExaminationArea"
      },
      "minItems": 1,
      "title": "Areas",
      "type": "array"
    },
    "indications": {
      "items": {
        "$ref": "#/$defs/SurfaceIndication"
      },
      "title": "Indications",
      "type": "array"
    },
    "areas_mutually_exclusive_reviewed": {
      "title": "Areas Mutually Exclusive Reviewed",
      "type": "boolean"
    },
    "material_and_consumables_compatibility_reviewed": {
      "title": "Material And Consumables Compatibility Reviewed",
      "type": "boolean"
    },
    "process_sequence_reviewed": {
      "title": "Process Sequence Reviewed",
      "type": "boolean"
    },
    "temperature_and_times_reviewed": {
      "title": "Temperature And Times Reviewed",
      "type": "boolean"
    },
    "surface_condition_reviewed": {
      "title": "Surface Condition Reviewed",
      "type": "boolean"
    },
    "indication_mapping_reviewed": {
      "title": "Indication Mapping Reviewed",
      "type": "boolean"
    },
    "negative_result_reviewed": {
      "default": false,
      "title": "Negative Result Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "examination_id",
    "procedure_id",
    "procedure_revision",
    "penetrant_type",
    "removal_method",
    "cleaner_batch_id",
    "penetrant_batch_id",
    "remover_or_emulsifier_batch_id",
    "developer_batch_id",
    "surface_material_id",
    "surface_condition",
    "precleaning_basis",
    "drying_basis",
    "examination_temperature_K",
    "penetrant_dwell_s",
    "excess_removal_basis",
    "developer_application_basis",
    "development_time_s",
    "observation_lighting_basis",
    "final_cleaning_basis",
    "areas",
    "areas_mutually_exclusive_reviewed",
    "material_and_consumables_compatibility_reviewed",
    "process_sequence_reviewed",
    "temperature_and_times_reviewed",
    "surface_condition_reviewed",
    "indication_mapping_reviewed",
    "evidence"
  ],
  "title": "LiquidPenetrantExamination",
  "type": "object"
}