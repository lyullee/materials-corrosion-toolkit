{
  "$defs": {
    "MarkovGeneratorSegment": {
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "minLength": 1,
          "title": "Segment Id",
          "type": "string"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "exclusiveMinimum": 0,
          "title": "End S",
          "type": "number"
        },
        "generator_per_s": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Generator Per S",
          "type": "array"
        },
        "transition_basis_id": {
          "minLength": 1,
          "title": "Transition Basis Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "source_content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Content Sha256",
          "type": "string"
        },
        "rates_reviewed": {
          "title": "Rates Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "segment_id",
        "start_s",
        "end_s",
        "generator_per_s",
        "transition_basis_id",
        "provider_revision",
        "source_content_sha256",
        "rates_reviewed"
      ],
      "title": "MarkovGeneratorSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chain_id": {
      "minLength": 1,
      "title": "Chain Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "time_basis": {
      "minLength": 1,
      "title": "Time Basis",
      "type": "string"
    },
    "horizon_start_s": {
      "minimum": 0,
      "title": "Horizon Start S",
      "type": "number"
    },
    "horizon_end_s": {
      "exclusiveMinimum": 0,
      "title": "Horizon End S",
      "type": "number"
    },
    "conditioning": {
      "minLength": 1,
      "title": "Conditioning",
      "type": "string"
    },
    "top_event_id": {
      "minLength": 1,
      "title": "Top Event Id",
      "type": "string"
    },
    "top_event_definition": {
      "minLength": 1,
      "title": "Top Event Definition",
      "type": "string"
    },
    "state_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 2,
      "title": "State Ids",
      "type": "array"
    },
    "state_definitions": {
      "items": {
        "type": "string"
      },
      "title": "State Definitions",
      "type": "array"
    },
    "initial_state_probabilities": {
      "items": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "title": "Initial State Probabilities",
      "type": "array"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/MarkovGeneratorSegment"
      },
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    },
    "top_event_state_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Top Event State Ids",
      "type": "array"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_version": {
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "source_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Content Sha256",
      "type": "string"
    },
    "common_cause_group_ids": {
      "items": {
        "type": "string"
      },
      "title": "Common Cause Group Ids",
      "type": "array"
    },
    "state_semantics_reviewed": {
      "title": "State Semantics Reviewed",
      "type": "boolean"
    },
    "segment_sequence_reviewed": {
      "title": "Segment Sequence Reviewed",
      "type": "boolean"
    },
    "normalization_tolerance": {
      "exclusiveMinimum": 0,
      "maximum": 1e-08,
      "title": "Normalization Tolerance",
      "type": "number"
    },
    "generator_row_sum_tolerance_per_s": {
      "exclusiveMinimum": 0,
      "title": "Generator Row Sum Tolerance Per S",
      "type": "number"
    },
    "boundary_time_tolerance_s": {
      "exclusiveMinimum": 0,
      "title": "Boundary Time Tolerance S",
      "type": "number"
    },
    "numerical_probability_tolerance": {
      "exclusiveMinimum": 0,
      "maximum": 1e-08,
      "title": "Numerical Probability Tolerance",
      "type": "number"
    }
  },
  "required": [
    "chain_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "time_basis",
    "horizon_start_s",
    "horizon_end_s",
    "conditioning",
    "top_event_id",
    "top_event_definition",
    "state_ids",
    "state_definitions",
    "initial_state_probabilities",
    "segments",
    "top_event_state_ids",
    "provider_id",
    "provider_version",
    "source_content_sha256",
    "state_semantics_reviewed",
    "segment_sequence_reviewed",
    "normalization_tolerance",
    "generator_row_sum_tolerance_per_s",
    "boundary_time_tolerance_s",
    "numerical_probability_tolerance"
  ],
  "title": "PiecewiseContinuousTimeMarkovChain",
  "type": "object"
}