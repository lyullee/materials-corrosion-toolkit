{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Piecewise-constant external and gas-side boundary over one interval.",
  "properties": {
    "start_time_s": {
      "minimum": 0,
      "title": "Start Time S",
      "type": "number"
    },
    "end_time_s": {
      "exclusiveMinimum": 0,
      "title": "End Time S",
      "type": "number"
    },
    "gas_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Gas Temperature K",
      "type": "number"
    },
    "gas_volume_m3": {
      "exclusiveMinimum": 0,
      "title": "Gas Volume M3",
      "type": "number"
    },
    "water_vapor_fugacity_coefficient": {
      "exclusiveMinimum": 0,
      "title": "Water Vapor Fugacity Coefficient",
      "type": "number"
    },
    "gas_film_molar_transfer_coefficient_mol_m2_s_Pa": {
      "minimum": 0,
      "title": "Gas Film Molar Transfer Coefficient Mol M2 S Pa",
      "type": "number"
    },
    "transfer_area_m2": {
      "exclusiveMinimum": 0,
      "title": "Transfer Area M2",
      "type": "number"
    },
    "gas_to_wall_heat_transfer_coefficient_W_m2_K": {
      "minimum": 0,
      "title": "Gas To Wall Heat Transfer Coefficient W M2 K",
      "type": "number"
    },
    "external_wall_heat_flux_W_m2": {
      "title": "External Wall Heat Flux W M2",
      "type": "number"
    },
    "latent_heat_of_vaporization_J_kg": {
      "exclusiveMinimum": 0,
      "title": "Latent Heat Of Vaporization J Kg",
      "type": "number"
    },
    "liquid_water_density_kg_m3": {
      "exclusiveMinimum": 0,
      "title": "Liquid Water Density Kg M3",
      "type": "number"
    },
    "transfer_provider_id": {
      "minLength": 1,
      "title": "Transfer Provider Id",
      "type": "string"
    },
    "transfer_provider_revision": {
      "minLength": 1,
      "title": "Transfer Provider Revision",
      "type": "string"
    },
    "transfer_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Transfer Configuration Sha256",
      "type": "string"
    },
    "transfer_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Transfer Result Sha256",
      "type": "string"
    },
    "thermal_provider_id": {
      "minLength": 1,
      "title": "Thermal Provider Id",
      "type": "string"
    },
    "thermal_provider_revision": {
      "minLength": 1,
      "title": "Thermal Provider Revision",
      "type": "string"
    },
    "thermal_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Thermal Configuration Sha256",
      "type": "string"
    },
    "thermal_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Thermal Result Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 64,
      "minItems": 2,
      "title": "Evidence",
      "type": "array"
    },
    "interval_boundary_and_sign_reviewed": {
      "title": "Interval Boundary And Sign Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "start_time_s",
    "end_time_s",
    "gas_temperature_K",
    "gas_volume_m3",
    "water_vapor_fugacity_coefficient",
    "gas_film_molar_transfer_coefficient_mol_m2_s_Pa",
    "transfer_area_m2",
    "gas_to_wall_heat_transfer_coefficient_W_m2_K",
    "external_wall_heat_flux_W_m2",
    "latent_heat_of_vaporization_J_kg",
    "liquid_water_density_kg_m3",
    "transfer_provider_id",
    "transfer_provider_revision",
    "transfer_configuration_sha256",
    "transfer_result_sha256",
    "thermal_provider_id",
    "thermal_provider_revision",
    "thermal_configuration_sha256",
    "thermal_result_sha256",
    "evidence",
    "interval_boundary_and_sign_reviewed"
  ],
  "title": "LumpedWallCondensationInterval",
  "type": "object"
}