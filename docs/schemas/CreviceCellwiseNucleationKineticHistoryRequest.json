{
  "$defs": {
    "CreviceMolarNucleationLaw": {
      "additionalProperties": false,
      "description": "A caller-calibrated phase-appearance source in molar inventory units.",
      "properties": {
        "solid_species_id": {
          "minLength": 1,
          "title": "Solid Species Id",
          "type": "string"
        },
        "critical_saturation_ratio": {
          "exclusiveMinimum": 0,
          "title": "Critical Saturation Ratio",
          "type": "number"
        },
        "source_rate_constant_mol_m3_s": {
          "minimum": 0.0,
          "title": "Source Rate Constant Mol M3 S",
          "type": "number"
        },
        "supersaturation_order": {
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "title": "Supersaturation Order",
          "type": "number"
        },
        "nucleated_inventory_threshold_mol_m3": {
          "exclusiveMinimum": 0,
          "title": "Nucleated Inventory Threshold Mol M3",
          "type": "number"
        },
        "maximum_rate_mol_m3_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Rate Mol M3 S",
          "type": "number"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "solid_species_id",
        "critical_saturation_ratio",
        "source_rate_constant_mol_m3_s",
        "supersaturation_order",
        "nucleated_inventory_threshold_mol_m3",
        "maximum_rate_mol_m3_s",
        "source_sha256",
        "evidence"
      ],
      "title": "CreviceMolarNucleationLaw",
      "type": "object"
    },
    "CreviceNucleationKineticHistoryRequest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.crevice_nucleation_kinetic_history.v1",
          "default": "matintegrity.crevice_nucleation_kinetic_history.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "physical_scope_id": {
          "minLength": 1,
          "title": "Physical Scope Id",
          "type": "string"
        },
        "clock_id": {
          "minLength": 1,
          "title": "Clock Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "kinetic_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Kinetic Configuration Sha256",
          "type": "string"
        },
        "kinetic_parameter_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Kinetic Parameter Source Sha256",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "aqueous_species": {
          "items": {
            "$ref": "#/$defs/KineticAqueousSpecies"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Aqueous Species",
          "type": "array"
        },
        "candidate_solid_phases": {
          "items": {
            "$ref": "#/$defs/KineticSolidPhase"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Candidate Solid Phases",
          "type": "array"
        },
        "nucleation_laws": {
          "items": {
            "$ref": "#/$defs/CreviceMolarNucleationLaw"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Nucleation Laws",
          "type": "array"
        },
        "growth_laws": {
          "items": {
            "$ref": "#/$defs/EvidenceBoundSaturationGrowthLaw"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Growth Laws",
          "type": "array"
        },
        "intervals": {
          "items": {
            "$ref": "#/$defs/NucleationSaturationInterval"
          },
          "maxItems": 5000,
          "minItems": 1,
          "title": "Intervals",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "absolute_balance_tolerance_mol_m3": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "title": "Absolute Balance Tolerance Mol M3",
          "type": "number"
        },
        "relative_balance_tolerance": {
          "default": 1e-09,
          "exclusiveMinimum": 0.0,
          "maximum": 0.01,
          "title": "Relative Balance Tolerance",
          "type": "number"
        },
        "maximum_total_nucleation_rate_mol_m3_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Total Nucleation Rate Mol M3 S",
          "type": "number"
        },
        "maximum_interval_phase_updates": {
          "default": 100000,
          "maximum": 500000,
          "minimum": 1,
          "title": "Maximum Interval Phase Updates",
          "type": "integer"
        },
        "maximum_total_ledger_evaluations": {
          "default": 100000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Maximum Total Ledger Evaluations",
          "type": "integer"
        },
        "maximum_seed_threshold_splits_per_interval": {
          "default": 128,
          "maximum": 10000,
          "minimum": 1,
          "title": "Maximum Seed Threshold Splits Per Interval",
          "type": "integer"
        },
        "phase_stoichiometry_and_volume_reviewed": {
          "title": "Phase Stoichiometry And Volume Reviewed",
          "type": "boolean"
        },
        "saturation_source_and_standard_state_reviewed": {
          "title": "Saturation Source And Standard State Reviewed",
          "type": "boolean"
        },
        "nucleation_law_units_threshold_and_support_reviewed": {
          "title": "Nucleation Law Units Threshold And Support Reviewed",
          "type": "boolean"
        },
        "growth_law_temperature_support_reviewed": {
          "title": "Growth Law Temperature Support Reviewed",
          "type": "boolean"
        },
        "dissolution_then_formation_split_reviewed": {
          "title": "Dissolution Then Formation Split Reviewed",
          "type": "boolean"
        },
        "closed_batch_scope_reviewed": {
          "title": "Closed Batch Scope Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "assessment_id",
        "physical_scope_id",
        "clock_id",
        "provider_id",
        "provider_revision",
        "kinetic_configuration_sha256",
        "kinetic_parameter_source_sha256",
        "temperature_K",
        "aqueous_species",
        "candidate_solid_phases",
        "nucleation_laws",
        "growth_laws",
        "intervals",
        "evidence",
        "maximum_total_nucleation_rate_mol_m3_s",
        "phase_stoichiometry_and_volume_reviewed",
        "saturation_source_and_standard_state_reviewed",
        "nucleation_law_units_threshold_and_support_reviewed",
        "growth_law_temperature_support_reviewed",
        "dissolution_then_formation_split_reviewed",
        "closed_batch_scope_reviewed",
        "computational_use_authorized"
      ],
      "title": "CreviceNucleationKineticHistoryRequest",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceBoundSaturationGrowthLaw": {
      "additionalProperties": false,
      "description": "Existing caller rate law plus Evidence pin for phase growth/dissolution.",
      "properties": {
        "law": {
          "$ref": "#/$defs/SolidSaturationRateLaw"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "law",
        "evidence"
      ],
      "title": "EvidenceBoundSaturationGrowthLaw",
      "type": "object"
    },
    "FixedKineticCell": {
      "additionalProperties": false,
      "description": "One fixed liquid cell and its independently evidenced batch request.",
      "properties": {
        "cell_id": {
          "minLength": 1,
          "title": "Cell Id",
          "type": "string"
        },
        "cell_length_m": {
          "exclusiveMinimum": 0,
          "title": "Cell Length M",
          "type": "number"
        },
        "cross_section_area_m2": {
          "exclusiveMinimum": 0,
          "title": "Cross Section Area M2",
          "type": "number"
        },
        "solution_volume_m3": {
          "exclusiveMinimum": 0,
          "title": "Solution Volume M3",
          "type": "number"
        },
        "geometry_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Sha256",
          "type": "string"
        },
        "geometry_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Geometry Evidence",
          "type": "array"
        },
        "kinetic_history": {
          "$ref": "#/$defs/CreviceNucleationKineticHistoryRequest"
        }
      },
      "required": [
        "cell_id",
        "cell_length_m",
        "cross_section_area_m2",
        "solution_volume_m3",
        "geometry_sha256",
        "geometry_evidence",
        "kinetic_history"
      ],
      "title": "FixedKineticCell",
      "type": "object"
    },
    "KineticAqueousSpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "charge_number": {
          "title": "Charge Number",
          "type": "integer"
        },
        "elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Elemental Composition",
          "type": "object"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "initial_concentration_mol_m3": {
          "minimum": 0,
          "title": "Initial Concentration Mol M3",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "charge_number",
        "elemental_composition",
        "source_sha256",
        "initial_concentration_mol_m3"
      ],
      "title": "KineticAqueousSpecies",
      "type": "object"
    },
    "KineticSolidPhase": {
      "additionalProperties": false,
      "properties": {
        "solid_species_id": {
          "minLength": 1,
          "title": "Solid Species Id",
          "type": "string"
        },
        "precipitation_stoichiometry": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Precipitation Stoichiometry",
          "type": "object"
        },
        "solid_elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Solid Elemental Composition",
          "type": "object"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "initial_solid_moles_per_solution_volume_mol_m3": {
          "minimum": 0,
          "title": "Initial Solid Moles Per Solution Volume Mol M3",
          "type": "number"
        }
      },
      "required": [
        "solid_species_id",
        "precipitation_stoichiometry",
        "solid_elemental_composition",
        "source_sha256",
        "initial_solid_moles_per_solution_volume_mol_m3"
      ],
      "title": "KineticSolidPhase",
      "type": "object"
    },
    "NucleationSaturationInterval": {
      "additionalProperties": false,
      "description": "One exact interval of caller-provided phase saturation ratios.",
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0.0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature K"
        },
        "saturation_ratio_by_phase": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 16,
          "minProperties": 2,
          "title": "Saturation Ratio By Phase",
          "type": "object"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "saturation_ratio_by_phase",
        "record_sha256",
        "evidence"
      ],
      "title": "NucleationSaturationInterval",
      "type": "object"
    },
    "SolidSaturationRateLaw": {
      "additionalProperties": false,
      "description": "Caller-calibrated precipitation and dissolution law for one neutral phase.",
      "properties": {
        "solid_species_id": {
          "minLength": 1,
          "title": "Solid Species Id",
          "type": "string"
        },
        "precipitation_rate_constant_mol_m3_s": {
          "minimum": 0,
          "title": "Precipitation Rate Constant Mol M3 S",
          "type": "number"
        },
        "precipitation_order": {
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "title": "Precipitation Order",
          "type": "number"
        },
        "dissolution_rate_constant_mol_m3_s": {
          "minimum": 0,
          "title": "Dissolution Rate Constant Mol M3 S",
          "type": "number"
        },
        "dissolution_order": {
          "exclusiveMinimum": 0,
          "maximum": 8.0,
          "title": "Dissolution Order",
          "type": "number"
        },
        "rate_constant_reference_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rate Constant Reference Temperature K"
        },
        "minimum_valid_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Valid Temperature K"
        },
        "maximum_valid_temperature_K": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Valid Temperature K"
        },
        "precipitation_activation_energy_J_mol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precipitation Activation Energy J Mol"
        },
        "dissolution_activation_energy_J_mol": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dissolution Activation Energy J Mol"
        },
        "arrhenius_parameter_applicability_reviewed": {
          "default": false,
          "title": "Arrhenius Parameter Applicability Reviewed",
          "type": "boolean"
        },
        "source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "solid_species_id",
        "precipitation_rate_constant_mol_m3_s",
        "precipitation_order",
        "dissolution_rate_constant_mol_m3_s",
        "dissolution_order",
        "source_sha256"
      ],
      "title": "SolidSaturationRateLaw",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Run independent threshold-split kinetics in an ordered fixed-volume mesh.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.crevice_cellwise_nucleation_kinetic_history.v1",
      "default": "matintegrity.crevice_cellwise_nucleation_kinetic_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/FixedKineticCell"
      },
      "maxItems": 300,
      "minItems": 2,
      "title": "Cells",
      "type": "array"
    },
    "cell_order_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Cell Order Sha256",
      "type": "string"
    },
    "cell_order_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Cell Order Evidence",
      "type": "array"
    },
    "maximum_total_cell_time_phase_records": {
      "default": 2000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Total Cell Time Phase Records",
      "type": "integer"
    },
    "maximum_total_ledger_evaluations": {
      "default": 1000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Total Ledger Evaluations",
      "type": "integer"
    },
    "independent_cell_batch_scope_reviewed": {
      "title": "Independent Cell Batch Scope Reviewed",
      "type": "boolean"
    },
    "no_intercell_transfer_during_kinetic_substep_reviewed": {
      "title": "No Intercell Transfer During Kinetic Substep Reviewed",
      "type": "boolean"
    },
    "fixed_cell_solution_volume_reviewed": {
      "title": "Fixed Cell Solution Volume Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "physical_scope_id",
    "clock_id",
    "cells",
    "cell_order_sha256",
    "cell_order_evidence",
    "independent_cell_batch_scope_reviewed",
    "no_intercell_transfer_during_kinetic_substep_reviewed",
    "fixed_cell_solution_volume_reviewed",
    "computational_use_authorized"
  ],
  "title": "CreviceCellwiseNucleationKineticHistoryRequest",
  "type": "object"
}