{
  "$defs": {
    "CreviceIonicReaction": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "reactants": {
          "items": {
            "$ref": "#/$defs/CreviceIonicReactionTerm"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Reactants",
          "type": "array"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/CreviceIonicReactionTerm"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Products",
          "type": "array"
        },
        "forward_rate_constant_by_knot": {
          "items": {
            "type": "number"
          },
          "maxItems": 1000,
          "minItems": 2,
          "title": "Forward Rate Constant By Knot",
          "type": "array"
        },
        "reverse_rate_constant_by_knot": {
          "items": {
            "type": "number"
          },
          "maxItems": 1000,
          "minItems": 2,
          "title": "Reverse Rate Constant By Knot",
          "type": "array"
        },
        "forward_rate_constant_units": {
          "minLength": 1,
          "title": "Forward Rate Constant Units",
          "type": "string"
        },
        "reverse_rate_constant_units": {
          "minLength": 1,
          "title": "Reverse Rate Constant Units",
          "type": "string"
        },
        "parameter_record_id": {
          "minLength": 1,
          "title": "Parameter Record Id",
          "type": "string"
        },
        "parameter_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parameter Sha256",
          "type": "string"
        }
      },
      "required": [
        "reaction_id",
        "reactants",
        "products",
        "forward_rate_constant_by_knot",
        "reverse_rate_constant_by_knot",
        "forward_rate_constant_units",
        "reverse_rate_constant_units",
        "parameter_record_id",
        "parameter_sha256"
      ],
      "title": "CreviceIonicReaction",
      "type": "object"
    },
    "CreviceIonicReactionTerm": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "stoichiometric_coefficient": {
          "maximum": 8,
          "minimum": 1,
          "title": "Stoichiometric Coefficient",
          "type": "integer"
        }
      },
      "required": [
        "species_id",
        "stoichiometric_coefficient"
      ],
      "title": "CreviceIonicReactionTerm",
      "type": "object"
    },
    "CreviceIonicReactiveSpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "charge_number": {
          "maximum": 8,
          "minimum": -8,
          "title": "Charge Number",
          "type": "integer"
        },
        "diffusivity_m2_s": {
          "exclusiveMinimum": 0,
          "title": "Diffusivity M2 S",
          "type": "number"
        },
        "initial_cell_concentration_mol_m3": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "maxItems": 300,
          "minItems": 2,
          "title": "Initial Cell Concentration Mol M3",
          "type": "array"
        },
        "elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "maxProperties": 12,
          "minProperties": 1,
          "title": "Elemental Composition",
          "type": "object"
        }
      },
      "required": [
        "species_id",
        "charge_number",
        "diffusivity_m2_s",
        "initial_cell_concentration_mol_m3",
        "elemental_composition"
      ],
      "title": "CreviceIonicReactiveSpecies",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fixed slit geometry with caller face velocity, ionic boundaries and kinetic network.",
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "transport_provider_id": {
      "minLength": 1,
      "title": "Transport Provider Id",
      "type": "string"
    },
    "transport_provider_revision": {
      "minLength": 1,
      "title": "Transport Provider Revision",
      "type": "string"
    },
    "length_m": {
      "exclusiveMinimum": 0,
      "title": "Length M",
      "type": "number"
    },
    "cross_section_area_m2": {
      "exclusiveMinimum": 0,
      "title": "Cross Section Area M2",
      "type": "number"
    },
    "cell_count": {
      "maximum": 300,
      "minimum": 2,
      "title": "Cell Count",
      "type": "integer"
    },
    "output_time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Output Time S",
      "type": "array"
    },
    "cell_face_axial_velocity_m_s_by_knot": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 301,
      "minItems": 3,
      "title": "Cell Face Axial Velocity M S By Knot",
      "type": "array"
    },
    "species": {
      "items": {
        "$ref": "#/$defs/CreviceIonicReactiveSpecies"
      },
      "maxItems": 32,
      "minItems": 2,
      "title": "Species",
      "type": "array"
    },
    "mouth_boundary_concentration_mol_m3_by_species": {
      "additionalProperties": {
        "items": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "type": "array"
      },
      "maxProperties": 32,
      "minProperties": 2,
      "title": "Mouth Boundary Concentration Mol M3 By Species",
      "type": "object"
    },
    "reactions": {
      "items": {
        "$ref": "#/$defs/CreviceIonicReaction"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Reactions",
      "type": "array"
    },
    "relative_tolerance": {
      "default": 1e-08,
      "exclusiveMinimum": 0,
      "maximum": 0.001,
      "title": "Relative Tolerance",
      "type": "number"
    },
    "absolute_tolerance_mol_m3": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "title": "Absolute Tolerance Mol M3",
      "type": "number"
    },
    "maximum_step_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Step S",
      "type": "number"
    },
    "maximum_function_evaluations": {
      "default": 300000,
      "maximum": 10000000,
      "minimum": 100,
      "title": "Maximum Function Evaluations",
      "type": "integer"
    },
    "provider_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 128,
      "minItems": 2,
      "title": "Provider Evidence",
      "type": "array"
    },
    "rights_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Rights Evidence",
      "type": "array"
    },
    "fixed_geometry_and_cell_order_reviewed": {
      "title": "Fixed Geometry And Cell Order Reviewed",
      "type": "boolean"
    },
    "face_velocity_sign_and_spatial_mapping_reviewed": {
      "title": "Face Velocity Sign And Spatial Mapping Reviewed",
      "type": "boolean"
    },
    "dilute_nernst_planck_zero_current_reviewed": {
      "title": "Dilute Nernst Planck Zero Current Reviewed",
      "type": "boolean"
    },
    "reaction_charge_and_element_balance_reviewed": {
      "title": "Reaction Charge And Element Balance Reviewed",
      "type": "boolean"
    },
    "rate_units_and_temperature_support_reviewed": {
      "title": "Rate Units And Temperature Support Reviewed",
      "type": "boolean"
    },
    "mouth_boundary_and_blind_tip_condition_reviewed": {
      "title": "Mouth Boundary And Blind Tip Condition Reviewed",
      "type": "boolean"
    },
    "phase_absence_and_no_wall_reaction_reviewed": {
      "title": "Phase Absence And No Wall Reaction Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "physical_scope_id",
    "clock_id",
    "transport_provider_id",
    "transport_provider_revision",
    "length_m",
    "cross_section_area_m2",
    "cell_count",
    "output_time_s",
    "cell_face_axial_velocity_m_s_by_knot",
    "species",
    "mouth_boundary_concentration_mol_m3_by_species",
    "reactions",
    "maximum_step_s",
    "provider_evidence",
    "rights_evidence",
    "fixed_geometry_and_cell_order_reviewed",
    "face_velocity_sign_and_spatial_mapping_reviewed",
    "dilute_nernst_planck_zero_current_reviewed",
    "reaction_charge_and_element_balance_reviewed",
    "rate_units_and_temperature_support_reviewed",
    "mouth_boundary_and_blind_tip_condition_reviewed",
    "phase_absence_and_no_wall_reaction_reviewed",
    "computational_use_authorized"
  ],
  "title": "CreviceIonicReactiveTransportRequest",
  "type": "object"
}