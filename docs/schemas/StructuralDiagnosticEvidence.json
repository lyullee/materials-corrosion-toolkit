{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "diagnostic_id": {
      "minLength": 1,
      "title": "Diagnostic Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "equilibrium",
        "convergence",
        "uncertainty",
        "verification"
      ],
      "title": "Category",
      "type": "string"
    },
    "metric_id": {
      "minLength": 1,
      "title": "Metric Id",
      "type": "string"
    },
    "metric_definition": {
      "minLength": 1,
      "title": "Metric Definition",
      "type": "string"
    },
    "status": {
      "enum": [
        "reported",
        "missing",
        "invalid"
      ],
      "title": "Status",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value"
    },
    "expanded_uncertainty": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expanded Uncertainty"
    },
    "unit_token": {
      "minLength": 1,
      "title": "Unit Token",
      "type": "string"
    },
    "provider_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Record Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "diagnostic_id",
    "category",
    "metric_id",
    "metric_definition",
    "status",
    "unit_token",
    "provider_record_digest",
    "evidence"
  ],
  "title": "StructuralDiagnosticEvidence",
  "type": "object"
}