{
  "$defs": {
    "ClosedTensorCycle": {
      "additionalProperties": false,
      "properties": {
        "cycle_id": {
          "minLength": 1,
          "title": "Cycle Id",
          "type": "string"
        },
        "allocated_cycle_count": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Allocated Cycle Count",
          "type": "number"
        },
        "sample_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50000,
          "minItems": 3,
          "title": "Sample Ids",
          "type": "array"
        },
        "stress_tensor_components_Pa": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 50000,
          "minItems": 3,
          "title": "Stress Tensor Components Pa",
          "type": "array"
        },
        "strain_tensor_components": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 50000,
          "minItems": 3,
          "title": "Strain Tensor Components",
          "type": "array"
        },
        "sample_time_s": {
          "anyOf": [
            {
              "items": {
                "minimum": 0,
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Time S"
        },
        "stress_time_derivative_components_Pa_s": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stress Time Derivative Components Pa S"
        },
        "strain_time_derivative_components_s_inv": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Strain Time Derivative Components S Inv"
        }
      },
      "required": [
        "cycle_id",
        "sample_ids",
        "stress_tensor_components_Pa",
        "strain_tensor_components"
      ],
      "title": "ClosedTensorCycle",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Ordered tensor cycles and bounded state for an externally calibrated rate law.",
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "cycles": {
      "items": {
        "$ref": "#/$defs/ClosedTensorCycle"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Cycles",
      "type": "array"
    },
    "state_variable_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "State Variable Ids",
      "type": "array"
    },
    "initial_state": {
      "items": {
        "type": "number"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Initial State",
      "type": "array"
    },
    "minimum_state": {
      "items": {
        "type": "number"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Minimum State",
      "type": "array"
    },
    "maximum_state": {
      "items": {
        "type": "number"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Maximum State",
      "type": "array"
    },
    "strain_shear_convention": {
      "enum": [
        "tensor",
        "engineering"
      ],
      "title": "Strain Shear Convention",
      "type": "string"
    },
    "time_reconstruction": {
      "enum": [
        "piecewise_linear",
        "piecewise_cubic_hermite",
        "piecewise_pchip",
        "piecewise_periodic_cubic_spline"
      ],
      "title": "Time Reconstruction",
      "type": "string"
    },
    "stress_history_source_id": {
      "minLength": 1,
      "title": "Stress History Source Id",
      "type": "string"
    },
    "stress_history_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Stress History Sha256",
      "type": "string"
    },
    "strain_history_source_id": {
      "minLength": 1,
      "title": "Strain History Source Id",
      "type": "string"
    },
    "strain_history_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Strain History Sha256",
      "type": "string"
    },
    "damage_provider_id": {
      "minLength": 1,
      "title": "Damage Provider Id",
      "type": "string"
    },
    "damage_provider_revision": {
      "minLength": 1,
      "title": "Damage Provider Revision",
      "type": "string"
    },
    "damage_provider_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Damage Provider Configuration Sha256",
      "type": "string"
    },
    "calibration_id": {
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Sha256",
      "type": "string"
    },
    "integration_method": {
      "default": "fixed_step_rk4",
      "enum": [
        "fixed_step_rk4",
        "adaptive_step_doubling_rk4"
      ],
      "title": "Integration Method",
      "type": "string"
    },
    "maximum_time_step_s": {
      "exclusiveMinimum": 0,
