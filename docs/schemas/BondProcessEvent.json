{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "sequence_index": {
      "minimum": 0,
      "title": "Sequence Index",
      "type": "integer"
    },
    "process_kind": {
      "enum": [
        "surface_preparation",
        "layer_application",
        "bonding",
        "cure",
        "heat_treatment",
        "cooling",
        "other"
      ],
      "title": "Process Kind",
      "type": "string"
    },
    "process_step_id": {
      "minLength": 1,
      "title": "Process Step Id",
      "type": "string"
    },
    "start_time_s": {
      "minimum": 0,
      "title": "Start Time S",
      "type": "number"
    },
    "end_time_s": {
      "exclusiveMinimum": 0,
      "title": "End Time S",
      "type": "number"
    },
    "minimum_recorded_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Recorded Temperature K",
      "type": "number"
    },
    "maximum_recorded_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Recorded Temperature K",
      "type": "number"
    },
    "expanded_temperature_uncertainty_K": {
      "minimum": 0,
      "title": "Expanded Temperature Uncertainty K",
      "type": "number"
    },
    "applied_pressure": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied Pressure"
    },
    "pressure_unit_token": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pressure Unit Token"
    },
    "expanded_pressure_uncertainty": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expanded Pressure Uncertainty"
    },
    "process_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Process Configuration Digest",
      "type": "string"
    },
    "process_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Process Record Digest",
      "type": "string"
    },
    "record_valid": {
      "title": "Record Valid",
      "type": "boolean"
    },
    "invalid_or_missing_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalid Or Missing Basis"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "event_id",
    "sequence_index",
    "process_kind",
    "process_step_id",
    "start_time_s",
    "end_time_s",
    "minimum_recorded_temperature_K",
    "maximum_recorded_temperature_K",
    "expanded_temperature_uncertainty_K",
    "process_configuration_digest",
    "process_record_digest",
    "record_valid",
    "evidence"
  ],
  "title": "BondProcessEvent",
  "type": "object"
}