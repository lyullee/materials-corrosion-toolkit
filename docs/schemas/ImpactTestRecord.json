{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ImpactReportedResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "metric": {
          "enum": [
            "absorbed_energy",
            "lateral_expansion",
            "shear_fracture"
          ],
          "title": "Metric",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "status": {
          "enum": [
            "reported",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "result_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Record Digest",
          "type": "string"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "metric",
        "metric_definition",
        "status",
        "unit_token",
        "result_record_digest",
        "evidence"
      ],
      "title": "ImpactReportedResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "test_id": {
      "minLength": 1,
      "title": "Test Id",
      "type": "string"
    },
    "specimen_id": {
      "minLength": 1,
      "title": "Specimen Id",
      "type": "string"
    },
    "test_temperature": {
      "exclusiveMinimum": 0,
      "title": "Test Temperature",
      "type": "number"
    },
    "expanded_temperature_uncertainty": {
      "minimum": 0,
      "title": "Expanded Temperature Uncertainty",
      "type": "number"
    },
    "temperature_unit_token": {
      "const": "K",
      "default": "K",
      "title": "Temperature Unit Token",
      "type": "string"
    },
    "replicate_group_id": {
      "minLength": 1,
      "title": "Replicate Group Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "independence_group_id": {
      "minLength": 1,
      "title": "Independence Group Id",
      "type": "string"
    },
    "sequence_index": {
      "minimum": 0,
      "title": "Sequence Index",
      "type": "integer"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/ImpactReportedResult"
      },
      "minItems": 1,
      "title": "Results",
      "type": "array"
    },
    "caller_validity_status": {
      "enum": [
        "valid",
        "invalid",
        "unknown"
      ],
      "title": "Caller Validity Status",
      "type": "string"
    },
    "caller_validity_basis": {
      "minLength": 1,
      "title": "Caller Validity Basis",
      "type": "string"
    },
    "test_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Test Record Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "test_id",
    "specimen_id",
    "test_temperature",
    "expanded_temperature_uncertainty",
    "replicate_group_id",
    "source_group_id",
    "independence_group_id",
    "sequence_index",
    "results",
    "caller_validity_status",
    "caller_validity_basis",
    "test_record_digest",
    "evidence"
  ],
  "title": "ImpactTestRecord",
  "type": "object"
}