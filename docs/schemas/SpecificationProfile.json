{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SpecificationAlias": {
      "additionalProperties": false,
      "properties": {
        "alias_id": {
          "minLength": 1,
          "title": "Alias Id",
          "type": "string"
        },
        "designation": {
          "$ref": "#/$defs/SpecificationDesignation"
        },
        "mapping_basis": {
          "minLength": 1,
          "title": "Mapping Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "alias_id",
        "designation",
        "mapping_basis",
        "evidence"
      ],
      "title": "SpecificationAlias",
      "type": "object"
    },
    "SpecificationDesignation": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "designation": {
          "minLength": 1,
          "title": "Designation",
          "type": "string"
        },
        "edition": {
          "minLength": 1,
          "title": "Edition",
          "type": "string"
        },
        "product_form": {
          "minLength": 1,
          "title": "Product Form",
          "type": "string"
        },
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "designation",
        "edition",
        "product_form",
        "condition"
      ],
      "title": "SpecificationDesignation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "canonical_designation": {
      "$ref": "#/$defs/SpecificationDesignation"
    },
    "aliases": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SpecificationAlias"
      },
      "title": "Aliases",
      "type": "array"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "profile_authority_id": {
      "minLength": 1,
      "title": "Profile Authority Id",
      "type": "string"
    },
    "profile_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Source Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "canonical_designation",
    "profile_revision",
    "profile_authority_id",
    "profile_source_digest",
    "evidence"
  ],
  "title": "SpecificationProfile",
  "type": "object"
}