{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.controlled_ae_waveform.v1",
      "default": "matintegrity.controlled_ae_waveform.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "zenodo-22011152-controlled-wire-cut-ae",
      "default": "zenodo-22011152-controlled-wire-cut-ae",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.5281/zenodo.22011152",
      "default": "https://doi.org/10.5281/zenodo.22011152",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "source_filename": {
      "minLength": 1,
      "title": "Source Filename",
      "type": "string"
    },
    "source_file_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source File Sha256",
      "type": "string"
    },
    "source_label_from_filename": {
      "pattern": "^C_[AI][0-9]$",
      "title": "Source Label From Filename",
      "type": "string"
    },
    "sensor_channel": {
      "minimum": 1,
      "title": "Sensor Channel",
      "type": "integer"
    },
    "trace_index_from_filename": {
      "minimum": 0,
      "title": "Trace Index From Filename",
      "type": "integer"
    },
    "provider_set": {
      "minimum": 0,
      "title": "Provider Set",
      "type": "integer"
    },
    "provider_index": {
      "minimum": 0,
      "title": "Provider Index",
      "type": "integer"
    },
    "provider_time_text": {
      "minLength": 1,
      "title": "Provider Time Text",
      "type": "string"
    },
    "sample_rate_Hz": {
      "const": 5000000,
      "title": "Sample Rate Hz",
      "type": "integer"
    },
    "pretrigger_samples": {
      "const": 2000,
      "title": "Pretrigger Samples",
      "type": "integer"
    },
    "sample_count": {
      "const": 16384,
      "title": "Sample Count",
      "type": "integer"
    },
    "amplitude_unit": {
      "const": "mV",
      "default": "mV",
      "title": "Amplitude Unit",
      "type": "string"
    },
    "minimum_amplitude_mV": {
      "title": "Minimum Amplitude Mv",
      "type": "number"
    },
    "maximum_amplitude_mV": {
      "title": "Maximum Amplitude Mv",
      "type": "number"
    },
    "localization_use_status": {
      "const": "raw_waveform_no_arrival_pick",
      "default": "raw_waveform_no_arrival_pick",
      "title": "Localization Use Status",
      "type": "string"
    }
  },
  "required": [
    "source_filename",
    "source_file_sha256",
    "source_label_from_filename",
    "sensor_channel",
    "trace_index_from_filename",
    "provider_set",
    "provider_index",
    "provider_time_text",
    "sample_rate_Hz",
    "pretrigger_samples",
    "sample_count",
    "minimum_amplitude_mV",
    "maximum_amplitude_mV"
  ],
  "title": "AEWaveformRecord",
  "type": "object"
}