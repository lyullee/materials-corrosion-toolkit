{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One source record, preserving provider-native values and test semantics.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.otto_electrolyte_observation.v1",
      "default": "matintegrity.otto_electrolyte_observation.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "matr-aqueous-electrolytes",
      "default": "matr-aqueous-electrolytes",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_license": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "Dataset License",
      "type": "string"
    },
    "attribution": {
      "const": "Dave et al. (2020), Autonomous Discovery of Battery Electrolytes with Robotic Experimentation and Machine Learning, Cell Reports Physical Science 1, 100264; dataset: TRI Energy & Materials Data, Aqueous electrolytes, https://data.matr.io/5/",
      "default": "Dave et al. (2020), Autonomous Discovery of Battery Electrolytes with Robotic Experimentation and Machine Learning, Cell Reports Physical Science 1, 100264; dataset: TRI Energy & Materials Data, Aqueous electrolytes, https://data.matr.io/5/",
      "title": "Attribution",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "source_json_member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Json Member Sha256",
      "type": "string"
    },
    "normalized_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Normalized Record Sha256",
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "source_run_id": {
      "minLength": 1,
      "title": "Source Run Id",
      "type": "string"
    },
    "run_type_as_reported": {
      "minLength": 1,
      "title": "Run Type As Reported",
      "type": "string"
    },
    "timestamp_as_reported": {
      "minLength": 1,
      "title": "Timestamp As Reported",
      "type": "string"
    },
    "test_protocol_as_reported": {
      "minLength": 1,
      "title": "Test Protocol As Reported",
      "type": "string"
    },
    "temperature_reported_value": {
      "title": "Temperature Reported Value",
      "type": "number"
    },
    "temperature_unit": {
      "default": "not encoded in JSON; caller review required",
      "title": "Temperature Unit",
      "type": "string"
    },
    "conductivity_reported_value": {
      "title": "Conductivity Reported Value",
      "type": "number"
    },
    "conductivity_unit": {
      "default": "not encoded in JSON; caller review required",
      "title": "Conductivity Unit",
      "type": "string"
    },
    "pH_reported_value": {
      "title": "Ph Reported Value",
      "type": "number"
    },
    "feeder_volume_mL": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Feeder Volume Ml",
      "type": "object"
    },
    "feeder_source_molality_as_reported": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Feeder Source Molality As Reported",
      "type": "object"
    },
    "feeder_source_density_as_reported": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Feeder Source Density As Reported",
      "type": "object"
    },
    "time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Time S",
      "type": "array"
    },
    "potential_V_as_reported": {
      "items": {
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Potential V As Reported",
      "type": "array"
    },
    "signed_current_density_mA_cm2": {
      "items": {
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Signed Current Density Ma Cm2",
      "type": "array"
    },
    "potential_reference_electrode": {
      "const": "Ag/AgCl",
      "default": "Ag/AgCl",
      "title": "Potential Reference Electrode",
      "type": "string"
    },
    "working_counter_material": {
      "const": "platinum",
      "default": "platinum",
      "title": "Working Counter Material",
      "type": "string"
    },
    "reported_stability_metrics_V": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Reported Stability Metrics V",
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "source_archive_sha256",
    "source_json_member_sha256",
    "normalized_record_sha256",
    "record_id",
    "source_run_id",
    "run_type_as_reported",
    "timestamp_as_reported",
    "test_protocol_as_reported",
    "temperature_reported_value",
    "conductivity_reported_value",
    "pH_reported_value",
    "feeder_volume_mL",
    "feeder_source_molality_as_reported",
    "feeder_source_density_as_reported",
    "time_s",
    "potential_V_as_reported",
    "signed_current_density_mA_cm2",
    "reported_stability_metrics_V",
    "evidence"
  ],
  "title": "OttoElectrolyteObservation",
  "type": "object"
}