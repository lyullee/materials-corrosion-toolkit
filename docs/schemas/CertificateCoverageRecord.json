{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "minLength": 1,
      "title": "Record Id",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "heat_id": {
      "minLength": 1,
      "title": "Heat Id",
      "type": "string"
    },
    "product_id": {
      "minLength": 1,
      "title": "Product Id",
      "type": "string"
    },
    "traceability_id": {
      "minLength": 1,
      "title": "Traceability Id",
      "type": "string"
    },
    "category": {
      "enum": [
        "chemistry",
        "mechanical",
        "heat_treatment",
        "nde",
        "traceability"
      ],
      "title": "Category",
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "review",
        "missing"
      ],
      "title": "Status",
      "type": "string"
    },
    "caller_criterion_id": {
      "minLength": 1,
      "title": "Caller Criterion Id",
      "type": "string"
    },
    "result_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Result Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "record_id",
    "document_id",
    "heat_id",
    "product_id",
    "traceability_id",
    "category",
    "status",
    "caller_criterion_id",
    "result_digest",
    "evidence"
  ],
  "title": "CertificateCoverageRecord",
  "type": "object"
}