{
  "additionalProperties": false,
  "properties": {
    "report_schema_version": {
      "const": "matintegrity.external_pressure_campaign_report.v1",
      "default": "matintegrity.external_pressure_campaign_report.v1",
      "title": "Report Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "evidence_outcome": {
      "enum": [
        "supported",
        "review",
        "not_supported",
        "insufficient_evidence"
      ],
      "title": "Evidence Outcome",
      "type": "string"
    },
    "caller_profile_id": {
      "minLength": 1,
      "title": "Caller Profile Id",
      "type": "string"
    },
    "metric_values": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metric Values",
      "type": "object"
    },
    "criterion_findings": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Criterion Findings",
      "type": "array"
    },
    "receipt_summaries": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Receipt Summaries",
      "type": "array"
    },
    "diagnostics": {
      "additionalProperties": true,
      "title": "Diagnostics",
      "type": "object"
    },
    "input_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "caller_profile_only": {
      "const": true,
      "default": true,
      "title": "Caller Profile Only",
      "type": "boolean"
    },
    "buckling_analysis_executed": {
      "const": false,
      "default": false,
      "title": "Buckling Analysis Executed",
      "type": "boolean"
    },
    "allowable_pressure_or_safety_factor_produced": {
      "const": false,
      "default": false,
      "title": "Allowable Pressure Or Safety Factor Produced",
      "type": "boolean"
    },
    "automatic_acceptance_or_field_qualification": {
      "const": false,
      "default": false,
      "title": "Automatic Acceptance Or Field Qualification",
      "type": "boolean"
    },
    "report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Digest",
      "type": "string"
    }
  },
  "required": [
    "assessment_id",
    "campaign_id",
    "evidence_outcome",
    "caller_profile_id",
    "metric_values",
    "criterion_findings",
    "receipt_summaries",
    "diagnostics",
    "input_digest",
    "report_digest"
  ],
  "title": "ExternalPressureCampaignReport",
  "type": "object"
}