{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SCCRuleCondition": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "expected_fact_kind": {
          "enum": [
            "number",
            "descriptor",
            "boolean"
          ],
          "title": "Expected Fact Kind",
          "type": "string"
        },
        "operator": {
          "enum": [
            "greater_than",
            "greater_than_or_equal",
            "less_than",
            "less_than_or_equal",
            "between_inclusive",
            "equals",
            "in_set",
            "is_true",
            "is_false"
          ],
          "title": "Operator",
          "type": "string"
        },
        "unit_token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Token"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "lower_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "upper_bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        },
        "expected_descriptors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Expected Descriptors",
          "type": "array"
        },
        "condition_basis": {
          "minLength": 1,
          "title": "Condition Basis",
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "fact_id",
        "expected_fact_kind",
        "operator",
        "condition_basis"
      ],
      "title": "SCCRuleCondition",
      "type": "object"
    },
    "SCCScreeningRule": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_definition": {
          "minLength": 1,
          "title": "Rule Definition",
          "type": "string"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/SCCRuleCondition"
          },
          "minItems": 1,
          "title": "Conditions",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "rule_id",
        "rule_definition",
        "conditions",
        "evidence"
      ],
      "title": "SCCScreeningRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "mechanism_id": {
      "minLength": 1,
      "title": "Mechanism Id",
      "type": "string"
    },
    "mechanism_definition": {
      "minLength": 1,
      "title": "Mechanism Definition",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "required_fact_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Required Fact Ids",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/SCCScreeningRule"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "unknown_policy": {
      "enum": [
        "indeterminate",
        "screen_in"
      ],
      "title": "Unknown Policy",
      "type": "string"
    },
    "authority_and_rule_completeness_reviewed": {
      "title": "Authority And Rule Completeness Reviewed",
      "type": "boolean"
    },
    "profile_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "mechanism_id",
    "mechanism_definition",
    "provider_id",
    "revision",
    "required_fact_ids",
    "rules",
    "unknown_policy",
    "authority_and_rule_completeness_reviewed",
    "profile_sha256",
    "evidence"
  ],
  "title": "DamageMechanismProfile",
  "type": "object"
}