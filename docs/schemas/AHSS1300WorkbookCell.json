        "boolean",
        "date",
        "datetime",
        "time",
        "formula",
        "error"
      ],
      "title": "Cell Kind",
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "coordinate",
    "cell_kind",
    "value"
  ],
