{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One original numeric matrix row without assigning columns to physical quantities.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.zenodo_deis_matrix_row.v1",
      "default": "matintegrity.zenodo_deis_matrix_row.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "az-we43-az31-molybdate-eis",
      "default": "az-we43-az31-molybdate-eis",
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_doi": {
      "const": "10.5281/zenodo.10482561",
      "default": "10.5281/zenodo.10482561",
      "title": "Dataset Doi",
      "type": "string"
    },
    "license_id": {
      "const": "CC0-1.0",
      "default": "CC0-1.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    },
    "source_archive_filename": {
      "const": "Dataset_CorSci.zip",
      "default": "Dataset_CorSci.zip",
      "title": "Source Archive Filename",
      "type": "string"
    },
    "source_archive_bytes": {
      "exclusiveMinimum": 0,
      "title": "Source Archive Bytes",
      "type": "integer"
    },
    "source_archive_md5": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Source Archive Md5",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "source_member_path": {
      "enum": [
        "DEIS/AZ31/AZ31-zw.txt",
        "DEIS/WE43/WE43-zw.txt"
      ],
      "title": "Source Member Path",
      "type": "string"
    },
    "source_member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Member Sha256",
      "type": "string"
    },
    "declared_alloy_label": {
      "enum": [
        "AZ31",
        "WE43"
      ],
      "title": "Declared Alloy Label",
      "type": "string"
    },
    "source_row_order": {
      "minimum": 0,
      "title": "Source Row Order",
      "type": "integer"
    },
    "provider_row_number": {
      "minimum": 1,
      "title": "Provider Row Number",
      "type": "integer"
    },
    "source_column_count": {
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "title": "Source Column Count",
      "type": "integer"
    },
    "matrix_values_as_provided": {
      "items": {
        "type": "number"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Matrix Values As Provided",
      "type": "array"
    },
    "delimiter": {
      "const": "tab",
      "default": "tab",
      "title": "Delimiter",
      "type": "string"
    },
    "row_axis_mapping": {
      "const": "unresolved",
      "default": "unresolved",
      "title": "Row Axis Mapping",
      "type": "string"
    },
    "column_axis_mapping": {
      "const": "unresolved",
      "default": "unresolved",
      "title": "Column Axis Mapping",
      "type": "string"
    },
    "units_mapping": {
      "const": "unresolved",
      "default": "unresolved",
      "title": "Units Mapping",
      "type": "string"
    },
    "time_series_identity_inferred": {
      "const": false,
      "default": false,
      "title": "Time Series Identity Inferred",
      "type": "boolean"
    },
    "frequency_axis_inferred": {
      "const": false,
      "default": false,
      "title": "Frequency Axis Inferred",
      "type": "boolean"
    },
    "corrosion_quantity_inferred": {
      "const": false,
      "default": false,
      "title": "Corrosion Quantity Inferred",
      "type": "boolean"
    },
    "material_performance_inferred": {
      "const": false,
      "default": false,
      "title": "Material Performance Inferred",
      "type": "boolean"
    },
    "source_row_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Row Sha256",
      "type": "string"
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "source_archive_bytes",
    "source_archive_md5",
    "source_archive_sha256",
    "source_member_path",
    "source_member_sha256",
    "declared_alloy_label",
    "source_row_order",
    "provider_row_number",
    "source_column_count",
    "matrix_values_as_provided",
    "source_row_sha256",
    "evidence"
  ],
  "title": "ZenodoDeisMatrixRow",
  "type": "object"
}