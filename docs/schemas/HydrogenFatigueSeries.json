{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.hydrogen_fatigue_series.v1",
      "default": "matintegrity.hydrogen_fatigue_series.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "series_id": {
      "minLength": 1,
      "title": "Series Id",
      "type": "string"
    },
    "source_group_id": {
      "minLength": 1,
      "title": "Source Group Id",
      "type": "string"
    },
    "physical_material_condition_id": {
      "minLength": 1,
      "title": "Physical Material Condition Id",
      "type": "string"
    },
    "material_designation_token": {
      "minLength": 1,
      "title": "Material Designation Token",
      "type": "string"
    },
    "product_form_token": {
      "minLength": 1,
      "title": "Product Form Token",
      "type": "string"
    },
    "temper_token": {
      "minLength": 1,
      "title": "Temper Token",
      "type": "string"
    },
    "microstructure_token": {
      "minLength": 1,
      "title": "Microstructure Token",
      "type": "string"
    },
    "environment_token": {
      "minLength": 1,
      "title": "Environment Token",
      "type": "string"
    },
    "workbook_pressure_Pa": {
      "exclusiveMinimum": 0,
      "title": "Workbook Pressure Pa",
      "type": "number"
    },
    "provider_record_pressure_Pa": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Record Pressure Pa"
    },
    "pressure_reconciliation_status": {
      "enum": [
        "record_not_supplied",
        "record_matches_workbook",
        "record_conflicts_with_workbook"
      ],
      "title": "Pressure Reconciliation Status",
      "type": "string"
    },
    "pressure_conflict_acknowledged": {
      "title": "Pressure Conflict Acknowledged",
      "type": "boolean"
    },
    "workbook_temperature_token": {
      "minLength": 1,
      "title": "Workbook Temperature Token",
      "type": "string"
    },
    "provider_record_temperature_K": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Record Temperature K"
    },
    "specimen_orientation_token": {
      "minLength": 1,
      "title": "Specimen Orientation Token",
      "type": "string"
    },
    "test_method_token": {
      "minLength": 1,
      "title": "Test Method Token",
      "type": "string"
    },
    "stress_ratio": {
      "title": "Stress Ratio",
      "type": "number"
    },
    "frequency_Hz": {
      "exclusiveMinimum": 0,
      "title": "Frequency Hz",
      "type": "number"
    },
    "source_filename": {
      "minLength": 1,
      "title": "Source Filename",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "source_sheet": {
      "const": "Mechanical Properties-Fatigue",
      "default": "Mechanical Properties-Fatigue",
      "title": "Source Sheet",
      "type": "string"
    },
    "source_delta_k_column": {
      "pattern": "^[A-Z]+$",
      "title": "Source Delta K Column",
      "type": "string"
    },
    "source_growth_column": {
      "pattern": "^[A-Z]+$",
      "title": "Source Growth Column",
      "type": "string"
    },
    "physical_specimen_identity_status": {
      "const": "not_supplied_in_workbook",
      "default": "not_supplied_in_workbook",
      "title": "Physical Specimen Identity Status",
      "type": "string"
    },
    "validity_status": {
      "const": "provider_method_named_validity_not_independently_reviewed",
      "default": "provider_method_named_validity_not_independently_reviewed",
      "title": "Validity Status",
      "type": "string"
    },
    "point_count": {
      "exclusiveMinimum": 0,
      "title": "Point Count",
      "type": "integer"
    }
  },
  "required": [
    "series_id",
    "source_group_id",
    "physical_material_condition_id",
    "material_designation_token",
    "product_form_token",
    "temper_token",
    "microstructure_token",
    "environment_token",
    "workbook_pressure_Pa",
    "pressure_reconciliation_status",
    "pressure_conflict_acknowledged",
    "workbook_temperature_token",
    "specimen_orientation_token",
    "test_method_token",
    "stress_ratio",
    "frequency_Hz",
    "source_filename",
    "source_sha256",
    "source_delta_k_column",
    "source_growth_column",
    "point_count"
  ],
  "title": "HydrogenFatigueSeries",
  "type": "object"
}