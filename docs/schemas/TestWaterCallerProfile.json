{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TestWaterCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "analyte": {
          "enum": [
            "ph",
            "conductivity",
            "chloride",
            "halide",
            "oxygen",
            "solids",
            "microbiology",
            "inhibitor",
            "temperature"
          ],
          "title": "Analyte",
          "type": "string"
        },
        "species_or_quantity_definition": {
          "minLength": 1,
          "title": "Species Or Quantity Definition",
          "type": "string"
        },
        "aggregation": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "direction": {
          "enum": [
            "minimum",
            "maximum"
          ],
          "title": "Direction",
          "type": "string"
        },
        "accept_limit": {
          "minimum": 0,
          "title": "Accept Limit",
          "type": "number"
        },
        "reject_limit": {
          "minimum": 0,
          "title": "Reject Limit",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        }
      },
      "required": [
        "criterion_id",
        "analyte",
        "species_or_quantity_definition",
        "aggregation",
        "direction",
        "accept_limit",
        "reject_limit",
        "unit_token",
        "criterion_basis"
      ],
      "title": "TestWaterCriterion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_version": {
      "minLength": 1,
      "title": "Profile Version",
      "type": "string"
    },
    "required_history_kinds": {
      "items": {
        "enum": [
          "fill",
          "hold",
          "drain",
          "dry",
          "other"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required History Kinds",
      "type": "array"
    },
    "required_analytes": {
      "items": {
        "enum": [
          "ph",
          "conductivity",
          "chloride",
          "halide",
          "oxygen",
          "solids",
          "microbiology",
          "inhibitor",
          "temperature"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Analytes",
      "type": "array"
    },
    "minimum_sample_count": {
      "minimum": 1,
      "title": "Minimum Sample Count",
      "type": "integer"
    },
    "minimum_independent_source_group_count": {
      "minimum": 1,
      "title": "Minimum Independent Source Group Count",
      "type": "integer"
    },
    "criteria": {
      "items": {
        "$ref": "#/$defs/TestWaterCriterion"
      },
      "minItems": 1,
      "title": "Criteria",
      "type": "array"
    },
    "profile_provider_id": {
      "minLength": 1,
      "title": "Profile Provider Id",
      "type": "string"
    },
    "profile_revision": {
      "minLength": 1,
      "title": "Profile Revision",
      "type": "string"
    },
    "profile_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Profile Configuration Digest",
      "type": "string"
    },
    "caller_acceptance_authority": {
      "minLength": 1,
      "title": "Caller Acceptance Authority",
      "type": "string"
    },
    "chemical_species_conversion_used": {
      "const": false,
      "default": false,
      "title": "Chemical Species Conversion Used",
      "type": "boolean"
    },
    "corrosion_rate_inference_claimed": {
      "const": false,
      "default": false,
      "title": "Corrosion Rate Inference Claimed",
      "type": "boolean"
    },
    "microbiological_risk_inference_claimed": {
      "const": false,
      "default": false,
      "title": "Microbiological Risk Inference Claimed",
      "type": "boolean"
    },
    "built_in_code_or_standard_limits_used": {
      "const": false,
      "default": false,
      "title": "Built In Code Or Standard Limits Used",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "required_history_kinds",
    "required_analytes",
    "minimum_sample_count",
    "minimum_independent_source_group_count",
    "criteria",
    "profile_provider_id",
    "profile_revision",
    "profile_configuration_digest",
    "caller_acceptance_authority",
    "evidence"
  ],
  "title": "TestWaterCallerProfile",
  "type": "object"
}