{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "WetCo2CylindricalGeometryKnot": {
      "additionalProperties": false,
      "properties": {
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "wall_recession_m": {
          "minimum": 0,
          "title": "Wall Recession M",
          "type": "number"
        },
        "phase_inventories": {
          "items": {
            "$ref": "#/$defs/WetCo2ScalePhaseLineInventory"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Phase Inventories",
          "type": "array"
        }
      },
      "required": [
        "time_s",
        "wall_recession_m",
        "phase_inventories"
      ],
      "title": "WetCo2CylindricalGeometryKnot",
      "type": "object"
    },
    "WetCo2CylindricalMultilayerTransportKnot": {
      "additionalProperties": false,
      "properties": {
        "time_s": {
          "minimum": 0.0,
          "title": "Time S",
          "type": "number"
        },
        "solution_film_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Solution Film Thickness M",
          "type": "number"
        },
        "scale_diffusivities": {
          "items": {
            "$ref": "#/$defs/WetCo2LayerSpeciesDiffusivity"
          },
          "maxItems": 2048,
          "minItems": 1,
          "title": "Scale Diffusivities",
          "type": "array"
        },
        "solution_diffusivities": {
          "items": {
            "$ref": "#/$defs/WetCo2SolutionSpeciesDiffusivity"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Solution Diffusivities",
          "type": "array"
        },
        "parameter_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Parameter Record Sha256",
          "type": "string"
        },
        "parameter_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Parameter Evidence",
          "type": "array"
        }
      },
      "required": [
        "time_s",
        "solution_film_thickness_m",
        "scale_diffusivities",
        "solution_diffusivities",
        "parameter_record_sha256",
        "parameter_evidence"
      ],
      "title": "WetCo2CylindricalMultilayerTransportKnot",
      "type": "object"
    },
    "WetCo2CylindricalScaleGeometryHistory": {
      "additionalProperties": false,
      "description": "Map lineal phase inventory into an axisymmetric cylindrical bore at exact knots.",
      "properties": {
        "schema_version": {
          "const": "matintegrity.wet_co2_cylindrical_scale_geometry_history.v1",
          "default": "matintegrity.wet_co2_cylindrical_scale_geometry_history.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Time Basis Id",
          "type": "string"
        },
        "outer_radius_m": {
          "exclusiveMinimum": 0,
          "title": "Outer Radius M",
          "type": "number"
        },
        "initial_inner_radius_m": {
          "exclusiveMinimum": 0,
          "title": "Initial Inner Radius M",
          "type": "number"
        },
        "initial_wall_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Initial Wall Thickness M",
          "type": "number"
        },
        "segment_length_m": {
          "exclusiveMinimum": 0,
          "title": "Segment Length M",
          "type": "number"
        },
        "geometry_provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Geometry Provider Id",
          "type": "string"
        },
        "geometry_provider_revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Geometry Provider Revision",
          "type": "string"
        },
        "geometry_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Record Sha256",
          "type": "string"
        },
        "geometry_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "history_provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "History Provider Id",
          "type": "string"
        },
        "history_provider_revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "History Provider Revision",
          "type": "string"
        },
        "history_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "History Record Sha256",
          "type": "string"
        },
        "history_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/WetCo2CylindricalScalePhase"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/WetCo2CylindricalGeometryKnot"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "History",
          "type": "array"
        },
        "axisymmetric_uniformity_reviewed": {
          "title": "Axisymmetric Uniformity Reviewed",
          "type": "boolean"
        },
        "phase_inventory_reference_basis_reviewed": {
          "title": "Phase Inventory Reference Basis Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "assessment_id",
        "asset_id",
        "location_id",
        "time_basis_id",
        "outer_radius_m",
        "initial_inner_radius_m",
        "initial_wall_thickness_m",
        "segment_length_m",
        "geometry_provider_id",
        "geometry_provider_revision",
        "geometry_record_sha256",
        "geometry_evidence",
        "history_provider_id",
        "history_provider_revision",
        "history_record_sha256",
        "history_evidence",
        "phases",
        "history",
        "axisymmetric_uniformity_reviewed",
        "phase_inventory_reference_basis_reviewed"
      ],
      "title": "WetCo2CylindricalScaleGeometryHistory",
      "type": "object"
    },
    "WetCo2CylindricalScalePhase": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "molar_volume_m3_mol": {
          "exclusiveMinimum": 0,
          "title": "Molar Volume M3 Mol",
          "type": "number"
        },
        "provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "phase_id",
        "molar_volume_m3_mol",
        "provider_id",
        "provider_revision",
        "source_record_id",
        "evidence"
      ],
      "title": "WetCo2CylindricalScalePhase",
      "type": "object"
    },
    "WetCo2LayerSpeciesDiffusivity": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "species_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "diffusivity_m2_s": {
          "exclusiveMinimum": 0,
          "title": "Diffusivity M2 S",
          "type": "number"
        }
      },
      "required": [
        "phase_id",
        "species_id",
        "diffusivity_m2_s"
      ],
      "title": "WetCo2LayerSpeciesDiffusivity",
      "type": "object"
    },
    "WetCo2ScalePhaseLineInventory": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "moles_per_axial_metre_mol_m": {
          "minimum": 0,
          "title": "Moles Per Axial Metre Mol M",
          "type": "number"
        }
      },
      "required": [
        "phase_id",
        "moles_per_axial_metre_mol_m"
      ],
      "title": "WetCo2ScalePhaseLineInventory",
      "type": "object"
    },
    "WetCo2SolutionSpeciesDiffusivity": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "diffusivity_m2_s": {
          "exclusiveMinimum": 0,
          "title": "Diffusivity M2 S",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "diffusivity_m2_s"
      ],
      "title": "WetCo2SolutionSpeciesDiffusivity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Compute species-specific radial resistance through phase layers and liquid film.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.wet_co2_cylindrical_multilayer_transport_resistance.v1",
      "default": "matintegrity.wet_co2_cylindrical_multilayer_transport_resistance.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/WetCo2CylindricalScaleGeometryHistory"
    },
    "geometry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Geometry Sha256",
      "type": "string"
    },
    "species_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Species Ids",
      "type": "array"
    },
    "layer_order_steel_to_bore": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Layer Order Steel To Bore",
      "type": "array"
    },
    "knots": {
      "items": {
        "$ref": "#/$defs/WetCo2CylindricalMultilayerTransportKnot"
      },
      "maxItems": 5000,
      "minItems": 1,
      "title": "Knots",
      "type": "array"
    },
    "radial_layer_order_reviewed": {
      "title": "Radial Layer Order Reviewed",
      "type": "boolean"
    },
    "dense_scale_and_solution_film_reviewed": {
      "title": "Dense Scale And Solution Film Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "geometry",
    "geometry_sha256",
    "species_ids",
    "layer_order_steel_to_bore",
    "knots",
    "radial_layer_order_reviewed",
    "dense_scale_and_solution_film_reviewed"
  ],
  "title": "WetCo2CylindricalMultilayerTransportResistance",
  "type": "object"
}