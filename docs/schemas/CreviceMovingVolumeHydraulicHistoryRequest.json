{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Integrate one pressure-driven series slit with prescribed aperture history.\n\nCell aperture is linearly interpolated on each exact interval. Incompressible\ncontinuity determines the flow difference across each cell; total pressure\ndrop drives the remaining common inlet-flow degree of freedom through a\nreduced series resistance/inertance balance.",
  "properties": {
    "schema_version": {
      "default": "matintegrity.crevice_moving_volume_hydraulic_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Time S",
      "type": "array"
    },
    "cell_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Cell Ids",
      "type": "array"
    },
    "cell_lengths_m": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Cell Lengths M",
      "type": "array"
    },
    "cell_widths_m": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Cell Widths M",
      "type": "array"
    },
    "aperture_m_by_knot_and_cell": {
      "items": {
        "items": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Aperture M By Knot And Cell",
      "type": "array"
    },
    "pressure_drop_Pa_by_interval": {
      "items": {
        "type": "number"
      },
      "maxItems": 4999,
      "minItems": 1,
      "title": "Pressure Drop Pa By Interval",
      "type": "array"
    },
    "initial_left_boundary_flow_m3_s": {
      "title": "Initial Left Boundary Flow M3 S",
      "type": "number"
    },
    "density_kg_m3": {
      "exclusiveMinimum": 0,
      "title": "Density Kg M3",
      "type": "number"
    },
    "dynamic_viscosity_Pa_s": {
      "exclusiveMinimum": 0,
      "title": "Dynamic Viscosity Pa S",
      "type": "number"
    },
    "geometry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Geometry Sha256",
      "type": "string"
    },
    "pressure_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Pressure Sha256",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 256,
      "minItems": 2,
      "title": "Evidence",
      "type": "array"
    },
    "absolute_tolerance_flow_m3_s": {
      "default": 1e-12,
      "exclusiveMinimum": 0,
      "title": "Absolute Tolerance Flow M3 S",
      "type": "number"
    },
    "relative_tolerance": {
      "default": 1e-07,
      "exclusiveMinimum": 0,
      "maximum": 0.01,
      "title": "Relative Tolerance",
      "type": "number"
    },
    "absolute_pressure_closure_tolerance_Pa": {
      "default": 1e-09,
      "exclusiveMinimum": 0,
      "title": "Absolute Pressure Closure Tolerance Pa",
      "type": "number"
    },
    "relative_pressure_closure_tolerance": {
      "default": 1e-09,
      "exclusiveMinimum": 0,
      "maximum": 0.001,
      "title": "Relative Pressure Closure Tolerance",
      "type": "number"
    },
    "maximum_step_s": {
      "default": 1000000.0,
      "exclusiveMinimum": 0,
      "title": "Maximum Step S",
      "type": "number"
    },
    "maximum_righthand_evaluations": {
      "default": 1000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Righthand Evaluations",
      "type": "integer"
    },
    "maximum_output_cell_intervals": {
      "default": 2000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Output Cell Intervals",
      "type": "integer"
    },
    "minimum_width_to_aperture_ratio": {
      "default": 20.0,
      "exclusiveMinimum": 0,
      "maximum": 1000.0,
      "minimum": 20.0,
      "title": "Minimum Width To Aperture Ratio",
      "type": "number"
    },
    "maximum_reviewed_reynolds_number": {
      "default": 1000.0,
      "exclusiveMinimum": 0,
      "maximum": 1000.0,
      "minimum": 1.0,
      "title": "Maximum Reviewed Reynolds Number",
      "type": "number"
    },
    "geometry_and_volume_history_reviewed": {
      "title": "Geometry And Volume History Reviewed",
      "type": "boolean"
    },
    "pressure_reference_and_sign_reviewed": {
      "title": "Pressure Reference And Sign Reviewed",
      "type": "boolean"
    },
    "incompressible_newtonian_fluid_reviewed": {
      "title": "Incompressible Newtonian Fluid Reviewed",
      "type": "boolean"
    },
    "wide_laminar_slit_resistance_and_inertance_reviewed": {
      "title": "Wide Laminar Slit Resistance And Inertance Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "physical_scope_id",
    "time_s",
    "cell_ids",
    "cell_lengths_m",
    "cell_widths_m",
    "aperture_m_by_knot_and_cell",
    "pressure_drop_Pa_by_interval",
    "initial_left_boundary_flow_m3_s",
    "density_kg_m3",
    "dynamic_viscosity_Pa_s",
    "geometry_sha256",
    "pressure_sha256",
    "evidence",
    "geometry_and_volume_history_reviewed",
    "pressure_reference_and_sign_reviewed",
    "incompressible_newtonian_fluid_reviewed",
    "wide_laminar_slit_resistance_and_inertance_reviewed",
    "computational_use_authorized"
  ],
  "title": "CreviceMovingVolumeHydraulicHistoryRequest",
  "type": "object"
}