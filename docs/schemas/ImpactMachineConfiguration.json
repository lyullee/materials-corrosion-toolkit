{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "machine_id": {
      "minLength": 1,
      "title": "Machine Id",
      "type": "string"
    },
    "machine_revision": {
      "minLength": 1,
      "title": "Machine Revision",
      "type": "string"
    },
    "striker_id": {
      "minLength": 1,
      "title": "Striker Id",
      "type": "string"
    },
    "striker_definition": {
      "minLength": 1,
      "title": "Striker Definition",
      "type": "string"
    },
    "striker_radius": {
      "exclusiveMinimum": 0,
      "title": "Striker Radius",
      "type": "number"
    },
    "striker_radius_unit_token": {
      "minLength": 1,
      "title": "Striker Radius Unit Token",
      "type": "string"
    },
    "machine_capacity": {
      "exclusiveMinimum": 0,
      "title": "Machine Capacity",
      "type": "number"
    },
    "machine_capacity_unit_token": {
      "minLength": 1,
      "title": "Machine Capacity Unit Token",
      "type": "string"
    },
    "calibration_id": {
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_revision": {
      "minLength": 1,
      "title": "Calibration Revision",
      "type": "string"
    },
    "calibration_status": {
      "enum": [
        "valid",
        "invalid",
        "missing"
      ],
      "title": "Calibration Status",
      "type": "string"
    },
    "calibration_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Record Digest",
      "type": "string"
    },
    "invalid_or_missing_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalid Or Missing Basis"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "machine_id",
    "machine_revision",
    "striker_id",
    "striker_definition",
    "striker_radius",
    "striker_radius_unit_token",
    "machine_capacity",
    "machine_capacity_unit_token",
    "calibration_id",
    "calibration_revision",
    "calibration_status",
    "calibration_record_digest",
    "evidence"
  ],
  "title": "ImpactMachineConfiguration",
  "type": "object"
}