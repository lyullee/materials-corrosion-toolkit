{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SurfaceProfilePoint": {
      "additionalProperties": false,
      "properties": {
        "point_id": {
          "minLength": 1,
          "title": "Point Id",
          "type": "string"
        },
        "reference_position_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Reference Position M",
          "type": "array"
        },
        "measured_position_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Measured Position M",
          "type": "array"
        },
        "outward_unit_normal": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Outward Unit Normal",
          "type": "array"
        },
        "normal_deviation_expanded_uncertainty_m": {
          "minimum": 0,
          "title": "Normal Deviation Expanded Uncertainty M",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "point_id",
        "reference_position_m",
        "measured_position_m",
        "outward_unit_normal",
        "normal_deviation_expanded_uncertainty_m",
        "evidence"
      ],
      "title": "SurfaceProfilePoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "coordinate_frame_id": {
      "minLength": 1,
      "title": "Coordinate Frame Id",
      "type": "string"
    },
    "reference_geometry_id": {
      "minLength": 1,
      "title": "Reference Geometry Id",
      "type": "string"
    },
    "measurement_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Measurement Digest",
      "type": "string"
    },
    "reference_geometry_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Reference Geometry Digest",
      "type": "string"
    },
    "reference_length_m": {
      "exclusiveMinimum": 0,
      "title": "Reference Length M",
      "type": "number"
    },
    "points": {
      "items": {
        "$ref": "#/$defs/SurfaceProfilePoint"
      },
      "minItems": 1,
      "title": "Points",
      "type": "array"
    },
    "caller_minimum_signed_deviation_m": {
      "title": "Caller Minimum Signed Deviation M",
      "type": "number"
    },
    "caller_maximum_signed_deviation_m": {
      "title": "Caller Maximum Signed Deviation M",
      "type": "number"
    },
    "point_correspondence_coordinate_frame_and_normals_reviewed": {
      "title": "Point Correspondence Coordinate Frame And Normals Reviewed",
      "type": "boolean"
    },
    "measurement_uncertainty_and_limit_authority_reviewed": {
      "title": "Measurement Uncertainty And Limit Authority Reviewed",
      "type": "boolean"
    },
    "limit_basis": {
      "minLength": 1,
      "title": "Limit Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "location_id",
    "coordinate_frame_id",
    "reference_geometry_id",
    "measurement_digest",
    "reference_geometry_digest",
    "reference_length_m",
    "points",
    "caller_minimum_signed_deviation_m",
    "caller_maximum_signed_deviation_m",
    "point_correspondence_coordinate_frame_and_normals_reviewed",
    "measurement_uncertainty_and_limit_authority_reviewed",
    "limit_basis",
    "evidence"
  ],
  "title": "SurfaceProfileDeviation",
  "type": "object"
}