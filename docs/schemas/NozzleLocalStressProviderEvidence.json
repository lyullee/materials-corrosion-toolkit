{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "NozzleGeometryQuantity": {
      "additionalProperties": false,
      "properties": {
        "quantity_id": {
          "minLength": 1,
          "title": "Quantity Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "quantity_id",
        "value",
        "unit_token",
        "basis",
        "evidence"
      ],
      "title": "NozzleGeometryQuantity",
      "type": "object"
    },
    "NozzleLoadComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "component_kind": {
          "enum": [
            "force",
            "moment",
            "pressure",
            "temperature",
            "user_defined"
          ],
          "title": "Component Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "sign_and_basis": {
          "minLength": 1,
          "title": "Sign And Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "component_kind",
        "value",
        "unit_token",
        "sign_and_basis",
        "evidence"
      ],
      "title": "NozzleLoadComponent",
      "type": "object"
    },
    "NozzleLocalStressEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "vessel_geometry_id": {
          "minLength": 1,
          "title": "Vessel Geometry Id",
          "type": "string"
        },
        "nozzle_geometry_id": {
          "minLength": 1,
          "title": "Nozzle Geometry Id",
          "type": "string"
        },
        "opening_geometry_id": {
          "minLength": 1,
          "title": "Opening Geometry Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "supported_mesh_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Mesh Ids",
          "type": "array"
        },
        "geometry_support": {
          "items": {
            "$ref": "#/$defs/NozzleQuantitySupport"
          },
          "minItems": 1,
          "title": "Geometry Support",
          "type": "array"
        },
        "load_support": {
          "items": {
            "$ref": "#/$defs/NozzleQuantitySupport"
          },
          "minItems": 1,
          "title": "Load Support",
          "type": "array"
        },
        "result_support": {
          "items": {
            "$ref": "#/$defs/NozzleResultSupport"
          },
          "minItems": 1,
          "title": "Result Support",
          "type": "array"
        },
        "qualification_evidence": {
          "items": {
            "$ref": "#/$defs/NozzleQualificationEvidence"
          },
          "minItems": 2,
          "title": "Qualification Evidence",
          "type": "array"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "vessel_geometry_id",
        "nozzle_geometry_id",
        "opening_geometry_id",
        "material_condition_id",
        "coordinate_frame_id",
        "provider_id",
        "provider_revision",
        "provider_configuration_digest",
        "supported_mesh_ids",
        "geometry_support",
        "load_support",
        "result_support",
        "qualification_evidence",
        "qualification_basis",
        "evidence"
      ],
      "title": "NozzleLocalStressEnvelope",
      "type": "object"
    },
    "NozzleProviderStressResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "load_case_id": {
          "minLength": 1,
          "title": "Load Case Id",
          "type": "string"
        },
        "mesh_id": {
          "minLength": 1,
          "title": "Mesh Id",
          "type": "string"
        },
        "result_location_id": {
          "minLength": 1,
          "title": "Result Location Id",
          "type": "string"
        },
        "spatial_averaging_basis": {
          "minLength": 1,
          "title": "Spatial Averaging Basis",
          "type": "string"
        },
        "coordinate_frame_id": {
          "minLength": 1,
          "title": "Coordinate Frame Id",
          "type": "string"
        },
        "representation_kind": {
          "enum": [
            "stress_tensor_component",
            "linearized_membrane",
            "linearized_bending",
            "user_defined_metric"
          ],
          "title": "Representation Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "reported_value": {
          "title": "Reported Value",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "expanded_uncertainty": {
          "minimum": 0,
          "title": "Expanded Uncertainty",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "load_case_id",
        "mesh_id",
        "result_location_id",
        "spatial_averaging_basis",
        "coordinate_frame_id",
        "representation_kind",
        "metric_id",
        "metric_definition",
        "reported_value",
        "unit_token",
        "expanded_uncertainty",
        "provider_id",
        "provider_revision",
        "provider_configuration_digest",
        "input_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "NozzleProviderStressResult",
      "type": "object"
    },
    "NozzleQualificationEvidence": {
