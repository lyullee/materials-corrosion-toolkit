        },
        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "supports_declared_envelope": {
          "title": "Supports Declared Envelope",
          "type": "boolean"
        },
        "invalid_or_limiting_basis": {
          "anyOf": [
            {
              "type": "string"
