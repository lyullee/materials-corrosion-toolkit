        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "evidence_record_id",
        "physical_specimen_id",
        "source_group_id",
        "partition",
        "supported_metric_ids",
        "provider_id",
        "provider_revision",
        "provider_configuration_digest",
        "result_digest",
        "record_valid",
        "supports_declared_envelope",
        "evidence"
      ],
      "title": "NozzleQualificationEvidence",
      "type": "object"
    },
    "NozzleQuantitySupport": {
