{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "weld_id": {
      "minLength": 1,
      "title": "Weld Id",
      "type": "string"
    },
    "joint_id": {
      "minLength": 1,
      "title": "Joint Id",
      "type": "string"
    },
    "wps_id": {
      "minLength": 1,
      "title": "Wps Id",
      "type": "string"
    },
    "wps_revision": {
      "minLength": 1,
      "title": "Wps Revision",
      "type": "string"
    },
    "welder_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Welder Ids",
      "type": "array"
    },
    "consumable_lot_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Consumable Lot Ids",
      "type": "array"
    },
    "base_material_heat_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Base Material Heat Ids",
      "type": "array"
    },
    "identity_reviewed": {
      "title": "Identity Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "weld_id",
    "joint_id",
    "wps_id",
    "wps_revision",
    "welder_ids",
    "consumable_lot_ids",
    "base_material_heat_ids",
    "identity_reviewed",
    "evidence"
  ],
  "title": "ProductionWeldIdentity",
  "type": "object"
}