{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ScaleDiffusionReactionInterval": {
      "additionalProperties": false,
      "properties": {
        "interval_id": {
          "minLength": 1,
          "title": "Interval Id",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "effective_diffusivity_m2_s": {
          "exclusiveMinimum": 0,
          "title": "Effective Diffusivity M2 S",
          "type": "number"
        },
        "interface_transfer_coefficient_m_s": {
          "exclusiveMinimum": 0,
          "title": "Interface Transfer Coefficient M S",
          "type": "number"
        },
        "signed_reservoir_driving_concentration_mol_m3": {
          "title": "Signed Reservoir Driving Concentration Mol M3",
          "type": "number"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        }
      },
      "required": [
        "interval_id",
        "start_time_s",
        "end_time_s",
        "effective_diffusivity_m2_s",
        "interface_transfer_coefficient_m_s",
        "signed_reservoir_driving_concentration_mol_m3",
        "temperature_K"
      ],
      "title": "ScaleDiffusionReactionInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "scale_phase_id": {
      "minLength": 1,
      "title": "Scale Phase Id",
      "type": "string"
    },
    "transported_species_id": {
      "minLength": 1,
      "title": "Transported Species Id",
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_revision": {
      "minLength": 1,
      "title": "Provider Revision",
      "type": "string"
    },
    "configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Configuration Sha256",
      "type": "string"
    },
    "initial_thickness_m": {
      "minimum": 0,
      "title": "Initial Thickness M",
      "type": "number"
    },
    "scale_molar_volume_m3_mol": {
      "exclusiveMinimum": 0,
      "title": "Scale Molar Volume M3 Mol",
      "type": "number"
    },
    "temperature_support_min_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature Support Min K",
      "type": "number"
    },
    "temperature_support_max_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature Support Max K",
      "type": "number"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/ScaleDiffusionReactionInterval"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "fixed_planar_area_dense_single_phase_reviewed": {
      "title": "Fixed Planar Area Dense Single Phase Reviewed",
      "type": "boolean"
    },
    "quasi_steady_series_resistance_and_reservoir_reviewed": {
      "title": "Quasi Steady Series Resistance And Reservoir Reviewed",
      "type": "boolean"
    },
    "signed_driving_force_and_one_to_one_molar_balance_reviewed": {
      "title": "Signed Driving Force And One To One Molar Balance Reviewed",
      "type": "boolean"
    },
    "interval_properties_and_temperature_support_reviewed": {
      "title": "Interval Properties And Temperature Support Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "physical_scope_id",
    "clock_id",
    "scale_phase_id",
    "transported_species_id",
    "provider_id",
    "provider_revision",
    "configuration_sha256",
    "initial_thickness_m",
    "scale_molar_volume_m3_mol",
    "temperature_support_min_K",
    "temperature_support_max_K",
    "intervals",
    "fixed_planar_area_dense_single_phase_reviewed",
    "quasi_steady_series_resistance_and_reservoir_reviewed",
    "signed_driving_force_and_one_to_one_molar_balance_reviewed",
    "interval_properties_and_temperature_support_reviewed",
    "computational_use_authorized",
    "evidence"
  ],
  "title": "PlanarScaleDiffusionReactionHistory",
  "type": "object"
}