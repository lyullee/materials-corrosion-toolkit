          "minItems": 1,
          "title": "Supported Welding Process Ids",
          "type": "array"
        },
        "supported_consumable_condition_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Consumable Condition Ids",
          "type": "array"
        },
        "supported_hydrogen_control_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Hydrogen Control Descriptors",
          "type": "array"
        },
        "provider_metric_support": {
          "items": {
            "$ref": "#/$defs/HotTapProviderMetricSupport"
          },
          "minItems": 2,
          "title": "Provider Metric Support",
          "type": "array"
        },
        "qualification_evidence": {
          "items": {
            "$ref": "#/$defs/HotTapQualificationEvidence"
          },
          "minItems": 1,
          "title": "Qualification Evidence",
          "type": "array"
        },
        "minimum_qualification_source_group_count": {
          "minimum": 1,
          "title": "Minimum Qualification Source Group Count",
          "type": "integer"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "host_pipe_id",
        "host_material_condition_id",
        "pressure_basis",
        "minimum_operating_pressure_Pa",
        "maximum_operating_pressure_Pa",
        "minimum_operating_temperature_K",
        "maximum_operating_temperature_K",
        "minimum_wall_thickness_m",
        "maximum_wall_thickness_m",
        "supported_flow_heat_extraction_descriptors",
        "supported_branch_geometry_ids",
        "supported_joint_geometry_ids",
        "supported_welding_process_ids",
        "supported_consumable_condition_ids",
        "supported_hydrogen_control_descriptors",
        "provider_metric_support",
        "qualification_evidence",
        "minimum_qualification_source_group_count",
        "qualification_basis",
        "evidence"
      ],
      "title": "HotTapQualificationEnvelope",
      "type": "object"
    },
    "HotTapQualificationEvidence": {
      "additionalProperties": false,
