          "default": null,
          "title": "Invalid Or Limiting Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "evidence_record_id",
        "physical_specimen_id",
        "source_group_id",
        "partition",
        "supported_metric_ids",
        "method_id",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "result_digest",
        "expanded_uncertainty",
        "uncertainty_unit_token",
        "record_valid",
        "supports_declared_envelope",
        "evidence"
      ],
      "title": "HotTapQualificationEvidence",
      "type": "object"
    }
