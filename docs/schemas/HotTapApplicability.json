          "minLength": 1,
          "title": "Host Pipe Id",
          "type": "string"
        },
        "host_material_condition_id": {
          "minLength": 1,
          "title": "Host Material Condition Id",
          "type": "string"
        },
        "pressure_basis": {
          "minLength": 1,
          "title": "Pressure Basis",
          "type": "string"
        },
        "minimum_operating_pressure_Pa": {
          "minimum": 0,
          "title": "Minimum Operating Pressure Pa",
          "type": "number"
        },
        "maximum_operating_pressure_Pa": {
          "minimum": 0,
          "title": "Maximum Operating Pressure Pa",
          "type": "number"
        },
        "minimum_operating_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Operating Temperature K",
          "type": "number"
        },
        "maximum_operating_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Operating Temperature K",
          "type": "number"
        },
        "minimum_wall_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Minimum Wall Thickness M",
          "type": "number"
        },
        "maximum_wall_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Maximum Wall Thickness M",
          "type": "number"
        },
        "supported_flow_heat_extraction_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Flow Heat Extraction Descriptors",
          "type": "array"
        },
        "supported_branch_geometry_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Branch Geometry Ids",
          "type": "array"
