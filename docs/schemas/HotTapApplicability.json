{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "HotTapProviderMetricSupport": {
      "additionalProperties": false,
      "properties": {
        "result_kind": {
          "enum": [
            "thermal_or_burn_through_screen",
            "hydrogen_cracking_screen"
          ],
          "title": "Result Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_supported_value": {
          "title": "Minimum Supported Value",
          "type": "number"
        },
        "maximum_supported_value": {
          "title": "Maximum Supported Value",
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "support_basis": {
          "minLength": 1,
          "title": "Support Basis",
          "type": "string"
        }
      },
      "required": [
        "result_kind",
        "metric_id",
        "unit_token",
        "minimum_supported_value",
        "maximum_supported_value",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "support_basis"
      ],
      "title": "HotTapProviderMetricSupport",
      "type": "object"
    },
    "HotTapProviderResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "result_kind": {
          "enum": [
            "thermal_or_burn_through_screen",
            "hydrogen_cracking_screen"
          ],
          "title": "Result Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "reported_value": {
          "title": "Reported Value",
          "type": "number"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "result_kind",
        "metric_id",
        "metric_definition",
        "reported_value",
        "unit_token",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "provider_configuration_digest",
        "input_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "HotTapProviderResult",
      "type": "object"
    },
    "HotTapQualificationEnvelope": {
      "additionalProperties": false,
