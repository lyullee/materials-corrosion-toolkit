      },
      "maxItems": 4999,
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "supports": {
      "items": {
        "$ref": "#/$defs/CreviceComponentDiffusionSupport"
      },
      "minItems": 1,
      "title": "Supports",
