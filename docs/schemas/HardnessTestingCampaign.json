          "type": "string"
        },
        "scale_id": {
          "minLength": 1,
          "title": "Scale Id",
          "type": "string"
        },
        "certified_value": {
          "title": "Certified Value",
          "type": "number"
        },
        "certified_expanded_uncertainty": {
          "minimum": 0,
          "title": "Certified Expanded Uncertainty",
          "type": "number"
