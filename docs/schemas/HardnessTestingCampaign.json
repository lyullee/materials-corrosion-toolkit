          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "reference_block_id",
        "reference_block_condition_id",
        "scale_id",
        "certified_value",
        "certified_expanded_uncertainty",
        "hardness_unit_token",
        "certificate_id",
        "certificate_revision",
        "certificate_digest",
        "verification_status",
        "verification_record_digest",
        "evidence"
      ],
      "title": "HardnessReferenceBlockEvidence",
      "type": "object"
    },
