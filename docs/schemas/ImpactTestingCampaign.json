{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ImpactCampaignCallerProfile": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "minLength": 1,
          "title": "Profile Revision",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "heat_id": {
          "minLength": 1,
          "title": "Heat Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "orientation_id": {
          "minLength": 1,
          "title": "Orientation Id",
          "type": "string"
        },
        "notch_id": {
          "minLength": 1,
          "title": "Notch Id",
          "type": "string"
        },
        "size_id": {
          "minLength": 1,
          "title": "Size Id",
          "type": "string"
        },
        "specimen_dimension_unit_token": {
          "minLength": 1,
          "title": "Specimen Dimension Unit Token",
          "type": "string"
        },
        "minimum_test_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Test Temperature K",
          "type": "number"
        },
        "maximum_test_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Test Temperature K",
          "type": "number"
        },
        "required_metrics": {
          "items": {
            "enum": [
              "absorbed_energy",
              "lateral_expansion",
              "shear_fracture"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Metrics",
          "type": "array"
        },
        "metric_criteria": {
          "items": {
            "$ref": "#/$defs/ImpactMetricCriterion"
          },
          "minItems": 1,
          "title": "Metric Criteria",
          "type": "array"
        },
        "minimum_valid_replicates_per_exact_temperature": {
          "minimum": 1,
          "title": "Minimum Valid Replicates Per Exact Temperature",
          "type": "integer"
        },
        "minimum_independence_group_count": {
          "minimum": 1,
          "title": "Minimum Independence Group Count",
          "type": "integer"
        },
        "required_machine_id": {
          "minLength": 1,
          "title": "Required Machine Id",
          "type": "string"
        },
        "required_striker_id": {
          "minLength": 1,
          "title": "Required Striker Id",
          "type": "string"
        },
        "required_calibration_id": {
          "minLength": 1,
          "title": "Required Calibration Id",
          "type": "string"
        },
        "caller_validity_policy_id": {
          "minLength": 1,
          "title": "Caller Validity Policy Id",
          "type": "string"
        },
        "profile_source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Profile Source Digest",
          "type": "string"
        },
        "built_in_standard_criteria_used": {
          "const": false,
          "default": false,
          "title": "Built In Standard Criteria Used",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "profile_revision",
        "product_id",
        "heat_id",
        "material_condition_id",
        "orientation_id",
        "notch_id",
        "size_id",
        "specimen_dimension_unit_token",
        "minimum_test_temperature_K",
        "maximum_test_temperature_K",
        "required_metrics",
        "metric_criteria",
        "minimum_valid_replicates_per_exact_temperature",
        "minimum_independence_group_count",
        "required_machine_id",
        "required_striker_id",
        "required_calibration_id",
        "caller_validity_policy_id",
        "profile_source_digest",
        "evidence"
      ],
      "title": "ImpactCampaignCallerProfile",
      "type": "object"
    },
    "ImpactMachineConfiguration": {
      "additionalProperties": false,
      "properties": {
        "machine_id": {
          "minLength": 1,
          "title": "Machine Id",
          "type": "string"
        },
        "machine_revision": {
          "minLength": 1,
          "title": "Machine Revision",
          "type": "string"
        },
        "striker_id": {
          "minLength": 1,
          "title": "Striker Id",
          "type": "string"
        },
        "striker_definition": {
          "minLength": 1,
          "title": "Striker Definition",
          "type": "string"
        },
        "striker_radius": {
          "exclusiveMinimum": 0,
          "title": "Striker Radius",
          "type": "number"
        },
        "striker_radius_unit_token": {
          "minLength": 1,
          "title": "Striker Radius Unit Token",
          "type": "string"
        },
        "machine_capacity": {
          "exclusiveMinimum": 0,
          "title": "Machine Capacity",
          "type": "number"
        },
        "machine_capacity_unit_token": {
          "minLength": 1,
          "title": "Machine Capacity Unit Token",
          "type": "string"
        },
        "calibration_id": {
          "minLength": 1,
          "title": "Calibration Id",
          "type": "string"
        },
        "calibration_revision": {
          "minLength": 1,
          "title": "Calibration Revision",
          "type": "string"
        },
        "calibration_status": {
          "enum": [
            "valid",
            "invalid",
            "missing"
          ],
          "title": "Calibration Status",
          "type": "string"
        },
        "calibration_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Record Digest",
          "type": "string"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "machine_id",
        "machine_revision",
        "striker_id",
        "striker_definition",
        "striker_radius",
        "striker_radius_unit_token",
        "machine_capacity",
        "machine_capacity_unit_token",
        "calibration_id",
        "calibration_revision",
        "calibration_status",
        "calibration_record_digest",
        "evidence"
      ],
      "title": "ImpactMachineConfiguration",
      "type": "object"
    },
    "ImpactMetricCriterion": {
      "additionalProperties": false,
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "metric": {
          "enum": [
            "absorbed_energy",
            "lateral_expansion",
            "shear_fracture"
          ],
          "title": "Metric",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "minimum_acceptable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Acceptable"
        },
        "maximum_acceptable": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Acceptable"
        },
        "criterion_basis": {
          "minLength": 1,
          "title": "Criterion Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "criterion_id",
        "metric",
        "unit_token",
        "criterion_basis",
        "evidence"
      ],
      "title": "ImpactMetricCriterion",
      "type": "object"
    },
    "ImpactReportedResult": {
      "additionalProperties": false,
      "properties": {
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "metric": {
          "enum": [
            "absorbed_energy",
            "lateral_expansion",
            "shear_fracture"
          ],
          "title": "Metric",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "status": {
          "enum": [
            "reported",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "result_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Record Digest",
          "type": "string"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "result_id",
        "metric",
        "metric_definition",
        "status",
        "unit_token",
        "result_record_digest",
        "evidence"
      ],
      "title": "ImpactReportedResult",
      "type": "object"
    },
    "ImpactSpecimenIdentity": {
      "additionalProperties": false,
      "properties": {
        "specimen_id": {
          "minLength": 1,
          "title": "Specimen Id",
          "type": "string"
        },
        "product_id": {
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "heat_id": {
          "minLength": 1,
          "title": "Heat Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "orientation_id": {
          "minLength": 1,
          "title": "Orientation Id",
          "type": "string"
        },
        "notch_id": {
          "minLength": 1,
          "title": "Notch Id",
          "type": "string"
        },
        "notch_definition": {
          "minLength": 1,
          "title": "Notch Definition",
          "type": "string"
        },
        "size_id": {
          "minLength": 1,
          "title": "Size Id",
          "type": "string"
        },
        "thickness": {
          "exclusiveMinimum": 0,
          "title": "Thickness",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "number"
        },
        "length": {
          "exclusiveMinimum": 0,
          "title": "Length",
          "type": "number"
        },
        "dimension_unit_token": {
          "minLength": 1,
          "title": "Dimension Unit Token",
          "type": "string"
        },
        "specimen_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Specimen Record Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "specimen_id",
        "product_id",
        "heat_id",
        "material_condition_id",
        "orientation_id",
        "notch_id",
        "notch_definition",
        "size_id",
        "thickness",
        "width",
        "length",
        "dimension_unit_token",
        "specimen_record_digest",
        "evidence"
      ],
      "title": "ImpactSpecimenIdentity",
      "type": "object"
    },
    "ImpactTestRecord": {
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        },
        "specimen_id": {
          "minLength": 1,
          "title": "Specimen Id",
          "type": "string"
        },
        "test_temperature": {
          "exclusiveMinimum": 0,
          "title": "Test Temperature",
          "type": "number"
        },
        "expanded_temperature_uncertainty": {
          "minimum": 0,
          "title": "Expanded Temperature Uncertainty",
          "type": "number"
        },
        "temperature_unit_token": {
          "const": "K",
          "default": "K",
          "title": "Temperature Unit Token",
          "type": "string"
        },
        "replicate_group_id": {
          "minLength": 1,
          "title": "Replicate Group Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "independence_group_id": {
          "minLength": 1,
          "title": "Independence Group Id",
          "type": "string"
        },
        "sequence_index": {
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/ImpactReportedResult"
          },
          "minItems": 1,
          "title": "Results",
          "type": "array"
        },
        "caller_validity_status": {
          "enum": [
            "valid",
            "invalid",
            "unknown"
          ],
          "title": "Caller Validity Status",
          "type": "string"
        },
        "caller_validity_basis": {
          "minLength": 1,
          "title": "Caller Validity Basis",
          "type": "string"
        },
        "test_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Test Record Digest",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "test_id",
        "specimen_id",
        "test_temperature",
        "expanded_temperature_uncertainty",
        "replicate_group_id",
        "source_group_id",
        "independence_group_id",
        "sequence_index",
        "results",
        "caller_validity_status",
        "caller_validity_basis",
        "test_record_digest",
        "evidence"
      ],
      "title": "ImpactTestRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "specimens": {
      "items": {
        "$ref": "#/$defs/ImpactSpecimenIdentity"
      },
      "minItems": 1,
      "title": "Specimens",
      "type": "array"
    },
    "machine": {
      "$ref": "#/$defs/ImpactMachineConfiguration"
    },
    "tests": {
      "items": {
        "$ref": "#/$defs/ImpactTestRecord"
      },
      "minItems": 1,
      "title": "Tests",
      "type": "array"
    },
    "caller_profile": {
      "$ref": "#/$defs/ImpactCampaignCallerProfile"
    },
    "specimen_product_heat_orientation_notch_and_size_reviewed": {
      "title": "Specimen Product Heat Orientation Notch And Size Reviewed",
      "type": "boolean"
    },
    "temperature_results_units_and_uncertainties_reviewed": {
      "title": "Temperature Results Units And Uncertainties Reviewed",
      "type": "boolean"
    },
    "machine_striker_and_calibration_reviewed": {
      "title": "Machine Striker And Calibration Reviewed",
      "type": "boolean"
    },
    "replicate_source_and_independence_groups_reviewed": {
      "title": "Replicate Source And Independence Groups Reviewed",
      "type": "boolean"
    },
    "caller_validity_flags_and_profile_reviewed": {
      "title": "Caller Validity Flags And Profile Reviewed",
      "type": "boolean"
    },
    "provenance_and_record_digests_reviewed": {
      "title": "Provenance And Record Digests Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "campaign_id",
    "specimens",
    "machine",
    "tests",
    "caller_profile",
    "specimen_product_heat_orientation_notch_and_size_reviewed",
    "temperature_results_units_and_uncertainties_reviewed",
    "machine_striker_and_calibration_reviewed",
    "replicate_source_and_independence_groups_reviewed",
    "caller_validity_flags_and_profile_reviewed",
    "provenance_and_record_digests_reviewed",
    "evidence"
  ],
  "title": "ImpactTestingCampaign",
  "type": "object"
}