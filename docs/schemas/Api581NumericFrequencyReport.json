{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.api581_numeric_frequency_report.v1",
      "default": "matintegrity.api581_numeric_frequency_report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "exchange_id": {
      "title": "Exchange Id",
      "type": "string"
    },
    "api581_commit": {
      "pattern": "^[a-f0-9]{40}$",
      "title": "Api581 Commit",
      "type": "string"
    },
    "adjusted_calculation_id": {
      "const": "frequency/adjusted",
      "title": "Adjusted Calculation Id",
      "type": "string"
    },
    "probability_calculation_id": {
      "const": "reliability/poisson-probability",
      "title": "Probability Calculation Id",
      "type": "string"
    },
    "total_damage_factor": {
      "minimum": 0,
      "title": "Total Damage Factor",
      "type": "number"
    },
    "annual_failure_frequency_per_year": {
      "minimum": 0,
      "title": "Annual Failure Frequency Per Year",
      "type": "number"
    },
    "duration_years": {
      "minimum": 0,
      "title": "Duration Years",
      "type": "number"
    },
    "period_failure_probability": {
      "maximum": 1,
      "minimum": 0,
      "title": "Period Failure Probability",
      "type": "number"
    },
    "probability_semantics": {
      "const": "conditional_first_failure_in_period",
      "title": "Probability Semantics",
      "type": "string"
    },
    "adjusted_receipt_input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Adjusted Receipt Input Hash",
      "type": "string"
    },
    "probability_receipt_input_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Probability Receipt Input Hash",
      "type": "string"
    },
    "engine_code_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Engine Code Fingerprint",
      "type": "string"
    },
    "settings_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Settings Digest",
      "type": "string"
    },
    "report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Digest",
      "type": "string"
    },
    "numeric_pof_provider_executed": {
      "const": true,
      "default": true,
      "title": "Numeric Pof Provider Executed",
      "type": "boolean"
    },
    "physical_validation_claimed": {
      "const": false,
      "default": false,
      "title": "Physical Validation Claimed",
      "type": "boolean"
    },
    "engineering_qualification_claimed": {
      "const": false,
      "default": false,
      "title": "Engineering Qualification Claimed",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "exchange_id",
    "api581_commit",
    "adjusted_calculation_id",
    "probability_calculation_id",
    "total_damage_factor",
    "annual_failure_frequency_per_year",
    "duration_years",
    "period_failure_probability",
    "probability_semantics",
    "adjusted_receipt_input_hash",
    "probability_receipt_input_hash",
    "engine_code_fingerprint",
    "settings_digest",
    "report_digest",
    "limitations"
  ],
  "title": "Api581NumericFrequencyReport",
  "type": "object"
}