{
  "additionalProperties": false,
  "description": "Exact crosswalk from a compilation row to the licensed simulation workbook.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.wet_co2_simulation_source_match.v1",
      "default": "matintegrity.wet_co2_simulation_source_match.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "compilation_dataset_id": {
      "const": "heterogeneous-wet-co2-corrosion",
      "default": "heterogeneous-wet-co2-corrosion",
      "title": "Compilation Dataset Id",
      "type": "string"
    },
    "compilation_provider_source_row": {
      "minimum": 2,
      "title": "Compilation Provider Source Row",
      "type": "integer"
    },
    "compilation_observation_id": {
      "minLength": 1,
      "title": "Compilation Observation Id",
      "type": "string"
    },
    "compilation_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Compilation Sha256",
      "type": "string"
    },
    "source_dataset_id": {
      "const": "norsok-m506-simulation-grid",
      "default": "norsok-m506-simulation-grid",
      "title": "Source Dataset Id",
      "type": "string"
    },
    "source_dataset_doi": {
      "const": "10.17632/4nydhxjymw.1",
      "default": "10.17632/4nydhxjymw.1",
      "title": "Source Dataset Doi",
      "type": "string"
    },
    "source_provider_row": {
      "minimum": 2,
      "title": "Source Provider Row",
      "type": "integer"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "source_license": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "Source License",
      "type": "string"
    },
    "source_group_id": {
      "const": "doi:10.17632/4nydhxjymw.1",
      "default": "doi:10.17632/4nydhxjymw.1",
      "title": "Source Group Id",
      "type": "string"
    },
    "match_basis": {
      "const": "exact_position_header_and_eight_numeric_values",
      "default": "exact_position_header_and_eight_numeric_values",
      "title": "Match Basis",
      "type": "string"
    },
    "provider_data_type": {
      "const": "simulated_model_output",
      "default": "simulated_model_output",
      "title": "Provider Data Type",
      "type": "string"
    },
    "generator_basis": {
      "const": "provider_reported_norsok_m506_monte_carlo",
      "default": "provider_reported_norsok_m506_monte_carlo",
      "title": "Generator Basis",
      "type": "string"
    },
    "physical_specimen_id": {
      "default": null,
      "title": "Physical Specimen Id",
      "type": "null"
    },
    "independent_physical_observation": {
      "const": false,
      "default": false,
      "title": "Independent Physical Observation",
      "type": "boolean"
    },
    "physical_corrosion_calibration_ready": {
      "const": false,
      "default": false,
      "title": "Physical Corrosion Calibration Ready",
      "type": "boolean"
    },
    "public_surrogate_release_review_required": {
      "const": true,
      "default": true,
      "title": "Public Surrogate Release Review Required",
      "type": "boolean"
    }
  },
  "required": [
    "compilation_provider_source_row",
    "compilation_observation_id",
    "compilation_sha256",
    "source_provider_row",
    "source_sha256"
  ],
  "title": "WetCo2SimulationSourceMatch",
  "type": "object"
}