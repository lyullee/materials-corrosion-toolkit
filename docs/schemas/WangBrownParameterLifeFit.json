{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Fit and apply a same-condition power law to independent failure tests.",
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "parameter_result": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "parameter_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Parameter Result Sha256",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "calibration_id": {
      "minLength": 1,
      "title": "Calibration Id",
      "type": "string"
    },
    "calibration_source_id": {
      "const": "caller_wang_brown_parameter_constant_amplitude_life_data",
      "title": "Calibration Source Id",
      "type": "string"
    },
    "calibration_source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Source Sha256",
      "type": "string"
    },
    "calibration_evidence": {
      "$ref": "#/$defs/Evidence"
    },
    "calibration_license_id": {
      "minLength": 1,
      "title": "Calibration License Id",
      "type": "string"
    },
    "calibration_condition_descriptor_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Condition Descriptor Sha256",
      "type": "string"
    },
    "parameter_definition_id": {
      "const": "wang_brown_finite_reviewed_shear_reversal_plus_normal_excursion.v1",
      "title": "Parameter Definition Id",
      "type": "string"
    },
    "calibration_parameter_values": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 10000,
      "minItems": 3,
      "title": "Calibration Parameter Values",
      "type": "array"
    },
    "observed_cycles_to_failure": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 10000,
      "minItems": 3,
      "title": "Observed Cycles To Failure",
      "type": "array"
    },
    "calibration_material_test_scope_reviewed": {
      "title": "Calibration Material Test Scope Reviewed",
      "type": "boolean"
    },
    "calibration_rights_and_computational_use_reviewed": {
      "title": "Calibration Rights And Computational Use Reviewed",
      "type": "boolean"
    },
    "fit_and_prediction_scope_reviewed": {
      "title": "Fit And Prediction Scope Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_id",
    "parameter_result",
    "parameter_result_sha256",
    "material_condition_id",
    "calibration_id",
    "calibration_source_id",
    "calibration_source_sha256",
    "calibration_evidence",
    "calibration_license_id",
    "calibration_condition_descriptor_sha256",
    "parameter_definition_id",
    "calibration_parameter_values",
    "observed_cycles_to_failure",
    "calibration_material_test_scope_reviewed",
    "calibration_rights_and_computational_use_reviewed",
    "fit_and_prediction_scope_reviewed"
  ],
  "title": "WangBrownParameterLifeFit",
  "type": "object"
}