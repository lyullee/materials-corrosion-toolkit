{
  "$defs": {
    "PinnedExternalSourceTerm": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "scenario_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "operating_case_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Operating Case Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "api581",
            "prism",
            "user_supplied"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "source_code_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Code Digest",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "phase": {
          "enum": [
            "vapour",
            "liquid",
            "two_phase"
          ],
          "title": "Phase",
          "type": "string"
        },
        "mass_rate_kg_s": {
          "minimum": 0,
          "title": "Mass Rate Kg S",
          "type": "number"
        },
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "released_mass_kg": {
          "minimum": 0,
          "title": "Released Mass Kg",
          "type": "number"
        },
        "history_basis": {
          "const": "constant_rate",
          "default": "constant_rate",
          "title": "History Basis",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "scenario_id",
        "operating_case_id",
        "origin",
        "source_digest",
        "source_code_digest",
        "evidence_ids",
        "phase",
        "mass_rate_kg_s",
        "duration_s",
        "released_mass_kg"
      ],
      "title": "PinnedExternalSourceTerm",
      "type": "object"
    },
    "PinnedProviderEvidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "public_reference",
            "synthetic",
            "user_supplied"
          ],
          "title": "Kind",
          "type": "string"
        },
        "citation": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "locator": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "id",
        "kind",
        "citation",
        "locator"
      ],
      "title": "PinnedProviderEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operating_case_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Operating Case Id",
      "type": "string"
    },
    "context_mode": {
      "enum": [
        "synthetic",
        "engineering_review_required"
      ],
      "title": "Context Mode",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PinnedProviderEvidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/PinnedExternalSourceTerm"
    },
    "engine": {
      "enum": [
        "api581",
        "prism",
        "user_supplied"
      ],
      "title": "Engine",
      "type": "string"
    },
    "model_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "expected_engine_code_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Engine Code Digest",
      "type": "string"
    },
    "receptor_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Receptor Id",
      "type": "string"
    },
    "distance_m": {
      "exclusiveMinimum": 0,
      "title": "Distance M",
      "type": "number"
    },
    "quantity": {
      "enum": [
        "concentration_kg_m3",
        "heat_flux_w_m2",
        "overpressure_pa"
      ],
      "title": "Quantity",
      "type": "string"
    },
    "provider_settings": {
      "additionalProperties": true,
      "title": "Provider Settings",
      "type": "object"
    }
  },
  "required": [
    "operating_case_id",
    "context_mode",
    "source",
    "engine",
    "model_id",
    "expected_engine_code_digest",
    "receptor_id",
    "distance_m",
    "quantity"
  ],
  "title": "PinnedProviderRequestOptions",
  "type": "object"
}