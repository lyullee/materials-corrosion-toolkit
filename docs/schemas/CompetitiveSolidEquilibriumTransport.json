        "temperature_parameter_and_standard_state_reviewed": {
          "title": "Temperature Parameter And Standard State Reviewed",
          "type": "boolean"
        },
        "complete_species_parameter_set_and_applicability_reviewed": {
          "title": "Complete Species Parameter Set And Applicability Reviewed",
          "type": "boolean"
        },
        "competing_solid_bdot_applicability_reviewed": {
          "title": "Competing Solid Bdot Applicability Reviewed",
          "type": "boolean"
        },
        "charge_scope_and_solver_settings_reviewed": {
          "title": "Charge Scope And Solver Settings Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "equilibrium",
        "water_mass_per_solution_volume_kg_L",
        "debye_huckel_A_at_temperature",
        "debye_huckel_B_at_temperature_sqrt_kg_mol_per_angstrom",
        "parameter_temperature_K",
        "provider_id",
        "provider_revision",
        "configuration_sha256",
        "parameter_record_sha256",
        "species_parameters",
        "evidence",
        "maximum_supported_ionic_strength_mol_kg",
        "charge_balance_tolerance_mol_kg",
        "water_mass_conversion_reviewed",
        "temperature_parameter_and_standard_state_reviewed",
        "complete_species_parameter_set_and_applicability_reviewed",
        "competing_solid_bdot_applicability_reviewed",
        "charge_scope_and_solver_settings_reviewed"
