        },
        "maximum_outer_iterations": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maximum Outer Iterations",
          "type": "integer"
        },
        "log_gamma_tolerance": {
          "default": 1e-09,
          "exclusiveMinimum": 0,
          "maximum": 0.001,
          "title": "Log Gamma Tolerance",
          "type": "number"
        },
        "damping_fraction": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 1.0,
          "title": "Damping Fraction",
          "type": "number"
        },
        "water_mass_conversion_reviewed": {
          "title": "Water Mass Conversion Reviewed",
