{
  "$defs": {
    "BdotSpeciesParameter": {
      "additionalProperties": false,
      "description": "Caller-owned species parameters for the extended Debye-Huckel B-dot form.",
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "ion_size_angstrom": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Ion Size Angstrom",
          "type": "number"
        },
        "bdot_kg_per_mol": {
          "title": "Bdot Kg Per Mol",
          "type": "number"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "source_record_id": {
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "source_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "species_id",
        "ion_size_angstrom",
        "bdot_kg_per_mol",
        "source_id",
        "source_record_id",
        "source_record_sha256"
      ],
      "title": "BdotSpeciesParameter",
      "type": "object"
    },
    "CompetitiveAqueousSpecies": {
      "additionalProperties": false,
