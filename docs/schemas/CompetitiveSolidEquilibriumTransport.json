          {
            "$ref": "#/$defs/CompetitiveSolidSITIteration"
          },
          {
            "$ref": "#/$defs/CompetitiveSolidBdotIteration"
          }
        ]
      },
      "minItems": 2,
      "title": "Initial Cell Equilibria",
      "type": "array"
    },
    "uniform_temperature_K": {
