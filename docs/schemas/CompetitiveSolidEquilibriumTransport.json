      "title": "Uniform Temperature K",
      "type": "number"
    },
    "transport_activity_adapter_configuration_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
