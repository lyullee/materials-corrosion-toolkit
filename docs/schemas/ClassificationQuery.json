    "SpecificationDesignation": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "designation": {
          "minLength": 1,
          "title": "Designation",
          "type": "string"
        },
        "edition": {
          "minLength": 1,
          "title": "Edition",
          "type": "string"
        },
        "product_form": {
          "minLength": 1,
          "title": "Product Form",
          "type": "string"
        },
        "condition": {
          "minLength": 1,
          "title": "Condition",
          "type": "string"
        }
