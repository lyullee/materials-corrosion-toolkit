{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "zone_id": {
      "minLength": 1,
      "title": "Zone Id",
      "type": "string"
    },
    "component_or_circuit_id": {
      "minLength": 1,
      "title": "Component Or Circuit Id",
      "type": "string"
    },
    "physical_scope_definition": {
      "minLength": 1,
      "title": "Physical Scope Definition",
      "type": "string"
    },
    "coordinate_frame_id": {
      "minLength": 1,
      "title": "Coordinate Frame Id",
      "type": "string"
    },
    "substrate_material_id": {
      "minLength": 1,
      "title": "Substrate Material Id",
      "type": "string"
    },
    "substrate_material_condition_id": {
      "minLength": 1,
      "title": "Substrate Material Condition Id",
      "type": "string"
    },
    "service_id": {
      "minLength": 1,
      "title": "Service Id",
      "type": "string"
    },
    "service_medium_definition": {
      "minLength": 1,
      "title": "Service Medium Definition",
      "type": "string"
    },
    "minimum_service_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Service Temperature K",
      "type": "number"
    },
    "maximum_service_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Service Temperature K",
      "type": "number"
    },
    "insulation_system_id": {
      "minLength": 1,
      "title": "Insulation System Id",
      "type": "string"
    },
    "insulation_material_id": {
      "minLength": 1,
      "title": "Insulation Material Id",
      "type": "string"
    },
    "insulation_condition_id": {
      "minLength": 1,
      "title": "Insulation Condition Id",
      "type": "string"
    },
    "jacketing_system_id": {
      "minLength": 1,
      "title": "Jacketing System Id",
      "type": "string"
    },
    "jacketing_condition_id": {
      "minLength": 1,
      "title": "Jacketing Condition Id",
      "type": "string"
    },
    "coating_system_id": {
      "minLength": 1,
      "title": "Coating System Id",
      "type": "string"
    },
    "coating_condition_id": {
      "minLength": 1,
      "title": "Coating Condition Id",
      "type": "string"
    },
    "external_environment_id": {
      "minLength": 1,
      "title": "External Environment Id",
      "type": "string"
    },
    "external_environment_definition": {
      "minLength": 1,
      "title": "External Environment Definition",
      "type": "string"
    },
    "scope_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scope Configuration Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "zone_id",
    "component_or_circuit_id",
    "physical_scope_definition",
    "coordinate_frame_id",
    "substrate_material_id",
    "substrate_material_condition_id",
    "service_id",
    "service_medium_definition",
    "minimum_service_temperature_K",
    "maximum_service_temperature_K",
    "insulation_system_id",
    "insulation_material_id",
    "insulation_condition_id",
    "jacketing_system_id",
    "jacketing_condition_id",
    "coating_system_id",
    "coating_condition_id",
    "external_environment_id",
    "external_environment_definition",
    "scope_configuration_digest",
    "evidence"
  ],
  "title": "CUIScopeIdentity",
  "type": "object"
}