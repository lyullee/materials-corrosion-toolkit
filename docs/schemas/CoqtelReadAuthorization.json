{
  "additionalProperties": false,
  "description": "Caller attribution and local-use declaration for row-level access.",
  "properties": {
    "dataset_id": {
      "const": "coqtel",
      "default": "coqtel",
      "title": "Dataset Id",
      "type": "string"
    },
    "article_doi": {
      "const": "10.1016/j.dib.2025.111393",
      "default": "10.1016/j.dib.2025.111393",
      "title": "Article Doi",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "computational_use_authorized": {
      "const": true,
      "title": "Computational Use Authorized",
      "type": "boolean"
    },
    "local_only_authorized": {
      "const": true,
      "title": "Local Only Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "attribution",
    "computational_use_authorized",
    "local_only_authorized"
  ],
  "title": "CoqtelReadAuthorization",
  "type": "object"
}