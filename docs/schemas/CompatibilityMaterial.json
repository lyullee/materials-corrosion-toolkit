{
  "$defs": {
    "CompatibilityFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "minLength": 1,
          "title": "Fact Id",
          "type": "string"
        },
        "subject_id": {
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "fact_kind": {
          "enum": [
            "chemistry",
            "property",
            "dilution",
            "service_environment"
          ],
          "title": "Fact Kind",
          "type": "string"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "metric_definition": {
          "minLength": 1,
          "title": "Metric Definition",
          "type": "string"
        },
        "unit_token": {
          "minLength": 1,
          "title": "Unit Token",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "standard_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Uncertainty"
        },
        "missing_or_invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Or Invalid Basis"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Digest"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "fact_id",
        "subject_id",
        "fact_kind",
        "metric_id",
        "metric_definition",
        "unit_token",
        "status",
        "provider_id",
        "provider_revision",
        "evidence"
      ],
      "title": "CompatibilityFact",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "material_subject_id": {
      "minLength": 1,
      "title": "Material Subject Id",
      "type": "string"
    },
    "material_role": {
      "enum": [
        "base_a",
        "base_b",
        "filler",
        "buttering",
        "overlay",
        "dilution_layer"
      ],
      "title": "Material Role",
      "type": "string"
    },
    "material_id": {
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "material_lot_id": {
      "minLength": 1,
      "title": "Material Lot Id",
      "type": "string"
    },
    "consumable_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Consumable Id"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/CompatibilityFact"
      },
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "identity_reviewed": {
      "title": "Identity Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "material_subject_id",
    "material_role",
    "material_id",
    "material_condition_id",
    "material_lot_id",
    "facts",
    "identity_reviewed",
    "evidence"
  ],
  "title": "CompatibilityMaterial",
  "type": "object"
}