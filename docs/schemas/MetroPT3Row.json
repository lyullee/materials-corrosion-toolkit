{
  "additionalProperties": false,
  "description": "One provider row with raw cells, parsed numeric channels and source lineage.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.metropt3_row.v1",
      "default": "matintegrity.metropt3_row.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "dataset_id": {
      "const": "metropt3",
      "default": "metropt3",
      "title": "Dataset Id",
      "type": "string"
    },
    "provider_record": {
      "const": "https://doi.org/10.24432/C5VW3R",
      "default": "https://doi.org/10.24432/C5VW3R",
      "title": "Provider Record",
      "type": "string"
    },
    "license_id": {
      "const": "CC-BY-4.0",
      "default": "CC-BY-4.0",
      "title": "License Id",
      "type": "string"
    },
    "attribution": {
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Authorization Sha256",
      "type": "string"
    },
    "archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Archive Sha256",
      "type": "string"
    },
    "member_path": {
      "const": "MetroPT3(AirCompressor).csv",
      "default": "MetroPT3(AirCompressor).csv",
      "title": "Member Path",
      "type": "string"
    },
    "member_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Member Sha256",
      "type": "string"
    },
    "provider_row_number": {
      "minimum": 2,
      "title": "Provider Row Number",
      "type": "integer"
    },
    "provider_index": {
      "minimum": 0,
      "title": "Provider Index",
      "type": "integer"
    },
    "timestamp_text": {
      "minLength": 1,
      "title": "Timestamp Text",
      "type": "string"
    },
    "raw_signal_cells": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Raw Signal Cells",
      "type": "object"
    },
    "signal_values_provider_native": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Signal Values Provider Native",
      "type": "object"
    },
    "units_status": {
      "const": "provider_native_unresolved",
      "default": "provider_native_unresolved",
      "title": "Units Status",
      "type": "string"
    },
    "local_only": {
      "const": true,
      "default": true,
      "title": "Local Only",
      "type": "boolean"
    }
  },
  "required": [
    "attribution",
    "authorization_sha256",
    "archive_sha256",
    "member_sha256",
    "provider_row_number",
    "provider_index",
    "timestamp_text",
    "raw_signal_cells",
    "signal_values_provider_native"
  ],
  "title": "MetroPT3Row",
  "type": "object"
}