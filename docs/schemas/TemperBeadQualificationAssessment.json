        "interpass_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Interpass Temperature K",
          "type": "number"
        },
        "temper_bead_descriptor": {
          "minLength": 1,
          "title": "Temper Bead Descriptor",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
