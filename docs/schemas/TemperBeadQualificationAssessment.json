{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TemperBeadObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "observation_kind": {
          "enum": [
            "hardness",
            "microstructure",
            "nondestructive_examination"
          ],
          "title": "Observation Kind",
          "type": "string"
        },
        "physical_specimen_id": {
          "minLength": 1,
          "title": "Physical Specimen Id",
          "type": "string"
        },
        "source_group_id": {
          "minLength": 1,
          "title": "Source Group Id",
          "type": "string"
        },
        "physical_region_id": {
          "minLength": 1,
          "title": "Physical Region Id",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "result_definition": {
          "minLength": 1,
          "title": "Result Definition",
          "type": "string"
        },
        "reported_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Value"
        },
        "result_unit_token": {
          "minLength": 1,
          "title": "Result Unit Token",
          "type": "string"
        },
        "result_descriptor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Descriptor"
        },
        "expanded_uncertainty": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expanded Uncertainty"
        },
        "uncertainty_coverage_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty Coverage Factor"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "provider_state_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider State Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "observation_kind",
        "physical_specimen_id",
        "source_group_id",
        "physical_region_id",
        "method_id",
        "result_definition",
        "result_unit_token",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "TemperBeadObservation",
      "type": "object"
    },
    "TemperBeadObservationRequirement": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "minLength": 1,
          "title": "Requirement Id",
          "type": "string"
        },
        "observation_kind": {
          "enum": [
            "hardness",
            "microstructure",
            "nondestructive_examination"
          ],
          "title": "Observation Kind",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "result_definition": {
          "minLength": 1,
          "title": "Result Definition",
          "type": "string"
        },
        "result_unit_token": {
          "minLength": 1,
          "title": "Result Unit Token",
          "type": "string"
        },
        "supported_result_descriptors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supported Result Descriptors",
          "type": "array"
        },
        "minimum_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Value"
        },
        "maximum_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Value"
        },
        "requirement_basis": {
          "minLength": 1,
          "title": "Requirement Basis",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "observation_kind",
        "method_id",
        "result_definition",
        "result_unit_token",
        "requirement_basis"
      ],
      "title": "TemperBeadObservationRequirement",
      "type": "object"
    },
    "TemperBeadPassRecord": {
      "additionalProperties": false,
      "properties": {
        "pass_record_id": {
          "minLength": 1,
