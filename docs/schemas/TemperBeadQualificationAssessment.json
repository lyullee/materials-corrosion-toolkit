        "provider_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Provider Configuration Digest",
          "type": "string"
        },
        "input_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_missing_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Missing Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "pass_record_id",
        "sequence_position",
        "layer_id",
        "start_time_s",
        "end_time_s",
        "heat_input_value",
        "heat_input_unit_token",
        "interpass_temperature_K",
        "temper_bead_descriptor",
        "provider_id",
        "provider_revision",
        "provider_state_digest",
        "provider_configuration_digest",
        "input_digest",
        "result_digest",
        "record_valid",
        "evidence"
      ],
      "title": "TemperBeadPassRecord",
      "type": "object"
    },
