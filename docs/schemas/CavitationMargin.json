{
  "additionalProperties": false,
  "description": "Reviewed local liquid state for thermodynamic cavitation screening.",
  "properties": {
    "fluid_id": {
      "minLength": 1,
      "title": "Fluid Id",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "pressure_basis": {
      "const": "absolute",
      "default": "absolute",
      "title": "Pressure Basis",
      "type": "string"
    },
    "local_static_pressure_Pa": {
      "exclusiveMinimum": 0,
      "title": "Local Static Pressure Pa",
      "type": "number"
    },
    "vapor_pressure_Pa": {
      "exclusiveMinimum": 0,
      "title": "Vapor Pressure Pa",
      "type": "number"
    },
    "liquid_density_kg_m3": {
      "exclusiveMinimum": 0,
      "title": "Liquid Density Kg M3",
      "type": "number"
    },
    "characteristic_velocity_m_s": {
      "exclusiveMinimum": 0,
      "title": "Characteristic Velocity M S",
      "type": "number"
    },
    "property_provider_id": {
      "minLength": 1,
      "title": "Property Provider Id",
      "type": "string"
    },
    "property_provider_version": {
      "minLength": 1,
      "title": "Property Provider Version",
      "type": "string"
    },
    "property_state_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Property State Digest",
      "type": "string"
    },
    "local_pressure_definition": {
      "minLength": 1,
      "title": "Local Pressure Definition",
      "type": "string"
    },
    "velocity_definition": {
      "minLength": 1,
      "title": "Velocity Definition",
      "type": "string"
    },
    "absolute_pressure_reviewed": {
      "title": "Absolute Pressure Reviewed",
      "type": "boolean"
    },
    "thermodynamic_state_reviewed": {
      "title": "Thermodynamic State Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "fluid_id",
    "temperature_K",
    "local_static_pressure_Pa",
    "vapor_pressure_Pa",
    "liquid_density_kg_m3",
    "characteristic_velocity_m_s",
    "property_provider_id",
    "property_provider_version",
    "property_state_digest",
    "local_pressure_definition",
    "velocity_definition",
    "absolute_pressure_reviewed",
    "thermodynamic_state_reviewed"
  ],
  "title": "CavitationMargin",
  "type": "object"
}