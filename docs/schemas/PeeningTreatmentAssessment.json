          "minLength": 1,
          "title": "Intensity Metric Definition",
          "type": "string"
        },
        "intensity_unit_token": {
          "minLength": 1,
          "title": "Intensity Unit Token",
          "type": "string"
        },
        "minimum_intensity_value": {
          "minimum": 0,
          "title": "Minimum Intensity Value",
          "type": "number"
        },
        "maximum_intensity_value": {
          "minimum": 0,
          "title": "Maximum Intensity Value",
          "type": "number"
        },
        "coverage_metric_definition": {
          "minLength": 1,
          "title": "Coverage Metric Definition",
          "type": "string"
        },
        "coverage_unit_token": {
          "minLength": 1,
          "title": "Coverage Unit Token",
          "type": "string"
        },
        "minimum_coverage_value": {
          "minimum": 0,
          "title": "Minimum Coverage Value",
          "type": "number"
        },
        "maximum_coverage_value": {
          "minimum": 0,
          "title": "Maximum Coverage Value",
          "type": "number"
        },
        "stress_requirements": {
          "items": {
            "$ref": "#/$defs/PeeningStressRequirement"
          },
          "minItems": 1,
          "title": "Stress Requirements",
          "type": "array"
        },
        "minimum_physical_specimen_count": {
          "minimum": 1,
          "title": "Minimum Physical Specimen Count",
          "type": "integer"
        },
        "minimum_source_group_count": {
          "minimum": 1,
          "title": "Minimum Source Group Count",
          "type": "integer"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "material_condition_id",
        "supported_method_ids",
        "supported_media_condition_ids",
