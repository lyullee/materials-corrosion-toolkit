        "intensity_metric_definition",
        "intensity_unit_token",
        "minimum_intensity_value",
        "maximum_intensity_value",
        "coverage_metric_definition",
        "coverage_unit_token",
        "minimum_coverage_value",
        "maximum_coverage_value",
        "stress_requirements",
        "minimum_physical_specimen_count",
        "minimum_source_group_count",
        "qualification_basis",
        "evidence"
      ],
      "title": "DeclaredPeeningQualificationEnvelope",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
