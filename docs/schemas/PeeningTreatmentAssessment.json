{
  "$defs": {
    "DeclaredPeeningQualificationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "supported_method_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Method Ids",
          "type": "array"
        },
        "supported_media_condition_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Media Condition Ids",
          "type": "array"
        },
        "supported_direction_descriptors": {
