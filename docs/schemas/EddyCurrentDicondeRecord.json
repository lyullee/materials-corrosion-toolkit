{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.eddy_current_diconde_record.v1",
      "default": "matintegrity.eddy_current_diconde_record.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "physical_specimen_id": {
      "minLength": 1,
      "title": "Physical Specimen Id",
      "type": "string"
    },
    "source_role": {
      "enum": [
        "laboratory_observation",
        "simulation_output",
        "user_record"
      ],
      "title": "Source Role",
      "type": "string"
    },
    "source_filename": {
      "minLength": 1,
      "title": "Source Filename",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "source_bytes": {
      "exclusiveMinimum": 0,
      "title": "Source Bytes",
      "type": "integer"
    },
    "sop_class_uid": {
      "minLength": 1,
      "title": "Sop Class Uid",
      "type": "string"
    },
    "sop_instance_uid": {
      "minLength": 1,
      "title": "Sop Instance Uid",
      "type": "string"
    },
    "modality": {
      "const": "EC",
      "title": "Modality",
      "type": "string"
    },
    "acquisition_datetime_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquisition Datetime Token"
    },
    "series_description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Series Description"
    },
    "drive_type_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drive Type Token"
    },
    "excitation_frequency_Hz": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excitation Frequency Hz"
    },
    "rows": {
      "exclusiveMinimum": 0,
      "title": "Rows",
      "type": "integer"
    },
    "columns": {
      "exclusiveMinimum": 0,
      "title": "Columns",
      "type": "integer"
    },
    "frame_count": {
      "exclusiveMinimum": 0,
      "title": "Frame Count",
      "type": "integer"
    },
    "samples_per_pixel": {
      "exclusiveMinimum": 0,
      "title": "Samples Per Pixel",
      "type": "integer"
    },
    "bits_allocated": {
      "exclusiveMinimum": 0,
