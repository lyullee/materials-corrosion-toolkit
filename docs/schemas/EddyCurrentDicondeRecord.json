      "type": "integer"
    },
    "bits_stored": {
      "exclusiveMinimum": 0,
      "title": "Bits Stored",
      "type": "integer"
    },
    "pixel_representation": {
      "enum": [
        "unsigned_integer",
        "signed_integer"
