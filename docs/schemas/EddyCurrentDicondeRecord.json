      "type": "string"
    },
    "pixel_padding_value": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pixel Padding Value"
    },
    "component_order": {
      "items": {
        "type": "string"
      },
