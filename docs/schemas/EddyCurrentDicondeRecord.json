        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pixel Spacing Column M"
    },
    "physical_unit_code_x": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Unit Code X"
    },
    "physical_unit_code_y": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Unit Code Y"
    },
    "physical_delta_x_raw": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Delta X Raw"
    },
    "physical_delta_y_raw": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Delta Y Raw"
    },
    "physical_delta_x_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Delta X M"
    },
    "physical_delta_y_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Physical Delta Y M"
