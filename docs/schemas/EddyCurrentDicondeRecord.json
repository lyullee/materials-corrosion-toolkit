  "required": [
    "physical_specimen_id",
    "source_role",
    "source_filename",
    "source_sha256",
    "source_bytes",
    "sop_class_uid",
    "sop_instance_uid",
    "modality",
    "rows",
    "columns",
    "frame_count",
    "samples_per_pixel",
    "bits_allocated",
    "bits_stored",
    "pixel_representation",
    "component_order",
    "component_order_basis",
    "frame_view_name_tokens",
    "frame_rescale_slopes",
