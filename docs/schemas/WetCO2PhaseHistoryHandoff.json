{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "ElementalComponent": {
      "additionalProperties": false,
      "description": "Explicit elemental formula for one already-computed species/phase ID.",
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "phase": {
          "enum": [
            "aqueous_species",
            "solid_phase"
          ],
          "title": "Phase",
          "type": "string"
        },
        "atom_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Atom Counts",
          "type": "object"
        }
      },
      "required": [
        "component_id",
        "phase",
        "atom_counts"
      ],
      "title": "ElementalComponent",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Map a computed transport/phase output into element-resolved inventory receipts.\n\nConcentrations are read from the provider's output without recomputation. Cell\nsolution volumes and formulas are caller-supplied and digest-bound. The handoff\nreports inventory differences; it does not infer reaction extents or kinetics.",
  "properties": {
    "campaign_id": {
      "minLength": 1,
      "title": "Campaign Id",
      "type": "string"
    },
    "source_provider_id": {
      "minLength": 1,
      "title": "Source Provider Id",
      "type": "string"
    },
    "source_provider_revision": {
      "minLength": 1,
      "title": "Source Provider Revision",
      "type": "string"
    },
    "source_assessment_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssessmentResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_assessment_result_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Assessment Result Sha256"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "time_basis": {
      "minLength": 1,
      "title": "Time Basis",
      "type": "string"
    },
    "source_result_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Result Digest",
      "type": "string"
    },
    "source_values": {
      "additionalProperties": true,
      "title": "Source Values",
      "type": "object"
    },
    "cell_solution_volume_m3": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "minItems": 1,
      "title": "Cell Solution Volume M3",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ElementalComponent"
      },
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "formulas_and_cell_volume_basis_reviewed": {
      "title": "Formulas And Cell Volume Basis Reviewed",
      "type": "boolean"
    },
    "provider_species_and_phase_id_mapping_reviewed": {
      "title": "Provider Species And Phase Id Mapping Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "campaign_id",
    "source_provider_id",
    "source_provider_revision",
    "asset_id",
    "location_id",
    "time_basis",
    "source_result_digest",
    "source_values",
    "cell_solution_volume_m3",
    "components",
    "formulas_and_cell_volume_basis_reviewed",
    "provider_species_and_phase_id_mapping_reviewed"
  ],
  "title": "WetCO2PhaseHistoryHandoff",
  "type": "object"
}