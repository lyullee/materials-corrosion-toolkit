{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state_id": {
      "minLength": 1,
      "title": "State Id",
      "type": "string"
    },
    "temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Temperature K",
      "type": "number"
    },
    "expanded_temperature_uncertainty_K": {
      "minimum": 0,
      "title": "Expanded Temperature Uncertainty K",
      "type": "number"
    },
    "internal_pressure_Pa": {
      "minimum": 0,
      "title": "Internal Pressure Pa",
      "type": "number"
    },
    "external_pressure_Pa": {
      "minimum": 0,
      "title": "External Pressure Pa",
      "type": "number"
    },
    "expanded_pressure_uncertainty_Pa": {
      "minimum": 0,
      "title": "Expanded Pressure Uncertainty Pa",
      "type": "number"
    },
    "pressure_basis": {
      "minLength": 1,
      "title": "Pressure Basis",
      "type": "string"
    },
    "thermal_and_phase_state_descriptor": {
      "minLength": 1,
      "title": "Thermal And Phase State Descriptor",
      "type": "string"
    },
    "state_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "State Record Digest",
      "type": "string"
    },
    "record_valid": {
      "title": "Record Valid",
      "type": "boolean"
    },
    "invalid_or_missing_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invalid Or Missing Basis"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "state_id",
    "temperature_K",
    "expanded_temperature_uncertainty_K",
    "internal_pressure_Pa",
    "external_pressure_Pa",
    "expanded_pressure_uncertainty_Pa",
    "pressure_basis",
    "thermal_and_phase_state_descriptor",
    "state_record_digest",
    "record_valid",
    "evidence"
  ],
  "title": "LeakCampaignStateIdentity",
  "type": "object"
}