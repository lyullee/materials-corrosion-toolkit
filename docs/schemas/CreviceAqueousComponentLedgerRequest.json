{
  "$defs": {
    "AqueousActivitySpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "charge_number": {
          "maximum": 8,
          "minimum": -8,
          "title": "Charge Number",
          "type": "integer"
        },
        "activity_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Activity Coefficient",
          "type": "number"
        },
        "initial_activity": {
          "exclusiveMinimum": 0,
          "title": "Initial Activity",
          "type": "number"
        },
        "elemental_composition": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elemental Composition"
        }
      },
      "required": [
        "species_id",
        "charge_number",
        "activity_coefficient",
        "initial_activity"
      ],
      "title": "AqueousActivitySpecies",
      "type": "object"
    },
    "AqueousEquilibriumReaction": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "log10_equilibrium_constant": {
          "title": "Log10 Equilibrium Constant",
          "type": "number"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/AqueousStoichiometricTerm"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "reaction_id",
        "log10_equilibrium_constant",
        "terms"
      ],
      "title": "AqueousEquilibriumReaction",
      "type": "object"
    },
    "AqueousLinearConstraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "target_mol_L": {
          "title": "Target Mol L",
          "type": "number"
        },
        "residual_scale_mol_L": {
          "exclusiveMinimum": 0,
          "title": "Residual Scale Mol L",
          "type": "number"
        },
        "terms": {
          "items": {
            "$ref": "#/$defs/AqueousStoichiometricTerm"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "constraint_id",
        "target_mol_L",
        "residual_scale_mol_L",
        "terms"
      ],
      "title": "AqueousLinearConstraint",
      "type": "object"
    },
    "AqueousMassActionSystem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.aqueous_mass_action.v1",
          "default": "matintegrity.aqueous_mass_action.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "solution_id": {
          "minLength": 1,
          "title": "Solution Id",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "activity_standard_state": {
          "const": "molarity_1_mol_L",
          "title": "Activity Standard State",
          "type": "string"
        },
        "species": {
          "items": {
            "$ref": "#/$defs/AqueousActivitySpecies"
          },
          "maxItems": 100,
          "minItems": 2,
          "title": "Species",
          "type": "array"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/AqueousEquilibriumReaction"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Reactions",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/AqueousLinearConstraint"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Constraints",
          "type": "array"
        },
        "maximum_iterations": {
          "default": 100,
          "maximum": 1000,
          "minimum": 1,
          "title": "Maximum Iterations",
          "type": "integer"
        },
        "normalized_residual_tolerance": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "maximum": 0.0001,
          "title": "Normalized Residual Tolerance",
          "type": "number"
        },
        "maximum_jacobian_condition_number": {
          "default": 100000000000000.0,
          "exclusiveMinimum": 0,
          "maximum": 1e+16,
          "title": "Maximum Jacobian Condition Number",
          "type": "number"
        },
        "local_parameter_covariance": {
          "anyOf": [
            {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Parameter Covariance"
        },
        "local_parameter_covariance_reviewed": {
          "default": false,
          "title": "Local Parameter Covariance Reviewed",
          "type": "boolean"
        },
        "activity_provider_id": {
          "minLength": 1,
          "title": "Activity Provider Id",
          "type": "string"
        },
        "activity_provider_revision": {
          "minLength": 1,
          "title": "Activity Provider Revision",
          "type": "string"
        },
        "activity_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Activity Configuration Digest",
          "type": "string"
        },
        "activity_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Activity Record Digest",
          "type": "string"
        },
        "equilibrium_provider_id": {
          "minLength": 1,
          "title": "Equilibrium Provider Id",
          "type": "string"
        },
        "equilibrium_provider_revision": {
          "minLength": 1,
          "title": "Equilibrium Provider Revision",
          "type": "string"
        },
        "equilibrium_configuration_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Configuration Digest",
          "type": "string"
        },
        "equilibrium_record_digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Record Digest",
          "type": "string"
        },
        "complete_aqueous_species_inventory_reviewed": {
          "title": "Complete Aqueous Species Inventory Reviewed",
          "type": "boolean"
        },
        "reaction_stoichiometry_and_constant_reviewed": {
          "title": "Reaction Stoichiometry And Constant Reviewed",
          "type": "boolean"
        },
        "balance_constraints_and_charge_scope_reviewed": {
          "title": "Balance Constraints And Charge Scope Reviewed",
          "type": "boolean"
        },
        "fixed_activity_coefficients_and_standard_state_reviewed": {
          "title": "Fixed Activity Coefficients And Standard State Reviewed",
          "type": "boolean"
        },
        "temperature_and_provider_lineage_reviewed": {
          "title": "Temperature And Provider Lineage Reviewed",
          "type": "boolean"
        },
        "initial_activity_guess_and_solver_tolerance_reviewed": {
          "title": "Initial Activity Guess And Solver Tolerance Reviewed",
          "type": "boolean"
        },
        "single_liquid_phase_and_no_precipitation_reviewed": {
          "title": "Single Liquid Phase And No Precipitation Reviewed",
          "type": "boolean"
        },
        "elemental_formula_and_reaction_balance_reviewed": {
          "default": false,
          "title": "Elemental Formula And Reaction Balance Reviewed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assessment_id",
        "solution_id",
        "temperature_K",
        "activity_standard_state",
        "species",
        "reactions",
        "constraints",
        "activity_provider_id",
        "activity_provider_revision",
        "activity_configuration_digest",
        "activity_record_digest",
        "equilibrium_provider_id",
        "equilibrium_provider_revision",
        "equilibrium_configuration_digest",
        "equilibrium_record_digest",
        "complete_aqueous_species_inventory_reviewed",
        "reaction_stoichiometry_and_constant_reviewed",
        "balance_constraints_and_charge_scope_reviewed",
        "fixed_activity_coefficients_and_standard_state_reviewed",
        "temperature_and_provider_lineage_reviewed",
        "initial_activity_guess_and_solver_tolerance_reviewed",
        "single_liquid_phase_and_no_precipitation_reviewed",
        "evidence"
      ],
      "title": "AqueousMassActionSystem",
      "type": "object"
    },
    "AqueousStoichiometricTerm": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "coefficient"
      ],
      "title": "AqueousStoichiometricTerm",
      "type": "object"
    },
    "ComponentSpeciesCoefficient": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "coefficient": {
          "title": "Coefficient",
          "type": "number"
        }
      },
      "required": [
        "species_id",
        "coefficient"
      ],
      "title": "ComponentSpeciesCoefficient",
      "type": "object"
    },
    "ConservedAqueousComponent": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "species_coefficients": {
          "items": {
            "$ref": "#/$defs/ComponentSpeciesCoefficient"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Species Coefficients",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "species_coefficients"
      ],
      "title": "ConservedAqueousComponent",
      "type": "object"
    },
    "ConstraintRoleAssignment": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "title": "Constraint Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "conserved_component",
            "fixed_target",
            "charge_neutrality"
          ],
          "title": "Role",
          "type": "string"
        },
        "component_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component Id"
        }
      },
      "required": [
        "constraint_id",
        "role"
      ],
      "title": "ConstraintRoleAssignment",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "SpeciesCellAmount": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "amount_mol_by_cell": {
          "items": {
            "type": "number"
          },
          "maxItems": 300,
          "minItems": 1,
          "title": "Amount Mol By Cell",
          "type": "array"
        }
      },
      "required": [
        "species_id",
        "amount_mol_by_cell"
      ],
      "title": "SpeciesCellAmount",
      "type": "object"
    },
    "SpeciesFaceTransfer": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "transfer_mol_by_face": {
          "items": {
            "type": "number"
          },
          "maxItems": 301,
          "minItems": 2,
          "title": "Transfer Mol By Face",
          "type": "array"
        }
      },
      "required": [
        "species_id",
        "transfer_mol_by_face"
      ],
      "title": "SpeciesFaceTransfer",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.crevice_aqueous_component_ledger.v1",
      "default": "matintegrity.crevice_aqueous_component_ledger.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "aqueous_system": {
      "$ref": "#/$defs/AqueousMassActionSystem"
    },
    "cell_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 300,
      "minItems": 1,
      "title": "Cell Ids",
      "type": "array"
    },
    "duration_s": {
      "exclusiveMinimum": 0,
      "title": "Duration S",
      "type": "number"
    },
    "constraint_roles": {
      "items": {
        "$ref": "#/$defs/ConstraintRoleAssignment"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Constraint Roles",
      "type": "array"
    },
    "conserved_components": {
      "items": {
        "$ref": "#/$defs/ConservedAqueousComponent"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Conserved Components",
      "type": "array"
    },
    "species_inventory_start": {
      "items": {
        "$ref": "#/$defs/SpeciesCellAmount"
      },
      "maxItems": 100,
      "minItems": 2,
      "title": "Species Inventory Start",
      "type": "array"
    },
    "species_inventory_end": {
      "items": {
        "$ref": "#/$defs/SpeciesCellAmount"
      },
      "maxItems": 100,
      "minItems": 2,
      "title": "Species Inventory End",
      "type": "array"
    },
    "species_face_transfers": {
      "items": {
        "$ref": "#/$defs/SpeciesFaceTransfer"
      },
      "maxItems": 100,
      "minItems": 2,
      "title": "Species Face Transfers",
      "type": "array"
    },
    "species_source_transfers": {
      "items": {
        "$ref": "#/$defs/SpeciesCellAmount"
      },
      "maxItems": 100,
      "minItems": 2,
      "title": "Species Source Transfers",
      "type": "array"
    },
    "absolute_component_closure_tolerance_mol": {
      "exclusiveMinimum": 0,
      "title": "Absolute Component Closure Tolerance Mol",
      "type": "number"
    },
    "relative_component_closure_tolerance": {
      "default": 1e-08,
      "exclusiveMinimum": 0,
      "maximum": 0.01,
      "title": "Relative Component Closure Tolerance",
      "type": "number"
    },
    "maximum_projection_operations": {
      "default": 2000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Projection Operations",
      "type": "integer"
    },
    "role_map_and_charge_scope_reviewed": {
      "title": "Role Map And Charge Scope Reviewed",
      "type": "boolean"
    },
    "component_map_and_reaction_conservation_reviewed": {
      "title": "Component Map And Reaction Conservation Reviewed",
      "type": "boolean"
    },
    "finite_volume_face_orientation_and_source_sign_reviewed": {
      "title": "Finite Volume Face Orientation And Source Sign Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "aqueous_system",
    "cell_ids",
    "duration_s",
    "constraint_roles",
    "conserved_components",
    "species_inventory_start",
    "species_inventory_end",
    "species_face_transfers",
    "species_source_transfers",
    "absolute_component_closure_tolerance_mol",
    "role_map_and_charge_scope_reviewed",
    "component_map_and_reaction_conservation_reviewed",
    "finite_volume_face_orientation_and_source_sign_reviewed",
    "computational_use_authorized"
  ],
  "title": "CreviceAqueousComponentLedgerRequest",
  "type": "object"
}