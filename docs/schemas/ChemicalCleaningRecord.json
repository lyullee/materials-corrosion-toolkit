{
  "$defs": {
    "ChemicalCleaningStep": {
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "minLength": 1,
          "title": "Step Id",
          "type": "string"
        },
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "solution_id": {
          "minLength": 1,
          "title": "Solution Id",
          "type": "string"
        },
        "chemical_family": {
          "minLength": 1,
          "title": "Chemical Family",
          "type": "string"
        },
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "concentration_mass_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Concentration Mass Fraction",
          "type": "number"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "pH": {
          "maximum": 14,
          "minimum": 0,
          "title": "Ph",
          "type": "number"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "step_id",
        "envelope_id",
        "solution_id",
        "chemical_family",
        "start_time_s",
        "end_time_s",
        "concentration_mass_fraction",
        "temperature_K",
        "pH",
        "record_valid",
        "evidence"
      ],
      "title": "ChemicalCleaningStep",
      "type": "object"
    },
    "CleaningCompatibilityEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "material_condition_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Condition Id"
        },
        "solution_id": {
          "minLength": 1,
          "title": "Solution Id",
          "type": "string"
        },
        "chemical_family": {
          "minLength": 1,
          "title": "Chemical Family",
          "type": "string"
        },
        "minimum_concentration_mass_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Minimum Concentration Mass Fraction",
          "type": "number"
        },
        "maximum_concentration_mass_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Concentration Mass Fraction",
          "type": "number"
        },
        "minimum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "minimum_pH": {
          "maximum": 14,
          "minimum": 0,
          "title": "Minimum Ph",
          "type": "number"
        },
        "maximum_pH": {
          "maximum": 14,
          "minimum": 0,
          "title": "Maximum Ph",
          "type": "number"
        },
        "maximum_single_exposure_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Single Exposure S",
          "type": "number"
        },
        "maximum_cumulative_exposure_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Cumulative Exposure S",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "solution_id",
        "chemical_family",
        "minimum_concentration_mass_fraction",
        "maximum_concentration_mass_fraction",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "minimum_pH",
        "maximum_pH",
        "maximum_single_exposure_s",
        "maximum_cumulative_exposure_s",
        "evidence"
      ],
      "title": "CleaningCompatibilityEnvelope",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cleaning_record_id": {
      "minLength": 1,
      "title": "Cleaning Record Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "clock_id": {
      "minLength": 1,
      "title": "Clock Id",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/ChemicalCleaningStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "compatibility_envelopes": {
      "items": {
        "$ref": "#/$defs/CleaningCompatibilityEnvelope"
      },
      "minItems": 1,
      "title": "Compatibility Envelopes",
      "type": "array"
    },
    "record_completeness_reviewed": {
      "title": "Record Completeness Reviewed",
      "type": "boolean"
    },
    "sequence_and_clock_reviewed": {
      "title": "Sequence And Clock Reviewed",
      "type": "boolean"
    },
    "material_identity_reviewed": {
      "title": "Material Identity Reviewed",
      "type": "boolean"
    },
    "compatibility_envelopes_reviewed": {
      "title": "Compatibility Envelopes Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "cleaning_record_id",
    "asset_id",
    "location_id",
    "material_condition_id",
    "clock_id",
    "steps",
    "compatibility_envelopes",
    "record_completeness_reviewed",
    "sequence_and_clock_reviewed",
    "material_identity_reviewed",
    "compatibility_envelopes_reviewed"
  ],
  "title": "ChemicalCleaningRecord",
  "type": "object"
}