{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "support_id": {
      "minLength": 1,
      "title": "Support Id",
      "type": "string"
    },
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "bulk_solution_id": {
      "minLength": 1,
      "title": "Bulk Solution Id",
      "type": "string"
    },
    "geometry_id": {
      "minLength": 1,
      "title": "Geometry Id",
      "type": "string"
    },
    "minimum_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Temperature K",
      "type": "number"
    },
    "maximum_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Temperature K",
      "type": "number"
    },
    "minimum_gap_m": {
      "exclusiveMinimum": 0,
      "title": "Minimum Gap M",
      "type": "number"
    },
    "maximum_gap_m": {
      "exclusiveMinimum": 0,
      "title": "Maximum Gap M",
      "type": "number"
    },
    "minimum_diffusivity_m2_s": {
      "exclusiveMinimum": 0,
      "title": "Minimum Diffusivity M2 S",
      "type": "number"
    },
    "maximum_diffusivity_m2_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Diffusivity M2 S",
      "type": "number"
    },
    "maximum_supported_component_concentration_mol_m3": {
      "exclusiveMinimum": 0,
      "title": "Maximum Supported Component Concentration Mol M3",
      "type": "number"
    },
    "provider_id": {
      "minLength": 1,
      "title": "Provider Id",
      "type": "string"
    },
    "provider_version": {
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "provider_model_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Provider Model Digest",
      "type": "string"
    },
    "calibration_basis": {
      "minLength": 1,
      "title": "Calibration Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "support_id",
    "component_id",
    "material_condition_id",
    "bulk_solution_id",
    "geometry_id",
    "minimum_temperature_K",
    "maximum_temperature_K",
    "minimum_gap_m",
    "maximum_gap_m",
    "minimum_diffusivity_m2_s",
    "maximum_diffusivity_m2_s",
    "maximum_supported_component_concentration_mol_m3",
    "provider_id",
    "provider_version",
    "provider_model_digest",
    "calibration_basis",
    "evidence"
  ],
  "title": "CreviceComponentDiffusionSupport",
  "type": "object"
}