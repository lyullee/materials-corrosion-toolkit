{
  "additionalProperties": false,
  "properties": {
    "mesh_id": {
      "minLength": 1,
      "title": "Mesh Id",
      "type": "string"
    },
    "mesh_revision": {
      "minLength": 1,
      "title": "Mesh Revision",
      "type": "string"
    },
    "coordinate_frame_id": {
      "minLength": 1,
      "title": "Coordinate Frame Id",
      "type": "string"
    },
    "dimensionality": {
      "enum": [
        "axisymmetric",
        "2d",
        "3d"
      ],
      "title": "Dimensionality",
      "type": "string"
    },
    "element_family_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Element Family Ids",
      "type": "array"
    },
    "node_count": {
      "minimum": 1,
      "title": "Node Count",
      "type": "integer"
    },
    "element_count": {
      "minimum": 1,
      "title": "Element Count",
      "type": "integer"
    },
    "mesh_content_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Mesh Content Digest",
      "type": "string"
    }
  },
  "required": [
    "mesh_id",
    "mesh_revision",
    "coordinate_frame_id",
    "dimensionality",
    "element_family_ids",
    "node_count",
    "element_count",
    "mesh_content_digest"
  ],
  "title": "StructuralMeshReceipt",
  "type": "object"
}