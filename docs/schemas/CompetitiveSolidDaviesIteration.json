{
  "$defs": {
    "CompetitiveAqueousSpecies": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "initial_concentration_mol_m3": {
          "minimum": 0,
          "title": "Initial Concentration Mol M3",
          "type": "number"
        },
        "activity_reference_concentration_mol_m3": {
          "exclusiveMinimum": 0,
          "title": "Activity Reference Concentration Mol M3",
          "type": "number"
        },
        "activity_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Activity Coefficient",
          "type": "number"
        },
        "charge_number": {
          "title": "Charge Number",
          "type": "integer"
        },
        "elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Elemental Composition",
          "type": "object"
        }
      },
      "required": [
        "species_id",
        "initial_concentration_mol_m3",
        "activity_reference_concentration_mol_m3",
        "activity_coefficient",
        "charge_number",
        "elemental_composition"
      ],
      "title": "CompetitiveAqueousSpecies",
      "type": "object"
    },
    "CompetitiveSolidEquilibrium": {
      "additionalProperties": false,
      "properties": {
        "equilibrium_id": {
          "minLength": 1,
          "title": "Equilibrium Id",
          "type": "string"
        },
        "aqueous_species": {
          "items": {
            "$ref": "#/$defs/CompetitiveAqueousSpecies"
          },
          "minItems": 1,
          "title": "Aqueous Species",
          "type": "array"
        },
        "candidate_solid_phases": {
          "items": {
            "$ref": "#/$defs/CompetitiveSolidPhase"
          },
          "maxItems": 16,
          "minItems": 2,
          "title": "Candidate Solid Phases",
          "type": "array"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "standard_state_id": {
          "minLength": 1,
          "title": "Standard State Id",
          "type": "string"
        },
        "candidate_phase_set_completeness_reviewed": {
          "title": "Candidate Phase Set Completeness Reviewed",
          "type": "boolean"
        },
        "fixed_activity_coefficients_and_standard_states_reviewed": {
          "title": "Fixed Activity Coefficients And Standard States Reviewed",
          "type": "boolean"
        },
        "equilibrium_constant_temperature_and_computational_use_reviewed": {
          "title": "Equilibrium Constant Temperature And Computational Use Reviewed",
          "type": "boolean"
        },
        "single_liquid_fixed_volume_and_neutral_solid_assumptions_reviewed": {
          "title": "Single Liquid Fixed Volume And Neutral Solid Assumptions Reviewed",
          "type": "boolean"
        },
        "optimizer_maximum_iterations": {
          "default": 2000,
          "maximum": 20000,
          "minimum": 50,
          "title": "Optimizer Maximum Iterations",
          "type": "integer"
        },
        "maximum_absolute_log_saturation_residual": {
          "default": 1e-07,
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "title": "Maximum Absolute Log Saturation Residual",
          "type": "number"
        },
        "absolute_extent_balance_tolerance_mol_m3": {
          "default": 1e-10,
          "exclusiveMinimum": 0,
          "title": "Absolute Extent Balance Tolerance Mol M3",
          "type": "number"
        },
        "relative_extent_balance_tolerance": {
          "default": 1e-09,
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "title": "Relative Extent Balance Tolerance",
          "type": "number"
        }
      },
      "required": [
        "equilibrium_id",
        "aqueous_species",
        "candidate_solid_phases",
        "temperature_K",
        "standard_state_id",
        "candidate_phase_set_completeness_reviewed",
        "fixed_activity_coefficients_and_standard_states_reviewed",
        "equilibrium_constant_temperature_and_computational_use_reviewed",
        "single_liquid_fixed_volume_and_neutral_solid_assumptions_reviewed"
      ],
      "title": "CompetitiveSolidEquilibrium",
      "type": "object"
    },
    "CompetitiveSolidPhase": {
      "additionalProperties": false,
      "properties": {
        "solid_species_id": {
          "minLength": 1,
          "title": "Solid Species Id",
          "type": "string"
        },
        "precipitation_stoichiometry": {
          "additionalProperties": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Precipitation Stoichiometry",
          "type": "object"
        },
        "solid_elemental_composition": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Solid Elemental Composition",
          "type": "object"
        },
        "initial_solid_moles_per_solution_volume_mol_m3": {
          "minimum": 0,
          "title": "Initial Solid Moles Per Solution Volume Mol M3",
          "type": "number"
        },
        "dimensionless_solubility_product": {
          "exclusiveMinimum": 0,
          "title": "Dimensionless Solubility Product",
          "type": "number"
        },
        "equilibrium_constant_source_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Equilibrium Constant Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "solid_species_id",
        "precipitation_stoichiometry",
        "solid_elemental_composition",
        "initial_solid_moles_per_solution_volume_mol_m3",
        "dimensionless_solubility_product",
        "equilibrium_constant_source_sha256"
      ],
      "title": "CompetitiveSolidPhase",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.competitive_solid_davies_iteration.v1",
      "default": "matintegrity.competitive_solid_davies_iteration.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "equilibrium": {
      "$ref": "#/$defs/CompetitiveSolidEquilibrium"
    },
    "water_mass_per_solution_volume_kg_L": {
      "exclusiveMinimum": 0,
      "title": "Water Mass Per Solution Volume Kg L",
      "type": "number"
    },
    "davies_A_at_temperature": {
      "exclusiveMinimum": 0,
      "title": "Davies A At Temperature",
      "type": "number"
    },
    "davies_A_provider_id": {
      "minLength": 1,
      "title": "Davies A Provider Id",
      "type": "string"
    },
    "davies_A_provider_revision": {
      "minLength": 1,
      "title": "Davies A Provider Revision",
      "type": "string"
    },
    "davies_A_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Davies A Configuration Digest",
      "type": "string"
    },
    "davies_A_record_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Davies A Record Digest",
      "type": "string"
    },
    "ionic_strength_limit_mol_kg": {
      "exclusiveMinimum": 0,
      "maximum": 0.5,
      "title": "Ionic Strength Limit Mol Kg",
      "type": "number"
    },
    "charge_balance_tolerance_mol_kg": {
      "exclusiveMinimum": 0,
      "title": "Charge Balance Tolerance Mol Kg",
      "type": "number"
    },
    "maximum_outer_iterations": {
      "default": 100,
      "maximum": 1000,
      "minimum": 1,
      "title": "Maximum Outer Iterations",
      "type": "integer"
    },
    "log_gamma_tolerance": {
      "default": 1e-09,
      "exclusiveMinimum": 0,
      "maximum": 0.001,
      "title": "Log Gamma Tolerance",
      "type": "number"
    },
    "damping_fraction": {
      "default": 0.5,
      "exclusiveMinimum": 0,
      "maximum": 1.0,
      "title": "Damping Fraction",
      "type": "number"
    },
    "water_mass_conversion_reviewed": {
      "title": "Water Mass Conversion Reviewed",
      "type": "boolean"
    },
    "davies_A_temperature_solvent_basis_reviewed": {
      "title": "Davies A Temperature Solvent Basis Reviewed",
      "type": "boolean"
    },
    "molarity_standard_state_and_molality_mapping_reviewed": {
      "title": "Molarity Standard State And Molality Mapping Reviewed",
      "type": "boolean"
    },
    "Davies_applicability_to_competing_solids_reviewed": {
      "title": "Davies Applicability To Competing Solids Reviewed",
      "type": "boolean"
    },
    "charge_scope_and_solver_settings_reviewed": {
      "title": "Charge Scope And Solver Settings Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "equilibrium",
    "water_mass_per_solution_volume_kg_L",
    "davies_A_at_temperature",
    "davies_A_provider_id",
    "davies_A_provider_revision",
    "davies_A_configuration_digest",
    "davies_A_record_digest",
    "ionic_strength_limit_mol_kg",
    "charge_balance_tolerance_mol_kg",
    "water_mass_conversion_reviewed",
    "davies_A_temperature_solvent_basis_reviewed",
    "molarity_standard_state_and_molality_mapping_reviewed",
    "Davies_applicability_to_competing_solids_reviewed",
    "charge_scope_and_solver_settings_reviewed"
  ],
  "title": "CompetitiveSolidDaviesIteration",
  "type": "object"
}