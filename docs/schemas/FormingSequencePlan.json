{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FormingTreatmentWaiverBranch": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "minLength": 1,
          "title": "Branch Id",
          "type": "string"
        },
        "minimum_last_finish_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Last Finish Temperature K",
          "type": "number"
        },
        "finish_boundary_inclusive": {
          "title": "Finish Boundary Inclusive",
          "type": "boolean"
        },
        "maximum_final_area_reduction_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Maximum Final Area Reduction Fraction",
          "type": "number"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "branch_id",
        "minimum_last_finish_temperature_K",
        "finish_boundary_inclusive",
        "maximum_final_area_reduction_fraction",
        "basis"
      ],
      "title": "FormingTreatmentWaiverBranch",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "material_id": {
      "minLength": 1,
      "title": "Material Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "minimum_operation_count": {
      "minimum": 1,
      "title": "Minimum Operation Count",
      "type": "integer"
    },
    "maximum_operation_count": {
      "minimum": 1,
      "title": "Maximum Operation Count",
      "type": "integer"
    },
    "minimum_forming_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Forming Temperature K",
      "type": "number"
    },
    "maximum_forming_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Forming Temperature K",
      "type": "number"
    },
    "maximum_last_operation_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Last Operation Temperature K",
      "type": "number"
    },
    "maximum_single_operation_duration_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Single Operation Duration S",
      "type": "number"
    },
    "maximum_total_operation_duration_s": {
      "exclusiveMinimum": 0,
      "title": "Maximum Total Operation Duration S",
      "type": "number"
    },
    "cooling_before_each_subsequent_operation_below_K": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cooling Before Each Subsequent Operation Below K"
    },
    "waiver_branches": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FormingTreatmentWaiverBranch"
      },
      "title": "Waiver Branches",
      "type": "array"
    },
    "basis": {
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "plan_id",
    "material_id",
    "material_condition_id",
    "minimum_operation_count",
    "maximum_operation_count",
    "minimum_forming_temperature_K",
    "maximum_forming_temperature_K",
    "maximum_last_operation_temperature_K",
    "maximum_single_operation_duration_s",
    "maximum_total_operation_duration_s",
    "basis",
    "evidence"
  ],
  "title": "FormingSequencePlan",
  "type": "object"
}