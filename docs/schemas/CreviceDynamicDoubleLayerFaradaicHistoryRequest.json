{
  "$defs": {
    "DynamicDoubleLayerPolarizationBranch": {
      "additionalProperties": false,
      "description": "One caller-calibrated, signed current-density curve for each cell.",
      "properties": {
        "branch_id": {
          "minLength": 1,
          "title": "Branch Id",
          "type": "string"
        },
        "overpotential_axis_V": {
          "items": {
            "type": "number"
          },
          "maxItems": 2000,
          "minItems": 2,
          "title": "Overpotential Axis V",
          "type": "array"
        },
        "signed_current_density_A_m2_by_cell_and_overpotential": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Signed Current Density A M2 By Cell And Overpotential",
          "type": "array"
        },
        "equilibrium_potential_V_by_knot_and_cell": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "maxItems": 1000,
          "minItems": 2,
          "title": "Equilibrium Potential V By Knot And Cell",
          "type": "array"
        },
        "curve_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Curve Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "branch_id",
        "overpotential_axis_V",
        "signed_current_density_A_m2_by_cell_and_overpotential",
        "equilibrium_potential_V_by_knot_and_cell",
        "curve_sha256",
        "evidence"
      ],
      "title": "DynamicDoubleLayerPolarizationBranch",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Integrate lumped cell potentials under caller total-current histories.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.crevice_dynamic_double_layer_faradaic_history.v1",
      "default": "matintegrity.crevice_dynamic_double_layer_faradaic_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "time_s": {
      "items": {
        "type": "number"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Time S",
      "type": "array"
    },
    "cell_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Cell Ids",
      "type": "array"
    },
    "initial_potential_V_by_cell": {
      "items": {
        "type": "number"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Initial Potential V By Cell",
      "type": "array"
    },
    "reference_potential_V_by_cell": {
      "items": {
        "type": "number"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Reference Potential V By Cell",
      "type": "array"
    },
    "active_area_m2_by_knot_and_cell": {
      "items": {
        "items": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Active Area M2 By Knot And Cell",
      "type": "array"
    },
    "active_area_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Active Area Record Sha256",
      "type": "string"
    },
    "active_area_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Active Area Evidence",
      "type": "array"
    },
    "total_current_A_by_knot_and_cell": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "maxItems": 1000,
      "minItems": 2,
      "title": "Total Current A By Knot And Cell",
      "type": "array"
    },
    "total_current_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Total Current Record Sha256",
      "type": "string"
    },
    "total_current_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Total Current Evidence",
      "type": "array"
    },
    "differential_capacitance_potential_axis_V": {
      "items": {
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Differential Capacitance Potential Axis V",
      "type": "array"
    },
    "differential_capacitance_F_m2": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 2000,
      "minItems": 2,
      "title": "Differential Capacitance F M2",
      "type": "array"
    },
    "differential_capacitance_curve_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Differential Capacitance Curve Sha256",
      "type": "string"
    },
    "capacitance_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Capacitance Evidence",
      "type": "array"
    },
    "faradaic_branches": {
      "items": {
        "$ref": "#/$defs/DynamicDoubleLayerPolarizationBranch"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Faradaic Branches",
      "type": "array"
    },
    "absolute_current_closure_tolerance_A": {
      "default": 1e-09,
      "exclusiveMinimum": 0,
      "title": "Absolute Current Closure Tolerance A",
      "type": "number"
    },
    "absolute_potential_tolerance_V": {
      "default": 1e-09,
      "exclusiveMinimum": 0,
      "title": "Absolute Potential Tolerance V",
      "type": "number"
    },
    "relative_current_closure_tolerance": {
      "default": 1e-08,
      "exclusiveMinimum": 0,
      "maximum": 0.001,
      "title": "Relative Current Closure Tolerance",
      "type": "number"
    },
    "relative_potential_tolerance": {
      "default": 1e-08,
      "exclusiveMinimum": 0,
      "maximum": 0.001,
      "title": "Relative Potential Tolerance",
      "type": "number"
    },
    "maximum_total_rhs_evaluations": {
      "default": 2000000,
      "maximum": 20000000,
      "minimum": 2,
      "title": "Maximum Total Rhs Evaluations",
      "type": "integer"
    },
    "maximum_total_table_operations": {
      "default": 20000000,
      "maximum": 20000000,
      "minimum": 1,
      "title": "Maximum Total Table Operations",
      "type": "integer"
    },
    "curve_linearity_and_no_extrapolation_reviewed": {
      "title": "Curve Linearity And No Extrapolation Reviewed",
      "type": "boolean"
    },
    "current_sign_and_external_boundary_reviewed": {
      "title": "Current Sign And External Boundary Reviewed",
      "type": "boolean"
    },
    "lumped_cell_independence_and_no_ionic_transport_reviewed": {
      "title": "Lumped Cell Independence And No Ionic Transport Reviewed",
      "type": "boolean"
    },
    "parameter_applicability_reviewed": {
      "title": "Parameter Applicability Reviewed",
      "type": "boolean"
    },
    "computation_budget_reviewed": {
      "title": "Computation Budget Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "time_s",
    "cell_ids",
    "initial_potential_V_by_cell",
    "reference_potential_V_by_cell",
    "active_area_m2_by_knot_and_cell",
    "active_area_record_sha256",
    "active_area_evidence",
    "total_current_A_by_knot_and_cell",
    "total_current_record_sha256",
    "total_current_evidence",
    "differential_capacitance_potential_axis_V",
    "differential_capacitance_F_m2",
    "differential_capacitance_curve_sha256",
    "capacitance_evidence",
    "faradaic_branches",
    "curve_linearity_and_no_extrapolation_reviewed",
    "current_sign_and_external_boundary_reviewed",
    "lumped_cell_independence_and_no_ionic_transport_reviewed",
    "parameter_applicability_reviewed",
    "computation_budget_reviewed",
    "computational_use_authorized"
  ],
  "title": "CreviceDynamicDoubleLayerFaradaicHistoryRequest",
  "type": "object"
}