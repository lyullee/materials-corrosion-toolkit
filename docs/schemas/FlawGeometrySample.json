{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "sample_role": {
      "enum": [
        "nominal",
        "uncertainty_realization"
      ],
      "title": "Sample Role",
      "type": "string"
    },
    "component_geometry_id": {
      "minLength": 1,
      "title": "Component Geometry Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "load_case_id": {
      "minLength": 1,
      "title": "Load Case Id",
      "type": "string"
    },
    "coordinates": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Coordinates",
      "type": "object"
    },
    "coordinate_units": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Coordinate Units",
      "type": "object"
    },
    "sample_weight": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "title": "Sample Weight",
      "type": "number"
    },
    "geometry_source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Geometry Source Digest",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "sample_id",
    "sample_role",
    "component_geometry_id",
    "material_condition_id",
    "load_case_id",
    "coordinates",
    "coordinate_units",
    "geometry_source_digest",
    "evidence"
  ],
  "title": "FlawGeometrySample",
  "type": "object"
}