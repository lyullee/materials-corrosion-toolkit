{
  "$defs": {
    "CorrelationBasis": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "license_id": {
          "minLength": 1,
          "title": "License Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "applicability_and_units_reviewed": {
          "title": "Applicability And Units Reviewed",
          "type": "boolean"
        },
        "computational_use_authorized": {
          "title": "Computational Use Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "source_id",
        "revision",
        "license_id",
        "record_sha256",
        "evidence",
        "applicability_and_units_reviewed",
        "computational_use_authorized"
      ],
      "title": "CorrelationBasis",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis": {
      "$ref": "#/$defs/CorrelationBasis"
    },
    "component_id": {
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "physical_location_id": {
      "minLength": 1,
      "title": "Physical Location Id",
      "type": "string"
    },
    "hole_id": {
      "minLength": 1,
      "title": "Hole Id",
      "type": "string"
    },
    "local_wall_thickness_m": {
      "exclusiveMinimum": 0,
      "title": "Local Wall Thickness M",
      "type": "number"
    },
    "drilled_depth_m": {
      "minimum": 0,
      "title": "Drilled Depth M",
      "type": "number"
    },
    "reference_required_wall_m": {
      "exclusiveMinimum": 0,
      "title": "Reference Required Wall M",
      "type": "number"
    },
    "same_location_depth_direction_and_blind_hole_role_reviewed": {
      "title": "Same Location Depth Direction And Blind Hole Role Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "basis",
    "component_id",
    "physical_location_id",
    "hole_id",
    "local_wall_thickness_m",
    "drilled_depth_m",
    "reference_required_wall_m",
    "same_location_depth_direction_and_blind_hole_role_reviewed"
  ],
  "title": "BlindIndicatorHoleLigament",
  "type": "object"
}