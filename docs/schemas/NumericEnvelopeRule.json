{
  "additionalProperties": false,
  "properties": {
    "rule_kind": {
      "const": "numeric_envelope",
      "default": "numeric_envelope",
      "title": "Rule Kind",
      "type": "string"
    },
    "rule_id": {
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "target_kind": {
      "enum": [
        "material_role",
        "layer_role",
        "layer_position",
        "service_environment"
      ],
      "title": "Target Kind",
      "type": "string"
    },
    "target_value": {
      "minLength": 1,
      "title": "Target Value",
      "type": "string"
    },
    "fact_kind": {
      "enum": [
        "chemistry",
        "property",
        "dilution",
        "service_environment"
      ],
      "title": "Fact Kind",
      "type": "string"
    },
    "metric_id": {
      "minLength": 1,
      "title": "Metric Id",
      "type": "string"
    },
    "unit_token": {
      "minLength": 1,
      "title": "Unit Token",
      "type": "string"
    },
    "minimum_inclusive": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Inclusive"
    },
    "maximum_inclusive": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Inclusive"
    },
    "uncertainty_policy": {
      "enum": [
        "point_value",
        "interval_must_fit"
