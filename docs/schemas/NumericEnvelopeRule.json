      "type": "number"
    },
    "missing_fact_disposition": {
      "enum": [
        "review",
        "insufficient_evidence"
      ],
      "title": "Missing Fact Disposition",
      "type": "string"
    },
    "rule_description": {
      "minLength": 1,
      "title": "Rule Description",
      "type": "string"
    }
