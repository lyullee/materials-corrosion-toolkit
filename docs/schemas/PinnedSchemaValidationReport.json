{
  "$defs": {
    "PinnedSchemaPathFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "schema",
            "unit",
            "identity",
            "probability_semantics"
          ],
          "title": "Category",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "expected_descriptor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Descriptor"
        },
        "observed_descriptor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Descriptor"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "category",
        "status",
        "basis"
      ],
      "title": "PinnedSchemaPathFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.pinned_schema_validation_report.v1",
      "default": "matintegrity.pinned_schema_validation_report.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "pattern": "^pinned-schema-report-[a-f0-9]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_audit_id": {
      "pattern": "^external-schema-[a-f0-9]{64}$",
      "title": "Schema Audit Id",
      "type": "string"
    },
    "schema_audit_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schema Audit Digest",
      "type": "string"
    },
    "schema_repository_id": {
      "minLength": 1,
      "title": "Schema Repository Id",
      "type": "string"
    },
    "schema_pinned_commit": {
      "pattern": "^[a-fA-F0-9]{40}$|^[a-fA-F0-9]{64}$",
      "title": "Schema Pinned Commit",
      "type": "string"
    },
    "schema_repository_path": {
      "minLength": 1,
      "title": "Schema Repository Path",
      "type": "string"
    },
    "schema_content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schema Content Sha256",
      "type": "string"
    },
    "schema_compatibility_summary_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Schema Compatibility Summary Digest",
      "type": "string"
    },
    "json_schema_id": {
      "minLength": 1,
      "title": "Json Schema Id",
      "type": "string"
    },
    "json_schema_version": {
      "minLength": 1,
      "title": "Json Schema Version",
      "type": "string"
    },
    "producer_payload_canonical_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Producer Payload Canonical Sha256",
      "type": "string"
    },
    "validator_id": {
      "minLength": 1,
      "title": "Validator Id",
      "type": "string"
    },
    "validator_revision": {
      "minLength": 1,
      "title": "Validator Revision",
      "type": "string"
    },
    "validator_configuration_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Validator Configuration Digest",
      "type": "string"
    },
    "schema_validation_status": {
      "enum": [
        "valid",
        "invalid"
      ],
      "title": "Schema Validation Status",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/PinnedSchemaPathFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "network_download_performed": {
      "const": false,
      "default": false,
      "title": "Network Download Performed",
      "type": "boolean"
    },
    "consumer_executed": {
      "const": false,
      "default": false,
      "title": "Consumer Executed",
      "type": "boolean"
    },
    "end_to_end_qualification_claimed": {
      "const": false,
      "default": false,
      "title": "End To End Qualification Claimed",
      "type": "boolean"
    },
    "physical_validation_claimed": {
      "const": false,
      "default": false,
      "title": "Physical Validation Claimed",
      "type": "boolean"
    },
    "report_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Report Digest",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "schema_audit_id",
    "schema_audit_digest",
    "schema_repository_id",
    "schema_pinned_commit",
    "schema_repository_path",
    "schema_content_sha256",
    "schema_compatibility_summary_digest",
    "json_schema_id",
    "json_schema_version",
    "producer_payload_canonical_sha256",
    "validator_id",
    "validator_revision",
    "validator_configuration_digest",
    "schema_validation_status",
    "findings",
    "limitations",
    "report_digest"
  ],
  "title": "PinnedSchemaValidationReport",
  "type": "object"
}