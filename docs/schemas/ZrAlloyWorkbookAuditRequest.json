{
  "$defs": {
    "ZrAlloyReadAuthorization": {
      "additionalProperties": false,
      "description": "Caller declaration for attribution and local-only access to CC BY material.",
      "properties": {
        "dataset_id": {
          "const": "zenodo-zr-nb-sn-electrochemical-noise-v2",
          "default": "zenodo-zr-nb-sn-electrochemical-noise-v2",
          "title": "Dataset Id",
          "type": "string"
        },
        "dataset_doi": {
          "const": "10.5281/zenodo.23220129",
          "default": "10.5281/zenodo.23220129",
          "title": "Dataset Doi",
          "type": "string"
        },
        "license_id": {
          "const": "CC-BY-4.0",
          "default": "CC-BY-4.0",
          "title": "License Id",
          "type": "string"
        },
        "attribution": {
          "minLength": 1,
          "title": "Attribution",
          "type": "string"
        },
        "computational_use_authorized": {
          "const": true,
          "title": "Computational Use Authorized",
          "type": "boolean"
        },
        "local_only_authorized": {
          "const": true,
          "title": "Local Only Authorized",
          "type": "boolean"
        }
      },
      "required": [
        "attribution",
        "computational_use_authorized",
        "local_only_authorized"
      ],
      "title": "ZrAlloyReadAuthorization",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "local_workbook_path": {
      "minLength": 1,
      "title": "Local Workbook Path",
      "type": "string"
    },
    "authorization": {
      "$ref": "#/$defs/ZrAlloyReadAuthorization"
    }
  },
  "required": [
    "local_workbook_path",
    "authorization"
  ],
  "title": "ZrAlloyWorkbookAuditRequest",
  "type": "object"
}