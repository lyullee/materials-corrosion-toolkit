{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "pick_id": {
      "minLength": 1,
      "title": "Pick Id",
      "type": "string"
    },
    "frame_id": {
      "minLength": 1,
      "title": "Frame Id",
      "type": "string"
    },
    "reported_role": {
      "enum": [
        "upper_tip",
        "lower_tip",
        "unclassified_diffraction"
      ],
      "title": "Reported Role",
      "type": "string"
    },
    "arrival_time_s": {
      "exclusiveMinimum": 0,
      "title": "Arrival Time S",
      "type": "number"
    },
    "picking_basis": {
      "minLength": 1,
      "title": "Picking Basis",
      "type": "string"
    },
    "reported_amplitude": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reported Amplitude"
    },
    "amplitude_unit": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amplitude Unit"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "pick_id",
    "frame_id",
    "reported_role",
    "arrival_time_s",
    "picking_basis",
    "evidence"
  ],
  "title": "TofdDiffractionPick",
  "type": "object"
}