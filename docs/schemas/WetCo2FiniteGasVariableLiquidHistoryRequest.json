{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "WetCo2FiniteGasVariableLiquidInterval": {
      "additionalProperties": false,
      "description": "Piecewise-constant Henry, film, and signed volume-flux conditions.",
      "properties": {
        "start_time_s": {
          "minimum": 0,
          "title": "Start Time S",
          "type": "number"
        },
        "end_time_s": {
          "exclusiveMinimum": 0,
          "title": "End Time S",
          "type": "number"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "liquid_volume_flux_m_s": {
          "title": "Liquid Volume Flux M S",
          "type": "number"
        },
        "incoming_co2star_mol_m3": {
          "minimum": 0,
          "title": "Incoming Co2Star Mol M3",
          "type": "number"
        },
        "henry_concentration_over_fugacity_mol_m3_Pa": {
          "exclusiveMinimum": 0,
          "title": "Henry Concentration Over Fugacity Mol M3 Pa",
          "type": "number"
        },
        "gas_film_coefficient_mol_m2_s_Pa": {
          "exclusiveMinimum": 0,
          "title": "Gas Film Coefficient Mol M2 S Pa",
          "type": "number"
        },
        "liquid_film_coefficient_m_s": {
          "exclusiveMinimum": 0,
          "title": "Liquid Film Coefficient M S",
          "type": "number"
        },
        "interval_provider_id": {
          "minLength": 1,
          "title": "Interval Provider Id",
          "type": "string"
        },
        "interval_provider_revision": {
          "minLength": 1,
          "title": "Interval Provider Revision",
          "type": "string"
        },
        "interval_configuration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Interval Configuration Sha256",
          "type": "string"
        },
        "interval_result_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Interval Result Sha256",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 64,
          "minItems": 3,
          "title": "Evidence",
          "type": "array"
        },
        "interval_state_and_units_reviewed": {
          "title": "Interval State And Units Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "start_time_s",
        "end_time_s",
        "temperature_K",
        "liquid_volume_flux_m_s",
        "incoming_co2star_mol_m3",
        "henry_concentration_over_fugacity_mol_m3_Pa",
        "gas_film_coefficient_mol_m2_s_Pa",
        "liquid_film_coefficient_m_s",
        "interval_provider_id",
        "interval_provider_revision",
        "interval_configuration_sha256",
        "interval_result_sha256",
        "evidence",
        "interval_state_and_units_reviewed"
      ],
      "title": "WetCo2FiniteGasVariableLiquidInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Finite gas inventory exchanging with a time-varying liquid volume per patch area.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.wet_co2_finite_gas_variable_liquid_history.v1",
      "default": "matintegrity.wet_co2_finite_gas_variable_liquid_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "wall_patch_id": {
      "minLength": 1,
      "title": "Wall Patch Id",
      "type": "string"
    },
    "condition_id": {
      "minLength": 1,
      "title": "Condition Id",
      "type": "string"
    },
    "initial_liquid_volume_per_area_m": {
      "exclusiveMinimum": 0,
      "title": "Initial Liquid Volume Per Area M",
      "type": "number"
    },
    "initial_liquid_co2star_mol_m3": {
      "minimum": 0,
      "title": "Initial Liquid Co2Star Mol M3",
      "type": "number"
    },
    "initial_gas_co2_fugacity_Pa": {
      "minimum": 0,
      "title": "Initial Gas Co2 Fugacity Pa",
      "type": "number"
    },
    "finite_gas_inventory_capacity_mol_m2_Pa": {
      "exclusiveMinimum": 0,
      "title": "Finite Gas Inventory Capacity Mol M2 Pa",
      "type": "number"
    },
    "initial_state_provider_id": {
      "minLength": 1,
      "title": "Initial State Provider Id",
      "type": "string"
    },
    "initial_state_provider_revision": {
      "minLength": 1,
      "title": "Initial State Provider Revision",
      "type": "string"
    },
    "initial_state_configuration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Initial State Configuration Sha256",
      "type": "string"
    },
    "initial_state_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Initial State Result Sha256",
      "type": "string"
    },
    "initial_state_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Initial State Evidence",
      "type": "array"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/WetCo2FiniteGasVariableLiquidInterval"
      },
      "maxItems": 2000,
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "relative_tolerance": {
      "default": 1e-09,
      "maximum": 0.001,
      "minimum": 1e-12,
      "title": "Relative Tolerance",
      "type": "number"
    },
    "liquid_concentration_absolute_tolerance_mol_m3": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "title": "Liquid Concentration Absolute Tolerance Mol M3",
      "type": "number"
    },
    "gas_fugacity_absolute_tolerance_Pa": {
      "default": 0.001,
      "exclusiveMinimum": 0,
      "title": "Gas Fugacity Absolute Tolerance Pa",
      "type": "number"
    },
    "areal_mole_absolute_tolerance_mol_m2": {
      "default": 1e-12,
      "exclusiveMinimum": 0,
      "title": "Areal Mole Absolute Tolerance Mol M2",
      "type": "number"
    },
    "maximum_step_s": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Step S"
    },
    "fixed_area_and_gas_capacity_reviewed": {
      "title": "Fixed Area And Gas Capacity Reviewed",
      "type": "boolean"
    },
    "positive_volume_flux_is_condensate_inflow_reviewed": {
      "title": "Positive Volume Flux Is Condensate Inflow Reviewed",
      "type": "boolean"
    },
    "negative_volume_flux_is_well_mixed_liquid_outflow_reviewed": {
      "title": "Negative Volume Flux Is Well Mixed Liquid Outflow Reviewed",
      "type": "boolean"
    },
    "no_dryout_within_simulated_history_reviewed": {
      "title": "No Dryout Within Simulated History Reviewed",
      "type": "boolean"
    },
    "incoming_co2star_convention_reviewed": {
      "title": "Incoming Co2Star Convention Reviewed",
      "type": "boolean"
    },
    "no_reaction_or_speciation_change_reviewed": {
      "title": "No Reaction Or Speciation Change Reviewed",
      "type": "boolean"
    },
    "solver_tolerances_and_use_reviewed": {
      "title": "Solver Tolerances And Use Reviewed",
      "type": "boolean"
    },
    "calculation_use_authorized": {
      "title": "Calculation Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "asset_id",
    "location_id",
    "physical_scope_id",
    "wall_patch_id",
    "condition_id",
    "initial_liquid_volume_per_area_m",
    "initial_liquid_co2star_mol_m3",
    "initial_gas_co2_fugacity_Pa",
    "finite_gas_inventory_capacity_mol_m2_Pa",
    "initial_state_provider_id",
    "initial_state_provider_revision",
    "initial_state_configuration_sha256",
    "initial_state_result_sha256",
    "initial_state_evidence",
    "intervals",
    "fixed_area_and_gas_capacity_reviewed",
    "positive_volume_flux_is_condensate_inflow_reviewed",
    "negative_volume_flux_is_well_mixed_liquid_outflow_reviewed",
    "no_dryout_within_simulated_history_reviewed",
    "incoming_co2star_convention_reviewed",
    "no_reaction_or_speciation_change_reviewed",
    "solver_tolerances_and_use_reviewed",
    "calculation_use_authorized"
  ],
  "title": "WetCo2FiniteGasVariableLiquidHistoryRequest",
  "type": "object"
}