          "default": false,
          "title": "Built In Code Or Specification Limits Used",
          "type": "boolean"
        },
        "automatic_cohesive_or_adhesive_mechanism_claimed": {
          "const": false,
          "default": false,
          "title": "Automatic Cohesive Or Adhesive Mechanism Claimed",
          "type": "boolean"
        },
        "service_life_claimed": {
          "const": false,
          "default": false,
          "title": "Service Life Claimed",
          "type": "boolean"
        },
        "physical_qualification_claimed": {
          "const": false,
          "default": false,
          "title": "Physical Qualification Claimed",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
