          "title": "Result Qualifier",
          "type": "string"
        },
        "reported_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Value"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "detection_limit": {
          "exclusiveMinimum": 0,
          "title": "Detection Limit",
          "type": "number"
        },
        "caller_indicator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caller Indicator Id"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "assay_id",
        "sample_id",
        "target_id",
        "method_id",
        "result_qualifier",
        "unit",
        "detection_limit",
        "record_valid",
        "evidence"
      ],
      "title": "MicrobialAssay",
      "type": "object"
    },
    "MicrobialSample": {
      "additionalProperties": false,
