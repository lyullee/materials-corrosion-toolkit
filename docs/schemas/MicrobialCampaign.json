{
  "$defs": {
    "BiofilmDepositObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "observation_method_id": {
          "minLength": 1,
          "title": "Observation Method Id",
          "type": "string"
        },
        "reported_description": {
          "minLength": 1,
          "title": "Reported Description",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "reported_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "sample_id",
        "observation_method_id",
        "reported_description",
        "record_valid",
        "evidence"
      ],
      "title": "BiofilmDepositObservation",
      "type": "object"
    },
    "CallerMicrobialIndicator": {
      "additionalProperties": false,
      "properties": {
        "indicator_id": {
          "minLength": 1,
          "title": "Indicator Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "method_id": {
          "minLength": 1,
          "title": "Method Id",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "minimum_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Value"
        },
        "maximum_value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Value"
        },
        "definition_basis": {
          "minLength": 1,
          "title": "Definition Basis",
          "type": "string"
        },
        "caller_disposition_id_if_outside": {
          "minLength": 1,
          "title": "Caller Disposition Id If Outside",
          "type": "string"
        }
      },
      "required": [
        "indicator_id",
        "target_id",
        "method_id",
        "unit",
        "definition_basis",
        "caller_disposition_id_if_outside"
      ],
      "title": "CallerMicrobialIndicator",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "MicrobialAssay": {
      "additionalProperties": false,
      "properties": {
        "assay_id": {
          "minLength": 1,
          "title": "Assay Id",
          "type": "string"
        },
        "sample_id": {
          "minLength": 1,
          "title": "Sample Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
