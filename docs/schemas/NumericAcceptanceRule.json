{
  "additionalProperties": false,
  "properties": {
    "rule_kind": {
      "const": "numeric",
      "default": "numeric",
      "title": "Rule Kind",
      "type": "string"
    },
    "rule_id": {
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "target_scope": {
      "enum": [
        "examination",
        "region",
        "indication",
        "group"
      ],
      "title": "Target Scope",
      "type": "string"
    },
    "metric": {
      "enum": [
        "coverage_fraction",
        "indication_count",
        "length_m",
        "width_m",
        "area_m2",
        "group_member_count",
        "aggregate_length_m",
        "aggregate_width_m",
        "aggregate_area_m2"
      ],
      "title": "Metric",
      "type": "string"
    },
    "operator": {
      "enum": [
        "less_than",
        "less_than_or_equal",
        "greater_than",
        "greater_than_or_equal"
      ],
      "title": "Operator",
      "type": "string"
    },
    "threshold": {
      "title": "Threshold",
      "type": "number"
    },
    "unit_token": {
      "enum": [
        "1",
        "count",
        "m",
        "m^2"
      ],
      "title": "Unit Token",
      "type": "string"
    },
    "missing_metric_disposition": {
      "enum": [
        "review",
        "insufficient_evidence"
      ],
      "title": "Missing Metric Disposition",
      "type": "string"
    },
    "rule_description": {
      "minLength": 1,
      "title": "Rule Description",
      "type": "string"
    }
  },
  "required": [
    "rule_id",
    "target_scope",
    "metric",
    "operator",
    "threshold",
    "unit_token",
    "missing_metric_disposition",
    "rule_description"
  ],
  "title": "NumericAcceptanceRule",
  "type": "object"
}