        "record_valid": {
          "title": "Record Valid",
          "type": "boolean"
        },
        "invalid_or_limiting_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Or Limiting Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "observation_kind",
        "method_id",
        "physical_region_id",
        "reported_endpoint",
        "record_valid",
        "evidence"
      ],
      "title": "LMEQualificationObservation",
      "type": "object"
    },
    "LMEQualificationTestEvidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_record_id": {
          "minLength": 1,
