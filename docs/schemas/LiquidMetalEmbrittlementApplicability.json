{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "LMEQualificationEnvelope": {
      "additionalProperties": false,
      "properties": {
        "envelope_id": {
          "minLength": 1,
          "title": "Envelope Id",
          "type": "string"
        },
        "structural_material_id": {
          "minLength": 1,
          "title": "Structural Material Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "liquid_metal_species_id": {
          "minLength": 1,
          "title": "Liquid Metal Species Id",
          "type": "string"
        },
        "liquid_metal_composition_id": {
          "minLength": 1,
          "title": "Liquid Metal Composition Id",
          "type": "string"
        },
        "impurity_profile_id": {
          "minLength": 1,
          "title": "Impurity Profile Id",
          "type": "string"
        },
        "supported_contact_state_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Contact State Descriptors",
          "type": "array"
        },
        "supported_wetting_descriptors": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Wetting Descriptors",
          "type": "array"
        },
        "minimum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Minimum Temperature K",
          "type": "number"
        },
        "maximum_temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Maximum Temperature K",
          "type": "number"
        },
        "minimum_stress_value": {
          "minimum": 0,
          "title": "Minimum Stress Value",
          "type": "number"
        },
        "maximum_stress_value": {
          "minimum": 0,
          "title": "Maximum Stress Value",
          "type": "number"
        },
        "stress_unit_token": {
          "minLength": 1,
          "title": "Stress Unit Token",
          "type": "string"
        },
        "minimum_strain_rate_value": {
          "minimum": 0,
          "title": "Minimum Strain Rate Value",
          "type": "number"
        },
        "maximum_strain_rate_value": {
          "minimum": 0,
          "title": "Maximum Strain Rate Value",
          "type": "number"
        },
        "strain_rate_unit_token": {
          "minLength": 1,
          "title": "Strain Rate Unit Token",
          "type": "string"
        },
        "maximum_single_exposure_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Single Exposure S",
          "type": "number"
        },
        "maximum_cumulative_exposure_s": {
          "exclusiveMinimum": 0,
          "title": "Maximum Cumulative Exposure S",
          "type": "number"
        },
        "test_evidence": {
          "items": {
            "$ref": "#/$defs/LMEQualificationTestEvidence"
          },
          "minItems": 1,
          "title": "Test Evidence",
          "type": "array"
        },
        "qualification_basis": {
          "minLength": 1,
          "title": "Qualification Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "envelope_id",
        "structural_material_id",
        "material_condition_id",
        "liquid_metal_species_id",
        "liquid_metal_composition_id",
        "impurity_profile_id",
        "supported_contact_state_descriptors",
        "supported_wetting_descriptors",
        "minimum_temperature_K",
        "maximum_temperature_K",
        "minimum_stress_value",
        "maximum_stress_value",
        "stress_unit_token",
        "minimum_strain_rate_value",
        "maximum_strain_rate_value",
        "strain_rate_unit_token",
        "maximum_single_exposure_s",
        "maximum_cumulative_exposure_s",
        "test_evidence",
        "qualification_basis",
        "evidence"
      ],
      "title": "LMEQualificationEnvelope",
      "type": "object"
    },
    "LMEQualificationObservation": {
