{
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "matintegrity.assessment.v1",
          "default": "matintegrity.assessment.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/RunContext"
        },
        "input_digest": {
          "title": "Input Digest",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "qualification": {
          "enum": [
            "engineering_screening",
            "user_model",
            "data_import"
          ],
          "title": "Qualification",
          "type": "string"
        },
        "runtime": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Runtime",
          "type": "object"
        },
        "probability_semantics": {
          "additionalProperties": {
            "enum": [
              "conditional_first_failure_in_period",
              "point_in_time_state_probability",
              "posterior_parameter_probability",
              "model_implied_input_uncertainty_probability",
              "spatial_size_exceedance_at_one_exposure",
              "detection_given_flaw_and_procedure",
              "unscoped_event_probability",
              "fault_tree_top_event_probability"
            ],
            "type": "string"
          },
          "title": "Probability Semantics",
          "type": "object"
        }
      },
      "required": [
        "model_id",
        "model_version",
        "status",
        "inputs",
        "values",
        "units",
        "assumptions",
        "notes",
        "context",
        "input_digest",
        "source_ids",
        "qualification",
        "runtime"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "BoltFatigueCurve": {
      "additionalProperties": false,
      "properties": {
        "bolt_id": {
          "minLength": 1,
          "title": "Bolt Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "reference_stress_range_Pa": {
          "exclusiveMinimum": 0,
          "title": "Reference Stress Range Pa",
          "type": "number"
        },
        "reference_cycles": {
          "exclusiveMinimum": 0,
          "title": "Reference Cycles",
          "type": "number"
        },
        "basquin_exponent": {
          "exclusiveMinimum": 0,
          "title": "Basquin Exponent",
          "type": "number"
        },
        "ultimate_tensile_strength_Pa": {
          "exclusiveMinimum": 0,
          "title": "Ultimate Tensile Strength Pa",
          "type": "number"
        },
        "calibration_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Record Sha256",
          "type": "string"
        },
        "usage_license_id": {
          "minLength": 1,
          "title": "Usage License Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "bolt_id",
        "material_condition_id",
        "provider_id",
        "provider_revision",
        "reference_stress_range_Pa",
        "reference_cycles",
        "basquin_exponent",
        "ultimate_tensile_strength_Pa",
        "calibration_record_sha256",
        "usage_license_id",
        "evidence"
      ],
      "title": "BoltFatigueCurve",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RunContext": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis": {
          "minLength": 1,
          "title": "Time Basis",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "asset_id",
        "location_id",
        "time_basis"
      ],
      "title": "RunContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Rainflow plus caller-supplied Basquin/Goodman screening for one bolt-joint history.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.gasket_bolt_cyclic_damage.v1",
      "default": "matintegrity.gasket_bolt_cyclic_damage.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "bolt_history_result": {
      "$ref": "#/$defs/AssessmentResult"
    },
    "bolt_history_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bolt History Result Sha256",
      "type": "string"
    },
    "curves": {
      "items": {
        "$ref": "#/$defs/BoltFatigueCurve"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Curves",
      "type": "array"
    },
    "declared_damage_limit": {
      "exclusiveMinimum": 0,
      "title": "Declared Damage Limit",
      "type": "number"
    },
    "time_history_interpretation": {
      "const": "ordered_repeated_service_record",
      "title": "Time History Interpretation",
      "type": "string"
    },
    "load_history_scope_reviewed": {
      "title": "Load History Scope Reviewed",
      "type": "boolean"
    },
    "bolt_identity_and_stress_area_reviewed": {
      "title": "Bolt Identity And Stress Area Reviewed",
      "type": "boolean"
    },
    "material_condition_and_temperature_applicability_reviewed": {
      "title": "Material Condition And Temperature Applicability Reviewed",
      "type": "boolean"
    },
    "calibration_lineage_license_and_computational_use_reviewed": {
      "title": "Calibration Lineage License And Computational Use Reviewed",
      "type": "boolean"
    },
    "cycle_counting_and_record_boundary_reviewed": {
      "title": "Cycle Counting And Record Boundary Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "bolt_history_result",
    "bolt_history_result_sha256",
    "curves",
    "declared_damage_limit",
    "time_history_interpretation",
    "load_history_scope_reviewed",
    "bolt_identity_and_stress_area_reviewed",
    "material_condition_and_temperature_applicability_reviewed",
    "calibration_lineage_license_and_computational_use_reviewed",
    "cycle_counting_and_record_boundary_reviewed"
  ],
  "title": "GasketBoltCyclicDamage",
  "type": "object"
}