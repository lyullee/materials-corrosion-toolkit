{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-supplied exact temperature knots and one Arrhenius wall coefficient.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.crevice_wall_sink_rate_history.v1",
      "default": "matintegrity.crevice_wall_sink_rate_history.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "history_id": {
      "minLength": 1,
      "title": "History Id",
      "type": "string"
    },
    "asset_id": {
      "minLength": 1,
      "title": "Asset Id",
      "type": "string"
    },
    "location_id": {
      "minLength": 1,
      "title": "Location Id",
      "type": "string"
    },
    "geometry_id": {
      "minLength": 1,
      "title": "Geometry Id",
      "type": "string"
    },
    "species_id": {
      "minLength": 1,
      "title": "Species Id",
      "type": "string"
    },
    "condition_id": {
      "minLength": 1,
      "title": "Condition Id",
      "type": "string"
    },
    "elapsed_time_s": {
      "items": {
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Elapsed Time S",
      "type": "array"
    },
    "temperature_K": {
      "items": {
        "exclusiveMinimum": 0,
        "type": "number"
      },
      "maxItems": 5000,
      "minItems": 2,
      "title": "Temperature K",
      "type": "array"
    },
    "reference_wall_transfer_velocity_m_s": {
      "minimum": 0,
      "title": "Reference Wall Transfer Velocity M S",
      "type": "number"
    },
    "activation_energy_J_mol": {
      "minimum": 0,
      "title": "Activation Energy J Mol",
      "type": "number"
    },
    "reference_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Reference Temperature K",
      "type": "number"
    },
    "minimum_supported_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Minimum Supported Temperature K",
      "type": "number"
    },
    "maximum_supported_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Maximum Supported Temperature K",
      "type": "number"
    },
    "activation_parameter_and_use_reviewed": {
      "title": "Activation Parameter And Use Reviewed",
      "type": "boolean"
    },
    "temperature_history_to_condition_mapping_reviewed": {
      "title": "Temperature History To Condition Mapping Reviewed",
      "type": "boolean"
    },
    "first_order_irreversible_wall_law_reviewed": {
      "title": "First Order Irreversible Wall Law Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "history_id",
    "asset_id",
    "location_id",
    "geometry_id",
    "species_id",
    "condition_id",
    "elapsed_time_s",
    "temperature_K",
    "reference_wall_transfer_velocity_m_s",
    "activation_energy_J_mol",
    "reference_temperature_K",
    "minimum_supported_temperature_K",
    "maximum_supported_temperature_K",
    "activation_parameter_and_use_reviewed",
    "temperature_history_to_condition_mapping_reviewed",
    "first_order_irreversible_wall_law_reviewed",
    "evidence"
  ],
  "title": "CreviceWallSinkRateHistoryRequest",
  "type": "object"
}