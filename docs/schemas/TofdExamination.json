{
  "$defs": {
    "EncodedTofdFrame": {
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "encoder_position_m": {
          "title": "Encoder Position M",
          "type": "number"
        },
        "data_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Data Sha256",
          "type": "string"
        },
        "sample_count": {
          "exclusiveMinimum": 0,
          "title": "Sample Count",
          "type": "integer"
        },
        "sample_interval_s": {
          "exclusiveMinimum": 0,
          "title": "Sample Interval S",
          "type": "number"
        },
        "amplitude_encoding": {
          "minLength": 1,
          "title": "Amplitude Encoding",
          "type": "string"
        },
        "time_zero_basis": {
          "minLength": 1,
          "title": "Time Zero Basis",
          "type": "string"
        },
        "lateral_wave_arrival_time_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lateral Wave Arrival Time S"
        },
        "backwall_echo_arrival_time_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backwall Echo Arrival Time S"
        }
      },
      "required": [
        "frame_id",
        "encoder_position_m",
        "data_sha256",
        "sample_count",
        "sample_interval_s",
        "amplitude_encoding",
        "time_zero_basis"
      ],
      "title": "EncodedTofdFrame",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TofdDiffractionPick": {
      "additionalProperties": false,
      "properties": {
        "pick_id": {
          "minLength": 1,
          "title": "Pick Id",
          "type": "string"
        },
        "frame_id": {
          "minLength": 1,
          "title": "Frame Id",
          "type": "string"
        },
        "reported_role": {
          "enum": [
            "upper_tip",
            "lower_tip",
            "unclassified_diffraction"
          ],
          "title": "Reported Role",
          "type": "string"
        },
        "arrival_time_s": {
          "exclusiveMinimum": 0,
          "title": "Arrival Time S",
          "type": "number"
        },
        "picking_basis": {
          "minLength": 1,
          "title": "Picking Basis",
          "type": "string"
        },
        "reported_amplitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Amplitude"
        },
        "amplitude_unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Amplitude Unit"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "pick_id",
        "frame_id",
        "reported_role",
        "arrival_time_s",
        "picking_basis",
        "evidence"
      ],
      "title": "TofdDiffractionPick",
      "type": "object"
    },
    "TofdIndication": {
      "additionalProperties": false,
      "properties": {
        "indication_id": {
          "minLength": 1,
          "title": "Indication Id",
          "type": "string"
        },
        "upper_tip_pick_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Tip Pick Id"
        },
        "lower_tip_pick_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Tip Pick Id"
        },
        "reported_indication_type": {
          "minLength": 1,
          "title": "Reported Indication Type",
          "type": "string"
        },
        "acquisition_location_description": {
          "minLength": 1,
          "title": "Acquisition Location Description",
          "type": "string"
        },
        "physical_location_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Physical Location Id"
        },
        "object_mapping_basis": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Mapping Basis"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "indication_id",
        "reported_indication_type",
        "acquisition_location_description",
        "evidence"
      ],
      "title": "TofdIndication",
      "type": "object"
    },
    "TofdProbePair": {
      "additionalProperties": false,
      "properties": {
        "pair_id": {
          "minLength": 1,
          "title": "Pair Id",
          "type": "string"
        },
        "transmit_probe_id": {
          "minLength": 1,
          "title": "Transmit Probe Id",
          "type": "string"
        },
        "receive_probe_id": {
          "minLength": 1,
          "title": "Receive Probe Id",
          "type": "string"
        },
        "transmit_wedge_id": {
          "minLength": 1,
          "title": "Transmit Wedge Id",
          "type": "string"
        },
        "receive_wedge_id": {
          "minLength": 1,
          "title": "Receive Wedge Id",
          "type": "string"
        },
        "probe_index_separation_m": {
          "exclusiveMinimum": 0,
          "title": "Probe Index Separation M",
          "type": "number"
        },
        "center_frequency_Hz": {
          "exclusiveMinimum": 0,
          "title": "Center Frequency Hz",
          "type": "number"
        },
        "nominal_refracted_angle_rad": {
          "exclusiveMaximum": 1.5707963267948966,
          "exclusiveMinimum": 0,
          "title": "Nominal Refracted Angle Rad",
          "type": "number"
        },
        "index_separation_basis": {
          "minLength": 1,
          "title": "Index Separation Basis",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "transmit_probe_id",
        "receive_probe_id",
        "transmit_wedge_id",
        "receive_wedge_id",
        "probe_index_separation_m",
        "center_frequency_Hz",
        "nominal_refracted_angle_rad",
        "index_separation_basis",
        "evidence"
      ],
      "title": "TofdProbePair",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "examination_id": {
      "minLength": 1,
      "title": "Examination Id",
      "type": "string"
    },
    "procedure_id": {
      "minLength": 1,
      "title": "Procedure Id",
      "type": "string"
    },
    "procedure_revision": {
      "minLength": 1,
      "title": "Procedure Revision",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "specimen_longitudinal_velocity_m_s": {
      "exclusiveMinimum": 0,
      "title": "Specimen Longitudinal Velocity M S",
      "type": "number"
    },
    "specimen_velocity_basis": {
      "minLength": 1,
      "title": "Specimen Velocity Basis",
      "type": "string"
    },
    "wall_thickness_m": {
      "exclusiveMinimum": 0,
      "title": "Wall Thickness M",
      "type": "number"
    },
    "wall_thickness_basis": {
      "minLength": 1,
      "title": "Wall Thickness Basis",
      "type": "string"
    },
    "probe_pair": {
      "$ref": "#/$defs/TofdProbePair"
    },
    "encoder_id": {
      "minLength": 1,
      "title": "Encoder Id",
      "type": "string"
    },
    "encoder_direction": {
      "enum": [
        "increasing",
        "decreasing"
      ],
      "title": "Encoder Direction",
      "type": "string"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/EncodedTofdFrame"
      },
      "minItems": 1,
      "title": "Frames",
      "type": "array"
    },
    "diffraction_picks": {
      "items": {
        "$ref": "#/$defs/TofdDiffractionPick"
      },
      "title": "Diffraction Picks",
      "type": "array"
    },
    "indications": {
      "items": {
        "$ref": "#/$defs/TofdIndication"
      },
      "title": "Indications",
      "type": "array"
    },
    "probe_pair_identity_reviewed": {
      "title": "Probe Pair Identity Reviewed",
      "type": "boolean"
    },
    "specimen_velocity_reviewed": {
      "title": "Specimen Velocity Reviewed",
      "type": "boolean"
    },
    "wall_thickness_reviewed": {
      "title": "Wall Thickness Reviewed",
      "type": "boolean"
    },
    "encoder_calibration_reviewed": {
      "title": "Encoder Calibration Reviewed",
      "type": "boolean"
    },
    "acquisition_calibration_reviewed": {
      "title": "Acquisition Calibration Reviewed",
      "type": "boolean"
    },
    "frame_identity_reviewed": {
      "title": "Frame Identity Reviewed",
      "type": "boolean"
    },
    "time_picks_reviewed": {
      "title": "Time Picks Reviewed",
      "type": "boolean"
    },
    "indication_mapping_reviewed": {
      "title": "Indication Mapping Reviewed",
      "type": "boolean"
    },
    "symmetric_path_applicable": {
      "title": "Symmetric Path Applicable",
      "type": "boolean"
    },
    "negative_result_reviewed": {
      "default": false,
      "title": "Negative Result Reviewed",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "examination_id",
    "procedure_id",
    "procedure_revision",
    "physical_scope_id",
    "material_condition_id",
    "specimen_longitudinal_velocity_m_s",
    "specimen_velocity_basis",
    "wall_thickness_m",
    "wall_thickness_basis",
    "probe_pair",
    "encoder_id",
    "encoder_direction",
    "frames",
    "probe_pair_identity_reviewed",
    "specimen_velocity_reviewed",
    "wall_thickness_reviewed",
    "encoder_calibration_reviewed",
    "acquisition_calibration_reviewed",
    "frame_identity_reviewed",
    "time_picks_reviewed",
    "indication_mapping_reviewed",
    "symmetric_path_applicable",
    "evidence"
  ],
  "title": "TofdExamination",
  "type": "object"
}