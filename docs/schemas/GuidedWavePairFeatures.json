{
  "additionalProperties": false,
  "description": "Descriptive features for one aligned baseline/current guided-wave channel pair.",
  "properties": {
    "specimen_id": {
      "minLength": 1,
      "title": "Specimen Id",
      "type": "string"
    },
    "baseline_acquisition_id": {
      "minLength": 1,
      "title": "Baseline Acquisition Id",
      "type": "string"
    },
    "observation_acquisition_id": {
      "minLength": 1,
      "title": "Observation Acquisition Id",
      "type": "string"
    },
    "frequency_Hz": {
      "exclusiveMinimum": 0,
      "title": "Frequency Hz",
      "type": "number"
    },
    "wave_mode": {
      "enum": [
        "torsional",
        "flexural"
      ],
      "title": "Wave Mode",
      "type": "string"
    },
    "baseline_distance_m": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Baseline Distance M",
      "type": "array"
    },
    "baseline_voltage_V": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Baseline Voltage V",
      "type": "array"
    },
    "observation_distance_m": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Observation Distance M",
      "type": "array"
    },
    "observation_voltage_V": {
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "title": "Observation Voltage V",
      "type": "array"
    },
    "window_start_m": {
      "title": "Window Start M",
      "type": "number"
    },
    "window_end_m": {
      "title": "Window End M",
      "type": "number"
    },
    "distance_match_tolerance_m": {
      "default": 0.0,
      "minimum": 0,
      "title": "Distance Match Tolerance M",
      "type": "number"
    },
    "duplicate_distance_policy": {
      "default": "preserve_samples",
      "enum": [
        "preserve_samples",
        "mean_aligned_duplicates",
        "reject"
      ],
      "title": "Duplicate Distance Policy",
      "type": "string"
    }
  },
  "required": [
    "specimen_id",
    "baseline_acquisition_id",
    "observation_acquisition_id",
    "frequency_Hz",
    "wave_mode",
    "baseline_distance_m",
    "baseline_voltage_V",
    "observation_distance_m",
    "observation_voltage_V",
    "window_start_m",
    "window_end_m"
  ],
  "title": "GuidedWavePairFeatures",
  "type": "object"
}