{
  "$defs": {
    "Calculation": {
      "additionalProperties": false,
      "properties": {
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        },
        "status": {
          "default": "computed",
          "enum": [
            "computed",
            "out_of_scope",
            "needs_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "title": "Calculation",
      "type": "object"
    },
    "FsLifeCalibration": {
      "additionalProperties": false,
      "properties": {
        "criterion": {
          "const": "fatemi_socie",
          "default": "fatemi_socie",
          "title": "Criterion",
          "type": "string"
        },
        "calibrated_fatemi_socie_coefficient": {
          "minimum": 0,
          "title": "Calibrated Fatemi Socie Coefficient",
          "type": "number"
        },
        "calibrated_normalization_stress_Pa": {
          "exclusiveMinimum": 0,
          "title": "Calibrated Normalization Stress Pa",
          "type": "number"
        },
        "shear_modulus_Pa": {
          "exclusiveMinimum": 0,
          "title": "Shear Modulus Pa",
          "type": "number"
        },
        "shear_fatigue_strength_coefficient_Pa": {
          "exclusiveMinimum": 0,
          "title": "Shear Fatigue Strength Coefficient Pa",
          "type": "number"
        },
        "shear_fatigue_strength_exponent": {
          "exclusiveMaximum": 0,
          "title": "Shear Fatigue Strength Exponent",
          "type": "number"
        },
        "shear_fatigue_ductility_coefficient": {
          "exclusiveMinimum": 0,
          "title": "Shear Fatigue Ductility Coefficient",
          "type": "number"
        },
        "shear_fatigue_ductility_exponent": {
          "exclusiveMaximum": 0,
          "title": "Shear Fatigue Ductility Exponent",
          "type": "number"
        }
      },
      "required": [
        "calibrated_fatemi_socie_coefficient",
        "calibrated_normalization_stress_Pa",
        "shear_modulus_Pa",
        "shear_fatigue_strength_coefficient_Pa",
        "shear_fatigue_strength_exponent",
        "shear_fatigue_ductility_coefficient",
        "shear_fatigue_ductility_exponent"
      ],
      "title": "FsLifeCalibration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Convert an FS continuous-plane factor bracket into a cycle-life bracket.",
  "properties": {
    "analysis_id": {
      "minLength": 1,
      "title": "Analysis Id",
      "type": "string"
    },
    "factor_bound_result": {
      "$ref": "#/$defs/Calculation"
    },
    "factor_bound_result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Factor Bound Result Sha256",
      "type": "string"
    },
    "calibration": {
      "$ref": "#/$defs/FsLifeCalibration"
    },
    "calibration_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Calibration Sha256",
      "type": "string"
    },
    "minimum_valid_cycles": {
      "exclusiveMinimum": 0,
      "title": "Minimum Valid Cycles",
      "type": "number"
    },
    "maximum_valid_cycles": {
      "exclusiveMinimum": 0,
      "title": "Maximum Valid Cycles",
      "type": "number"
    },
    "continuous_plane_factor_to_life_monotonicity_reviewed": {
      "title": "Continuous Plane Factor To Life Monotonicity Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_id",
    "factor_bound_result",
    "factor_bound_result_sha256",
    "calibration",
    "calibration_sha256",
    "minimum_valid_cycles",
    "maximum_valid_cycles",
    "continuous_plane_factor_to_life_monotonicity_reviewed"
  ],
  "title": "ContinuousPlaneFsLifeBound",
  "type": "object"
}