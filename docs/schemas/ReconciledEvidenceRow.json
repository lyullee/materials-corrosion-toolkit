{
  "additionalProperties": false,
  "properties": {
    "certificate_id": {
      "title": "Certificate Id",
      "type": "string"
    },
    "measurement_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measurement Id"
    },
    "requirement_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requirement Id"
    },
    "state": {
      "enum": [
        "match",
        "mismatch",
        "unknown",
        "uncertainty_overlap"
      ],
      "title": "State",
      "type": "string"
    },
    "basis": {
      "title": "Basis",
      "type": "string"
    },
    "normalized_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Value"
    },
    "normalized_uncertainty": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Normalized Uncertainty"
    },
    "canonical_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Canonical Unit"
    },
    "source_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Digest",
      "type": "string"
    }
  },
  "required": [
    "certificate_id",
    "state",
    "basis",
    "source_digest"
  ],
  "title": "ReconciledEvidenceRow",
  "type": "object"
}