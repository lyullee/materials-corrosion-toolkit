{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "flag_id": {
      "minLength": 1,
      "title": "Flag Id",
      "type": "string"
    },
    "flag_result": {
      "enum": [
        "satisfied",
        "not_satisfied",
        "not_evaluated"
      ],
      "title": "Flag Result",
      "type": "string"
    },
    "flag_definition": {
      "minLength": 1,
      "title": "Flag Definition",
      "type": "string"
    },
    "review_basis": {
      "minLength": 1,
      "title": "Review Basis",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "flag_id",
    "flag_result",
    "flag_definition",
    "review_basis",
    "evidence"
  ],
  "title": "CallerValidityFlag",
  "type": "object"
}