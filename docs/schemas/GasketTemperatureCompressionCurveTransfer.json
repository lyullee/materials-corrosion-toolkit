{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "TemperatureCompressionCurve": {
      "additionalProperties": false,
      "properties": {
        "specimen_id": {
          "minLength": 1,
          "title": "Specimen Id",
          "type": "string"
        },
        "material_condition_id": {
          "minLength": 1,
          "title": "Material Condition Id",
          "type": "string"
        },
        "loading_branch_id": {
          "minLength": 1,
          "title": "Loading Branch Id",
          "type": "string"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "strain_fraction": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Strain Fraction",
          "type": "array"
        },
        "compressive_stress_Pa": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 10000,
          "minItems": 2,
          "title": "Compressive Stress Pa",
          "type": "array"
        },
        "provider_id": {
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Record Sha256",
          "type": "string"
        },
        "usage_license_id": {
          "minLength": 1,
          "title": "Usage License Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "specimen_id",
        "material_condition_id",
        "loading_branch_id",
        "temperature_K",
        "strain_fraction",
        "compressive_stress_Pa",
        "provider_id",
        "provider_revision",
        "record_id",
        "record_sha256",
        "usage_license_id",
        "evidence"
      ],
      "title": "TemperatureCompressionCurve",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "matintegrity.gasket_temperature_compression_curve_transfer.v1",
      "default": "matintegrity.gasket_temperature_compression_curve_transfer.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "physical_scope_id": {
      "minLength": 1,
      "title": "Physical Scope Id",
      "type": "string"
    },
    "material_condition_id": {
      "minLength": 1,
      "title": "Material Condition Id",
      "type": "string"
    },
    "specimen_id": {
      "minLength": 1,
      "title": "Specimen Id",
      "type": "string"
    },
    "lower_temperature_curve": {
      "$ref": "#/$defs/TemperatureCompressionCurve"
    },
    "upper_temperature_curve": {
      "$ref": "#/$defs/TemperatureCompressionCurve"
    },
    "target_temperature_K": {
      "exclusiveMinimum": 0,
      "title": "Target Temperature K",
      "type": "number"
    },
    "loaded_area_m2": {
      "exclusiveMinimum": 0,
      "title": "Loaded Area M2",
      "type": "number"
    },
    "initial_gasket_thickness_m": {
      "exclusiveMinimum": 0,
      "title": "Initial Gasket Thickness M",
      "type": "number"
    },
    "specimen_geometry_provider_id": {
      "minLength": 1,
      "title": "Specimen Geometry Provider Id",
      "type": "string"
    },
    "specimen_geometry_provider_revision": {
      "minLength": 1,
      "title": "Specimen Geometry Provider Revision",
      "type": "string"
    },
    "specimen_geometry_record_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Specimen Geometry Record Sha256",
      "type": "string"
    },
    "geometry_usage_license_id": {
      "minLength": 1,
      "title": "Geometry Usage License Id",
      "type": "string"
    },
    "geometry_evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "minItems": 1,
      "title": "Geometry Evidence",
      "type": "array"
    },
    "same_specimen_and_condition_transfer_reviewed": {
      "title": "Same Specimen And Condition Transfer Reviewed",
      "type": "boolean"
    },
    "same_loading_path_and_strain_grid_reviewed": {
      "title": "Same Loading Path And Strain Grid Reviewed",
      "type": "boolean"
    },
    "linear_temperature_interpolation_reviewed": {
      "title": "Linear Temperature Interpolation Reviewed",
      "type": "boolean"
    },
    "no_extrapolation_and_no_time_history_reviewed": {
      "title": "No Extrapolation And No Time History Reviewed",
      "type": "boolean"
    },
    "computational_use_authorized": {
      "title": "Computational Use Authorized",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "physical_scope_id",
    "material_condition_id",
    "specimen_id",
    "lower_temperature_curve",
    "upper_temperature_curve",
    "target_temperature_K",
    "loaded_area_m2",
    "initial_gasket_thickness_m",
    "specimen_geometry_provider_id",
    "specimen_geometry_provider_revision",
    "specimen_geometry_record_sha256",
    "geometry_usage_license_id",
    "geometry_evidence",
    "same_specimen_and_condition_transfer_reviewed",
    "same_loading_path_and_strain_grid_reviewed",
    "linear_temperature_interpolation_reviewed",
    "no_extrapolation_and_no_time_history_reviewed",
    "computational_use_authorized"
  ],
  "title": "GasketTemperatureCompressionCurveTransfer",
  "type": "object"
}