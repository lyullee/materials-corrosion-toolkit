{
  "$defs": {
    "ButlerVolmerReaction": {
      "additionalProperties": false,
      "properties": {
        "reaction_id": {
          "minLength": 1,
          "title": "Reaction Id",
          "type": "string"
        },
        "calibration_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Calibration Sha256",
          "type": "string"
        },
        "exchange_current_density_A_m2": {
          "minimum": 0,
          "title": "Exchange Current Density A M2",
          "type": "number"
        },
        "electron_count": {
          "exclusiveMinimum": 0,
          "title": "Electron Count",
          "type": "integer"
        },
        "anodic_transfer_coefficient": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Anodic Transfer Coefficient",
          "type": "number"
        },
        "cathodic_transfer_coefficient": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Cathodic Transfer Coefficient",
          "type": "number"
        },
        "equilibrium_potential_V": {
          "title": "Equilibrium Potential V",
          "type": "number"
        },
        "temperature_K": {
          "exclusiveMinimum": 0,
          "title": "Temperature K",
          "type": "number"
        },
        "minimum_overpotential_V": {
          "title": "Minimum Overpotential V",
          "type": "number"
        },
        "maximum_overpotential_V": {
          "title": "Maximum Overpotential V",
          "type": "number"
        },
        "stoichiometric_species_coefficients": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stoichiometric Species Coefficients",
          "type": "object"
        },
        "calibration_and_reaction_direction_reviewed": {
          "title": "Calibration And Reaction Direction Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "reaction_id",
        "calibration_sha256",
        "exchange_current_density_A_m2",
        "electron_count",
        "anodic_transfer_coefficient",
        "cathodic_transfer_coefficient",
        "equilibrium_potential_V",
        "temperature_K",
        "minimum_overpotential_V",
        "maximum_overpotential_V",
        "stoichiometric_species_coefficients",
        "calibration_and_reaction_direction_reviewed"
      ],
      "title": "ButlerVolmerReaction",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin": {
          "enum": [
            "measured",
            "open_dataset",
            "model_prediction",
            "user_declared",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "source_id",
        "origin",
        "citation"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "WetCo2CylindricalElectrodeKnot": {
      "additionalProperties": false,
      "properties": {
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "solution_film_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Solution Film Thickness M",
          "type": "number"
        },
        "species": {
          "items": {
            "$ref": "#/$defs/WetCo2CylindricalSpeciesBoundary"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Species",
          "type": "array"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/ButlerVolmerReaction"
          },
          "maxItems": 64,
          "minItems": 2,
          "title": "Reactions",
          "type": "array"
        },
        "kinetics_evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Kinetics Evidence",
          "type": "array"
        }
      },
      "required": [
        "time_s",
        "solution_film_thickness_m",
        "species",
        "reactions",
        "kinetics_evidence"
      ],
      "title": "WetCo2CylindricalElectrodeKnot",
      "type": "object"
    },
    "WetCo2CylindricalGeometryKnot": {
      "additionalProperties": false,
      "properties": {
        "time_s": {
          "minimum": 0,
          "title": "Time S",
          "type": "number"
        },
        "wall_recession_m": {
          "minimum": 0,
          "title": "Wall Recession M",
          "type": "number"
        },
        "phase_inventories": {
          "items": {
            "$ref": "#/$defs/WetCo2ScalePhaseLineInventory"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Phase Inventories",
          "type": "array"
        }
      },
      "required": [
        "time_s",
        "wall_recession_m",
        "phase_inventories"
      ],
      "title": "WetCo2CylindricalGeometryKnot",
      "type": "object"
    },
    "WetCo2CylindricalScaleGeometryHistory": {
      "additionalProperties": false,
      "description": "Map lineal phase inventory into an axisymmetric cylindrical bore at exact knots.",
      "properties": {
        "schema_version": {
          "const": "matintegrity.wet_co2_cylindrical_scale_geometry_history.v1",
          "default": "matintegrity.wet_co2_cylindrical_scale_geometry_history.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "asset_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "location_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Location Id",
          "type": "string"
        },
        "time_basis_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Time Basis Id",
          "type": "string"
        },
        "outer_radius_m": {
          "exclusiveMinimum": 0,
          "title": "Outer Radius M",
          "type": "number"
        },
        "initial_inner_radius_m": {
          "exclusiveMinimum": 0,
          "title": "Initial Inner Radius M",
          "type": "number"
        },
        "initial_wall_thickness_m": {
          "exclusiveMinimum": 0,
          "title": "Initial Wall Thickness M",
          "type": "number"
        },
        "segment_length_m": {
          "exclusiveMinimum": 0,
          "title": "Segment Length M",
          "type": "number"
        },
        "geometry_provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Geometry Provider Id",
          "type": "string"
        },
        "geometry_provider_revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Geometry Provider Revision",
          "type": "string"
        },
        "geometry_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Geometry Record Sha256",
          "type": "string"
        },
        "geometry_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "history_provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "History Provider Id",
          "type": "string"
        },
        "history_provider_revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "History Provider Revision",
          "type": "string"
        },
        "history_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "History Record Sha256",
          "type": "string"
        },
        "history_evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/WetCo2CylindricalScalePhase"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Phases",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/WetCo2CylindricalGeometryKnot"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "History",
          "type": "array"
        },
        "axisymmetric_uniformity_reviewed": {
          "title": "Axisymmetric Uniformity Reviewed",
          "type": "boolean"
        },
        "phase_inventory_reference_basis_reviewed": {
          "title": "Phase Inventory Reference Basis Reviewed",
          "type": "boolean"
        }
      },
      "required": [
        "assessment_id",
        "asset_id",
        "location_id",
        "time_basis_id",
        "outer_radius_m",
        "initial_inner_radius_m",
        "initial_wall_thickness_m",
        "segment_length_m",
        "geometry_provider_id",
        "geometry_provider_revision",
        "geometry_record_sha256",
        "geometry_evidence",
        "history_provider_id",
        "history_provider_revision",
        "history_record_sha256",
        "history_evidence",
        "phases",
        "history",
        "axisymmetric_uniformity_reviewed",
        "phase_inventory_reference_basis_reviewed"
      ],
      "title": "WetCo2CylindricalScaleGeometryHistory",
      "type": "object"
    },
    "WetCo2CylindricalScalePhase": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "molar_volume_m3_mol": {
          "exclusiveMinimum": 0,
          "title": "Molar Volume M3 Mol",
          "type": "number"
        },
        "provider_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider Id",
          "type": "string"
        },
        "provider_revision": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Provider Revision",
          "type": "string"
        },
        "source_record_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Source Record Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        }
      },
      "required": [
        "phase_id",
        "molar_volume_m3_mol",
        "provider_id",
        "provider_revision",
        "source_record_id",
        "evidence"
      ],
      "title": "WetCo2CylindricalScalePhase",
      "type": "object"
    },
    "WetCo2CylindricalSpeciesBoundary": {
      "additionalProperties": false,
      "properties": {
        "species_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Species Id",
          "type": "string"
        },
        "bulk_concentration_mol_m3": {
          "minimum": 0,
          "title": "Bulk Concentration Mol M3",
          "type": "number"
        },
        "radial_cell_diffusivity_m2_s": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Radial Cell Diffusivity M2 S",
          "type": "array"
        }
      },
      "required": [
        "species_id",
        "bulk_concentration_mol_m3",
        "radial_cell_diffusivity_m2_s"
      ],
      "title": "WetCo2CylindricalSpeciesBoundary",
      "type": "object"
    },
    "WetCo2ScalePhaseLineInventory": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Phase Id",
          "type": "string"
        },
        "moles_per_axial_metre_mol_m": {
          "minimum": 0,
          "title": "Moles Per Axial Metre Mol M",
          "type": "number"
        }
      },
      "required": [
        "phase_id",
        "moles_per_axial_metre_mol_m"
      ],
      "title": "WetCo2ScalePhaseLineInventory",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Independent steady radial species balances at exact annular-geometry knots.",
  "properties": {
    "schema_version": {
      "const": "matintegrity.wet_co2_cylindrical_transport_mixed_potential.v1",
      "default": "matintegrity.wet_co2_cylindrical_transport_mixed_potential.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "assessment_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Assessment Id",
      "type": "string"
    },
    "geometry": {
      "$ref": "#/$defs/WetCo2CylindricalScaleGeometryHistory"
    },
    "geometry_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Geometry Sha256",
      "type": "string"
    },
    "knots": {
      "items": {
        "$ref": "#/$defs/WetCo2CylindricalElectrodeKnot"
      },
      "maxItems": 5000,
      "minItems": 1,
      "title": "Knots",
      "type": "array"
    },
    "potential_absolute_tolerance_V": {
      "default": 1e-10,
      "exclusiveMinimum": 0,
      "title": "Potential Absolute Tolerance V",
      "type": "number"
    },
    "maximum_bisection_iterations": {
      "default": 200,
      "maximum": 500,
      "minimum": 1,
      "title": "Maximum Bisection Iterations",
      "type": "integer"
    },
    "boundary_chemistry_and_reference_reviewed": {
      "title": "Boundary Chemistry And Reference Reviewed",
      "type": "boolean"
    },
    "radial_domain_mesh_and_film_reviewed": {
      "title": "Radial Domain Mesh And Film Reviewed",
      "type": "boolean"
    },
    "current_reaction_and_surface_area_basis_reviewed": {
      "title": "Current Reaction And Surface Area Basis Reviewed",
      "type": "boolean"
    }
  },
  "required": [
    "assessment_id",
    "geometry",
    "geometry_sha256",
    "knots",
    "boundary_chemistry_and_reference_reviewed",
    "radial_domain_mesh_and_film_reviewed",
    "current_reaction_and_surface_area_basis_reviewed"
  ],
  "title": "WetCo2CylindricalTransportMixedPotential",
  "type": "object"
}