include README.md LICENSE THIRD_PARTY_NOTICES.md .gitignore setup.py
include .gitattributes
include CITATION.cff .zenodo.json CHANGELOG.md CONTRIBUTING.md SECURITY.md
recursive-include docs *.md
recursive-include docs/schemas *.json
recursive-include scripts *.py
recursive-include examples *.py *.json *.jsonl
recursive-include tests *.py
recursive-include tests/data *.json *.jsonl
recursive-include hpc *.json *.sh
recursive-include data/catalogs *.json
recursive-include data/profiles *.json
include data/acquisition_log.json data/data_inventory.json
recursive-include validation *.json *.xml
# Archive-digest receipts are provided alongside archives, never inside themselves.
exclude validation/prepublish_checks.json validation/prepublish_artifact_audit.json
recursive-include .github *.yml
prune data/raw
prune data/derived
prune data/evidence
prune tmp
prune validation/hpc-local
global-exclude *.pdf *.h5 *.mat *.xlsx *.xlsm *.opju *.pyc
global-exclude __pycache__
